	</register>
	<register acronym="PLCP_SIGA_MSB_STATUS" id="plcp_siga_msb_status" width="32" description="MSBs of HE_SIG_A/HT_SIG/VHT_SIG_A" offset="0x20">
		<bitfield width="20" end="0" begin="19" rwaccess="RO" description="MSBs of HE_SIG_A/HT_SIG/VHT_SIG_A" id="PLCP_SIGA_MSB" resetval="0x0" />
		<bitfield width="12" end="20" begin="31" rwaccess="RO" id="Reserved" resetval="0x0" />
	</register>
	<register acronym="PLCP_SIGB_USER_LSB_STATUS" id="plcp_sigb_user_lsb_status" width="32" description="32 LSBs of HE_SIGB of our USER" offset="0x24">
		<bitfield width="32" end="0" begin="31" rwaccess="RO" description="32 LSBs of HE_SIGB of our USER" id="PLCP_SIGB_USER_LSB" resetval="0x0" />
	</register>
	<register acronym="PLCP_SIGB_USER_MSB_STATUS" id="plcp_sigb_user_msb_status" width="32" description="MSBs of HE_SIGB of our USER" offset="0x28">
		<bitfield width="20" end="0" begin="19" rwaccess="RO" description="MSBs of HE_SIGB of our USER" id="PLCP_SIGB_USER_MSB" resetval="0x0" />
		<bitfield width="12" end="20" begin="31" rwaccess="RO" id="Reserved" resetval="0x0" />
	</register>
	<register acronym="PLCP_SIGB_COMMON_STATUS" id="plcp_sigb_common_status" width="32" description="HE_SIG_B Common bits" offset="0x2c">
		<bitfield width="27" end="0" begin="26" rwaccess="RO" description="HE_SIG_B Common bits" id="PLCP_SIGB_COMMON" resetval="0x0" />
		<bitfield width="5" end="27" begin="31" rwaccess="RO" id="Reserved" resetval="0x0" />
	</register>
	<register acronym="PLCP_RATE_LENGTH_PACKET_TYPE_STATUS" id="plcp_rate_length_packet_type_status" width="32" offset="0x30">
		<bitfield width="16" end="0" begin="15" rwaccess="RO" id="PLCP_LENGTH" resetval="0xb0000" />
		<bitfield width="7" end="16" begin="22" rwaccess="RO" id="PLCP_RATE_MCS" resetval="0xb0000" />
		<bitfield width="1" end="23" begin="23" rwaccess="RO" id="Reserved" resetval="0xb0000" />
		<bitfield width="4" end="24" begin="27" rwaccess="RO" id="PTD_PACKET_TYPE" resetval="0xb0000" />
		<bitfield width="1" end="28" begin="28" rwaccess="RO" id="Reserved_2" resetval="0xb0000" />
		<bitfield width="3" end="29" begin="31" rwaccess="RO" id="RX_PLCP_HE_PE" resetval="0xb0000" />
	</register>
	<register acronym="PLCP_MIN_LEN" id="plcp_min_len" width="32" offset="0x34">
		<bitfield width="4" end="0" begin="3" rwaccess="RW" description="Active RU Index in case of receiving supported HE_TB packet" id="MEM_MIN_LEN" resetval="0x300" />
		<bitfield width="4" end="4" begin="7" rwaccess="RO" id="Reserved" resetval="0x300" />
		<bitfield width="1" end="8" begin="8" rwaccess="RW" description="MCS Rate in case of receiving supported HE_TB packet" id="MEM_DELAY_DAT_EN_IN_SHORT_PACKETS" resetval="0x300" />
		<bitfield width="1" end="9" begin="9" rwaccess="RW" description="MCS Rate in case of receiving supported HE_TB packet" id="MEM_DELAY_LAST_IN_SHORT_PACKETS" resetval="0x300" />
		<bitfield width="22" end="10" begin="31" rwaccess="RO" id="Reserved_2" resetval="0x300" />
	</register>
	<register acronym="PLCP_STATE_STATUS" id="plcp_state_status" width="32" offset="0x38">
		<bitfield width="5" end="0" begin="4" rwaccess="RO" id="CURR_STATE" resetval="0x0" />
		<bitfield width="27" end="5" begin="31" rwaccess="RO" id="Reserved" resetval="0x0" />
	</register>
</module>