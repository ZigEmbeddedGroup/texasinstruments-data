<module id="wl_phy_plcp_secure" XML_version="1.0" description="">
	<register acronym="PLCP_FW_CFG" id="plcp_fw_cfg" width="32" offset="0x0">
		<bitfield width="5" end="0" begin="4" rwaccess="RW" description="nxt_state in case of FW control in case of error/unsupported packet" id="MEM_FW_NXT_STATE" resetval="0x180" />
		<bitfield width="1" end="5" begin="5" rwaccess="RW" description="enable FW control on state and cnt in case of error/unsup" id="MEM_FW_WAIT_EN" resetval="0x180" />
		<bitfield width="1" end="6" begin="6" rwaccess="RW" description="enable moving into HDR_ONLY_STATE in case of error/unsupported" id="MEM_FW_HDR_ONLY_EN" resetval="0x180" />
		<bitfield width="1" end="7" begin="7" rwaccess="RW" description="1 - Check reserved bits on he packets (Relevant for HE_SIGA, HE_SIGB)" id="MEM_CHECK_HE_RESERVED_BITS" resetval="0x180" />
		<bitfield width="1" end="8" begin="8" rwaccess="RW" description="2 - Check reserved bits on non he packets (Relevant for lsig, VHT SIG, HT SIG)" id="MEM_CHECK_NON_HE_RESERVED_BITS" resetval="0x180" />
		<bitfield width="1" end="9" begin="9" rwaccess="RW" description="2 - Check reserved bits on non he packets (Relevant for lsig, VHT SIG, HT SIG)" id="MEM_CHECK_EHT_RESERVED_BITS" resetval="0x180" />
		<bitfield width="4" end="10" begin="13" rwaccess="RW" description="0-1 in 40Mhz,0-3 in 80Mhz.which chunk of 20Mhz we need to process" id="MEM_PLCP_PRIMARY_SUB_BAND_INDEX" resetval="0x180" />
		<bitfield width="1" end="14" begin="14" rwaccess="RW" description="Set hdr_err in case plcp_length &gt;2048" id="MEM_ENABLE_ABORT_WRONG_NUM_OF_SYMBOLS" resetval="0x180" />
		<bitfield width="1" end="15" begin="15" rwaccess="RW" description="Don t send header to MAC in case of Unsupported/Error/'Not found our user' packet" id="MEM_DONT_SEND_HEADER_TO_MAC_IN_UNSUP_ERR" resetval="0x180" />
		<bitfield width="16" end="16" begin="31" rwaccess="RW" description="nxt_fsm_cnt in case of FW control in case of error/unsupported packet" id="MEM_FW_NXT_FSM_CNT" resetval="0x180" />
	</register>
	<register acronym="PLCP_BYPASS_CFG" id="plcp_bypass_cfg" width="32" offset="0x4">
		<bitfield width="1" end="0" begin="0" rwaccess="RW" description="Enable define rate from FW" id="MEM_RATE_OVR_EN" resetval="0x0" />
		<bitfield width="7" end="1" begin="7" rwaccess="RW" description="Defined rate from FW" id="MEM_RATE_OVR_VAL" resetval="0x0" />
		<bitfield width="1" end="8" begin="8" rwaccess="RW" description="Enable define length from FW" id="MEM_LENGTH_OVR_EN" resetval="0x0" />
		<bitfield width="7" end="9" begin="15" rwaccess="RO" id="Reserved" resetval="0x0" />
		<bitfield width="16" end="16" begin="31" rwaccess="RW" description="Defined length from FW" id="MEM_LENGTH_OVR_VAL" resetval="0x0" />
	</register>
	<register acronym="PLCP_STA_IDS" id="plcp_sta_ids" width="32" offset="0x8">
		<bitfield width="11" end="0" begin="10" rwaccess="RW" description="Required sta id for unicast" id="MEM_PLCP_STA_ID_LIST_UNICAST" resetval="0x4d2" />
		<bitfield width="5" end="11" begin="15" rwaccess="RO" id="Reserved" resetval="0x4d2" />
		<bitfield width="11" end="16" begin="26" rwaccess="RW" description="Required id for bss" id="MEM_PLCP_STA_ID_LIST_BSS" resetval="0x4d2" />
		<bitfield width="5" end="27" begin="31" rwaccess="RO" id="Reserved_2" resetval="0x4d2" />
	</register>
	<register acronym="PLCP_MAX_LENGTH" id="plcp_max_length" width="32" offset="0xc">
		<bitfield width="16" end="0" begin="15" rwaccess="RW" description="If packet length &gt; reg_value,packets is considered as Error packet" id="MEM_MAX_PACKET_LENGTH" resetval="0xffff" />
		<bitfield width="16" end="16" begin="31" rwaccess="RO" id="Reserved" resetval="0xffff" />
	</register>
	<register acronym="PLCP_HE_TB_CFG_0" id="plcp_he_tb_cfg_0" width="32" offset="0x10">
		<bitfield width="8" end="0" begin="7" rwaccess="RW" description="Active RU Index in case of receiving supported HE_TB packet" id="MEM_TB_ACTIVE_RU_INDEX" resetval="0x1300" />
		<bitfield width="4" end="8" begin="11" rwaccess="RW" description="Active RU size in case of receiving supported HE_TB packet" id="MEM_TB_ACTIVE_RU_SIZE" resetval="0x1300" />
		<bitfield width="4" end="12" begin="15" rwaccess="RW" description="Num of LTF in case of receiving supported HE_TB packet" id="MEM_TB_NUM_LTF" resetval="0x1300" />
		<bitfield width="4" end="16" begin="19" rwaccess="RW" description="MCS Rate in case of receiving supported HE_TB packet" id="MEM_TB_PLCP_RATE_MCS" resetval="0x1300" />
		<bitfield width="4" end="20" begin="23" rwaccess="RO" id="Reserved" resetval="0x1300" />
		<bitfield width="4" end="24" begin="27" rwaccess="RW" description="NSTS before our user in case of receiving supported HE_TB packet" id="MEM_TB_NSTS_BEFORE_ACTIVE_USER" resetval="0x1300" />
		<bitfield width="4" end="28" begin="31" rwaccess="RO" id="Reserved_2" resetval="0x1300" />
	</register>
	<register acronym="PLCP_HE_TB_CFG_1" id="plcp_he_tb_cfg_1" width="32" offset="0x14">
		<bitfield width="1" end="0" begin="0" rwaccess="RW" description="Enable receiving HE_TB packets (In default, TB packets are unsupported packets)" id="MEM_SUPPORT_TB_FLAG" resetval="0x20100" />
		<bitfield width="1" end="1" begin="1" rwaccess="RW" id="MEM_TB_PE_DISAMBIGUITY" resetval="0x20100" />
		<bitfield width="1" end="2" begin="2" rwaccess="RW" id="MEM_TB_DCM" resetval="0x20100" />
		<bitfield width="1" end="3" begin="3" rwaccess="RW" id="MEM_TB_SINGLE_STREAM_PILOT_HE_LTF_MODE" resetval="0x20100" />
		<bitfield width="1" end="4" begin="4" rwaccess="RW" id="MEM_MRU_UNSUPPORTED" resetval="0x20100" />
		<bitfield width="1" end="5" begin="5" rwaccess="RW" id="MEM_WIFI7_UNSUPPORTED" resetval="0x20100" />
		<bitfield width="2" end="6" begin="7" rwaccess="RO" id="Reserved" resetval="0x20100" />
		<bitfield width="2" end="8" begin="9" rwaccess="RW" description="SHORT_GI      = 2'd0 REGULAR_GI  = 2'd1 DOUBLE_GI   = 2'd2 QUAD_GI       = 2'd3" id="MEM_TB_GI_TYPE" resetval="0x20100" />
		<bitfield width="6" end="10" begin="15" rwaccess="RO" id="Reserved_2" resetval="0x20100" />
		<bitfield width="2" end="16" begin="17" rwaccess="RW" description="HE_LTF_1   = 2'd0#br#HE_LTF_2   = 2'd1#br#HE_LTF_4   = 2'd2#br#" id="MEM_TB_HE_LTF_TYPE" resetval="0x20100" />
		<bitfield width="6" end="18" begin="23" rwaccess="RO" id="Reserved_3" resetval="0x20100" />
		<bitfield width="2" end="24" begin="25" rwaccess="RW" id="MEM_TB_APADDING_FACTOR_VALUE" resetval="0x20100" />
		<bitfield width="6" end="26" begin="31" rwaccess="RO" id="Reserved_4" resetval="0x20100" />
	</register>
	<register acronym="PLCP_LSIG_STATUS" id="plcp_lsig_status" width="32" description="Lsig bits:#br# 3:0 - rate#br# 4     - Reserved#br#16:5 - Length#br#17    - Parity bit#br# 23:18 - tail#br# 4     : Reserved#br##br##br##br#" offset="0x18">
		<bitfield width="4" end="0" begin="3" rwaccess="RO" id="PLCP_LSIG_RATE" resetval="0x0" />
		<bitfield width="1" end="4" begin="4" rwaccess="RO" id="PLCP_LSIG_RESERVED" resetval="0x0" />
		<bitfield width="12" end="5" begin="16" rwaccess="RO" id="PLCP_LSIG_LENGTH" resetval="0x0" />
		<bitfield width="1" end="17" begin="17" rwaccess="RO" id="PLCP_LSIG_PARITY" resetval="0x0" />
		<bitfield width="6" end="18" begin="23" rwaccess="RO" id="PLCP_LSIG_TAIL" resetval="0x0" />
		<bitfield width="8" end="24" begin="31" rwaccess="RO" id="Reserved" resetval="0x0" />
	</register>
	<register acronym="PLCP_SIGA_LSB_STATUS" id="plcp_siga_lsb_status" width="32" description="32 LSBs of HE_SIG_A/HT_SIG/VHT_SIG_A" offset="0x1c">
