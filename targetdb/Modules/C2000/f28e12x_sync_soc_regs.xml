<module id="SYNC_SOC_REGS" HW_revision="" description="SYNC SOC Registers">
	<register id="SYNCSELECT" width="32" page="1" offset="0x0" internal="0" description="Sync Input and Output Select Register">
		<bitfield id="SYNCOUT" description="Select EXT Syncout Source" begin="28" end="24" width="5" rwaccess="RW"/>
	</register>
	<register id="ADCSOCOUTSELECT" width="32" page="1" offset="0x2" internal="0" description="External ADCSOC Select Register">
		<bitfield id="PWM1SOCAEN" description="PWM1SOCAEN Enable for ADCSOCAOn " begin="0" end="0" width="1" rwaccess="RW"/>
