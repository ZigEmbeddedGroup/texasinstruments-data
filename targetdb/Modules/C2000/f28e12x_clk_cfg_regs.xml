<module id="CLK_CFG_REGS" HW_revision="" description="CLK CFG Registers">
	<register id="CLKCFGLOCK" width="32" page="1" offset="0x0" internal="0" description="Lock bit for CLKCFG registers">
		<bitfield id="ALL" description="Lock bit for CLKCFG registers" begin="0" end="0" width="1" rwaccess="RW"/>
	</register>
	<register id="CLKSRCCTL1" width="32" page="1" offset="0x2" internal="0" description="Clock Source Control register-1">
		<bitfield id="OSCCLKSRCSEL" description="OSCCLK Source Select Bits" begin="1" end="0" width="2" rwaccess="RW"/>
		<bitfield id="SECCLKSRCSEL" description="SECCLK Source Select Bit" begin="2" end="2" width="1" rwaccess="RW"/>
		<bitfield id="WDHALTI" description="Watchdog HALT Mode Ignore Bit" begin="5" end="5" width="1" rwaccess="RW"/>
	</register>
	<register id="CLKSRCCTL2" width="32" page="1" offset="0x4" internal="0" description="Clock Source Control register-2">
		<bitfield id="CANABCLKSEL" description="CANA Bit Clock Source Select Bit" begin="1" end="0" width="2" rwaccess="RW"/>
	</register>
	<register id="CLKSRCCTL3" width="32" page="1" offset="0x6" internal="0" description="Clock Source Control register-3">
		<bitfield id="XCLKOUTSEL" description="XCLKOUT Source Select Bit" begin="3" end="0" width="4" rwaccess="RW"/>
	</register>
	<register id="SYSPLLCTL" width="32" page="1" offset="0x8" internal="0" description="SYSPLL Control register">
		<bitfield id="PLLEN" description="SYSPLL enable/disable bit" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="PLLCLKEN" description="SYSPLL bypassed or included in the PLLSYSCLK path" begin="1" end="1" width="1" rwaccess="RW"/>
	</register>
	<register id="SYSPLLMULT" width="32" page="1" offset="0xa" internal="0" description="SYSPLL Multiplier register">
		<bitfield id="QDIV" description="SYSPLL Feedback Divider (decides the Multiplier factor)" begin="6" end="0" width="7" rwaccess="RW"/>
		<bitfield id="RDIVCLK0" description="Output Clock Divider" begin="11" end="8" width="4" rwaccess="RW"/>
		<bitfield id="PDIV" description="Reference Clock Divider" begin="17" end="16" width="2" rwaccess="RW"/>
	</register>
	<register id="SYSPLLSTS" width="32" page="1" offset="0xc" internal="0" description="SYSPLL Status register">
		<bitfield id="LOCKS" description="SYSPLL Lock Status Bit" begin="0" end="0" width="1" rwaccess="R"/>
	</register>
	<register id="SYSCLKDIVSEL" width="32" page="1" offset="0xe" internal="0" description="System Clock Divider Select register">
		<bitfield id="PLLSYSCLKDIV" description="PLLSYSCLK Divide Select" begin="5" end="0" width="6" rwaccess="RW"/>
	</register>
	<register id="PERCLKDIVSEL" width="32" page="1" offset="0x10" internal="0" description="Peripheral Clock Divider Select register">
	</register>
	<register id="XCLKOUTDIVSEL" width="32" page="1" offset="0x12" internal="0" description="XCLKOUT Divider Select register">
		<bitfield id="XCLKOUTDIV" description="XCLKOUT Divide Select" begin="1" end="0" width="2" rwaccess="RW"/>
	</register>
	<register id="LOSPCP" width="32" page="1" offset="0x14" internal="0" description="Low Speed Clock Source Prescalar">
		<bitfield id="LSPCLKDIV" description="LSPCLK Divide Select" begin="2" end="0" width="3" rwaccess="RW"/>
	</register>
	<register id="MCDCR" width="32" page="1" offset="0x16" internal="0" description="Missing Clock Detect Control Register">
		<bitfield id="MCLKSTS" description="Missing Clock Status Bit" begin="0" end="0" width="1" rwaccess="R"/>
		<bitfield id="MCLKCLR" description="Missing Clock Clear Bit" begin="1" end="1" width="1" rwaccess="RW"/>
		<bitfield id="MCLKOFF" description="Missing Clock Detect Off Bit" begin="2" end="2" width="1" rwaccess="RW"/>
		<bitfield id="OSCOFF" description="Oscillator Clock Off Bit" begin="3" end="3" width="1" rwaccess="RW"/>
	</register>
	<register id="X1CNT" width="32" page="1" offset="0x18" internal="0" description="10-bit Counter on X1 Clock">
		<bitfield id="X1CNT" description="X1 Counter" begin="10" end="0" width="11" rwaccess="R"/>
		<bitfield id="CLR" description="X1 Counter Clear" begin="16" end="16" width="1" rwaccess="RW"/>
	</register>
	<register id="XTALCR" width="32" page="1" offset="0x1a" internal="0" description="XTAL Control Register">
		<bitfield id="OSCOFF" description="XTAL Oscillator powered-down" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="SE" description="XTAL Oscilator in Single-Ended mode" begin="1" end="1" width="1" rwaccess="RW"/>
	</register>
	<register id="XTALCR2" width="32" page="1" offset="0x1c" internal="0" description="XTAL Control Register for pad init">
		<bitfield id="XIF" description="XI Initial value deposited before XOSC start" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="XOF" description="XO Initial value deposited before XOSC start" begin="1" end="1" width="1" rwaccess="RW"/>
		<bitfield id="FEN" description="XOSC pads initialisation enable" begin="2" end="2" width="1" rwaccess="RW"/>
	</register>
	<register id="CLKFAILCFG" width="32" page="1" offset="0x1e" internal="0" description="Clock Fail cause Configuration">
		<bitfield id="DCC0_ERROR_EN" description="DCC0 Error causes Clock fail NMI, ERROR" begin="0" end="0" width="1" rwaccess="RW"/>
	</register>
	<register id="CLKSRCSTS" width="32" page="1" offset="0x20" internal="0" description="Clock Source Status">
		<bitfield id="SYSOSC_ENABLED" description="SYSOSC enabled status" begin="0" end="0" width="1" rwaccess="R"/>
		<bitfield id="SYSOSC_FCL_DONE" description="SYSOSC FCL done status" begin="1" end="1" width="1" rwaccess="R"/>
	</register>
</module>
