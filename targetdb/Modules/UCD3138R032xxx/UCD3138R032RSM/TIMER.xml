  <bitfield begin="8" description="Causes the value of the bit PWM_OUT to be written into the output latch. So it is possible to preload the output latch or to use the pin as GPIO. The compare action has priority before the preload function. This bit is always read as 0" end="8" id="PWM_OUT_DRV" rwaccess="RW" width="1"></bitfield>
    
  <bitfield begin="7" description="Output action for compare 1 event" end="6" id="PWM_OUT_ACTION1" rwaccess="RW" width="2"></bitfield>
    
  <bitfield begin="5" description="Output action for compare 0 event" end="4" id="PWM_OUT_ACTION0" rwaccess="RW" width="2"></bitfield>
    
  <bitfield begin="3" description="Compare 1 Interrupt Enable" end="3" id="CMP1_INT_ENA" rwaccess="RW" width="1"></bitfield>
    
  <bitfield begin="2" description="Flag which indicates a valid output compare 1 event. This bit is cleared by writing 1 to this bit or by rewriting T16PWM3CMP1DAT. If a clear and a compare event occurs at the same time, the flag will remain high (set has priority versus write clear)." end="2" id="CMP1_INT_FLAG" rwaccess="RW" width="1"></bitfield>
    
  <bitfield begin="1" description="Compare 0 Interrupt Enable" end="1" id="CMP0_INT_ENA" rwaccess="" width="1"></bitfield>
    
  <bitfield begin="0" description="Flag which indicates a valid output compare 0 event. This bit is cleared by writing 1 to this bit or by rewriting T16PWM3CMP0DAT. If a clear and a compare event occurs at the same time, the flag will remain high (set has priority versus write clear)." end="0" id="CMP0_INT_FLAG" rwaccess="RW" width="1"></bitfield>
  </register>
  
  
  <register acronym="WDST" description="Watchdog Status" id="WDST" offset="0x94" width="32">
    
  <bitfield begin="3" description="Watchdog wake event raw status" end="3" id="WAKE_EV_RAW" rwaccess="R" width="1"></bitfield>
    
  <bitfield begin="2" description="Watchdog eventraw status" end="2" id="WD_EV_RAW" rwaccess="R" width="1"></bitfield>
    
  <bitfield begin="1" description="Watchdog wakeup event interrupt status. Cleared on read of Watchdog Status Register" end="1" id="WAKE_EV_INT" rwaccess="R" width="1"></bitfield>
    
  <bitfield begin="0" description="Watchdog event interrupt status. Cleared on read of Watchdog Status Register" end="0" id="WD_EV_INT" rwaccess="R" width="1"></bitfield>
  </register>
  
  
  <register acronym="WDCTRL" description="Watchdog Control" id="WDCTRL" offset="0x98" width="32">
    
