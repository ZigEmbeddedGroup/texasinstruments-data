  <bitfield begin="4" description="Watchdog Reset Event Interrupt Enable" end="4" id="WDRST_INT_EN" rwaccess="RW" width="1"></bitfield>
    
  <bitfield begin="3" description="Watchdog Wake Event Interrupt Enable" end="3" id="WKEV_INT_EN" rwaccess="RW" width="1"></bitfield>
    
