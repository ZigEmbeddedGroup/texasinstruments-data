  <bitfield begin="7" description="Reserved" end="7" id="Reserved" rwaccess="R" width="1"></bitfield>
    
  <bitfield begin="6" description="Watchdog Protect Bit, Active Low" end="6" id="PROTECT" rwaccess="RW" width="1"></bitfield>
    
