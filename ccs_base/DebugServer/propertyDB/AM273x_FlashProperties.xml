<?xml version="1.0" encoding="UTF-8"?>
<PropertyList xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!-- Nodes -->
	<node id="FlashProgrammerNode">
		<name>Flash Settings</name>
		<children>
			<child>CustomFlashEnable</child>
			<child>FlashCustomNote</child>
			<child>FlasherCustomPath</child>
			<child>FlasherCustomName</child>
		</children>
	</node>

	<!-- Category -->
	<categories>
		<category>Erase</category>
		<category>Custom Flasher</category>
	</categories>
		
	<!-- Flash Erase Settings -->
    <property id="EraseActionChoice">
        <target>TMS470RDX</target>
        <name>Erase settings</name>
        <valueType>ChoiceList</valueType>
        <values>
            <value>Erase entire flash</value>
            <value>Erase specific flash blocks</value>
        </values>
        <defaultValue>Erase entire flash</defaultValue>
        <categories>
            <category>Erase</category>
        </categories>
    </property>
    <property id="ChipEraseButton">
        <target>TMS470RDX</target> 
        <name>Erase Entire Flash</name>
        <valueType>Button</valueType>
        <disableIf>
            <property id="EraseActionChoice">Erase specific flash blocks</property>
        </disableIf>
        <action>DPActiveDebugSession.flash.performOperation("EraseAll")</action>
        <categories>
            <category>Erase</category>
        </categories>
    </property>
    <property id="StandaloneEraseSpecificText">
        <target>TMS470RDX</target>
        <name>Sector(s): </name>
        <valueType>String</valueType>
        <defaultValue>0-5,8</defaultValue>
        <enableIf>
            <property id="EraseActionChoice">Erase specific flash blocks</property>
        </enableIf>
        <categories>
            <category>Erase</category>
        </categories>
    </property>
    <property id="StandaloneEraseSpecificButton">
        <target>TMS470RDX</target> 
        <name>Flash Erase</name>
        <valueType>Button</valueType>
        <enableIf>
            <property id="EraseActionChoice">Erase specific flash blocks</property>
        </enableIf>
        <action>DPActiveDebugSession.flash.performOperation("EraseBlocks")</action>
        <categories>
            <category>Erase</category>
        </categories>
    </property>
	
	<!-- Properties -->
	<property id="FlashCustomNote">
		<target>TMS470RDX</target>
		<name>Note: If you have custom board with different flash. Please refer SDK Documentation to build your flasher application and enter the path of .out below</name>
		<valueType>Text</valueType>
		<categories>
			<category>Custom Flasher</category>
		</categories> 
	</property>
	<property id="CustomFlashEnable">
	    <target>TMS470RDX</target>
	    <name>Custom Flasher</name>
	    <valueType>Boolean</valueType>
	    <defaultValue>0</defaultValue>
	    <categories>
			<category>Custom Flasher</category>
		</categories> 
	</property>

	
	<property id="FlasherCustomPath">
	    <target>TMS470RDX</target>
	    <name>Flasher Path</name>
	    <valueType>String</valueType>
	    <defaultValue>C:\ti</defaultValue>
		<disableIf>
			<property id="CustomFlashEnable">0</property>
		</disableIf>
	    <categories>
			<category>Custom Flasher</category>
		</categories> 
	</property>
	
	<property id="FlasherCustomName">
	    <target>TMS470RDX</target>
	    <name>Flasher Name</name>
	    <valueType>String</valueType>
	    <defaultValue>flasher_jtag_uniflash.out</defaultValue>
	    <disableIf>
			<property id="CustomFlashEnable">0</property>
		</disableIf>
	    <categories>
			<category>Custom Flasher</category>
		</categories> 
	</property>
	
	<!-- finish -->
</PropertyList>
