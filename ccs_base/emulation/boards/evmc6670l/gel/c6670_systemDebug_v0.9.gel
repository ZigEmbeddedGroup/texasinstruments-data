#define EDMA_TPTC_DFMPPRXY3    (0x000003D4u)


/* EDMA3 CC Base Memory address */
#define EDMA_TPCC0_BASE        (0x02700000u)
#define EDMA_TPCC1_BASE        (0x02720000u)
