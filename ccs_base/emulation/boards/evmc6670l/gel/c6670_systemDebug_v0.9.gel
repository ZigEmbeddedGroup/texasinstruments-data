nyquist_psc_voltage_control_identification()
{
	unsigned int reg_field, reg_field_1, reg_field_2, reg_field_3;
	
	GEL_TextOut(" *************************** Voltage Control Identification Register (VCNTLID) ****************************\n\n");
	
	GEL_TextOut(" PSC_VCNTLID ---> %x \n\n",,,,,(unsigned int)BB_REG_FIELD_READ(PSC_VCNTLID,31,0));
	
	reg_field = BB_REG_FIELD_READ(PSC_VCNTLID,21,16);
	
	GEL_TextOut(" SmartReflex Class-0 VCNTL selection coming from EFUSE(VCNTL) ---> %d\n",,,,,reg_field);
	
	reg_field_1 = reg_field/2;
	
	reg_field_2 = ((reg_field - 1)/2) + 1;
	
	reg_field_3 = 0.7 + (reg_field_1*0.007) + (reg_field_2*0.006);
	
	GEL_TextOut(" Vdd corresponding to VCNTL#%d: %f Volts\n\n",,,,,reg_field,reg_field_3);
}


Ny_Set_PSC_State(unsigned int power_domain_num,unsigned int clock_domain_num,unsigned int switch_input)
{
    //Wait for any previous transitions to complete
	while((BB_REG_FIELD_READ(PSC_PTSTAT,power_domain_num,power_domain_num)));
	
	//Write Switch input into the corresponding PDCTL register
	BB_REG_FIELD_WRITE((PSC_MDCTL0+(clock_domain_num*4)),4,0,switch_input);
	
	//Write PTCMD to start the transistion
	BB_REG_FIELD_WRITE(PSC_PTCMD,power_domain_num,power_domain_num,0x1);
	
	//wait for the transistion to complete
	while((BB_REG_FIELD_READ(PSC_PTSTAT,power_domain_num,power_domain_num)));
}

nyquist_enable_all_power_clock_domains()
{
	unsigned int power_domain_num, reg_field;
	
	GEL_TextOut( "Power on all PSC power and clock domains... \n");
	
	reg_field = BB_REG_FIELD_READ(NYQUIST_IDENTIFIER,10,10);  
	
	for(power_domain_num = 0; power_domain_num <= 17; power_domain_num++)
	{
		//Wait for any previous transitions to complete
		while((BB_REG_FIELD_READ(PSC_PTSTAT,power_domain_num,power_domain_num)));
		
		//Write Switch input into the corresponding PDCTL register
		BB_REG_FIELD_WRITE((PSC_PDCTL0+(power_domain_num*4)),0,0,0x1);
		
		//Write PTCMD to start the transistion
		BB_REG_FIELD_WRITE(PSC_PTCMD,power_domain_num,power_domain_num,0x1);
		
		//wait for the transistion to complete
		while((BB_REG_FIELD_READ(PSC_PTSTAT,power_domain_num,power_domain_num)));
	}
	
	if (reg_field == 0)
	{
		// Turbo Nyquist
		power_domain_num = 18;
		
		//Wait for any previous transitions to complete
		while((BB_REG_FIELD_READ(PSC_PTSTAT,power_domain_num,power_domain_num)));
		
		//Write Switch input into the corresponding PDCTL register
		BB_REG_FIELD_WRITE((PSC_PDCTL0+(power_domain_num*4)),0,0,0x1);
		
		//Write PTCMD to start the transistion
		BB_REG_FIELD_WRITE(PSC_PTCMD,power_domain_num,power_domain_num,0x1);
		
		//wait for the transistion to complete
		while((BB_REG_FIELD_READ(PSC_PTSTAT,power_domain_num,power_domain_num)));
	}
	
	GEL_TextOut(" All power domains of Nyquist are enabled Successfully\n\n");
    
	Ny_Set_PSC_State(PD0, LPSC_SMARTRFLX, PSC_ENABLE);
	Ny_Set_PSC_State(PD0, LPSC_DDR3, PSC_ENABLE);
	Ny_Set_PSC_State(PD0, LPSC_TCP3E, PSC_ENABLE);
	Ny_Set_PSC_State(PD0, LPSC_VCP2A, PSC_ENABLE);
	Ny_Set_PSC_State(PD1, LPSC_DEBUG, PSC_ENABLE);
	Ny_Set_PSC_State(PD1, LPSC_TETB, PSC_ENABLE);
	Ny_Set_PSC_State(PD2, LPSC_PA, PSC_ENABLE);
	Ny_Set_PSC_State(PD2, LPSC_SGMII, PSC_ENABLE);
	Ny_Set_PSC_State(PD2, LPSC_SA, PSC_ENABLE);
	Ny_Set_PSC_State(PD3, LPSC_PCIE, PSC_ENABLE);
	Ny_Set_PSC_State(PD4, LPSC_SRIO, PSC_ENABLE);
	Ny_Set_PSC_State(PD5, LPSC_HYPER, PSC_ENABLE);
	Ny_Set_PSC_State(PD7, LPSC_MSMCRAM, PSC_ENABLE);
	Ny_Set_PSC_State(PD8, LPSC_RACA_RACB, PSC_ENABLE);
	Ny_Set_PSC_State(PD8, LPSC_TAC, PSC_ENABLE);
	Ny_Set_PSC_State(PD9, LPSC_FFTCA_FFTCB, PSC_ENABLE);
	Ny_Set_PSC_State(PD10, LPSC_AIF2, PSC_ENABLE);
	Ny_Set_PSC_State(PD11, LPSC_TCP3DA, PSC_ENABLE);
	Ny_Set_PSC_State(PD12, LPSC_VCP2B, PSC_ENABLE);
	Ny_Set_PSC_State(PD12, LPSC_VCP2C, PSC_ENABLE);
	Ny_Set_PSC_State(PD12, LPSC_VCP2D, PSC_ENABLE);
	Ny_Set_PSC_State(PD13, LPSC_C0_TIM0, PSC_ENABLE);
	Ny_Set_PSC_State(PD14, LPSC_C1_TIM1, PSC_ENABLE);
	Ny_Set_PSC_State(PD14, LPSC_C1_RSA, PSC_ENABLE);
	Ny_Set_PSC_State(PD15, LPSC_C2_TIM2, PSC_ENABLE);
	Ny_Set_PSC_State(PD15, LPSC_C2_RSA, PSC_ENABLE);
	Ny_Set_PSC_State(PD16, LPSC_C3_TIM3, PSC_ENABLE);
	Ny_Set_PSC_State(PD17, LPSC_TCP3dB, PSC_ENABLE);   
		
	if (reg_field == 0)
	{
		// Turbo Nyquist
		Ny_Set_PSC_State(PD18, LPSC_BCP, PSC_ENABLE);
	}

	GEL_TextOut( "All clock domains of Nyquist are enabled Successfully\n\n" );
}

nyquist_psc_pwrdomain_status()
{
	unsigned int reg_field;
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** NYQUIST PSC PWR DOMAINS STATUS **************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	reg_field = BB_REG_FIELD_READ(PSC_PDSTAT0,1,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" Most peripheral logic (pwr domain) is in **OFF** state\n");
	}
	else
	{
		GEL_TextOut(" Most peripheral logic (pwr domain) is in ##0N## state\n");
	}
	
	reg_field = BB_REG_FIELD_READ(PSC_PDSTAT1,1,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" Per-core TETB and System TETB (pwr domain) is in **OFF** state\n");
