		GEL_TextOut(" MPY[7:1] => Reserved\n");
	}
	
	GEL_TextOut(" ENDIVCLK: %d\n",,,,,BB_REG_FIELD_READ(BOOTCFG_PCIE_SERDES_CFGPLL,8,8));
	
