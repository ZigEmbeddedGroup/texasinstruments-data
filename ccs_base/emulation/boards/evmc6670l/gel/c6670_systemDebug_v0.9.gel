	}
	else if(reg_field == 5)
	{
		GEL_TextOut(" L1PMODE[2:0] ---> Maximal cache\n\n");
	}
	else if(reg_field == 6)
	{
		GEL_TextOut(" L1PMODE[2:0] ---> Maximal cache\n\n");
	}
	else if(reg_field == 7)
