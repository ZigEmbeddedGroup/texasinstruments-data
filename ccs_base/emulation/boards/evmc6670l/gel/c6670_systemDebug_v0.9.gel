	GEL_TextOut(" BOOTCFG_PCIE_SERDES_CFGPLL ---> %x \n\n",,,,,(unsigned int)BB_REG_FIELD_READ(BOOTCFG_PCIE_SERDES_CFGPLL,31,0));
	
