hotmenu PW_Config_Snapshot()
{
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT-WRITE CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Port_Write_Control_Register();

	Port_Write_Routing_Register();

	Port_Write_Reception_Event_Generate_Register();

}

	
menuitem "SRIO PW Status";

Port_Write_Reception_Status_CSR()
{
	unsigned int reg_field;

	GEL_TextOut(" ******************* Port-Write Reception Status CSR (PW_RX_STAT) *******************\n\n");

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_RX_STAT),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_VAL  => The Port-Write data registers  ##DO NOT CONTAIN##  valid data \n");
	}
	else
	{
		
		GEL_TextOut(" PW_VAL  => The Port-Write data registers  **CONTAIN**  valid data \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_RX_STAT),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_DISC => A Port-Write was  ##NOT DISCARDED## \n");
	}
	else
	{
		
		GEL_TextOut(" PW_DISC => A Port-Write was  **DISCARDED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_RX_STAT),8,8);
	
	GEL_TextOut(" WDPTR   => %d (determines the size of the Port-Write payload received) \n",,,,,reg_field);
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_RX_STAT),15,12);
	
	GEL_TextOut(" RW_SIZE => %x (determines the size of the Port-Write payload received) \n\n",,,,,(unsigned char)reg_field);
	
}

Port_Write_Reception_Capture()
{

	unsigned int i,reg_field;

	GEL_TextOut(" ******************* Port-Write Reception Capture(n) CSR (PW_RX_CAPT(n)) *******************\n\n");

	for(i=0;i<4;i++)
	{
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PW_RX_CAPT0+(i*0x4))),31,0);;
		
		if(i != 3)
		{
			GEL_TextOut(" PW_CAPT[%d] => %x  \n",,,,,i,reg_field);
		}
		else
		{
			GEL_TextOut(" PW_CAPT[%d] => %x  \n\n",,,,,i,reg_field);
		}
	}
}


hotmenu Port_Write_Reception_Status_CSR_Status()
{
	Port_Write_Reception_Status_CSR();
}

hotmenu Port_Write_Reception_Capture_Status()
{
	Port_Write_Reception_Capture();
}


hotmenu PW_Status_Snapshot()
{
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT-WRITE STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Port_Write_Reception_Status_CSR();

	Port_Write_Reception_Capture();

}


menuitem "SRIO LLM Configuration";

Port_Number_CSR()
{
	unsigned int reg_field;

	GEL_TextOut(" ******************* Port Number CSR (PORT_NUMBER) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PORT_NUMBER),7,0);
	
	GEL_TextOut(" PORT_NUM   => Maintenance read operation accessed this register through Port%d \n",,,,,reg_field);

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PORT_NUMBER),15,8);
	
	GEL_TextOut(" PORT_TOTAL => Total number of Ports are %d  \n\n",,,,,reg_field);
}

Port_IP_Prescalar_for_SRV_CLK_Register()
{
	unsigned int reg_field;

	GEL_TextOut(" ******************* Port IP Prescalar for SRV_CLK Register(PRESCALAR_SRV_CLK) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PRESCALAR_SRV_CLK),7,0);
	
	GEL_TextOut(" PRESCALAR_SRV_CLK => %d (srio_ip_clk of %f MHz) \n",,,,,reg_field,SRIO_IP_CLK_MHZ);
	
	GEL_TextOut(" SRV_CLK_PERIOD    => %f us \n\n",,,,,reg_field*(1/SRIO_IP_CLK_MHZ));
}

Register_Reset_Control_CSR()
{
	unsigned int reg_field;

	GEL_TextOut(" ******************* Register Reset Control CSR (REG_RST_CTL) *******************\n\n");

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_REG_RST_CTL),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" CLEAR_STICKY => Sticky bits are  ##NOT CLEARED##  by  SELF_RST and PWDN_PORT \n\n");
	}
	else
	{
		
		GEL_TextOut(" CLEAR_STICKY => Sticky bits are  **CLEARED**  by  SELF_RST and PWDN_PORT \n\n");
	}
}

Local_Logical_Transport_Layer_Error_Enable_CSR()
{
	unsigned int reg_field;
	
	GEL_TextOut(" ******************* Local Logical/Transport Layer Error Enable CSR (LOCAL_ERR_EN)*******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LOCAL_ERR_EN),22,22);
	
	if(reg_field==0)
	{
		GEL_TextOut(" ILL_TYPE_EN => Unsupported Transaction error reporting  ##DISABLED##  \n");
	}
	else
	{
		
		GEL_TextOut(" ILL_TYPE_EN => Unsupported Transaction error reporting  **ENABLED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LOCAL_ERR_EN),26,26);
	
	if(reg_field==0)
	{
		GEL_TextOut(" ILL_ID_EN   => Illegal transaction target error reporting  ##DISABLED##  \n\n");
	}
	else
	{
		
		GEL_TextOut(" ILL_ID_EN   => Illegal transaction target error reporting  **ENABLED**  \n\n");
	}
}


