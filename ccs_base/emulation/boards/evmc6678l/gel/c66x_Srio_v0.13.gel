    reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_MECS_STAT),7,0);
	
	if((reg_field & 0x00000001) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=0 by any of the RIO ports\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=0   by any of the RIO ports\n");
	}
	
	if((reg_field & 0x00000002) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=1 by any of the RIO ports\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=1   by any of the RIO ports\n");
	}
	
	if((reg_field & 0x00000004) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=2 by any of the RIO ports\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=2   by any of the RIO ports\n");
	}
	
	
	if((reg_field & 0x00000008) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=3 by any of the RIO ports\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=3   by any of the RIO ports\n");
	}
	
	
	if((reg_field & 0x00000010) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=4 by any of the RIO ports\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=4   by any of the RIO ports\n");
	}
	
	
	if((reg_field & 0x00000020) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=5 by any of the RIO ports\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=5   by any of the RIO ports\n");
	}
	
	
	if((reg_field & 0x00000040) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=6 by any of the RIO ports\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=6   by any of the RIO ports\n");
	}
	
	
	if((reg_field & 0x00000080) != 0)
	{
		GEL_TextOut(" MECS  ##NOT RECEIVED##  with cmd=7 by any of the RIO ports\n\n");
	}
	else
	{
		GEL_TextOut(" MECS  **RECEIVED**  with cmd=7   by any of the RIO ports\n\n");
	}
	
}
	
