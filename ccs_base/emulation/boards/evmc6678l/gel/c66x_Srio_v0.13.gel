menuitem "SRIO TLM Status/All Ports Snapshot";

hotmenu Ports_TLM_status_Snapshot()
{
	unsigned int i;
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT TLM STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d TLM STATUS ******************* \n\n",,,,,i);
		
		TLM_Port_Status_Register(i);
	}
}


PBM_Port_Control_Register(unsigned int port_no)
{
	unsigned int reg_field,i;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PBM Port Control Register (PBM_SP%d_CONTROL)  ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_CONTROL+(i*0x80))),2,0);
	
	GEL_TextOut(" EG_REORDER_STICK => The CRQ is reordered after each reorder event for %d repeat times \n",,,,,(reg_field+1));
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_CONTROL+(i*0x80))),5,4);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" EG_REORDER_MODE  => Reorder on reorder trigger, bring the oldest higher preference flowID to front of CRQ \n\n");
	}
	else if(reg_field == 1)
	{
		GEL_TextOut(" EG_REORDER_MODE  => Reorder on reorder trigger, bring the oldest highest preference flowID to front of CRQ \n\n");
	}
	else if(reg_field == 2)
	{
		GEL_TextOut(" EG_REORDER_MODE  => Reserved \n\n");
	}
	else if(reg_field == 3)
	{
		GEL_TextOut(" EG_REORDER_MODE  => Reorder on each dequeue, bring oldest highest preference flowID to front of CRQ \n\n");
	}
}

PBM_Port_Interrupt_Enable_Register(unsigned int port_no)
{
	unsigned int reg_field,i;
	
	i=port_no;

	GEL_TextOut(" ******************* PBM Port Interrupt Enable Register(PBM_SP%d_INT_ENABLE) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_INT_ENABLE+(i*0x80))),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event  ##DOESNT CONTRIBUTE##  to the port interrupt request \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event  **CONTRIBUTES**  to the port interrupt request\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_INT_ENABLE+(i*0x80))),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event  ##DOESNT CONTRIBUTE##  to the port interrupt request \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event  **CONTRIBUTES**  to the port interrupt request\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_INT_ENABLE+(i*0x80))),3,3);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event  ##DOESNT CONTRIBUTE##  to the port interrupt request \n");
	}
	else
	{
		
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event  **CONTRIBUTES**  to the port interrupt request\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_INT_ENABLE+(i*0x80))),4,4);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event  ##DOESNT CONTRIBUTE##  to the port interrupt request \n\n");
	}
	else
	{
		
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event  **CONTRIBUTES**  to the port interrupt request\n\n");
	}
}

PBM_Port_Port_Write_Enable_Register(unsigned int port_no)
{
	unsigned int reg_field,i;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PBM Port%d Port-Write Enable Register (PBM_SP%d_Port-Write_ENABLE)  ******************* \n\n",,,,,i,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_PW_ENABLE+(i*0x80))),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event  ##DOESNT CONTRIBUTE##  to the port Port-Write request \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event  **CONTRIBUTES**  to the port Port-Write request\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_PW_ENABLE+(i*0x80))),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event  ##DOESNT CONTRIBUTE##  to the port Port-Write request \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event  **CONTRIBUTES**  to the port Port-Write request\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_PW_ENABLE+(i*0x80))),3,3);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event  ##DOESNT CONTRIBUTE##  to the port Port-Write request \n");
	}
	else
	{
		
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event  **CONTRIBUTES**  to the port Port-Write request\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_PW_ENABLE+(i*0x80))),4,4);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event  ##DOESNT CONTRIBUTE##  to the port Port-Write request \n\n");
	}
	else
	{
		
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event  **CONTRIBUTES**  to the port Port-Write request\n\n");
	}
}

PBM_Port_Event_Generate_Register(unsigned int port_no)
{
	unsigned int reg_field,i;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PBM Port Event Generate Register (PBM_SP%d_EVENT_GEN)  ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_EVENT_GEN+(i*0x80))),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event generation  ##DISABLED##  \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event generation  **ENABLED**  \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_EVENT_GEN+(i*0x80))),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event generation  ##DISABLED##  \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event generation  **ENABLED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_EVENT_GEN+(i*0x80))),3,3);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event generation  ##DISABLED##  \n");
	}
	else
	{
		
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event generation  **ENABLED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_EVENT_GEN+(i*0x80))),4,4);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event generation  ##DISABLED##  \n\n");
	}
	else
	{
		
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event generation  **ENABLED**  \n\n");
	}
}

PBM_Port_Ingress_Resources_Register(unsigned int port_no)
{
	unsigned int reg_field,i;
	
	i=port_no;

	GEL_TextOut(" ******************* PBM Port Ingress Resources Register(PBM_SP%d_IG_RESOURCES) ******************* \n\n",,,,,i);
	
