Port_Control_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;

	GEL_TextOut("  *******************Port%d Control CSR configuration******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.PORT_TYPE[0]                  => This port is a  **PARALELL PORT**   \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.PORT_TYPE[0]                  => This port is a  ##SERIAL PORT##   \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),1,1);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.PORT_LOCKOUT[1]               => The port is  ##ENABLED##  to issue any packets \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.PORT_LOCKOUT[1]               => The port is stopped and is  **NOT ENABLED**  to issue or receive any packets \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),2,2);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.DROP_PACKET_ENABLE[2]         => The output port  ##CONTINUES TO##  try to transmit packets that have been rejected due to transmission errors \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.DROP_PACKET_ENABLE[2]         => The output port  **DROPS PACKETS**  that are acknowledged with a packet-not-accepted control symbol \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),3,3);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.STOP_PORT_FLD_ENC_ENABLE[3]   => Even when the Output Failed-encountered bit is set, the port  ##CONTINUES TO ATTEMPT##  to transmit packets \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.STOP_PORT_FLD_ENC_ENABLE[3]   => When the Output Failed-encountered bit is set, the port  **STOPS ATTEMPTING**  to send packets \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),19,19);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.MULTICAST_PARTICIPANT[19]     => Multicast-event control symbols  **CANNOT BE ACCEPTED**  by this port \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.MULTICAST_PARTICIPANT[19]     => Multicast-event control symbols  ##CAN BE ACCEPTED##  by this port \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),20,20);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.ERROR_CHECK_DISABLE[20]       => RapidIO transmission error checking and recovery are  ##ENABLED##  \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.ERROR_CHECK_DISABLE[20]       => RapidIO transmission error checking and recovery are  **DISABLED**  \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),21,21);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.INPUT_PORT_ENABLE[21]         => The port is  **STOPPED AND ONLY ENABLED**  to route or respond I/O logical maintenance packets, depending upon the functionality of the processing element. \n",,,,,i,reg_field);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.INPUT_PORT_ENABLE[21]         => Port is  ##ENABLED##  to respond to any packet \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),22,22);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.OUTPUT_PORT_ENABLE[22]        => The port is  **STOPPED AND NOT ENABLED**  to issue any packets except to route or respond to I/O logical maintenance packets, depending upon the functionality of the processing element \n",,,,,i,reg_field);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.OUTPUT_PORT_ENABLE[22]        => The port is  ##ENABLED##  to issue any packets \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x10))),23,23);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.PORT_DISABLE[23]              => Port receivers/drivers are  ##ENABLED##  \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.PORT_DISABLE[23]              => Port receivers/drivers are  **DISABLED**  and are unable to receive/transmit any packets or control symbols \n",,,,,i,reg_field);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),26,24);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.OVER_PWIDTH[26:24]            => No override \n",,,,,i);
	}
	else if(reg_field == 2)
	{
		GEL_TextOut(" SP%d_CTL.OVER_PWIDTH[26:24]            => Force single lane, lane 0 \n",,,,,i);
	}
	else if(reg_field == 3)
	{
		GEL_TextOut(" SP%d_CTL.OVER_PWIDTH[26:24]            => Force single lane, lane R \n",,,,,i);
	}
	else if(reg_field == 5)
	{
		GEL_TextOut(" SP%d_CTL.OVER_PWIDTH[26:24]            => 2x mode enabled, 4x mode disabled \n",,,,,i);
	}
	else if(reg_field == 6)
	{
		GEL_TextOut(" SP%d_CTL.OVER_PWIDTH[26:24]            => 4x mode enabled, 2x mode disabled \n",,,,,i);
	}
	else if(reg_field == 7)
	{
		GEL_TextOut(" SP%d_CTL.OVER_PWIDTH[26:24]            => 2x and 4x modes enabled \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.OVER_PWIDTH[26:24]            => Reserved \n",,,,,i,reg_field);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),29,27);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.INIT_PWIDTH[29:27]            => Single-lane port, lane 0 \n",,,,,i);
	}
	else if(reg_field == 1)
	{
		GEL_TextOut(" SP%d_CTL.INIT_PWIDTH[29:27]            => Single-lane port, lane R \n",,,,,i);
	}
	else if(reg_field == 2)
	{
		GEL_TextOut(" SP%d_CTL.INIT_PWIDTH[29:27]            => Four-lane port \n",,,,,i);
	}
	else if(reg_field == 3)
	{
		GEL_TextOut(" SP%d_CTL.INIT_PWIDTH[29:27]            => Two-lane port \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.INIT_PWIDTH[29:27]            => Reserved \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),30,30);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.PORT_WIDTH_BIT1[30]           => 4x mode  **NOT SUPPORTED**   \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.PORT_WIDTH_BIT1[30]           => 4x mode  ##SUPPORTED##  \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),31,31);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_CTL.PORT_WIDTH_BIT0[31]           => 2x mode  **NOT SUPPORTED**   \n\n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_CTL.PORT_WIDTH_BIT0[31]           => 2x mode  ##SUPPORTED##  \n\n",,,,,i);
	}
}


Port_Control2_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;

	GEL_TextOut(" ******************* Port%d Control2 CSR configuration ******************* \n\n",,,,,i);
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RTEC_EN     => Remote transmit emphasis control is  **DISABLED**  \n");
	}
	else
	{
		
		GEL_TextOut(" RTEC_EN     => Remote transmit emphasis control is  ##ENABLED##  \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RTEC        => The port  **DOES NOT**  support remote transmit emphasis adjustment in the connected port \n");
	}
	else
	{
		
		GEL_TextOut(" RTEC        => Reserved \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),2,2);
	
	if(reg_field==0)
	{
		GEL_TextOut(" D_SCRM_DIS  => Transmit data scrambler and receive data descrambler are  ##ENABLED## \n");
	}
	else
	{
		
		GEL_TextOut(" D_SCRM_DIS  => Transmit data scrambler and receive data descrambler are  **DISABLED**  for control and packet data characters \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),3,3);
	
	if(reg_field==0)
	{
		GEL_TextOut(" INACT_EN    => Lanes assigned to the port but not used by the port have their outputs  **DISABLED**  \n");
	}
	else
	{
		
		GEL_TextOut(" INACT_EN    => Lanes assigned to the port but not used by the port have their transmitter and receiver  ##ENABLED##  \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),16,16);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_6p25_EN  => 6.25 GBaud operation  **DISABLED**  \n");
	}
	else
	{
		
		GEL_TextOut(" GB_6p25_EN  => 6.25 GBaud operation ##ENABLED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),17,17);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_6p25     => 6.25 GBaud operation  **NOT SUPPORTED** \n");
	}
	else
	{
		
		GEL_TextOut(" GB_6p25     => 6.25 GBaud operation  ##SUPPORTED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),18,18);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_5p0_EN   => 5 GBaud operation  **DISABLED**  \n");
	}
	else
	{
		
		GEL_TextOut(" GB_5p0_EN   => 5 GBaud operation ##ENABLED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),19,19);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_5p0      => 5 GBaud operation  **NOT SUPPORTED** \n");
	}
	else
	{
		
		GEL_TextOut(" GB_5p0      => 5 GBaud operation  ##SUPPORTED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),20,20);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_3p125_EN => 3.125 GBaud operation  **DISABLED**  \n");
	}
	else
	{
		
		GEL_TextOut(" GB_3p125_EN => 3.125 GBaud operation ##ENABLED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),21,21);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_3p125    => 3.125 GBaud operation  **NOT SUPPORTED** \n");
	}
	else
	{
		
		GEL_TextOut(" GB_3p125    => 3.125 GBaud operation  ##SUPPORTED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),22,22);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_2p5_EN   => 2.5 GBaud operation  **DISABLED**  \n");
	}
	else
	{
		
		GEL_TextOut(" GB_2p5_EN   => 2.5 GBaud operation ##ENABLED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),23,23);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_2p5      => 2.5 GBaud operation  **NOT SUPPORTED** \n");
	}
	else
	{
		
		GEL_TextOut(" GB_2p5      => 2.5 GBaud operation  ##SUPPORTED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),24,24);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_1p25_EN  => 1.25 GBaud operation  **DISABLED**  \n");
	}
	else
	{
		
		GEL_TextOut(" GB_1p25_EN  => 1.25 GBaud operation ##ENABLED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),25,25);
	
	if(reg_field==0)
	{
		GEL_TextOut(" GB_1p25     => 1.25 GBaud operation  **NOT SUPPORTED** \n");
	}
	else
	{
		
		GEL_TextOut(" GB_1p25     => 1.25 GBaud operation  ##SUPPORTED## \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),27,27);
	
	if(reg_field==0)
	{
		GEL_TextOut(" BAUD_DISC   => Automatic baud rate discovery  **NOT SUPPORTED**  \n");
	}
	else
	{
		
		GEL_TextOut(" BAUD_DISC   => Automatic baud rate discovery  ##SUPPORTED##  \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL2+(i*0x20))),28,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" BAUD_SEL    => No rate selected \n\n");
	}
	else if(reg_field==1)
	{
		GEL_TextOut(" BAUD_SEL    => 1.25 GBaud \n\n");
	}
	else if(reg_field==2)
	{
		GEL_TextOut(" BAUD_SEL    => 2.5 GBaud \n\n");
	}
	else if(reg_field==3)
	{
		GEL_TextOut(" BAUD_SEL    => 3.125 GBaud \n\n");
	}
	else if(reg_field==4)
	{
		GEL_TextOut(" BAUD_SEL    => 5.0 GBaud \n\n");
	}
	else if(reg_field==5)
	{
		GEL_TextOut(" BAUD_SEL    => 6.25 GBaud \n\n");
	}
	else
	{
		GEL_TextOut(" BAUD_SEL    => Reserved \n\n");
	}
}
	
Port_Error_Rate_Enable_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;
	
	GEL_TextOut(" *******************Port%d Error Rate Enable CSR configuration******************* \n \n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.LINK_TIMEOUT_EN[0]               =>  **DISABLE**  error rate counting of link timeout errors \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.LINK_TIMEOUT_EN[0]               =>  ##ENABLE##  error rate counting of link timeout errors \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),1,1);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.UNSOLICITED_ACK_CNTL_SYM_EN[1]   =>  **DISABLE**  error rate counting of unsolicited acknowledge control symbols. \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.UNSOLICITED_ACK_CNTL_SYM_EN[1]   =>  ##ENABLE##  error rate counting of unsolicited acknowledge control symbols. \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),2,2);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.DELINEATION_ERROR_EN[2]          =>  **DISABLE**  error rate counting of delineation errors \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.DELINEATION_ERROR_EN[2]          =>  ##ENABLE##  error rate counting of delineation errors \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),4,4);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.PROTOCOL_ERROR_EN[4]             =>  **DISABLE**  error rate counting of protocol errors \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.PROTOCOL_ERROR_EN[4]             =>  ##ENABLE##  error rate counting of protocol errors \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),5,5);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.NON_OUTSTANDING_ACKID_EN[5]      =>  **DISABLE**  error rate counting of link-responses received with an ackID that is not outstanding. \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.NON_OUTSTANDING_ACKID_EN[5]      =>  ##ENABLE##  error rate counting of link-responses received with an ackID that is not outstanding \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),14,14);
	
	if(reg_field==0)
	{
		GEL_TextOut(" SP%d_RATE_EN.DSCRAM_LOS_EN[14]                =>  **DISABLE**  error rate counting of the loss of receiver de-scrambler synchronization  \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.DSCRAM_LOS_EN[14]                =>  ##ENABLE##  error rate counting of the loss of receiver de-scrambler synchronization  \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),17,17);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.RCVED_PKT_OVER_276B_EN[17]       =>  **DISABLE**  error rate counting of packets that exceed the maximum allowed size \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.RCVED_PKT_OVER_276B_EN[17]       =>  ##ENABLE##  error rate counting of packets that exceed the maximum allowed size \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),18,18);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.RCVED_PKT_WITH_BAD_CRC_EN[18]    =>  **DISABLE**  error rate counting of packets with a bad CRC values \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.RCVED_PKT_WITH_BAD_CRC_EN[18]    =>  ##ENABLE##  error rate counting of packets with a bad CRC values \n",,,,,i);
	}
	

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),19,19);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.PKT_UNEXPECTED_ACKID_EN[19]      =>  **DISABLE**  error rate counting of packets with unexpected/out-of-sequence ackIDs \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.PKT_UNEXPECTED_ACKID_EN[19]      =>  ##ENABLE##  error rate counting of packets with unexpected/out-of-sequence ackIDs. \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),20,20);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.RCVED_PKT_NOT_ACCPT_EN[20]       =>  **DISABLE**  error rate counting of received packet-not-accepted control symbols. \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.RCVED_PKT_NOT_ACCPT_EN[20]       =>  ##ENABLE##  error rate counting of received packet-not-accepted control symbols. \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),21,21);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.CNTL_SYM_UNEXPECTED_ACKID_EN[21] =>  **DISABLE**  error rate counting of an acknowledge control symbol with an unexpected ackID \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.CNTL_SYM_UNEXPECTED_ACKID_EN[21] =>  ##ENABLE##  error rate counting of an acknowledge control symbol with an unexpected ackID. \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),22,22);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.CORRUPT_CNTL_SYM_ENABLE[22]      =>  **DISABLE**  error rate counting of a corrupt control symbol \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.CORRUPT_CNTL_SYM_ENABLE[22]      =>  ##ENABLE##  error rate counting of a corrupt control symbol \n",,,,,i);
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),31,31);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_RATE_EN.EN_IMP_SPECIFIC[31]              =>  **DISABLE**  error rate counting of implementation specific errors \n\n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_RATE_EN.EN_IMP_SPECIFIC[31]              =>  ##ENABLE##  error rate counting of implementation specific errors \n\n",,,,,i);
	}
}


Port_Error_Rate_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;

	GEL_TextOut(" *******************Port%d Error Rate CSR configuration*******************\n \n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),31,24);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Do not decrement the error rate counter \n",,,,,i);
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 1ms (nominal) \n",,,,,i);
	}
	
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 10ms (nominal) \n",,,,,i);
	}
	
	else if(reg_field == 0x7)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 100ms \n",,,,,i);
	}
	
	else if(reg_field == 0xF)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 1s (nominal) \n",,,,,i);
	}
	
	else if(reg_field == 0x1F)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 10s (nominal) \n",,,,,i);
	}
	
	else if(reg_field == 0x3F)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 100s (nominal) \n",,,,,i);
	}
	
	else if(reg_field == 0x7F)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 1000s (nominal) \n",,,,,i);
	}
	
	else if(reg_field == 0xFF)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Decrement every 10000s (nominal) \n",,,,,i);
	}
	
	else
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_BIAS[31:24]     => Reserved \n",,,,,i);
	}
					
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),17,16);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_RECOVERY[17:16] => Only count 2 errors & above \n\n",,,,,i);
	}
	else if(reg_field == 1)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_RECOVERY[17:16] => Only count 4 errors & above \n\n",,,,,i);
	}
	else if(reg_field == 2)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_RECOVERY[17:16] => Only count 16 errors & above \n\n",,,,,i);
	}
	else if(reg_field == 3)
	{
		GEL_TextOut(" SP%d_ERR_RATE.ERROR_RATE_RECOVERY[17:16] => Do not limit incrementing the error rate count \n\n",,,,,i);
	}
}
	
Port_Error_Rate_Threshold_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;	

	GEL_TextOut(" *******************Port%d Error Rate Threshold CSR configuration*******************\n \n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_THRESH+(i*0x40))),23,16);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_ERR_THRESH.ERROR_RATE_DEGRADED_THRESH[23:16] --->  **DISABLE**  the error rate register \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_ERR_THRESH.ERROR_RATE_DEGRADED_THRESH[23:16] ---> %d \n",,,,,i,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_THRESH+(i*0x40))),31,24);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SP%d_ERR_THRESH.ERROR_RATE_FAILED_THRESH[31:24]   --->  **DISABLE**  the error rate Register \n\n",,,,,i);
	}
	else
	{
		GEL_TextOut(" SP%d_ERR_THRESH.ERROR_RATE_FAILED_THRESH[31:24]   --->  %d \n\n",,,,,i,reg_field);
	}
}


