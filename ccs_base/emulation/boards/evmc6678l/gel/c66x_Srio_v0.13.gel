	PLM_Port_Vmin_Exponent_Register(3);

	PLM_Port_Lane_Polarity_Control_Register(3);

	PLM_Port_Packet_Denial_Control_Register(3);

	PLM_Port_MECS_Forwarding_Register(3);
}

