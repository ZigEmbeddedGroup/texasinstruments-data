/*--------------------------------------------------------------*/
/* tci6616_Srio_v0.11.gel                                               */
/* Version 0.11                                                */
/*                                                              */
/* This GEL file is designed to be used in conjunction with     */
/* CCS v4.2 and the TCI6616 Device.                                 */
/*                                                              */
/* HISTORY:                                                            */
/* Ver 0.1: Initial Draft                                           */
/* Ver 0.2: Updated w.r.t to the latest Tundra specs             */
/* Ver 0.3: Updated with proper formating and spacing            */
/* ver 0.4: Updated the reg fields of PER_SET_CNTL              */
/* ver 0.5: Updated error scan functions for Nysh specific errors */
/*          Updated LSU config and status menus                  */
/*          Updated Interrupt routing and Status                */
/* ver 0.6: Updated TX_CPPI and RX_CPPI config.                 */
/*          Updated Garbage Collection Info                    */
/* ver 0.7: Added status of garbage collection queues           */
/* ver 0.8: Added SERDES PLL lock status check.                 */
/*          Added All registers Snapshot menu                   */
/* ver 0.9: RXU_map function updated                            */
/* ver 0.10: updated Mailbox check for Multi-segment RXU Map entries */
/*           Added functions for Maintenance operations           */
/* ver 0.11: updated formatting to make it compatible with CCS v4.2 */
/* ver 0.12: updated the menu structure for more ease of use    */
/*                                                              */
/*                                                              */
/* Created By: Karthik Ramana Sankar                             */
/* Date: July 2010                                                   */
/*--------------------------------------------------------------*/

/*--------------------------------------------------------------*/
/* Nysh MENU                                              */
/*--------------------------------------------------------------*/



/* SRIO register field read macro */
#define SRIO_REG_FIELD_READ(reg_value, reg_high, reg_low) (unsigned int)((reg_value&((0xFFFFFFFF>>((31-reg_high)+reg_low))<<reg_low))>>reg_low)

/* SRIO register field write macro */
#define SRIO_REG_FIELD_WRITE(reg_addr, reg_high, reg_low, reg_value) (*(unsigned int *)reg_addr) = ((*(unsigned int *)reg_addr)&(~((0xFFFFFFFF>>(31-reg_high))&(0xFFFFFFFF<<reg_low))))|((reg_value<<reg_low)&((0xFFFFFFFF>>(31-reg_high))&(0xFFFFFFFF<<reg_low))) 


