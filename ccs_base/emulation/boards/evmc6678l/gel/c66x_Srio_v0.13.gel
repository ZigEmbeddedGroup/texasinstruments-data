{
	GEL_TextOut(" ********************************** Logical/Transport Layer High Address Capture CSR (H_ADDR_CAPT) ******************************************************\n\n");
	                        
    GEL_TextOut(" ADDRESS_63_32 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_H_ADDR_CAPT),31,0));
