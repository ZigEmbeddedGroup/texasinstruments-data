menuitem "SRIO RX_CPPI Configuration";

Mailbox_to_Queue_Mapping_Registers()
{
	unsigned int i,status,no_of_msgs,queue_ptr,reg_field,src_id,mailbox,letter,mailbox_mask,letter_mask,dest_id,queue_id,msg_type,srcid_match,destid_match,flow_id;
	
	GEL_TextOut(" ********************************** Mailbox to Queue Mapping Registers (RXU_MAPn_L, RXU_MAPn_H and RXU_MAPn_QID) ******************************************************\n\n");
	
	for(i=0;i<64;i++)
	{
		
		src_id=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_MAP0_L+(i*0xC))),15,0);
		
		mailbox=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_MAP0_L+(i*0xC))),21,16);
		
