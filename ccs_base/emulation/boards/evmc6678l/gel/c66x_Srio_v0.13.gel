menuitem "SRIO TLM Configuration/PORT 0";

TLM_Port_Control_Register(unsigned int port_no)
{

	unsigned int reg_field,reg_field_1;
	
	unsigned int i;
	
	i=port_no;

	GEL_TextOut(" ******************* TLM Port Control Register (TLM_SP%d_CONTROL) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_CONTROL+(i*0x80))),15,12);
	
	GEL_TextOut(" LENGTH => %d => The no of data nodes to be stored, before the PBMi notifies to schedule a pkt(default value=9) \n",,,,,reg_field);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_CONTROL+(i*0x80))),20,20);
	
	reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_CONTROL+(i*0x80))),21,21);
	
	GEL_TextOut(" Promiscuous Mode Settings: \n\n");
	
	if(reg_field==0 && reg_field_1==0)
	{
		GEL_TextOut(" For Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to LLM\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route by BRR\n"); 
		
		GEL_TextOut(" No match of destID            => Discard this pkt\n");
		
		GEL_TextOut(" For Non-Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to User-Core\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route pkt to User-Core\n"); 
		
		GEL_TextOut(" No match of destID            => Discard this pkt\n\n");
	}
	else if(reg_field==0 && reg_field_1==1)
	{
		GEL_TextOut(" For Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to LLM\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route by BRR\n"); 
		
		GEL_TextOut(" No match of destID            => route pkt to User-Core\n");
		
		GEL_TextOut(" For Non-Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to User-Core\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route pkt to User-Core\n"); 
		
		GEL_TextOut(" No match of destID            => route pkt to User-Core\n\n");
	}
	else if(reg_field==0 && reg_field_1==1)
	{
		GEL_TextOut(" For Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to LLM\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route pkt to LLM\n"); 
		
		GEL_TextOut(" No match of destID            => route pkt to LLM\n");
		
		GEL_TextOut(" For Non-Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to User-Core\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route pkt to User-Core\n"); 
		
		GEL_TextOut(" No match of destID            => Discard this pkt\n\n");
	}
	else if(reg_field==1 && reg_field_1==1)
	{
		GEL_TextOut(" For Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to LLM\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route pkt to LLM\n"); 
		
		GEL_TextOut(" No match of destID            => route pkt to LLM\n");
		
		GEL_TextOut(" For Non-Maintainence type pkts :\n");
		
		GEL_TextOut(" If destID matches base destID => route pkt to User-Core\n"); 
		
		GEL_TextOut(" If destID matches BRR         => route pkt to User-Core\n"); 
		
		GEL_TextOut(" No match of destID            => route pkt to User-Core\n\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_CONTROL+(i*0x80))),29,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" VOQ_SELECT       => VOQ within a Port Group is determined by the packet's FLOWID (PRIO,CRF) \n");
	}
	else if(reg_field==1)
	{
		GEL_TextOut(" VOQ_SELECT       => VOQ within a Port Group is determined only by the packet's PRIO field \n");
	}
	else
	{
		GEL_TextOut(" VOQ_SELECT       => Only VOQ zero is used in each Port Group FlowID is ignored\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_CONTROL+(i*0x80))),30,30);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PORTGROUP_SELECT => There is only one port group to which TLMi directs non-LLM traffic  \n\n");
	}
	else
	{
		GEL_TextOut(" PORTGROUP_SELECT => Reserved \n\n");
	}
}


TLM_Port_Interrupt_Enable_Register(unsigned int port_no)
{

	unsigned int reg_field,reg_field_1;
	
	unsigned int i;
	
	i=port_no;

	GEL_TextOut(" ******************* TLM Port Interrupt Enable Register(TLM_SP%d_INT_ENABLE)  ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_INT_ENABLE+(i*0x80))),20,20);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IG_BRR_FILTER => IG_BRR_FILTER  ##DOES NOT##  contribute to the port's interrupt request \n");
	}
	else
	{
		
		GEL_TextOut(" IG_BRR_FILTER => IG_BRR_FILTER  **DOES**  contribute to the port's interrupt request \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_INT_ENABLE+(i*0x80))),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IG_BAD_VC     => IG_BAD_VC  ##DOES NOT##  contribute to the port's interrupt request \n\n");
	}
	else
	{
		
		GEL_TextOut(" IG_BAD_VC     => IG_BAD_VC  **DOES**  contribute to the port's interrupt request \n\n");
	}
}


