menuitem "SRIO EM Configuration";

Event_Management_Interrupts_Enable_Register()
{
	unsigned int reg_field;
	
	GEL_TextOut(" ******************* Event Management Interrupts Enable Register(EM_INT_ENABLE) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_ENABLE),8,8);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOCALOG =>  ##DISABLES##  a logical layer event detected in the  User Core to cause an interrupt. \n");
	}
	else
	{
		
		GEL_TextOut(" LOCALOG =>  **ENABLES**  a logical layer event detected in the  User Core to cause an interrupt. \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_ENABLE),16,16);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_RX   =>  ##DISABLES##  the reception of a Port-Write to cause an interrupt \n");
	}
	else
	{
		
		GEL_TextOut(" PW_RX   =>  **ENABLES**  the reception of a Port-Write to cause an interrupt \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_ENABLE),26,26);
	
	if(reg_field==0)
	{
		GEL_TextOut(" MECS    =>  ##ENABLES##  an interrupt to be raised upon reception of an MECS \n");
	}	
	else
	{
		
		GEL_TextOut(" MECS    =>  ##DISABLES##  an interrupt to be raised upon reception of an MECS \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_ENABLE),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOG     =>  ##DISABLES## a logical layer event detected in the User Core to cause an interrupt \n\n");
	}
	else
	{
		
		GEL_TextOut(" LOG     =>  **ENABLES** a logical layer event detected in the User Core to cause an interrupt \n\n");
	}
	
}
	
Event_Management_Port_Write_Enable_Register()
{	
	unsigned int reg_field;
	
	GEL_TextOut(" ******************* Event Management Port-Write Enable Register(EM_PW_ENABLE) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_PW_EN),8,8);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOCALOG =>  ##DISABLES##  an implementation-specific Logical/Transport Layer Error to cause a Port-Write to be sent \n");
	}
	else
	{
		
		GEL_TextOut(" LOCALOG =>  **ENABLES**  an implementation-specific Logical/Transport Layer Error to cause a Port-Write to be sent \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_PW_EN),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOG     =>  ##DISABLES##  a logical layer event to cause a Port-Write to be sent \n\n");
	}
	else
	{
		
		GEL_TextOut(" LOG     =>  **ENABLES**  a logical layer event to cause a Port-Write to be sent \n\n");
	}
	
}
	
Event_Management_Device_Interrupt_Enable_Register()
{
	unsigned int reg_field;
	
	GEL_TextOut(" ******************* Event Management Device Interrupt Enable Register(EM_DEV_INT_EN) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_DEV_INT_EN),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" INT_EN => Interrupt line is  ##DEASSERTED##  \n\n");
	}
	else
	{
		
		GEL_TextOut(" INT_EN => Interrupt line may be  **ASSERTED**  by enabled events \n\n");
	}
}

Event_Management_Device_Port_Write_Enable_Register()
{
	unsigned int reg_field;

	GEL_TextOut(" ******************* Event Management Device Port-Write Enable Register(EM_DEV_PW_EN) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_DEV_PW_EN),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_EN => Port-Writes are  ##NOT SENT##\n\n");
	}
	else
	{
		
		GEL_TextOut(" PW_EN =>  Port-Writes may be  **SENT**  when an enabled event is detected\n\n");
	}
}
	
