menuitem "SRIO Interrupts Routing Configuration"

Doorbell_Interrupts_Routing_fn()
{
	unsigned int i,j,drbl_routing_info,bit_position,reg_field;
	
	bit_position=3;

	GEL_TextOut(" ********************************** DOORBELLn Interrupt Condition Routing Registers (DOORBELLn_ICRR and DOORBELLn_ICRR2) ******************************************************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_INTERRUPT_CTL),0,0);
	
	if(reg_field == 1)
	{
		for(j=0;j<4;j++)
		{
		
			GEL_TextOut(" DOORBELL REG%d INTERRUPT CONDITION ROUTING REGISTER: \n \n",,,,,j);
		
			for(i=0;i<8;i++)
			{
	 
				drbl_routing_info = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DOORBELL0_ICRR+(j*0x10))),(bit_position+(4*i)),(i*4));
				
				if(drbl_routing_info == 0x0)
				{
					GEL_TextOut(" DOORBELL%d_ICRR.ICR%d   ---> %d => INTDST0 \n",,,,,j,i,drbl_routing_info);
				}
				else if(drbl_routing_info == 0x1)
				{
					GEL_TextOut(" DOORBELL%d_ICRR.ICR%d   ---> %d => INTDST1 \n",,,,,j,i,drbl_routing_info);
				}
				else if(drbl_routing_info == 0x2)
				{
					GEL_TextOut(" DOORBELL%d_ICRR.ICR%d   ---> %d => INTDST2 \n",,,,,j,i,drbl_routing_info);
				}
				else if(drbl_routing_info == 0x3)
				{
					GEL_TextOut(" DOORBELL%d_ICRR.ICR%d   ---> %d => INTDST3 \n",,,,,j,i,drbl_routing_info);
				}
