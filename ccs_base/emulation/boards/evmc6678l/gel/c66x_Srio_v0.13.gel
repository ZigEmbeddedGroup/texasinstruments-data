menuitem "SRIO CPPI garbage collection";

Garbage_Collection_info()
{
	
	unsigned int Threshold, Temp, Entry_Count, Byte_Count, Packet_Size, Queue_Num;
	
	unsigned int garbage_len,garbage_Tout,garbage_retry,garbage_TransErr,garbage_ssize;
	
	GEL_TextOut("*******************************************************************************************************\n");
	GEL_TextOut("********************************* SRIO GARBAGE QUEUES ******************************************************\n");
	GEL_TextOut("*******************************************************************************************************\n\n");
	
	garbage_len = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GARBAGE_COLL_QID0),29,16);
	
	GEL_TextOut(" Queue%d stores descriptors of message whose length mismatch between size in the UDI packet and recieved payload. \n",,,,,garbage_len);
	
	Entry_Count = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_len) + QM_STATUS_CONFIG_REGA)) & 0x0007FFFF;
	
	Byte_Count 	= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_len) + QM_STATUS_CONFIG_REGB)) & 0x0FFFFFFF;
	
	Packet_Size = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_len) + QM_STATUS_CONFIG_REGC)) & 0x0000001F;
	
	Temp 		= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_len) + QM_STATUS_CONFIG_REGD)) & 0x0000000F;
	
	Threshold 	= (1<<Temp) - 1;
	
	GEL_TextOut(" Queue %d Status --> Entry Count %d \t Byte Count %d \t Packet Size %d \t Queue Threshold In terms of Packets %d \t \n",,,,, garbage_len, Entry_Count, Byte_Count, Packet_Size, Threshold);

	
	garbage_Tout = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GARBAGE_COLL_QID0),13,0);

	GEL_TextOut(" Queue%d stores descriptors of message which timeOut on receiving one of the segments. \n",,,,,garbage_Tout);
	
	Entry_Count = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_Tout) + QM_STATUS_CONFIG_REGA)) & 0x0007FFFF;
	
	Byte_Count 	= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_Tout) + QM_STATUS_CONFIG_REGB)) & 0x0FFFFFFF;
	
	Packet_Size = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_Tout) + QM_STATUS_CONFIG_REGC)) & 0x0000001F;
	
	Temp 		= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_Tout) + QM_STATUS_CONFIG_REGD)) & 0x0000000F;
	
	Threshold 	= (1<<Temp) - 1;
	
	GEL_TextOut(" Queue %d Status --> Entry Count %d \t Byte Count %d \t Packet Size %d \t Queue Threshold In terms of Packets %d \t \n",,,,, garbage_Tout, Entry_Count, Byte_Count, Packet_Size, Threshold);

	
	
	garbage_retry = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GARBAGE_COLL_QID1),29,16);
	
	GEL_TextOut(" Queue%d stores descriptors of message which received more than retry_count 'retry' responses \n",,,,,garbage_retry);
	
	Entry_Count = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_retry) + QM_STATUS_CONFIG_REGA)) & 0x0007FFFF;
	
	Byte_Count 	= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_retry) + QM_STATUS_CONFIG_REGB)) & 0x0FFFFFFF;
	
	Packet_Size = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_retry) + QM_STATUS_CONFIG_REGC)) & 0x0000001F;
	
	Temp 		= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_retry) + QM_STATUS_CONFIG_REGD)) & 0x0000000F;
	
	Threshold 	= (1<<Temp) - 1;
	
	GEL_TextOut(" Queue %d Status --> Entry Count %d \t Byte Count %d \t Packet Size %d \t Queue Threshold In terms of Packets %d \t \n",,,,, garbage_retry, Entry_Count, Byte_Count, Packet_Size, Threshold);

	
	garbage_TransErr = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GARBAGE_COLL_QID1),13,0);
	
	GEL_TextOut(" Queue%d stores descriptors of message which received an 'error' response. \n",,,,,garbage_TransErr);
	
	Entry_Count = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_TransErr) + QM_STATUS_CONFIG_REGA)) & 0x0007FFFF;
	
	Byte_Count 	= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_TransErr) + QM_STATUS_CONFIG_REGB)) & 0x0FFFFFFF;
	
	Packet_Size = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_TransErr) + QM_STATUS_CONFIG_REGC)) & 0x0000001F;
	
	Temp 		= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_TransErr) + QM_STATUS_CONFIG_REGD)) & 0x0000000F;
	
	Threshold 	= (1<<Temp) - 1;
	
	GEL_TextOut(" Queue %d Status --> Entry Count %d \t Byte Count %d \t Packet Size %d \t Queue Threshold In terms of Packets %d \t \n",,,,, garbage_TransErr, Entry_Count, Byte_Count, Packet_Size, Threshold);

	
	garbage_ssize = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GARBAGE_COLL_QID2),13,0);
	
	GEL_TextOut(" Queue%d stores descriptors of type11 message which fails the requirement (Msg_len/16) <= Ssize \n",,,,,garbage_ssize);
	
	Entry_Count = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_ssize) + QM_STATUS_CONFIG_REGA)) & 0x0007FFFF;
	
	Byte_Count 	= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_ssize) + QM_STATUS_CONFIG_REGB)) & 0x0FFFFFFF;
	
	Packet_Size = *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_ssize) + QM_STATUS_CONFIG_REGC)) & 0x0000001F;
	
	Temp 		= *((unsigned int*)(QM_STATUS_CONFIG_BASE + (16 * garbage_ssize) + QM_STATUS_CONFIG_REGD)) & 0x0000000F;
	
	Threshold 	= (1<<Temp) - 1;
	
	GEL_TextOut(" Queue %d Status --> Entry Count %d \t Byte Count %d \t Packet Size %d \t Queue Threshold In terms of Packets %d \t \n\n",,,,, garbage_ssize, Entry_Count, Byte_Count, Packet_Size, Threshold);

	
}

hotmenu Garbage_Collection_information()
{
	Garbage_Collection_info();
}


PLM_Port_Implementation_Specific_Control_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PLM Port Implementation Specific Control Register (PLM_SP%d_IMP_SPEC_CTL) ******************* \n\n",,,,,i);
	
	GEL_TextOut(" DLT_THRESH    => Dead link timer threshold set to %d  \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),15,0));
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),17,16);
	
	if(reg_field!=i)
	{
		GEL_TextOut(" SWAP_RX       => Port%d RX is  **SWAPPED**  with that of Port%d \n",,,,,i,reg_field);
	}
	else
	{
		GEL_TextOut(" SWAP_RX       => Port%d RX is  ##NOT SWAPPED##   \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),19,18);
	
	if(reg_field!=i)
	{
		GEL_TextOut(" SWAP_TX       => Port%d TX is  **SWAPPED**  with that of Port%d \n",,,,,i,reg_field);
	}
	else
	{
		GEL_TextOut(" SWAP_TX       => Port%d TX is  ##NOT SWAPPED##   \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),21,21);
	
	reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),20,20);
	
	if(reg_field_1==0)
	{
		if(reg_field==0)
		{
			GEL_TextOut(" PORT_SELF_RST => Port is  ##NOT RESET##  on receiving port reset request \n");
		}
		else
		{
			
			GEL_TextOut(" PORT_SELF_RST => Port is  **RESET**  on receiving port reset request \n");
		}
	}
	else
	{
		
		GEL_TextOut(" SELF_RST      => Port is  **RESET**  on receiving port reset request \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),23,23);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LLB_EN        => Line loopback mode is  ##DISABLED## \n");
	}
	else
	{
		
		GEL_TextOut(" LLB_EN        => Line loopback mode is  **ENABLED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),24,24);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TX_BYPASS     => Transmitter clock crossing FIFO  ##NOT BYPASSED## \n");
	}
	else
	{
		
		GEL_TextOut(" TX_BYPASS     => Transmitter clock crossing FIFO  **BYPASSED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),25,25);
	
	if(reg_field==0)
	{
		GEL_TextOut(" SOFT_RST_PORT => Normal mode of operation \n");
	}
	else
	{
		
		GEL_TextOut(" SOFT_RST_PORT => Port held in reset \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" DLB_EN        => Digital equipment loopback mode  ##DISABLED## \n");
	}
	else
	{
		
		GEL_TextOut(" DLB_EN        => Digital equipment loopback mode  **ENABLED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),29,29);
	
	if(reg_field==0)
	{
		GEL_TextOut(" USE_IDLE1     => IDLE1 sequences (above 5.5 GBaud) are  **NOT ALLOWED** \n");
	}
	else
	{
		
		GEL_TextOut(" USE_IDLE1     => IDLE1 sequences (above 5.5 GBaud) are  ##ALLOWED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),30,30);
	
	if(reg_field==0)
	{
		GEL_TextOut(" USE_IDLE2     => IDLE2 sequences (below 5.5 GBaud) are  **NOT ALLOWED** \n");
	}
	else
	{
		
		GEL_TextOut(" USE_IDLE2     => IDLE2 sequences (below 5.5 GBaud) are  ##ALLOWED## \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PAYL_CAP      => Payload capture (packet/control symbol error capture) settings are  ##NOT CHANGED##  \n\n");
	}
	else
	{
		
		GEL_TextOut(" PAYL_CAP      => Payload capture (packet/control symbol error capture) settings are  **CHANGED**  \n\n");
	}
}


