menuitem "SRIO Packet Forwarding & Flow Control Configuration"

Packet_Forwarding_Register_n_for_16_Bit_Device_IDs()
{
	unsigned int i,outbound_port;
	
	
    GEL_TextOut(" ********************************** Packet Forwarding Register n for 16-Bit Device IDs (PF_16B_CNTLn) ******************************************************\n\n");
	
    for(i=0;i<8;i++)
	{
		
		outbound_port=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),17,16),SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),17,16);
        
        if(i != 7)
		{    
			GEL_TextOut(" Packets received with devid in the range: %x to %x are forwarded to Port%d \n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_16B_CNTL0+(i*8))),15,0),(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_16B_CNTL0+(i*8))),31,16),outbound_port);
		}
		else
		{
			GEL_TextOut(" Packets received with devid in the range: %x to %x are forwarded to Port%d \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_16B_CNTL0+(i*8))),15,0),(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_16B_CNTL0+(i*8))),31,16),outbound_port);
		}
	}
}



Packet_Forwarding_Register_n_for_8_Bit_Device_IDs()
{
	unsigned int i,outbound_port;
	
    GEL_TextOut(" ********************************** Packet Forwarding Register n for 8-Bit Device IDs (PF_8B_CNTLn) ******************************************************\n\n");
	
    for(i=0;i<8;i++)
	{
		                 
		outbound_port=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),17,16),SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),17,16);
                    
        if(i != 7)
		{
			GEL_TextOut(" Packets received with devid in the range: %x to %x are forwarded to Port%d \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),7,0),(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),15,8),outbound_port);
		}
		else
		{
			GEL_TextOut(" Packets received with devid in the range: %x to %x are forwarded to Port%d \n\n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),7,0),(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PF_8B_CNTL0+(i*8))),15,8),outbound_port);
		}
	}
}



Flow_Control_Table_Entry_Register_n()
{
	unsigned int i,reg_field;
	
	GEL_TextOut(" ********************************** Flow Control Table Entry Register n (FLOW_CNTLn) ******************************************************\n\n");
	
	for(i=0;i<16;i++)
	{
		if(i<10)
		{
			
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),17,16);
			
			if(reg_field == 0)
			{
				GEL_TextOut(" FLOW CNTRL CONFIG REG%d:  FLOW_CNTL_ID ---> %x ** TT => 8 bit device IDs \n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
			}
			else if(reg_field == 1)
			{
				GEL_TextOut(" FLOW CNTRL CONFIG REG%d:  FLOW_CNTL_ID ---> %x ** TT => 16 bit device IDs \n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
			}
			else
			{
				GEL_TextOut(" FLOW CNTRL CONFIG REG%d:  FLOW_CNTL_ID ---> %x ** TT => Reserved \n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
			}
		}
		else
		{
			if(i != 15)
			{
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),17,16);
				
				if(reg_field == 0)
				{
					GEL_TextOut(" FLOW CNTRL CONFIG REG%d: FLOW_CNTL_ID ---> %x ** TT => 8 bit device IDs \n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
				}
				else if(reg_field == 1)
				{
					GEL_TextOut(" FLOW CNTRL CONFIG REG%d: FLOW_CNTL_ID ---> %x ** TT => 16 bit device IDs \n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
				}
				else
				{
					GEL_TextOut(" FLOW CNTRL CONFIG REG%d: FLOW_CNTL_ID ---> %x ** TT => Reserved \n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
				}
			}
			else
			{
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),17,16);
				
				if(reg_field == 0)
				{
					GEL_TextOut(" FLOW CNTRL CONFIG REG%d: FLOW_CNTL_ID ---> %x ** TT => 8 bit device IDs \n\n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
				}
				else if(reg_field == 1)
				{
					GEL_TextOut(" FLOW CNTRL CONFIG REG%d: FLOW_CNTL_ID ---> %x ** TT => 16 bit device IDs \n\n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
				}
				else
				{
					GEL_TextOut(" FLOW CNTRL CONFIG REG%d: FLOW_CNTL_ID ---> %x ** TT => Reserved \n\n",,,,,i,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_FLOW_CNTL0+(i*4))),15,0));
				}
			}
		}
		
	}
}


