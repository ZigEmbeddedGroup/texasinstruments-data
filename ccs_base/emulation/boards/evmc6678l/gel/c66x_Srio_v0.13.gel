	crf=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_TX_QUEUE_SCH_INFO1),0,0);
	
	prio=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_TX_QUEUE_SCH_INFO1),2,1);
	
	vc=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_TX_QUEUE_SCH_INFO1),3,3);
	
	port_out=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_TX_QUEUE_SCH_INFO1),5,4);
	
