	GEL_TextOut(" ATOMIC_INCRMNT[7]        ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),7,7));

	
	GEL_TextOut(" ATOMIC_TEST_AND_SWAP[8]  ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),8,8));

	
	GEL_TextOut(" DOORBELL[10]             ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),10,10));

	
	GEL_TextOut(" DATA_MESS[11]            ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),11,11));

	
	GEL_TextOut(" WRITE_WITH_RESP[12]      ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),12,12));

	
	GEL_TextOut(" STREAM_WRITE[13]         ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),13,13));

	
	GEL_TextOut(" WRITE[14]                ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),14,14));
	
	
	GEL_TextOut(" READ[15]                 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),15,15));
	
	
	GEL_TextOut(" IMPLMNT_DEFINED_2[17:16] ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),17,16));

}



Destination_Operations()
{
	
	GEL_TextOut(" ********************************** Destination Operations CAR (DEST_OP) ******************************************************\n");


	
	GEL_TextOut(" IMPLMNT_DEFINED_1[1:0]   ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),1,0));

	
	GEL_TextOut(" PORT_WRITE[2]            ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),2,2));

	
	GEL_TextOut(" ATOMIC_CLEAR[4]          ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),4,4));

	
	GEL_TextOut(" ATOMIC_SET[5]            ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),5,5));

	
	GEL_TextOut(" ATOMIC_DCRMNT[6]         ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),6,6));

	
	GEL_TextOut(" ATOMIC_INCRMNT[7]        ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),7,7));

	
	GEL_TextOut(" ATOMIC_TEST_AND_SWAP[8]  ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),8,8));

	
	GEL_TextOut(" DOORBELL[10]             ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),10,10));

	
	GEL_TextOut(" DATA_MESS[11]            ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),11,11));

	
	GEL_TextOut(" WRITE_WITH_RESP[12]      ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),12,12));

	
	GEL_TextOut(" STREAM_WRITE[13]         ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),13,13));

	
	GEL_TextOut(" WRITE[14]                ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),14,14));
	
	
	GEL_TextOut(" READ[15]                 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),15,15));
	
	
	GEL_TextOut(" IMPLMNT_DEFINED_2[17:16] ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_DEST_OP),17,16));
}


