menuitem "SRIO Interrupts Status";

Doorbell_Interrupts_Status_fn()
{
	unsigned int i,j,drbl_status,temp;

	GEL_TextOut(" ********************************** DOORBELLn Interrupt Condition Status Register (DOORBELLn_ICSR) ******************************************************\n");

                          
	for(j=0;j<4;j++)
	{
	
		GEL_TextOut(" DOORBELL REG%d INTERRUPT CONDITION STATUS REGISTER:  \n\n",,,,,j);
	
		for(i=0;i<16;i++)
		{
			temp=(j*16)+i;
		
			if(i<10)
			{
				if(temp<10)
				{
					drbl_status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DOORBELL0_ICSR+(j*0x10))),i,i);
					
					if(drbl_status == 0x1)
					{
						GEL_TextOut(" DOORBELL%d_ICSR.ICS%d  ---> %d => Doorbell Interrupt%d  is  **RECEIVED**  and pending  \n",,,,,j,i,drbl_status,((j*16)+i));
					}
					else
					{
						GEL_TextOut(" DOORBELL%d_ICSR.ICS%d  ---> %d => Doorbell Interrupt%d  is  ##NOT RECEIVED##   \n",,,,,j,i,drbl_status,((j*16)+i));
					}
				}
				else
				{
					drbl_status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DOORBELL0_ICSR+(j*0x10))),i,i);
				
					if(drbl_status == 0x1)
					{
						GEL_TextOut(" DOORBELL%d_ICSR.ICS%d  ---> %d => Doorbell Interrupt%d is  **RECEIVED**  and pending  \n",,,,,j,i,drbl_status,((j*16)+i));
					}
					else
					{
						GEL_TextOut(" DOORBELL%d_ICSR.ICS%d  ---> %d => Doorbell Interrupt%d is  ##NOT RECEIVED##   \n",,,,,j,i,drbl_status,((j*16)+i));
					}
				}
			}
			else
			{
				if(i != 15)
				{
					if(temp<10)
					{
						drbl_status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DOORBELL0_ICSR+(j*0x10))),i,i);
						
						if(drbl_status == 0x1)
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d  is  **RECEIVED**  and pending  \n",,,,,j,i,drbl_status,((j*16)+i));
						}
						else
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d  is  ##NOT RECEIVED##   \n",,,,,j,i,drbl_status,((j*16)+i));
						}
					}
					else
					{
						drbl_status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DOORBELL0_ICSR+(j*0x10))),i,i);
					
						if(drbl_status == 0x1)
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d is  **RECEIVED**  and pending  \n",,,,,j,i,drbl_status,((j*16)+i));
						}
						else
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d is  ##NOT RECEIVED##   \n",,,,,j,i,drbl_status,((j*16)+i));
						}
					}
				}
				else
				{
					if(temp<10)
					{
						drbl_status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DOORBELL0_ICSR+(j*0x10))),i,i);
						
						if(drbl_status == 0x1)
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d  is  **RECEIVED**  and pending  \n\n",,,,,j,i,drbl_status,((j*16)+i));
						}
						else
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d  is  ##NOT RECEIVED##   \n\n",,,,,j,i,drbl_status,((j*16)+i));
						}
					}
					else
					{
						drbl_status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DOORBELL0_ICSR+(j*0x10))),i,i);
					
						if(drbl_status == 0x1)
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d is  **RECEIVED**  and pending  \n\n",,,,,j,i,drbl_status,((j*16)+i));
						}
						else
						{
							GEL_TextOut(" DOORBELL%d_ICSR.ICS%d ---> %d => Doorbell Interrupt%d is  ##NOT RECEIVED##   \n\n",,,,,j,i,drbl_status,((j*16)+i));
						}
					}
				}
			}
			
		}
		
	}
}


LSU_Interrupts_Status_fn()
{
	unsigned int i,j,lsu_status;
	
	
	GEL_TextOut(" ********************************** LSU0 Interrupt Condition Status Register (LSU0_ICSR) ******************************************************\n\n"); 
    
	GEL_TextOut(" PER SRCID BASED INTERRUPTS: \n\n");
	
	GEL_TextOut(" LSU GOOD INTERRUPTS: \n\n");
	
	for(j=0;j<16;j++)
	{
		lsu_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU0_ICSR),j,j);
		
		if(j<10)
		{
			if(lsu_status == 0x1)
			{
				GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d:  Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,j);
			}
			else
			{
				GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d:  Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,j);
			}
		}
		else
		{
			if(j != 15)
			{
				if(lsu_status == 0x1)
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d ---> %d => SRCID%d: Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,j);
				}
				else
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d ---> %d => SRCID%d: Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,j);
				}
			}
			else
			{
				if(lsu_status == 0x1)
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d ---> %d => SRCID%d: Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n\n",,,,,j,lsu_status,j);
				}
				else
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d ---> %d => SRCID%d: Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n\n",,,,,j,lsu_status,j);
				}
			}
		}
	}
	
	GEL_TextOut(" LSU BAD INTERRUPTS: \n\n");
	
	for(j=16;j<32;j++)
	{
		lsu_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU0_ICSR),j,j);
		
		if(j<26)
		{
			if(lsu_status == 0x1)
			{
				GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d:  Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,(j-16));
			}
			else
			{
				GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d:  Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,(j-16));
			}
		}
		else
		{
			if(j != 31)
			{
				if(lsu_status == 0x1)
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d: Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,(j-16));
				}
				else
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d: Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,(j-16));
				}
			}
			else
			{
				if(lsu_status == 0x1)
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d: Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n\n",,,,,j,lsu_status,(j-16));
				}
				else
				{
					GEL_TextOut(" LSU0_ICSR.ICS%d  ---> %d => SRCID%d: Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n\n",,,,,j,lsu_status,(j-16));
				}
			}
		}
	}
	
	GEL_TextOut(" ********************************** LSU1 Interrupt Condition Status Register (LSU1_ICSR) ******************************************************\n");
	
	GEL_TextOut(" PER LSU BASED INTERRUPTS: \n");
	
	for(j=0;j<8;j++)
	{
		lsu_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU1_ICSR),j,j);
		
		if(j != 7)
		{
			if(lsu_status == 0x1)
			{
				GEL_TextOut(" LSU1_ICSR.ICS%d  ---> %d => LSU%d, Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,j);
			}
			else
			{
				GEL_TextOut(" LSU1_ICSR.ICS%d  ---> %d => LSU%d, Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n",,,,,j,lsu_status,j);
			}
		}
		else
		{
			if(lsu_status == 0x1)
			{
				GEL_TextOut(" LSU1_ICSR.ICS%d  ---> %d => LSU%d, Transaction  ##COMPLETE##  , No Errors (Posted/Non-posted)  \n\n",,,,,j,lsu_status,j);
			}
			else
			{
				GEL_TextOut(" LSU1_ICSR.ICS%d  ---> %d => LSU%d, Transaction  **NOT COMPLETE**  , No Errors (Posted/Non-posted)  \n\n",,,,,j,lsu_status,j);
			}
		}
	}
}



Splevents_and_Error_Interrupts_Status_fn()
{
	
	unsigned int i,j,error_status;
	
	GEL_TextOut(" ********************************** Error, Reset, and Special Event Interrupt Condition Status Register (ERR_RST_EVNT_ICSR) ******************************************************\n\n");
     
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),0,0);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Multi-cast event control symbol interrupt  **RECEIVED**  on any port  \n",,,,,0,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Multi-cast event control symbol interrupt  ##NOT RECEIVED##  on any port  \n",,,,,0,error_status);
	}
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),1,1);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Port-write-in request  **RECEIVED**  on any port  \n",,,,,1,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Port-write-in request  ##NOT RECEIVED##  on any port  \n",,,,,1,error_status);
	}
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),2,2);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Logical layer error management event capture  **DETECTED**   \n",,,,,2,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Logical layer error management event capture  ##NOT DETECTED##   \n",,,,,2,error_status);
	}
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),8,8);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Error  **DETECTED**  on port 0  \n",,,,,8,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Error  ##NOT DETECTED##  on port 0  \n",,,,,8,error_status);
	}
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),9,9);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Error  **DETECTED**  on port 1  \n",,,,,9,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d  ---> %d => Error  ##NOT DETECTED##  on port 1  \n",,,,,9,error_status);
	}
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),10,10);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d ---> %d => Error  **DETECTED**  on port 2  \n",,,,,10,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d ---> %d => Error  ##NOT DETECTED##  on port 2  \n",,,,,10,error_status);
	}
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),11,11);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d ---> %d => Error  **DETECTED**  on port 3  \n",,,,,11,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d ---> %d => Error  ##NOT DETECTED##  on port 3  \n",,,,,11,error_status);
	}
	
	error_status = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_RST_EVNT_ICSR),16,16);
		
	if(error_status == 0x1)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d ---> %d => Device reset interrupt  **RECEIVED**  from any port  \n\n",,,,,16,error_status);
	}
	else
	{
		GEL_TextOut(" ERR_RST_EVNT_ICSR.ICS%d ---> %d => Device reset interrupt  ##NOT RECEIVED##  from any port  \n\n",,,,,16,error_status);
	}
}



Interrupt_Status_Decode_Register_fn()
{
	unsigned int i,j,status;
	
	
	GEL_TextOut(" ********************************** Interrupt Status Decode Register (INTDSTn_DECODE) ******************************************************\n\n");
                                              
    
	for(j=0;j<24;j++)
	{
	
		GEL_TextOut(" INTERRUPT DST%d STATUS DECODE REGISTER:  \n\n",,,,,j);
		
		for(i=0;i<16;i++)
		{
			if(i<10)
			{
			
				status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_INTDST0_DECODE+(j*0x4))),i,i);
				
				if(status == 0x1)
				{
					GEL_TextOut(" INTDST%d_DECODE.ISD%d  ---> %d => Interrupt request  **DETECTED** . Possible interrupt sources: \n ---> Doorbell 0, bit %d (bit %d of DOORBELL0_ICSR) \n ---> Doorbell 1, bit %d (bit %d of DOORBELL1_ICSR)  \n ---> Doorbell 2, bit %d (bit %d of DOORBELL2_ICSR) \n ---> Doorbell 3, bit %d (bit %d of DOORBELL3_ICSR)  \n",,,,,j,i,status,i,i,i,i,i,i,i,i);
				}
				else
				{
					GEL_TextOut(" INTDST%d_DECODE.ISD%d  ---> %d =>  ##NO INTERRUPT REQUEST ROUTED##  to this bit.  \n",,,,,j,i,status);
				}
			}
			else
			{
				status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_INTDST0_DECODE+(j*0x4))),i,i);
			
				if(status == 0x1)
				{
					GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d => Interrupt request  **DETECTED** . Possible interrupt sources: \n ---> Doorbell 0, bit %d (bit %d of DOORBELL0_ICSR) \n ---> Doorbell 1, bit %d (bit %d of DOORBELL1_ICSR)  \n ---> Doorbell 2, bit %d (bit %d of DOORBELL2_ICSR) \n ---> Doorbell 3, bit %d (bit %d of DOORBELL3_ICSR)  \n",,,,,j,i,status,i,i,i,i,i,i,i,i);
				}
				else
				{
					GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d =>  ##NO INTERRUPT REQUEST ROUTED##  to this bit.  \n",,,,,j,i,status);
				}
			}
		}
		
		
		status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_INTDST0_DECODE+(j*0x4))),16,16);
			
		if(status == 0x1)
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d => Interrupt request  **DETECTED** . Possible interrupt sources: SRCID specific Good completion \n",,,,,j,16,status);
		}
		else
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d =>  ##NO INTERRUPT REQUEST ROUTED##  to this bit.  \n",,,,,j,16,status);
		}
		
		status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_INTDST0_DECODE+(j*0x4))),17,17);
			
		if(status == 0x1)
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d => Interrupt request  **DETECTED** . Possible interrupt sources: SRCID specific Error completion \n",,,,,j,17,status);
		}
		else
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d =>  ##NO INTERRUPT REQUEST ROUTED##  to this bit.  \n",,,,,j,17,status);
		}
		
		
		status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_INTDST0_DECODE+(j*0x4))),18,18);
			
		if(status == 0x1)
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d => Interrupt request  **DETECTED** . Possible interrupt sources: Good Completion has occured on a LSU specific interrupt bit \n",,,,,j,18,status);
		}
		else
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d =>  ##NO INTERRUPT REQUEST ROUTED##  to this bit.  \n",,,,,j,18,status);
		}
		
		
		status = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_INTDST0_DECODE+(j*0x4))),20,20);
			
		if(status == 0x1)
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d => Interrupt request  **DETECTED** . Possible interrupt sources: \n ---> A port (check ERR_RST_EVNT_ICSR) \n ---> TX buffer descriptor queue 1 (bit 1 of TX_CPPI_ICSR) \n ---> RX buffer descriptor queue 1 (bit 1 of RX_CPPI_ICSR) \n\n",,,,,j,30,status);
		}
		else
		{
			GEL_TextOut(" INTDST%d_DECODE.ISD%d ---> %d =>  ##NO INTERRUPT REQUEST ROUTED##  to this bit.  \n\n",,,,,j,20,status);
		}
		
	}
}


hotmenu Doorbell_Interrupts_Status()
{
	Doorbell_Interrupts_Status_fn();
}

