/* Genric Delay function */

SRIO_Delay(unsigned int delay_count)
{
	unsigned int i;
	
	for(i=0;i<delay_count;i++);
	
}


menuitem "SRIO General HW Configuartion";

Peripheral_Settings_Control_Register()
{
	unsigned int reg_field;
    
    GEL_TextOut(" ********************************** Peripheral Settings Control Register (PER_SET_CNTL) ******************************************************\n\n");
    
	
	
    reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SERDES0_PRBS_OVR[0]       --->  ##Normal##  (doesnt disable physical layer ENTX0 and ENRX0 control)\n");
	}
	else
	{
		GEL_TextOut(" SERDES0_PRBS_OVR[0]       --->  **Over-ride for PRBS**  (disables physical layer ENTX0 and ENRX0 control)\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),1,1);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SERDES1_PRBS_OVR[1]       --->  ##Normal##  (doesnt disable physical layer ENTX0 and ENRX0 control)\n");
	}
	else
	{
		GEL_TextOut(" SERDES1_PRBS_OVR[1]       --->  **Over-ride for PRBS**  (disables physical layer ENTX0 and ENRX0 control)\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),2,2);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SERDES2_PRBS_OVR[2]       --->  ##Normal##  (doesnt disable physical layer ENTX0 and ENRX0 control)\n");
	}
	else
	{
		GEL_TextOut(" SERDES2_PRBS_OVR[2]       --->  **Over-ride for PRBS**  (disables physical layer ENTX0 and ENRX0 control)\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),3,3);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SERDES3_PRBS_OVR[3]       --->  ##Normal##  (doesnt disable physical layer ENTX0 and ENRX0 control)\n");
	}
	else
	{
		GEL_TextOut(" SERDES3_PRBS_OVR[3]       --->  **Over-ride for PRBS**  (disables physical layer ENTX0 and ENRX0 control)\n");
	}
	
	
    
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),7,4);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 44.7 and Max 89.5\n");
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 89.5 and Max 179.0\n");
	}
	else if(reg_field == 0x2)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 134.2 and Max 268.4\n");
	}
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 180.0 and Max 360.0\n");
	}
	else if(reg_field == 0x4)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 223.7 and Max 447.4\n");
	}
	else if(reg_field == 0x5)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 268.4 and Max 536.8\n");
	}
	else if(reg_field == 0x6)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 313.2 and Max 626.4\n");
	}
	else if(reg_field == 0x7)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 357.9 and Max 715.8\n");
	}
	else if(reg_field == 0x8)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> sets the internal clock frequency Min 402.7 and Max 805.4\n");
	}
	else if(reg_field == 0x9)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 447.4 and Max 894.8\n");
	}
	else if(reg_field == 0xA)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 492.1 and Max 984.2\n");
	}
	else if(reg_field == 0xB)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 536.9 and Max 1073.8\n");
	}
	else if(reg_field == 0xC)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 581.6 and Max 1163.2\n");
	}
	else if(reg_field == 0xD)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 626.3 and Max 1252.6\n");
	}
	else if(reg_field == 0xE)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 671.1 and Max 1342.2\n");
	}
	else if(reg_field == 0xF)
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Sets the internal clock frequency Min 715.8 and Max 1431.6\n");
	}
	else
	{
		GEL_TextOut(" PRESCALER_SELECT[7:4]     ---> Reserved\n");
	}
	
	                       
    GEL_TextOut(" CBA_TRANS_PRI[11:9]       ---> %d \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),11,9));
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),14,12);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8, 7, 6, 5, 4, 3, 2, 1 (effectively lets all of this priority pass)\n");
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8, 7, 6, 5, 4, 3, 2\n");
	}
	else if(reg_field == 0x2)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8, 7, 6, 5, 4, 3\n");
	}
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8, 7, 6, 5, 4\n");
	}
	else if(reg_field == 0x4)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8, 7, 6, 5\n");
	}
	else if(reg_field == 0x5)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8, 7, 6\n");
	}
	else if(reg_field == 0x6)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8, 7\n");
	}
	else if(reg_field == 0x7)
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> 8\n");
	}
	else
	{
		GEL_TextOut(" TX_PRI0_WM[14:12]         ---> Reserved\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),17,15);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8, 7, 6, 5, 4, 3, 2, 1 (effectively lets all of this priority pass)\n");
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8, 7, 6, 5, 4, 3, 2\n");
	}
	else if(reg_field == 0x2)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8, 7, 6, 5, 4, 3\n");
	}
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8, 7, 6, 5, 4\n");
	}
	else if(reg_field == 0x4)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8, 7, 6, 5\n");
	}
	else if(reg_field == 0x5)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8, 7, 6\n");
	}
	else if(reg_field == 0x6)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8, 7\n");
	}
	else if(reg_field == 0x7)
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> 8\n");
	}
	else
	{
		GEL_TextOut(" TX_PRI1_WM[14:12]         ---> Reserved\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),20,18);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8, 7, 6, 5, 4, 3, 2, 1 (effectively lets all of this priority pass)\n");
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8, 7, 6, 5, 4, 3, 2\n");
	}
	else if(reg_field == 0x2)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8, 7, 6, 5, 4, 3\n");
	}
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8, 7, 6, 5, 4\n");
	}
	else if(reg_field == 0x4)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8, 7, 6, 5\n");
	}
	else if(reg_field == 0x5)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8, 7, 6\n");
	}
	else if(reg_field == 0x6)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8, 7\n");
	}
	else if(reg_field == 0x7)
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> 8\n");
	}
	else
	{
		GEL_TextOut(" TX_PRI2_WM[14:12]         ---> Reserved\n");
	}
	
    
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),21,21);
    
	if(reg_field == 0)
	{
		GEL_TextOut(" PROMOTE_DIS[24]           --->  ##NORMAL##  \n");
	}
	else
	{
		GEL_TextOut(" PROMOTE_DIS[24]           --->  **DISABLE**  auto promotion, responses will only be sent back at request+1 priority level. \n");
	}
	    
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),23,22);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" LEND_SWAP_MODE[23:22]     ---> Mode A\n");
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" LEND_SWAP_MODE[23:22]     ---> Mode B\n");
	}
	else if(reg_field == 0x2)
	{
		GEL_TextOut(" LEND_SWAP_MODE[23:22]     ---> Mode C\n");
	}
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" LEND_SWAP_MODE[23:22]     ---> Mode D\n");
	}
	else
	{
		GEL_TextOut(" LEND_SWAP_MODE[23:22]     ---> Reserved\n");
	}
                        
    
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),24,24);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" BOOT_COMPLETE[24]         ---> Write to read-only registers  ##ENABLED## \n");
	}
	else
	{
		GEL_TextOut(" BOOT_COMPLETE[24]         ---> Write to read-only registers  **DISABLED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),27,27);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" LOG_TGT_ID_DIS[27]        ---> All non-matching packets are  ##DESTROYED## \n");
	}
	else
	{
		GEL_TextOut(" LOG_TGT_ID_DIS[27]        ---> All packets, regardless of the destination ID,  **ARE FORWARDED**  to the application\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),29,28);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" LEND_SWAP_MODE[29:28]     ---> Mode A\n");
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" LEND_SWAP_MODE[29:28]     ---> Mode B\n");
	}
	else if(reg_field == 0x2)
	{
		GEL_TextOut(" LEND_SWAP_MODE[29:28]     ---> Mode C\n");
	}
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" LEND_SWAP_MODE[29:28]     ---> Mode D\n");
	}
	else
	{
		GEL_TextOut(" LEND_SWAP_MODE[29:28]     ---> Reserved\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),31,30);
	
	if(reg_field == 0x0)
	{
		GEL_TextOut(" LEND_SWAP_MODE[31:30]     ---> Mode A\n\n");
	}
	else if(reg_field == 0x1)
	{
		GEL_TextOut(" LEND_SWAP_MODE[31:30]     ---> Mode B\n\n");
	}
	else if(reg_field == 0x2)
	{
		GEL_TextOut(" LEND_SWAP_MODE[31:30]     ---> Mode C\n\n");
	}
	else if(reg_field == 0x3)
	{
		GEL_TextOut(" LEND_SWAP_MODE[31:30]     ---> Mode D\n\n");
	}
	else
	{
		GEL_TextOut(" LEND_SWAP_MODE[31:30]     ---> Reserved\n\n");
	}
}



Peripheral_Settings_Control_Register_1()
{
	unsigned int reg_field;
	
	GEL_TextOut(" ********************************** Peripheral Settings Control Register 1 (PER_SET_CNTL1) ******************************************************\n\n");
    
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL1),3,2);
	
	if(reg_field==0)
	{
		GEL_TextOut(" SYS_CLK_SEL           => TX0 is the source \n");
	}
	else if(reg_field==1)
	{
		GEL_TextOut(" SYS_CLK_SEL           => TX1 is the source \n");
	}
	else if(reg_field==2)
	{
		GEL_TextOut(" SYS_CLK_SEL           => TX2 is the source \n");
	}
	else if(reg_field==3)
	{
		GEL_TextOut(" SYS_CLK_SEL           => TX3 is the source \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL1),7,4);
	
	if((reg_field & 0x00000001) != 0)
	{
		GEL_TextOut(" LOOPBACK(Lane0)       => Digital domain ##Loopback##  mode\n");
	}
	else
	{
		GEL_TextOut(" LOOPBACK(Lane0)       =>  ##Normal##  operation\n");
	}
	
	if((reg_field & 0x00000002) != 0)
	{
		GEL_TextOut(" LOOPBACK(Lane1)       => Digital domain ##Loopback##  mode\n");
	}
	else
	{
		GEL_TextOut(" LOOPBACK(Lane1)       =>  ##Normal##  operation\n");
	}
	
	if((reg_field & 0x00000004) != 0)
	{
		GEL_TextOut(" LOOPBACK(Lane2)       => Digital domain ##Loopback##  mode\n");
	}
	else
	{
		GEL_TextOut(" LOOPBACK(Lane2)       =>  ##Normal##  operation\n");
	}
	
	if((reg_field & 0x00000008) != 0)
	{
		GEL_TextOut(" LOOPBACK(Lane3)       => Digital domain ##Loopback##  mode\n");
	}
	else
	{
		GEL_TextOut(" LOOPBACK(Lane3)       =>  ##Normal##  operation\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL1),8,8);
	
	if(reg_field==0)
	{
		GEL_TextOut(" COS_EN                => Class of Service(COS) is  **NOT A PART**  of the segmentation context for the RXU \n\n");
	}
	else
	{
		
		GEL_TextOut(" COS_EN                => Class of Service(COS) is  ##A PART##  of the segmentation context for the RXU \n\n");
	}
    
}


RapidIO_DEVICEID_Register_Config()
{
	unsigned int i,reg_field;
	
	GEL_TextOut(" ********************************** RapidIO DEVICEID Registers Configuration ******************************************************\n\n");
	
	for(i=0;i<16;i++)
	{   
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DEVICEID_REG0+(i*0x4))),15,0);
		
		GEL_TextOut(" RIO_DEVID%d.16BNODEID ---> %x \n",,,,,i,(unsigned short)reg_field);
	
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DEVICEID_REG0+(i*0x4))),23,16);
	
		GEL_TextOut(" RIO_DEVID%d.8BNODEID  ---> %x \n\n",,,,,i,(unsigned char)reg_field);
	}
}


RapidIO_MULTI_ID_Register_Config()
{
	unsigned int i,reg_field;
	
	GEL_TextOut(" ********************************** RapidIO MULTI_ID Registers Configuration ******************************************************\n\n");
	
	for(i=0;i<8;i++)
	{   
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_MULTIID_REG1+(i*0x4))),15,0);
		
		GEL_TextOut(" RIO_MULT_ID%d.16BNODEID ---> %x \n",,,,,(i+1),(unsigned short)reg_field);
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_MULTIID_REG1+(i*0x4))),23,16);
		
		GEL_TextOut(" RIO_MULT_ID%d.8BNODEID  ---> %x \n\n",,,,,(i+1),(unsigned char)reg_field);
	}
}



Peripheral_Global_Enable_Register()
{
	unsigned int reg_field;
	
    GEL_TextOut(" ********************************** Peripheral Global Enable Register (GBL_EN) ******************************************************\n\n");
	
	
	
    reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" EN[0] ---> %x => The peripheral is to be  **DISABLED**  (held in reset with clocks disabled) \n\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" EN[0] ---> %x => The peripheral is to be  ##ENABLED##  \n\n",,,,,reg_field);
	}
}


    
Block_n_Enable_Register()
{
	unsigned int reg_field;

    GEL_TextOut(" ********************************** Block n Enable Register (BLKn_EN) ******************************************************\n\n");
    
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK0_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block0 enable[0] ---> %x => 'set of memory-mapped registers (MMRs) for the SRIO peripheral' is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block0 enable[0] ---> %x => 'set of memory-mapped registers (MMRs) for the SRIO peripheral' is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK1_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block1 enable[0] ---> %x => Load/Store module(LSU) is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block1 enable[0] ---> %x => Load/Store module(LSU) is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK2_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block2 enable[0] ---> %x => memory access unit (MAU) is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block2 enable[0] ---> %x => memory access unit (MAU) is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK3_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block3 enable[0] ---> %x => message transmit unit (TXU) is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block3 enable[0] ---> %x => message transmit unit (TXU) is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK4_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block4 enable[0] ---> %x => message receive unit (RXU) is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block4 enable[0] ---> %x => message receive unit (RXU) is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK5_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block5 enable[0] ---> %x => SRIO port 0 is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block5 enable[0] ---> %x => SRIO port 0 is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK6_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block6 enable[0] ---> %x => SRIO port 1 is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block6 enable[0] ---> %x => SRIO port 1 is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK7_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block7 enable[0] ---> %x => SRIO port 2 is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block7 enable[0] ---> %x => SRIO port 2 is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK8_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block8 enable[0] ---> %x => SRIO port 3 is to be  **RESET**  with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block8 enable[0] ---> %x => SRIO port 3 is to be  ##ENABLED##  with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_BLK9_EN),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block9 enable[0] ---> %x => Block9(TODO:add block descrip) is to be  **RESET**  with its clock off \n\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block9 enable[0] ---> %x => Block9(TODO:add block descrip) is to be  ##ENABLED##  with its clock running. \n\n",,,,,reg_field);
	}
}



Peripheral_Identification_Register()
{
	GEL_TextOut(" ********************************** Peripheral Identification Register (PID) ******************************************************\n\n");
    
	
    GEL_TextOut(" MINOR[5:0] (Minor revision ID)                        ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PID),5,0));
    
    GEL_TextOut(" CUSTOM[7:6] (Custom revision ID)                      ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PID),7,6));
    
    GEL_TextOut(" MAJOR[10:8] (Major revision ID)                       ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PID),10,8));
    
    GEL_TextOut(" RTL[15:11] (RTL revision ID)                          ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PID),15,11));
    
    GEL_TextOut(" FUNC[27:16] (Peripheral Functional class)             ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PID),27,16));
    
    GEL_TextOut(" SCHEME[31:30] (Peripheral scheme field. Fixed to 0x1) ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PID),31,30));
    
}



Peripheral_Control_Register()
{
	unsigned int reg_field;
	
    GEL_TextOut(" ********************************** Peripheral Control Register (PCR) ******************************************************\n\n");
    
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PCR),3,3);
    
    if(reg_field == 0)
	{
		GEL_TextOut(" LOCAL_DIS[3] ---> %x => Local RX traffic is  **DISCARDED**   \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" LOCAL_DIS[3] ---> %x => Local RX traffic is  ##ACCEPTED##  normally \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PCR),2,2);
    
    if(reg_field == 0)
	{
		GEL_TextOut(" PEREN[2]     ---> %x => Data flow control is  **DISABLED**  \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" PEREN[2]     ---> %x => Data flow control is  ##ENABLED##  \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PCR),1,1);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SOFT[1]      ---> %x => Hard stop. All status registers are frozen in default state. (This mode is not supported on the SRIO peripheral.) \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" SOFT[1]      ---> %x => Soft stop \n",,,,,reg_field);
	}
    
    
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PCR),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" FREE[0]      ---> %x => The SOFT bit takes effect \n\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" FREE[0]      ---> %x => Free run. Peripheral ignores the emulation suspend signal and functions normally \n\n",,,,,reg_field);
	}
}



