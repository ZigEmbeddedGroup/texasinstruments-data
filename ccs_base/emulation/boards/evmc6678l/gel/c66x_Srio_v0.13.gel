	LSU_Interrupts_Status_fn();

	Splevents_and_Error_Interrupts_Status_fn();

	Interrupt_Status_Decode_Register_fn();
}



menuitem "SRIO LSU Configuration";

lsu_configuration(unsigned int lsu_no)
{
	unsigned int i,reg_field,ttype,ftype;
	
	i=lsu_no;
	
	GEL_TextOut(" ********************************** SRIO LSU%d CONFIGURATION******************************************************\n \n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_SETUP_REG0),(3+(i*4)),i*4);
	
	GEL_TextOut(" The total number of shadow registers associated with the LSU%d => %d \n",,,,,i,reg_field);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_SETUP_REG1),i,i);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LSU%d_EDMA  => Cmd completion will be signalled as an interrupt based on the SRCID  \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" LSU%d_EDMA  => Cmd completion will be signalled as an interrupt which is specific to this LSU  \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_SETUP_REG1),9,8);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TIMEOUT_CNT => After an error condition, Timecode changes only once before the LSU transaction is discarded and a  new transaction is loaded from the shadow register \n\n");
	}
	else if(reg_field==1)
	{
		GEL_TextOut(" TIMEOUT_CNT => After an error condition, Timecode changes 2 times before the LSU transaction is discarded and a new transaction is loaded from the shadow register \n\n");
	}
	else if(reg_field==2)
	{
		GEL_TextOut(" TIMEOUT_CNT => After an error condition, Timecode changes 3 times before the LSU transaction is discarded and a new transaction is loaded from the shadow register \n\n");
	}
	else if(reg_field==3)
	{
		GEL_TextOut(" TIMEOUT_CNT => After an error condition, Timecode changes 4 times before the LSU transaction is discarded and a new transaction is loaded from the shadow register \n\n");
	}
	
	
	GEL_TextOut(" *********** DIO PKT DETAILS ***********\n\n");
	
	GEL_TextOut(" ADDRESS_MSB               ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG0+(i*0x1C))),31,0));
	
	GEL_TextOut(" ADDRESS_LSB/CONFIG_OFFSET ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG1+(i*0x1C))),31,0));
	
	GEL_TextOut(" LSUn_REG2.DSP_ADDRESS     ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG2+(i*0x1C))),31,0));
	
	GEL_TextOut(" BYTE_COUNT                ---> %d \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG3+(i*0x1C))),19,0));
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG5+(i*0x1C))),7,0);
	
	ftype= (reg_field&0xF0)>>4;
	
	if(ftype != 10)
	{ 
	
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG3+(i*0x1C))),31,31);
		
		if(reg_field==0)
		{
			GEL_TextOut(" Drbll_val                 ---> A doorbell pkt with drbll_info is  ##NOT SENT##  after succesfully sending a DIO pkt \n");
		}
		else
		{
			GEL_TextOut(" Drbll_val                 ---> A doorbell pkt with drbll_info is  **SENT**  after succesfully sending a DIO pkt \n");
		}
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" INTERRUPT_REQ             ---> Interrupt not requested upon completion of command\n");
	}
	else
	{
		GEL_TextOut(" INTERRUPT_REQ             ---> Interrupt requested upon completion of command\n");
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),1,1);
		
		if(reg_field==0)
		{
			GEL_TextOut(" SUP_GINT => Interrupt will be  **GENERATED**  on good completion as well \n");
		}
		else
		{
			GEL_TextOut(" SUP_GINT => Interrupt will be  ##SUPPRESSED##  on a good completion  \n");
		}
	}
	
	GEL_TextOut(" XAMSB                     ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),3,2));
	
	GEL_TextOut(" PRIORITY                  ---> VC: %d, PRIO: %d, CRF: %d \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),4,4),SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),6,5),SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),7,7));
	
	GEL_TextOut(" OUTPORT_ID                ---> Port%d \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),9,8));
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),11,10);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" ID_SIZE                   ---> 8 bit device IDs\n");
		
		i=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),15,12);
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DEVICEID_REG0+(i*0x4))),23,16);
	
		GEL_TextOut(" SRC_ID(RIO_DEVID%d)        ---> %x \n",,,,,i,(unsigned char)reg_field);
	}
	else if(reg_field == 1)
	{
		GEL_TextOut(" ID_SIZE                   ---> 16 bit device IDs\n");
		
		i=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),15,12);
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_DEVICEID_REG0+(i*0x4))),15,0);
		
		GEL_TextOut(" SRC_ID(RIO_DEVID%d)       ---> %x \n",,,,,i,(unsigned short)reg_field);
	}
	else
	{
		GEL_TextOut(" ID_SIZE                   ---> Reserved\n");
	}
	
	GEL_TextOut(" DESTID                    ---> %x \n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG4+(i*0x1C))),31,16));
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG5+(i*0x1C))),7,0);
	
	ftype= (reg_field&0xF0)>>4;
	
	ttype= reg_field&0xF;
	
	if(ftype == 0x2 && ttype == 0x4)
	{
		GEL_TextOut(" PKT_TYPE                  ---> NREAD packet\n");
	}
	else if(ftype == 0x2 && ttype == 0xC)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Atomic increment packet\n");
	}
	else if(ftype == 0x2 && ttype == 0xD)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Atomic decrement packet\n");
	}
	else if(ftype == 0x2 && ttype == 0xE)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Atomic set packet\n");
	}
	else if(ftype == 0x2 && ttype == 0xF)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Atomic clear packet\n");
	}
	else if(ftype == 0x5 && ttype == 0x4)
	{
		GEL_TextOut(" PKT_TYPE                  ---> NWRITE packet\n");
	}
	else if(ftype == 0x5 && ttype == 0x5)
	{
		GEL_TextOut(" PKT_TYPE                  ---> NWRITE_R packet\n");
	}
	else if(ftype == 0x5 && ttype == 0xE)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Atomic test and swap packet\n");
	}
	else if(ftype == 0x6)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Streaming write packet\n");
	}
	else if(ftype == 0x7)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Congestion Control packet\n");
	}
	else if(ftype == 0x8 && ttype == 0x0)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Maintenance read packet\n");
	}
	else if(ftype == 0x8 && ttype == 0x1)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Maintenance write packet\n");
	}
	else if(ftype == 0x8 && ttype == 0x2)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Maintenance read response packet\n");
	}
	else if(ftype == 0x8 && ttype == 0x3)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Maintenance write response packet\n");
	}
	else if(ftype == 0x8 && ttype == 0x4)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Maintenance port-write packet\n");
	}
	else if(ftype == 0xD && ttype == 0x0)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Response(+Doorbell Resp) packet\n");
	}
	else if(ftype == 0xD && ttype == 0x1)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Message Response packet\n");
	}
	else if(ftype == 0xD && ttype == 0x8)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Response w/payload packet\n");
	}
	else if(ftype == 0x9)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Data streaming packet\n");
	}
	else if(ftype == 0xA)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Doorbell packet\n");
	}
	else if(ftype == 0xB)
	{
		GEL_TextOut(" PKT_TYPE                  ---> Message packet\n");
	}
	else
	{
		GEL_TextOut(" PKT_TYPE                  ---> Not a valid packet type\n");
	}
	
	GEL_TextOut(" HOP_COUNT                 ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG5+(i*0x1C))),15,8));
	
	GEL_TextOut(" DRBLL_INFO                ---> %x \n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG5+(i*0x1C))),31,16));
	
	if(i == 0)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS0),15,0));
	}
	else if(i == 1)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS0),31,16));
	}
    else if(i == 2)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS1),15,0));
	}
	else if(i == 3)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS1),31,16));
	}
	else if(i == 4)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS2),15,0));
	}
	else if(i == 5)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS2),31,16));
	}
	else if(i == 6)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS3),15,0));
	}
	else if(i == 7)
	{
		GEL_TextOut(" FLOW_MASK                 ---> %x \n\n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_FLOW_MASKS3),31,16));
	}

}

