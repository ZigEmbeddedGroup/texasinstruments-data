menuitem "SRIO HW Block Status";

hotmenu GBL_EN_STAT__Peripheral_Global_Enable_Status_Register()
{
	unsigned int i,j,reg_field;
	
	
	GEL_TextOut(" *****************************SRIO HW Global Enable Status***************************** \n");
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Global enable status ---> %x => The peripheral is in reset with all its clocks off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Global enable status ---> %x => The peripheral is enabled with all its clocks running \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),1,1);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block0 enable status ---> %x => 'set of memory-mapped registers (MMRs) for the SRIO peripheral' is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block0 enable status ---> %x => 'set of memory-mapped registers (MMRs) for the SRIO peripheral' is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),2,2);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block1 enable status ---> %x => Load/Store module(LSU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block1 enable status ---> %x => Load/Store module(LSU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),3,3);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block2 enable status ---> %x => memory access unit (MAU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block2 enable status ---> %x => memory access unit (MAU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),4,4);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block3 enable status ---> %x => message transmit unit (TXU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block3 enable status ---> %x => message transmit unit (TXU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),5,5);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block4 enable status ---> %x => message receive unit (RXU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block4 enable status ---> %x => message receive unit (RXU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),6,6);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block5 enable status ---> %x => SRIO port 0 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block5 enable status ---> %x => SRIO port 0 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),7,7);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block6 enable status ---> %x => SRIO port 1 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block6 enable status ---> %x => SRIO port 1 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),8,8);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block7 enable status ---> %x => SRIO port 2 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block7 enable status ---> %x => SRIO port 2 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),9,9);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block8 enable status ---> %x => SRIO port 3 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block8 enable status ---> %x => SRIO port 3 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),10,10);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block9 enable status ---> %x => Block9 is reset with its clock off \n\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block9 enable status ---> %x => Block9 is enabled with its clock running. \n\n",,,,,reg_field);
	}
	
}


Port_Error_and_Status_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;
	
	GEL_TextOut(" *******************Port%d Error and Status CSR*******************\n \n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PORT_UNINITIALIZED  => Input and output ports  ##ARE INITIALIZED##  \n");
	}
	else
	{
		GEL_TextOut(" PORT_UNINITIALIZED  => Input and output ports are  **NOT INITIALIZED**  \n");
	}
	

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),1,1);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PORT_OK             => Port  **NOT-OK**  condition\n");
	}
	else
	{
		GEL_TextOut(" PORT_OK             => Port  ##OK##  condition\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),2,2);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PORT_ERROR          => The input or output port  ##HAS NOT ENCOUNTERED##  an unrecoverable HW error\n");
	}
	else
	{
		GEL_TextOut(" PORT_ERROR          => The input or output port  **HAS ENCOUNTERED**  an unrecoverable HW error\n");
	}

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),3,3);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PORT_UNAVL          => The port is  ##AVAILABLE##  for use \n");
	}
	else
	{
		
		GEL_TextOut(" PORT_UNAVL          => The port is  **NOT AVAILABLE**  for use \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),4,4);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PORT_WRITE_PND      => The port  ##HAS NOT ENCOUNTERED##  a condition which required it to initiate a Maintenance Port-write operation\n");
	}
	else
	{
		GEL_TextOut(" PORT_WRITE_PND      => The port  **HAS ENCOUNTERED**  a condition which required it to initiate a Maintenance Port-write operation\n");
	}
	

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),8,8);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" INPUT_ERROR_STP     => The input port  ##IS NOT##  in the 'input error-stopped' state\n");
	}
	else
	{
		GEL_TextOut(" INPUT_ERROR_STP     => The input port  **IS IN**  the 'input error-stopped' state\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),9,9);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" INPUT_ERROR_ENC     => The input port  ##HAS NOT ENCOUNTERED##  a transmission error\n");
	}
	else
	{
		GEL_TextOut(" INPUT_ERROR_ENC     => The input port  **HAS ENCOUNTERED**  (and possibly recovered from) a transmission error\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),10,10);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" INPUT_RETRY_STP     => The input port  ##IS NOT##  in the 'input retry-stopped' state\n");
	}
	else
	{
		GEL_TextOut(" INPUT_RETRY_STP     => The input port  **IS IN**  the 'input retry-stopped' state\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),16,16);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_ERROR_STP    => The output port  ##IS NOT##  in the 'output error-stopped' state\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_ERROR_STP    => The output port  **IS IN**  the 'output error-stopped' state\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),17,17);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_ERROR_ENC    => The output port  ##HAS NOT ENCOUNTERED##  a transmission error\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_ERROR_ENC    => The output port  **HAS ENCOUNTERED**  (and possibly recovered from) a transmission error.\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),18,18);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_RETRY_STP    => The output port  ##HAS NOT RECEIVED##  a packet-retry control symbol and/or is not in the 'output retry-stopped' state.\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_RETRY_STP    => The output port  **HAS RECEIVED**  a packet-retry control symbol and is in the 'output retry-stopped' state.\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),19,19);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_RETRIED      => The output port  ##HAS NOT RECEIVED##  a packet-retry control symbol and cannot make forward progress.\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_RETRIED      => The output port  **HAS RECEIVED**  a packet-retry control symbol and cannot make forward progress. \n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),20,20);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_RETRY_ENC    => The output port  ##HAS NOT ENCOUNTERED##  a retry condition\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_RETRY_ENC    => The output port  **HAS ENCOUNTERED**  a retry condition\n");
	}

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),24,24);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_DEGRD_ENC    => The output port  ##HAS NOT ENCOUNTERED##  a degraded condition\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_DEGRD_ENC    => The output port  **HAS ENCOUNTERED**  a degraded condition\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),25,25);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_FLD_ENC      => The output port  ##HAS NOT ENCOUNTERED##  a failed condition\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_FLD_ENC      => The output port  **HAS ENCOUNTERED**  a failed condition\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),26,26);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" OUTPUT_PKT_DROP     => The output port  ##HAS NOT DISCARDED##  a packet\n");
	}
	else
	{
		GEL_TextOut(" OUTPUT_PKT_DROP     => The output port  **HAS DISCARDED**  a packet\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),27,27);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TXFC                => Receiver-based flow control \n");
	}
	else
	{
		
		GEL_TextOut(" TXFC                => Transmitter-based flow control \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),29,29);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IDLE_SEQ            => Idle sequence 1 is active. \n");
	}
	else
	{
		
		GEL_TextOut(" IDLE_SEQ            => Idle sequence 2 is active. \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),30,30);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IDLE2_EN            => Idle sequence 2  **DISABLED**  for baud rates < 5.5 GBaud \n");
	}
	else
	{
		
		GEL_TextOut(" IDLE2_EN            => Idle sequence 2  ##ENABLED##  for baud rates < 5.5 GBaud \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IDLE2               => Idle sequence 2  **NOT SUPPORTED**  for baud rates < 5.5 GBaud \n\n");
	}
	else
	{
		
		GEL_TextOut(" IDLE2               => Idle sequence 2 ##SUPPORTED## for baud rates < 5.5 GBaud \n\n");
	}
}

Port_Error_Detect_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;
	
	GEL_TextOut(" *******************Port%d Error Detect CSR******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" LINK_TIMEOUT              => The port  ##DID NOT EXPERIENCE##  a link timeout\n");
	}
	else
	{
		GEL_TextOut(" LINK_TIMEOUT              => The port  **EXPERIENCED**  a link timeout\n");
	}


	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),1,1);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" UNSOLICITED_ACK_CNTL_SYM  => The port  ##DID NOT RECEIVE##  an unexpected acknowledge control symbol\n");
	}
	else
	{
		GEL_TextOut(" UNSOLICITED_ACK_CNTL_SYM  => The port  **RECEIVED**  an unexpected acknowledge control symbol\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),2,2);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" DELINEATION_ERROR         => The port  ##DID NOT DETECT##  a delineation error\n");
	}
	else
	{
		GEL_TextOut(" DELINEATION_ERROR         => The port  **DETECTED**  a delineation error\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),4,4);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PROTOCOL_ERROR            => The port  ##DID NOT RECEIVE##  an unexpected packet or control symbol\n");
	}
	else
	{
		GEL_TextOut(" PROTOCOL_ERROR            => The port  **RECEIVED**  an unexpected packet or control symbol\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),5,5);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" NON_OUTSTANDING_ACKID     => The port  ##DID NOT RECEIVE##  a link response with a non-outstanding ackID\n");
	}
	else
	{
		GEL_TextOut(" NON_OUTSTANDING_ACKID     => The port  **RECEIVED**  a link response with an ackID that is not outstanding\n");
	}

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),14,14);
	
	if(reg_field==0)
	{
		GEL_TextOut(" DSCRAM_LOS                => Receiver de-scrambler synchronization is  ##NOT LOST##  \n");
	}
	else
	{
		
		GEL_TextOut(" DSCRAM_LOS                => Receiver de-scrambler synchronization is  **LOST**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),17,17);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RCVD_PKT_OVER_276B        => The port  ##DID NOT RECEIVE##  packet that exceeds the maximum allowed size.\n");
	}
	else
	{
		GEL_TextOut(" RCVD_PKT_OVER_276B        => The port  **RECEIVED**  packet that exceeds the maximum allowed size\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),18,18);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RCVD_PKT_WITH_BAD_CRC     => The port  ##DID NOT RECEIVE##  a packet with a bad CRC value\n");
	}
	else
	{
		GEL_TextOut(" RCVD_PKT_WITH_BAD_CRC     => The port  **RECEIVED**  a packet with a bad CRC value\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),19,19);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PKT_UNEXPECTED_ACKID      => The port  ##DID NOT RECEIVE##  a packet with unexpected/out-of-sequence ackID\n");
	}
	else
	{
		GEL_TextOut(" PKT_UNEXPECTED_ACKID      => The port  **RECEIVED**  a packet with unexpected/out-of-sequence ackID\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),20,20);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RCVD_PKT_NOT_ACCPT        => The port  ##DID NOT RECEIVE##  a packet-not-accepted acknowledge control symbol.\n");
	}
	else
	{
		GEL_TextOut(" RCVD_PKT_NOT_ACCPT        => The port  **RECEIVED**  a packet-not-accepted acknowledge control symbol\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),21,21);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" CNTL_SYM_UNEXPECTED_ACKID => The port  ##DID NOT RECEIVE##  an acknowledge control symbol with an unexpected ackID (packet-accepted or packet-retry)\n");
	}
	else
	{
		GEL_TextOut(" CNTL_SYM_UNEXPECTED_ACKID => The port  **RECEIVED**  an acknowledge control symbol with an unexpected ackID (packet-accepted or packet-retry).\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),22,22);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" CORRUPT_CNTL_SYM          => The port  ##DID NOT RECEIVE##  a control symbol with a bad CRC value\n");
	}
	else
	{
		GEL_TextOut(" CORRUPT_CNTL_SYM          => The port  **RECEIVED**  a control symbol with a bad CRC value\n");
	}
 
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),31,31);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" ERR_IMP_SPECIFIC          => An implementation specific error  ##HAS NOT BEEN##  detected\n\n");
	}
	else
	{
		GEL_TextOut(" ERR_IMP_SPECIFIC          => An implementation specific error  **HAS BEEN**  detected\n\n");
	}
}

Port_Error_rate_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;

	GEL_TextOut(" *******************Port%d Error rate CSR******************* \n\n",,,,,i);

	GEL_TextOut(" ERROR_RATE_COUNTER ---> %d \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),7,0));
	
	GEL_TextOut(" PEAK_ERROR_RATE    ---> %d \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),15,8));
}

Port_Link_Maintenance_Response_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;
	
	GEL_TextOut(" *******************Port%d Link Maintenance Response CSR data******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_LM_RESP+(i*0x20))),4,0);
	
	if(reg_field == 0x2)
	{
		GEL_TextOut(" LINK_STATUS    ---> Error\n");
	}
	else if(reg_field == 0x4)
	{
		GEL_TextOut(" LINK_STATUS    ---> Retry-stopped\n");
	}
	else if(reg_field == 0x5)
	{
		GEL_TextOut(" LINK_STATUS    ---> Error-stopped\n");
	}
	else if(reg_field == 0x10)
	{
		GEL_TextOut(" LINK_STATUS    ---> OK\n");
	}
	else
	{
		GEL_TextOut(" LINK_STATUS    ---> Reserved\n");
	}

	GEL_TextOut(" ACKID_STATUS   ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_LM_RESP+(i*0x20))),9,5));
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_LM_RESP+(i*0x20))),31,31);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RESPONSE_VALID ---> Response  ##IS NOT##  valid\n\n");
	}
	else
	{
		GEL_TextOut(" RESPONSE_VALID ---> Response  **IS**  valid\n\n");
	}
}


Port_Local_AckId_Status_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;
	
	GEL_TextOut(" *******************Port%d Local AckId Status CSR******************* \n\n",,,,,i);
	
	GEL_TextOut(" OUTBOUND_ACKID    ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ACKID_STAT+(i*0x20))),4,0));
	
	GEL_TextOut(" OUTSTANDING_ACKID ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ACKID_STAT+(i*0x20))),12,8));
	
	GEL_TextOut(" INBOUND_ACKID     ---> %x \n\n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ACKID_STAT+(i*0x20))),28,24));
}

Port_Attributes_Error_Capture_CSR(unsigned int port_no)
{
	unsigned int i,reg_field;
	
	i=port_no;
	
	GEL_TextOut(" *******************Port%d Attributes Error Capture CSR******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" CAPTURE_VALID_INFO ---> The packet/control symbol capture registers  ##DO NOT CONTAIN##  valid information.\n");
	}
	else
	{
		GEL_TextOut(" CAPTURE_VALID_INFO ---> The packet/control symbol capture registers  **CONTAIN**  valid information.\n");
	}

	
	GEL_TextOut(" IMP_SPECIFIC       ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));
	
	GEL_TextOut(" ERROR_TYPE         ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" INFO_TYPE          ---> Packet\n");
	}
	else if(reg_field == 1)
	{
		GEL_TextOut(" INFO_TYPE          ---> Control symbol (only error capture register 0 is valid)\n");
	}
	else if(reg_field == 2)
	{
		GEL_TextOut(" INFO_TYPE          ---> Implementation specific\n");
	}
	else
	{
		GEL_TextOut(" INFO_TYPE          ---> Reserved\n");
	}
	
	GEL_TextOut(" CAPTURE0           ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
	
	GEL_TextOut(" CAPTURE1           ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
	
	GEL_TextOut(" CAPTURE2           ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
	
	GEL_TextOut(" CAPTURE3           ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
}


