				else
				{
					GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
				}
				
				GEL_TextOut(" CC   => Transaction complete, Packet not sent due to flow control blockade (Xoff)\n\n");
			}
			else if(lsu_status == 0x3)
			{
				if(lcb==0)
				{
					GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
				}
				else
				{
					GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
				}
				
				GEL_TextOut(" CC   => Transaction complete, Non-posted response packet (type 8 and 13) contained ERROR status, or response payload length was in error\n\n");
			}
			else if(lsu_status == 0x4)
			{
				if(lcb==0)
				{
					GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
				}
				else
				{
					GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
				}
				
				GEL_TextOut(" CC   => Transaction complete, Packet not sent due to unsupported transaction type or invalid programming encoding for one or more LSU register fields\n\n");
			}
			else if(lsu_status == 0x5)
			{
				if(lcb==0)
				{
					GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
				}
				else
				{
					GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
				}
				
				GEL_TextOut(" CC   => DMA data transfer error\n\n");
			}
			else if(lsu_status == 0x6)
			{
				if(lcb==0)
				{
					GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
				}
				else
				{
					GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
				}
				
				GEL_TextOut(" CC   => 'Retry' DOORBELL response received, or Atomic Test-and-swap was not allowed (semaphore in use)\n\n");
			}
			else if(lsu_status == 0x7)
			{
				if(lcb==0)
				{
					GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
				}
				else
				{
					GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
				}
				
				GEL_TextOut(" CC   => Transaction completed, No packets sent as the transaction was killed using the CBUSY bit\n\n");
			}
			else
			{
				if(lcb==0)
				{
					GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
				}
				else
				{
					GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
				}
				
				GEL_TextOut(" CC   => Reserved\n\n");
			}
		}
	}
}


