LSU_Interrupts_Routing_fn()
{
	unsigned int i,j,drbl_routing_info,bit_position;
	
	bit_position=3;

	GEL_TextOut(" ********************************** LSU0 Interrupt Condition Routing Registers (LSU0_ICRR0-LSU0_ICRR3) ******************************************************\n\n");
	
	for(j=0;j<4;j++)
	{

		if(j==0)
		{
	
			for(i=0;i<8;i++)
			{
				 
				drbl_routing_info = SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU0_ICRR0+(j*0x4))),(bit_position+(4*i)),(i*4));
				
