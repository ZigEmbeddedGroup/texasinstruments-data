menuitem "SRIO Common Port Configuration";


Port_Link_Time_Out_Control_CSR()
{
	unsigned int reg_field,shortest,longest,srv_clk_period,prescalar_srv_clk;

	GEL_TextOut(" ********************************** Port Link Time-Out Control CSR (SP_LT_CTL) ******************************************************\n\n");

	prescalar_srv_clk=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PRESCALAR_SRV_CLK),7,0);
	
	srv_clk_period=prescalar_srv_clk*(1/SRIO_IP_CLK_MHZ);

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SP_LT_CTL),31,8);
	
	shortest=srv_clk_period*reg_field*3;
	
	longest=srv_clk_period*reg_field*4;
	
	if(reg_field == 0)
	{
		GEL_TextOut(" TIMEOUT_VALUE[31:8] ---> %x => Timer is Disabled \n\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" TVAL ---> %f to %f sec (srio_ip_clk - %f MHz) \n\n",,,,,(shortest/1000000),(longest/1000000),SRIO_IP_CLK_MHZ);
	}
	
}

	
	
Port_Response_Time_Out_Control_CSR()
{
	unsigned long reg_field,PreScalar;
	
	GEL_TextOut(" ********************************** Port Response Time-Out Control CSR (SP_RT_CTL) ******************************************************\n\n");

	PreScalar=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PER_SET_CNTL),7,4);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SP_RT_CTL),31,8);

	                       
    GEL_TextOut(" TIMEOUT_VALUE[31:8] ---> %x => %f ns \n\n",,,,,reg_field,(15*((PreScalar+1)*DMA_CLOCK_PERIOD*reg_field)));
}



Port_General_Control_CSR()
{
	unsigned int reg_field;


	GEL_TextOut(" ********************************** Port General Control CSR (SP_GEN_CTL) ******************************************************\n\n");


	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SP_GEN_CTL),29,29);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" DISCOVERED[29]    ---> %x => The device has not been previously discovered \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" DISCOVERED[29]    ---> %x => The device has been discovered by another processing element \n",,,,,reg_field);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SP_GEN_CTL),30,30);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" MASTER_ENABLE[30] ---> %x => Processing element cannot issue requests \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" MASTER_ENABLE[30] ---> %x => Processing element can issue requests \n",,,,,reg_field);
	}
	
    
	
	
    reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SP_GEN_CTL),31,31);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" HOST[31]          ---> %x => Agent or Slave device \n\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" HOST[31]          ---> %x => Host device \n\n",,,,,reg_field);
	}
	
}



Port_Write_Target_Device_ID_CSR()
{
	unsigned int reg_field;


	GEL_TextOut(" ********************************** Port-Write Target Device ID CSR (PW_TGT_ID) ******************************************************\n\n");
	
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_TGT_ID),15,15);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" ID_LARGE[15]        ---> %x => 8-bit device ID for port-write operation \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" ID_LARGE[15]        ---> %x => 16-bit device ID for port-write operation \n",,,,,reg_field);
	}
	
	
	GEL_TextOut(" DEVICEID[23:16]     ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_TGT_ID),23,16));
	
	
	GEL_TextOut(" DEVICEID_MSB[31:24] ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_TGT_ID),31,24));
	
}




