	GEL_TextOut(" ******************* Fabric Control and Status Register (FABRIC_CSR) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_FABRIC_CSR),26,26);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IG_UC_BACKPRESSURE  => Ingress User Core backpressure indication  ##NOT ASSERTED##  \n");
	}
	else
	{
		
		GEL_TextOut(" IG_UC_BACKPRESSURE  => Ingress User Core backpressure indication  **ASSERTED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_FABRIC_CSR),27,27);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IG_LLM_BACKPRESSURE => Ingress LLM backpressure indication  ##NOT ASSERTED##  \n\n");
	}
	else
