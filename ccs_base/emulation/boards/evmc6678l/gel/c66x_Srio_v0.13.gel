		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST3 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0x4)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST4 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0x5)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST5 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0x6)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST6 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0x7)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST7 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0x8)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST8 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0x9)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST9 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0xA)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST10 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0xB)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST11 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0xC)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST12 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0xD)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST13 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0xE)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST14 \n\n",,,,,drbl_routing_info);
	}
	else if(drbl_routing_info == 0xF)
	{
		GEL_TextOut(" ERR_RST_EVNT_ICRR3.ICR16 ---> %d => INTDST15 \n\n",,,,,drbl_routing_info);
	}
	
}


