						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
