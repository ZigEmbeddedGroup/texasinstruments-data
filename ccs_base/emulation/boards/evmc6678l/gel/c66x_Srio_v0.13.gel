Rxu_type9_Mapping_Registers()
{
	unsigned int i,status,strm_id,queue_ptr,reg_field,src_id,class_service,letter,cos_mask,strm_mask,dest_id,queue_id,srcid_match,destid_match,flow_id;
	
	GEL_TextOut(" ********************************** RXU Type 9 Mapping Registers (RXU_TYPE9_MAPn_0, RXU_TYPE9_MAPn_1, RXU_TYPE9_MAPn_2 and RXU_MAP_QID) ******************************************************\n\n");
	
	for(i=0;i<64;i++)
	{
		
		src_id=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_0+(i*0xC))),15,0);
		
		class_service=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_0+(i*0xC))),23,16);
		
		cos_mask=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_0+(i*0xC))),31,24);
		
		
		dest_id=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_1+(i*0xC))),31,16);
		
		srcid_match=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_1+(i*0xC))),1,1);
		
		destid_match=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_1+(i*0xC))),15,15);
		
		
		
		strm_id=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_2+(i*0xC))),15,0);
		
		strm_mask=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_TYPE9_MAP0_2+(i*0xC))),31,16);
		
		
		queue_id=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_MAP0_QID+(i*0xC))),13,0);
		
		flow_id=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RXU_MAP0_QID+(i*0xC))),23,16);
		
		
		if(i<10)
		{
			if(srcid_match == 0x0 && destid_match == 0x0)
			{
				GEL_TextOut(" RXU_T9Map%d :SrcId:%x DestId:%x COS:%x COS_mask:%x STRM_id:%x STRM__Mask:%x QId:%d FlowId:%d check sourceID*check destID \n",,,,,i,(unsigned short)src_id,(unsigned short)dest_id,(char)class_service,(char)cos_mask,(unsigned short)strm_id,(unsigned short)strm_mask,queue_id,flow_id);
			}
			else if(srcid_match == 0x0 && destid_match != 0x0)
			{
				GEL_TextOut(" RXU_T9Map%d :SrcId:%x DestId:%x COS:%x COS_mask:%x STRM_id:%x STRM__Mask:%x QId:%d FlowId:%d check sourceID*ignore destID \n",,,,,i,(unsigned short)src_id,(unsigned short)dest_id,(char)class_service,(char)cos_mask,(unsigned short)strm_id,(unsigned short)strm_mask,queue_id,flow_id);
