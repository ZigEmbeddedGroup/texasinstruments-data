	}
	else
	{
		
		GEL_TextOut(" PORT_ERR    => Interrupt notification for Port Error event  **ENABLED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_INT_ENABLE+(i*0x80))),27,27);
	
	if(reg_field==0)
	{
		GEL_TextOut(" DLT         => Interrupt notification for Dead Link Timer events  ##DISABLED## \n");
	}
	else
	{
		
		GEL_TextOut(" DLT         => Interrupt notification for Dead Link Timer events  **ENABLED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_INT_ENABLE+(i*0x80))),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LINK_INIT   => Interrupt notification for Link Initialization event  ##DISABLED## \n");
	}
	else
	{
		
		GEL_TextOut(" LINK_INIT   => Interrupt notification for Link Initialization event  **ENABLED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_INT_ENABLE+(i*0x80))),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" MAX_DENIAL  => Interrupt notification for Max Denial event  ##DISABLED## \n\n");
	}
	else
	{
		
		GEL_TextOut(" MAX_DENIAL  => Interrupt notification for Max Denial event  **ENABLED** \n\n");
	}
}


