		{
			GEL_TextOut("                    No errors are captured. Please, enable the required errors detection in SP%d_ERR_EN Register \n\n",,,,,i);
		}
		else
		{
			err_reasons_flag==0;
		}
		
	}	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),24,24);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(OUTPUT_DEGRD_ENC): The output port%d has encountered a degraded condition (To clear this bit SW should write 1 to it)\n",,,,,i);
		GEL_TextOut(" Reason & Solution: The error counter has reached the degraded error threshold value. \n");
		GEL_TextOut("                    The list of phy layer errors which contributed to this problem are: \n\n");
		
		error_flag=1;
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),0,0);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),0,0);

			if(reg_field != 0)
			{
				GEL_TextOut("                    LINK_TIMEOUT:The port did not receive an acknowledge or link-response control symbol within the specified time-out interval\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),1,1);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),1,1);

			if(reg_field != 0)
			{
				GEL_TextOut("                    UNSOLICITED_ACK_CNTL_SYM:The port received an unexpected acknowledge control symbol\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),2,2);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),2,2);

			if(reg_field != 0)
			{
				GEL_TextOut("                    DELINEATION_ERROR: 1) The port received an unaligned /SC/ or /PD/ or undefined code-group\n");
				GEL_TextOut("                                       2) The port detected an illegal character\n");
				GEL_TextOut("                                       3) A character which is not a part of IDLE1 sequence has occured after link initialization\n");
				GEL_TextOut("                                       4) A character which is not a part of IDLE2 sequence has occured after link initialization\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),4,4);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),4,4);

			if(reg_field != 0)
			{
				GEL_TextOut("                    PROTOCOL_ERROR:The port received an unexpected packet or control symbol\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),5,5);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),5,5);

			if(reg_field != 0)
			{
				GEL_TextOut("                    NON_OUTSTANDING_ACKID:The port received a link response with an ackID that is not outstanding\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),14,14);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),14,14);

			if(reg_field != 0)
			{
				GEL_TextOut("                    DSCRAM_LOS_EN:Receiver descrambler synchronization lost\n");
				
				err_reasons_flag=1;
			}
		}
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),17,17);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),17,17);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_OVER_276B:The port received packet that exceeds the maximum allowed size\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),18,18);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),18,18);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_WITH_BAD_CRC:The port received a packet with a bad CRC value\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),19,19);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),19,19);

			if(reg_field != 0)
			{
				GEL_TextOut("                    PKT_UNEXPECTED_ACKID:The port received a packet with unexpected/out-of-sequence ackID\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),20,20);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),20,20);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_NOT_ACCPT:The port received a packet-not-accepted acknowledge control symbol\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),21,21);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),21,21);

			if(reg_field != 0)
			{
				GEL_TextOut("                    CNTL_SYM_UNEXPECTED_ACKID:The port received an acknowledge control symbol with an unexpected ackID (packet-accepted or packet-retry)\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),22,22);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),22,22);

			if(reg_field != 0)
			{
				GEL_TextOut("                    CORRUPT_CNTL_SYM:The port received a control symbol with a bad CRC value\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),31,31);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),31,31);

			if(reg_field != 0)
			{
				GEL_TextOut("                    ERR_IMP_SPECIFIC:An implementation specific error has been detected (illegal field in a maintenance pkt,illegal destID,unsupported trans and ingress UDI timeout)\n");
				
				err_reasons_flag=1;
			}
		}
		
		if(err_reasons_flag==0)
		{
			GEL_TextOut("                    No errors are captured. Please, enable the required errors detection in SP%d_ERR_EN Register \n",,,,,i);
		}
		else
		{
			err_reasons_flag==0;
		}
		
		GEL_TextOut("                    PORT %d ERROR_RATE_COUNTER ---> %d \n",,,,,i,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),7,0));

		GEL_TextOut("                    PORT %d PEAK_ERROR_RATE ---> %d \n\n",,,,,i,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),15,8));

	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),25,25);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(OUTPUT_FLD_ENC): The output port%d has encountered a failed condition (To clear this bit SW should write 1 to it)\n");
		GEL_TextOut(" Reason & Solution: The error counter has reached the failed error threshold value. \n");
		GEL_TextOut("                    The list of phy layer errors which contributed to this problem are: \n\n",,,,,i);
		
		error_flag=1;
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),0,0);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),0,0);

			if(reg_field != 0)
			{
				GEL_TextOut("                    LINK_TIMEOUT:The port did not receive an acknowledge or link-response control symbol within the specified time-out interval\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),1,1);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),1,1);

			if(reg_field != 0)
			{
				GEL_TextOut("                    UNSOLICITED_ACK_CNTL_SYM:The port received an unexpected acknowledge control symbol\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),2,2);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),2,2);

			if(reg_field != 0)
			{
				GEL_TextOut("                    DELINEATION_ERROR: 1) The port received an unaligned /SC/ or /PD/ or undefined code-group\n");
				GEL_TextOut("                                       2) The port detected an illegal character\n");
				GEL_TextOut("                                       3) A character which is not a part of IDLE1 sequence has occured after link initialization\n");
				GEL_TextOut("                                       4) A character which is not a part of IDLE2 sequence has occured after link initialization\n\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),4,4);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),4,4);

			if(reg_field != 0)
			{
				GEL_TextOut("                    PROTOCOL_ERROR:The port received an unexpected packet or control symbol\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),5,5);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),5,5);

			if(reg_field != 0)
			{
				GEL_TextOut("                    NON_OUTSTANDING_ACKID:The port received a link response with an ackID that is not outstanding\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),14,14);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),14,14);

			if(reg_field != 0)
			{
				GEL_TextOut("                    DSCRAM_LOS_EN:Receiver descrambler synchronization lost\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),17,17);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),17,17);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_OVER_276B:The port received packet that exceeds the maximum allowed size\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),18,18);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),18,18);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_WITH_BAD_CRC:The port received a packet with a bad CRC value\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),19,19);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),19,19);

			if(reg_field != 0)
			{
				GEL_TextOut("                    PKT_UNEXPECTED_ACKID:The port received a packet with unexpected/out-of-sequence ackID\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),20,20);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),20,20);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_NOT_ACCPT:The port received a packet-not-accepted acknowledge control symbol\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),21,21);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),21,21);

			if(reg_field != 0)
			{
				GEL_TextOut("                    CNTL_SYM_UNEXPECTED_ACKID:The port received an acknowledge control symbol with an unexpected ackID (packet-accepted or packet-retry)\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),22,22);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),22,22);

			if(reg_field != 0)
			{
				GEL_TextOut("                    CORRUPT_CNTL_SYM:The port received a control symbol with a bad CRC value\n");
				
				err_reasons_flag=1;
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),31,31);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),31,31);

			if(reg_field != 0)
			{
				GEL_TextOut("                    ERR_IMP_SPECIFIC:An implementation specific error has been detected (illegal field in a maintenance pkt,illegal destID,unsupported trans and ingress UDI timeout)\n");
				
				err_reasons_flag=1;
			}
		}
		
		if(err_reasons_flag==0)
		{
			GEL_TextOut("                    No errors are captured. Please, enable the required errors detection in SP%d_ERR_EN Register \n",,,,,i);
		}
		else
		{
			err_reasons_flag==0;
		}
		
		
		GEL_TextOut("                    PORT %d ERROR_RATE_COUNTER ---> %d \n",,,,,i,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),7,0));

		GEL_TextOut("                    PORT %d PEAK_ERROR_RATE ---> %d \n\n",,,,,i,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_RATE+(i*0x40))),15,8));

	}
	
	// Nysh specific errors
	
	// Discarding and Stomping Packets
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),25,25);
	
	if(reg_field != 0)
	{
		//output failed condition encountered
		
		reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),3,3);
		
		reg_field_2=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),2,2);
		
		if(reg_field_1 != 0 && reg_field_2 != 0)
		{
			GEL_TextOut(" Problem(EG_PKT_DROPPED): Port%d PBMe discards all output packets without attempting to send them.\n",,,,,i);
			GEL_TextOut(" Reason & Solution: The port output failed condition is encountered as the error counter has exceeded the\n");
			GEL_TextOut("                    failed threshold. The output pkt drop bit in SP_ERR_STAT register is set. \n\n");
			
			error_flag=1;
		}
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),1,1);
	
	if(reg_field != 0)
	{
		// port lock-out
		GEL_TextOut(" Problem(EG_PKT_DROPPED): Port%d PBMe to discard all output packets without attempting to send them.\n",,,,,i);
		GEL_TextOut(" Reason & Solution: PORT_LOCKOUT bit set in SP_CTL register. \n\n");
		
		error_flag=1;
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x10))),23,23);
	
	if(reg_field != 0)
	{
		// port disabled
		GEL_TextOut(" Problem(EG_PKT_DROPPED): Port%d PBMe to discard all output packets without attempting to send them.\n",,,,,i);
		GEL_TextOut(" Reason & Solution: PORT_DIS bit set in SP_CTL register. \n\n");
		
		error_flag=1;
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),22,22);
	
	if(reg_field == 0)
	{
		// output port disabled
		GEL_TextOut(" Problem(EG_PKT_DROPPED): Port%d PBMe to discard all output packets except I/O logical MAINTENANCE packets.\n",,,,,i);
		GEL_TextOut(" Reason & Solution: OUTPUT_PORT_ENABLE bit cleared in SP_CTL register. \n\n");
		
		error_flag=1;
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),15,0);
	
	if(reg_field != 0)
	{
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),27,27);
		
		if(reg_field != 0)
		{
			// dead link encountered
			GEL_TextOut(" Problem(EG_PKT_DROPPED): Port%d PBMe to discard all output packets without attempting to send them.\n",,,,,i);
			GEL_TextOut(" Reason & Solution: A dead link is detected which indicates that there is no link partner attached to the port. \n\n");
			
			error_flag=1;
		}
	}
	
	
	// Nysh specific errors
	
	cnt_rty=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_DENIAL_CTL+(i*0x80))),28,28);
	
	cnt_pna=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_DENIAL_CTL+(i*0x80))),29,29);
	
	denial_thresh=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_DENIAL_CTL+(i*0x80))),7,0);
	
	if((cnt_rty != 0 || cnt_pna != 0) && (denial_thresh > 0))
	{
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),31,31);
		
		if(reg_field != 0)
		{
			// max denial threshold reached
			GEL_TextOut(" Problem(MAX DENIAL): Port%d Packet has received too many consecutive Packet Retry and/or Packet Not Accepted (PNA) acknowledgements\n",,,,,i);
			GEL_TextOut(" Reason & Solution: Max denial threshold value is reached for this port. \n\n");
			
			error_flag=1;
		}
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_STATUS+(i*0x80))),31,31);
	
	if(reg_field != 0)
	{
		GEL_TextOut(" Problem(IG_BAD_VC): Port%d Received packet has the ‘VC’ bit set in the physical layer header. \n\n",,,,,i);
		
		error_flag=1;
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_IMP_SPEC_CTL+(i*0x80))),15,0);
	
	if(reg_field > 0)
	{
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),27,27);
		
		if(reg_field != 0)
		{
			GEL_TextOut(" Problem(DLT): Port%d Dead link timer expired\n",,,,,i);
			GEL_TextOut(" Reason & Solution: This port remained in the un-initialized state for a time greater than the dead link timer expiry period. \n\n");
			
			error_flag=1;
		}
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_BRR_0_CTL+(i*0x80))),31,31);
	
	if(reg_field != 0)
	{
		reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_CONTROL+(i*0x80))),20,20);

		reg_field_2=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_CONTROL+(i*0x80))),21,21);
		
		if(reg_field_1 == 0 && reg_field_2 == 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_STATUS+(i*0x80))),20,20);
			
			if(reg_field != 0)
			{
				GEL_TextOut(" Problem(IG_BRR_FILTER): Port%d discarded an inbound transaction based on the BRR programming.\n",,,,,i);
				GEL_TextOut(" Reason & Solution: The incoming pkt is filtered based on BRR match and pattern values for this port. \n\n");
				
				error_flag=1;
			}
		}
	}

	
	// Nysh Implementation or Configuration Indications
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),4,4);
	
	if(reg_field != 0)
	{
		GEL_TextOut(" Problem(EG_DATA_OVERFLOW): Port%d PBMe was requested to enqueue a packet when it had insufficient memory to do so. \n\n",,,,,i);
		
		error_flag=1;
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),3,3);
	
	if(reg_field != 0)
	{
		GEL_TextOut(" Problem(EG_CRQ_OVERFLOW): Port%d PBMe was requested to enqueue apacket when it did not have a CRQ entry to do so. \n\n",,,,,i);
		
		error_flag=1;
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),0,0);
	
	if(reg_field != 0)
	{
		GEL_TextOut(" Problem(EG_BABBLE_PACKET): Port%d PBMe has detected a request to enqueue a packet which is longer than 276 bytes. \n\n",,,,,i);
		
		error_flag=1;
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),1,1);
	
	if(reg_field != 0)
	{
		GEL_TextOut(" Problem(EG_BAD_CHANNEL): Port%d PBMe has received a packet from the Endpoint Fabric on a channel interface which is invalid for the path’s configuration. \n\n",,,,,i);
		
		error_flag=1;
	}
	
	
	//check the error flag
	if(error_flag == 0)
	{
		GEL_TextOut(" No Errors are detected in Port%d \n\n",,,,,i);
	}
	else
	{
		error_flag=0;
	}
		
}


hotmenu SRIO_Phy_errors_scan()
{
	unsigned int i;
	unsigned int path_configuration, path_mode, serdes_pll_lock;
	
	i=0;
	
	//Scan the SERDES PLL lock status
	serdes_pll_lock = SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SERDES_STS),0,0);
	
	if(serdes_pll_lock != 1)
	{
		GEL_TextOut(" Problem(SERDES_PLL_LOCK): The SRIO SERDES PLL is not locked\n");
		GEL_TextOut(" Reason & Solution: Check the SERDES PLL,TX and RX configurations and also verify whether the SERDES PLL is\n");
		GEL_TextOut("                    enabled.\n\n");
	}
	
	
	
	path_configuration=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),10,8);
	
	path_mode=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),2,0);
	
	if(path_mode==0)
	{
		GEL_TextOut(" PATH_MODE   => MODE0( 1x | 1x | 1x | 1x )\n");
	}
	else if(path_mode==1)
	{
		GEL_TextOut(" PATH_MODE   => MODE1( 1x | 1x |    2x    )\n");
	}
	else if(path_mode==2)
	{
		GEL_TextOut(" PATH_MODE   => MODE2(    2x    | 1x | 1x )\n");
	}
	else if(path_mode==3)
	{
		GEL_TextOut(" PATH_MODE   => MODE3(    2x    |    2x    )\n");
	}
	else if(path_mode==4)
	{
		GEL_TextOut(" PATH_MODE   => MODE4(          4x         )\n");
	}
	
	if(path_configuration==1)
	{
		GEL_TextOut(" PATH_CONFIG => 1 Lane, 1 Port\n");
	}
	else if(path_configuration==2)
	{
		GEL_TextOut(" PATH_CONFIG => 2 Lanes, a maximum of 2 ports\n");
	}
	else if(path_configuration==4)
	{
		GEL_TextOut(" PATH_CONFIG => 4 Lanes, a maximum of 4 ports\n");
	}
	else
	{
		GEL_TextOut(" PATH_CONFIG => Reserved, None of the SRIO ports are scanned for physical layer errors\n");
	}
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		
		path_configuration=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),10,8);
	
		path_mode=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),2,0);
		
		if(path_configuration == 4)  //path configuration 4
		{
			// all path modes are supported
			
			if(path_mode == 0) // Mode 0
			{
				phy_layer_error_scan_func(i);
			}
			
			if(path_mode == 1) // Mode 1
			{
				if(i == 0 || i == 2 || i == 3)
				{
					phy_layer_error_scan_func(i);
				}
			}
			
			if(path_mode == 2) // Mode 2
			{
				if(i == 0 || i == 1 || i == 2)
				{
					phy_layer_error_scan_func(i);
				}
			}
			
			if(path_mode == 3) // Mode 3
			{
				if(i == 0 || i == 2)
				{
					phy_layer_error_scan_func(i);
				}
			}
			
			if(path_mode == 4) // Mode 4
			{
				if(i == 0)
				{
					phy_layer_error_scan_func(i);
				}
			}
		}
		
		
		if(path_configuration == 2)  //path configuration 2
		{
			// only Mode0 and Mode1 are available
			
			if(path_mode == 0) // Mode 0
			{
				if(i == 0 || i == 1)
				{
					phy_layer_error_scan_func(i);
				}
			}
			
			if(path_mode == 1) // Mode 1
			{
				if(i == 0)
				{
					phy_layer_error_scan_func(i);
				}
			}
		}
		
		
		if(path_configuration == 1)  //path configuration 1
		{
			// only Mode0 is available

			if(path_mode == 0) // Mode 0
			{
				if(i == 0)
				{
					phy_layer_error_scan_func(i);
				}
			}
		}
	}
}



hotmenu SRIO_LogTrans_Errors_scan ()
{
	unsigned int reg_field,reg_field_1,reg_field_2,source_dev_id,dest_dev_id,ttype,ftype;
	unsigned int error_flag=0;
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut("********************************** SRIO LOGICAL/TRANS LAYER ERROR SCAN RESULTS ************************\n");
	GEL_TextOut("*******************************************************************************************************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),7,7);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(RX_CPPI_SECURITY): The RXU has detected an access block (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: 1) On the TX side, if error msg rsps are received for msgs sent to a particular src_id/mbox/letter, \n");
		GEL_TextOut("                       then check on the RX side, whether that particular src_id/mbox/letter has an entry in the RXU mapping table. \n");
		GEL_TextOut("                       Also observe that unsolicited rsps are recieved on the TX side \n");
		GEL_TextOut("                    2) On the TX side, if we see a pattern of alternating good completion and error msg rsps for msgs sent \n");
		GEL_TextOut("                       to a particular src_id/mbox/letter. Then the TX side is sending more than one msg with the \n");
		GEL_TextOut("                       same src_id/mbox/letter at the same time. Also observe that unsolicited rsps are recieved on the TX side \n\n");
		
		error_flag=1;

	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),6,6);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(RX_IO_DMA_ACCESS): A DMA access to the MAU was blocked (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: The Direct IO pkt request received by the RX side MAU, contained an invalid destination  \n");
		GEL_TextOut("                     address which is not accessible in the device memory map.\n\n");
		
		error_flag=1;

	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),22,22);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(UNSUPPORTED_TRANS): The MAU has received an unsupported transaction (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: Check the destination operations CAR for all the allowed transactions.\n\n");
		
		error_flag=1;

	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),23,23);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(UNSOLICITED_RSPNS): The LSU or TXU has received an unsolicited rsp pkt (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: 1) In between a multi-segmented msg if a middle segment fails to get outbound credit, then \n");
		GEL_TextOut("                       the rsps received for the previously transmitted segments are considered to be unsolicited. \n");
		GEL_TextOut("                    2) In case if one of the segments of a multi-segmented msg times out, then any further  \n");
		GEL_TextOut("                       rsps received for this msg are considered to be unsolicited. \n");
		GEL_TextOut("                    3) If the first segment of the multi-segmented msg receives an error rsp, then the rsps of the \n");
		GEL_TextOut("                       remaining segments are considered to be unsolicited.\n");
		GEL_TextOut("                    4) When TXU is sending a msg and the maximum retry count is exceeded, while trying to send  \n");
		GEL_TextOut("                       a particular segment, then any further rsps received for this msg are considered to be unsolicited.\n\n");

		error_flag=1;

	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),24,24);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(PKT_RSPNS_TIMEOUT): A required rsp has not been received by the LSU/TXU within the specified timeout interval. (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: 1) There might be congetion in the rapid IO interconnect. \n");
		GEL_TextOut("                    2) Re-visit you traffic scenario and try to minimize the load on the SRIO interconnect.\n\n");
		
		error_flag=1;

	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),25,25);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(MSG_REQ_TIMEOUT): A required rsp has not been received by the RXU within the specified timeout interval. (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: 1) There might be congetion in the rapid IO interconnect. \n");
		GEL_TextOut("                    2) Re-visit you traffic scenario and try to minimize the load on the SRIO interconnect.\n\n");
		
		error_flag=1;

	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),27,27);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(ILL_TRANS_DECODE): Illegal transaction decode (switch or endpoint device) (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: 1) For an LSU or the TXU: receives illegal fields in the rsp packet for an IO/msg trans. \n");
		GEL_TextOut("                    2) For an MAU or the RXU: receives illegal fields in the request packet for an IO/msg trans.\n\n"); 
		
		error_flag=1;

	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),28,28);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(ERR_MSG_FORMAT): The RXU received a message data payload with an invalid size or segment (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: Some problem with the SRIO node which is sending this erroneous rsp.\n\n");
		
		error_flag=1;
 
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),30,30);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(MSG_ERR_RSPNS): The TXU received an ERROR response to a message logical layer request (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: 1) An ERROR response is sent if the RX message is too big for the allotted buffer space. \n");
		GEL_TextOut("                       (ERROR responses are sent for all subsequent segments of that message) \n");
		GEL_TextOut("                    2) An ERROR response is sent if the mailbox is not mapped, or if it is mapped to  \n");
		GEL_TextOut("                       a non-existent queue. \n");
		GEL_TextOut("                    3) An ERROR response is sent if the mailbox is mapped but the queue is not initialized \n");
		GEL_TextOut("                       (the HDP not written), or if the queue is disabled (due to a teardown). \n");
		GEL_TextOut("                    4) An ERROR response is sent if the RX buffer descriptor queue has no empty buffers  \n");
		GEL_TextOut("                       (there is an overflow) \n");
		GEL_TextOut("                    5) If the TXU sends a pkt with the same src_id/mbox/letter as the previous pkt, whose rsp is not received. \n");
		GEL_TextOut("                    6) A RX Buffer descriptor programmed to receive a particular message, points to a non-existent memory. \n");
		GEL_TextOut("                       The RX BD status will also reflect with a DMA transfer error and a error rsp is sent.\n\n");
		
		error_flag=1;

	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),31,31);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(IO_ERR_RSPNS): An LSU received an ERROR response to an I/O logical layer request (To clear this bit SW should write 0 to it)\n");
		GEL_TextOut(" Reason & Solution: 1) DMA transfer error at RX SRIO node, receives an error rsp for NWRITE_R and NREAD  \n");
		GEL_TextOut("                       request pkts. \n");
		GEL_TextOut("                    2) Retry DOORBELL response received, or Atomic Test-and-swap was not allowed \n");
		GEL_TextOut("                       (semaphore in use). \n");
		GEL_TextOut("                    3) Request payload lenght was in error for NWRITE_R pkts.\n\n");
		
		error_flag=1;

	}
	
	reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),31,0);
	
	reg_field_2=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),31,0);
	
	if(reg_field_1 != 0 && reg_field_2 != 0)
	{
		source_dev_id=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ID_CAPT),15,0);
	
		dest_dev_id=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ID_CAPT),31,16);
		
		GEL_TextOut(" Logical layer Error occurred in transaction from %x ---> %x \n\n",,,,,(unsigned short)source_dev_id,(unsigned short)dest_dev_id);
		
		GEL_TextOut(" DETAILS OF THE ERRONEOUS PKT:\n\n");
		
		
		ttype=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),27,24);
		
		ftype=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),31,28);
		
		if(ftype == 0x2 && ttype == 0x4)
		{
			GEL_TextOut(" PKT_TYPE                  ---> NREAD packet\n");
		}
		else if(ftype == 0x2 && ttype == 0xC)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Atomic increment packet\n");
		}
		else if(ftype == 0x2 && ttype == 0xD)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Atomic decrement packet\n");
		}
		else if(ftype == 0x2 && ttype == 0xE)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Atomic set packet\n");
		}
		else if(ftype == 0x2 && ttype == 0xF)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Atomic clear packet\n");
		}
		else if(ftype == 0x5 && ttype == 0x4)
		{
			GEL_TextOut(" PKT_TYPE                  ---> NWRITE packet\n");
		}
		else if(ftype == 0x5 && ttype == 0x5)
		{
			GEL_TextOut(" PKT_TYPE                  ---> NWRITE_R packet\n");
		}
		else if(ftype == 0x5 && ttype == 0xE)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Atomic test and swap packet\n");
		}
		else if(ftype == 0x6)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Streaming write packet\n");
		}
		else if(ftype == 0x7)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Congestion Control packet\n");
		}
		else if(ftype == 0x8 && ttype == 0x0)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Maintenance read packet\n");
		}
		else if(ftype == 0x8 && ttype == 0x1)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Maintenance write packet\n");
		}
		else if(ftype == 0x8 && ttype == 0x2)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Maintenance read response packet\n");
		}
		else if(ftype == 0x8 && ttype == 0x3)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Maintenance write response packet\n");
		}
		else if(ftype == 0x8 && ttype == 0x4)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Maintenance port-write packet\n");
		}
		else if(ftype == 0xD && ttype == 0x0)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Response(+Doorbell Resp) packet\n");
		}
		else if(ftype == 0xD && ttype == 0x1)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Message Response packet\n");
		}
		else if(ftype == 0xD && ttype == 0x8)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Response w/payload packet\n");
		}
		else if(ftype == 0x9)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Data streaming packet\n");
		}
		else if(ftype == 0xA)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Doorbell packet\n");
		}
		else if(ftype == 0xB)
		{
			GEL_TextOut(" PKT_TYPE                  ---> Message packet\n");
		}
		else
		{
			GEL_TextOut(" PKT_TYPE                  ---> Not a valid packet type\n");
		}
		
		GEL_TextOut(" DIO_XAMSBS ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ADDR_CAPT),1,0));
		
		GEL_TextOut(" DIO_ADDRESS_MSB ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_H_ADDR_CAPT),31,0));
		
		GEL_TextOut(" DIO_ADDRESS_LSB ---> %x \n",,,,,(SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ADDR_CAPT),31,3))<<3);

		GEL_TextOut(" IMP_SPECIFIC---> %x \n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),15,0));
		
						   
		GEL_TextOut(" For Multi-segmented msgs: \n MSGINFO ---> Letter-%d, Mbox-%d, SegmentId-%d \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),23,22),SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),21,20),SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),19,16));
		
		GEL_TextOut(" For Single-segmented msgs: \n MSGINFO ---> Letter-%d, Mbox-%d \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),23,22),SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),21,16));
		
		error_flag=1;
		
	}
	
	//check the error flag
	if(error_flag == 0)
	{
		GEL_TextOut(" No Logical/Transport Errors are detected\n\n");
	}
	else
	{
		error_flag=0;
	}
	
}


menuitem "SRIO All Registers Snapshot";

hotmenu  Srio_allRegs_Snapshot()
{
	unsigned int i,j,reg_field;
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** GENERAL HW CONFIGURATION REGISTERS SNAPSHOT ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
    
	
	Peripheral_Settings_Control_Register();

	Peripheral_Settings_Control_Register_1();
	
	RapidIO_DEVICEID_Register_Config();
	
	RapidIO_MULTI_ID_Register_Config();
	
	Peripheral_Global_Enable_Register();

	Block_n_Enable_Register();

    Peripheral_Identification_Register();
		
    Peripheral_Control_Register();
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PACKET FORWARDING AND FLOW CONTROL REGISTERS SNAPSHOT ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Packet_Forwarding_Register_n_for_16_Bit_Device_IDs();

	Packet_Forwarding_Register_n_for_8_Bit_Device_IDs();

	Flow_Control_Table_Entry_Register_n();
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PHYSICAL LAYER REGISTERS SNAPSHOT ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	
	Device_Identity();

	Device_Information();

	Assembly_Identity();

	Assembly_Information();

	Processing_Element_Features();

	Switch_port_information();

	Source_Operations();

	Destination_Operations();

	Local_Configuration_Space_Base_Address_0();

	Local_Configuration_Space_Base_Address_1();

	Base_Device_ID_CSR();

	Host_Base_Device_ID_Lock_CSR();

	Component_Tag_CSR();

	Serial_Port_Maintenance_Block_Header_Register();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** COMMON PORT CONFIGURATION REGISTERS SNAPSHOT ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Port_Link_Time_Out_Control_CSR();

	Port_Response_Time_Out_Control_CSR();

	Port_General_Control_CSR();

	Port_Write_Target_Device_ID_CSR();
	
	
	
	
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{           
        GEL_TextOut(" *******************SRIO PORT%d CONFIGURATION *******************\n \n",,,,,i);
     
		Port_Control_CSR(i);

		Port_Control2_CSR(i);

		Port_Error_Rate_Enable_CSR(i);

		Port_Error_Rate_CSR(i);

		Port_Error_Rate_Threshold_CSR(i);
	}
	
	
	
	Logical_Transport_Layer_Error_Enable_CSR();

	Processing_Element_Logical_Layer_Control_CSR();
	
	
	
	
	
	GEL_TextOut(" *****************************SRIO HW Global Enable Status***************************** \n\n");
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),0,0);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Global enable status ---> %x => The peripheral is in reset with all its clocks off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Global enable status ---> %x => The peripheral is enabled with all its clocks running \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),1,1);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block0 enable status ---> %x => 'set of memory-mapped registers (MMRs) for the SRIO peripheral' is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block0 enable status ---> %x => 'set of memory-mapped registers (MMRs) for the SRIO peripheral' is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),2,2);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block1 enable status ---> %x => Load/Store module(LSU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block1 enable status ---> %x => Load/Store module(LSU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),3,3);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block2 enable status ---> %x => memory access unit (MAU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block2 enable status ---> %x => memory access unit (MAU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),4,4);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block3 enable status ---> %x => message transmit unit (TXU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block3 enable status ---> %x => message transmit unit (TXU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),5,5);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block4 enable status ---> %x => message receive unit (RXU) is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block4 enable status ---> %x => message receive unit (RXU) is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),6,6);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block5 enable status ---> %x => SRIO port 0 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block5 enable status ---> %x => SRIO port 0 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),7,7);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block6 enable status ---> %x => SRIO port 1 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block6 enable status ---> %x => SRIO port 1 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),8,8);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block7 enable status ---> %x => SRIO port 2 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block7 enable status ---> %x => SRIO port 2 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),9,9);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block8 enable status ---> %x => SRIO port 3 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block8 enable status ---> %x => SRIO port 3 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_GBL_EN_STAT),10,10);
		
	if(reg_field == 0)
	{
		GEL_TextOut(" Block9 enable status ---> %x => Block9 is reset with its clock off \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" Block9 enable status ---> %x => Block9 is enabled with its clock running. \n",,,,,reg_field);
	}
	
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** SRIO PORT STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{                
		GEL_TextOut(" ********************************** SRIO PORT%d STATUS ****************************************************** \n\n",,,,,i);
		
		Port_Error_and_Status_CSR(i);

		Port_Error_Detect_CSR(i);

		Port_Error_rate_CSR(i);

		Port_Link_Maintenance_Response_CSR(i);

		Port_Local_AckId_Status_CSR(i);

		Port_Attributes_Error_Capture_CSR(i);
	}
	
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** SRIO LOGICAL AND TRANSPORT ERROR STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");


	Logical_Transport_Layer_Error_Detect_CSR();

	Logical_Transport_Layer_Device_ID_Capture_CSR();

	Logical_Transport_Layer_Control_Capture_CSR();

	Logical_Transport_Layer_High_Address_Capture_CSR();

	Logical_Transport_Layer_Address_Capture_CSR();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** FARADAY SRIO INTERRUPTS ROUTING INFO ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Doorbell_Interrupts_Routing_fn();

	LSU_Interrupts_Routing_fn();

	Splevents_and_Error_Interrupts_Routing_fn();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** FARADAY SRIO INTERRUPTS STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Doorbell_Interrupts_Status_fn();

	LSU_Interrupts_Status_fn();

	Splevents_and_Error_Interrupts_Status_fn();

	Interrupt_Status_Decode_Register_fn();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** SRIO LSU CONFIGURATION******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	for(i=0;i<8;i++)
	{                
		lsu_configuration(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** SRIO LSU STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	
	for(i=0;i<8;i++)
	{
		lsu_status(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** SRIO TX CPPI CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Transmit_CPPI_Supported_Flow_Mask_Registers();
	
	TX_QUEUE_Scheduling_info();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** SRIO RX CPPI CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Mailbox_to_Queue_Mapping_Registers();
	
	Rxu_type9_Mapping_Registers();
	
	
	
	Garbage_Collection_info();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT PLM CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d PLM CONFIGURATION ******************* \n\n",,,,,i);
		
		PLM_Port_Implementation_Specific_Control_Register(i);

		PLM_Port_Interrupt_Enable_Register(i);

		PLM_Port_Port_Write_Enable_Register(i);

		PLM_Port_Event_Generate_Register(i);

		PLM_Port_All_Interrupts_Enable_Register(i);

		PLM_Port_All_Port_Writes_Enable_Register(i);

		PLM_Port_Path_Control_Register(i);

		PLM_Port_Discovery_Timer_Register(i);

		PLM_Port_Silence_Timer(i);

		PLM_Port_Vmin_Exponent_Register(i);

		PLM_Port_Lane_Polarity_Control_Register(i);

		PLM_Port_Packet_Denial_Control_Register(i);

		PLM_Port_MECS_Forwarding_Register(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT PLM STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d PLM STATUS ******************* \n\n",,,,,i);
		
		PLM_Port_Power_Down_Control_Register(i);

		PLM_Port_Event_Status_Register(i);

		PLM_Port_Received_MECS_Status_Register(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT TLM CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d TLM CONFIGURATION ******************* \n\n",,,,,i);
		
		TLM_Port_Control_Register(i);

		TLM_Port_Interrupt_Enable_Register(i);

		TLM_Port_Port_Write_Enable_Register(i);

		TLM_Port_Base_Routing_Register_0_Control_Register(i);

		TLM_Port_Base_Routing_Register0_Pattern_Match_Register(i);

		TLM_Port_Base_Routing_Register_1_Control_Register(i);

		TLM_Port_Base_Routing_Register1_Pattern_Match_Register(i);

		TLM_Port_Base_Routing_Register_2_Control_Register(i);

		TLM_Port_Base_Routing_Register2_Pattern_Match_Register(i);

		TLM_Port_Base_Routing_Register_3_Control_Register(i);

		TLM_Port_Base_Routing_Register3_Pattern_Match_Register(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT TLM STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d TLM STATUS ******************* \n\n",,,,,i);
		
		TLM_Port_Status_Register(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT PBM CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d PBM CONFIGURATION ******************* \n\n",,,,,i);
		
		PBM_Port_Control_Register(i);

		PBM_Port_Interrupt_Enable_Register(i);

		PBM_Port_Port_Write_Enable_Register(i);

		PBM_Port_Event_Generate_Register(i);

		PBM_Port_Ingress_Resources_Register(i);

		PBM_Port_Egress_Resources_Register(i);

		PBM_Port_Ingress_Watermarks_0_Register(i);

		PBM_Port_Ingress_Watermarks_1_Register(i);

		PBM_Port_Ingress_Watermarks_2_Register(i);

		PBM_Port_Ingress_Watermarks_3_Register(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT PBM STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d PBM STATUS ******************* \n\n",,,,,i);
		
		PBM_Port_Status_Register(i);
	}
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** EVENT MGT CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Event_Management_Interrupts_Enable_Register();
	
	Event_Management_Device_Interrupt_Enable_Register();

	Event_Management_Port_Write_Enable_Register();

    Event_Management_Device_Port_Write_Enable_Register();
	
	Event_Management_MECS_Interrupt_Enable_Register();
	
	Event_Management_MECS_Capture_Out_Register();
	
	Event_Management_MECS_Trigger_In_Register();

	Event_Management_Reset_Request_Interrupt_Enable_Register();

	Event_Management_Reset_Request_Port_Write_Enable_Register();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** EVENT MGT STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");


	Event_Management_Interrupt_Status_Register();
	
	Event_Management_Interrupt_Port_Status_Register();


	Event_Management_Port_Write_Status_Register();

	Event_Management_Port_Write_Port_Status_Register();

	
	Event_Management_MECS_Status_Register();
	
	Event_Management_MECS_Port_Status_Register();


	Event_Management_Reset_Request_Port_Status_Register();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT-WRITE CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Port_Write_Control_Register();

	Port_Write_Routing_Register();

	Port_Write_Reception_Event_Generate_Register();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT-WRITE STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Port_Write_Reception_Status_CSR();

	Port_Write_Reception_Capture();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** LLM CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Port_Number_CSR();

	Port_IP_Prescalar_for_SRV_CLK_Register();

	Register_Reset_Control_CSR();

	Local_Logical_Transport_Layer_Error_Enable_CSR();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** LLM STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
 
	Local_Logical_Transport_Layer_Error_Detect_CSR();

	Local_Logical_Transport_Layer_High_Address_Capture_CSR();

	Local_Logical_Transport_Layer_Address_Capture_CSR();

	Local_Logical_Transport_Layer_deviceID_Capture_CSR();

	Local_Logical_Transport_Layer_Control_Capture_CSR();
	
	
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** FABRIC STATUS ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
 

	Fabric_Control_and_Status_Register();

	Port_Fabric_Status_Register(0);

	Port_Fabric_Status_Register(1);

	Port_Fabric_Status_Register(2);

	Port_Fabric_Status_Register(3);
	
	
}

#define NREAD 		0x00000024
#define NWRITE		0x00000054
#define NWRITE_R	0x00000055

menuitem "SRIO APIs";

dialog  DIO_NWRITE(Src "Source Address", Dst "Destination Address", size_bytes "Size in Bytes", LSU_Num "LSU Number (0-7)", outport_id "Output Port (0-3)", id_size "ID size (0-8bits, 1-16bits)", destid "Dest Id")
{
	unsigned int temp,lsu_status, write_data;

	//check if any shadow registers of LSU8 are available
	
	lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG6+(LSU_Num*0x1C))),30,30);
	
	if(lsu_status == 0)
	{
	
		lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG6+(LSU_Num*0x1C))),31,31);
		
		if(lsu_status == 0)
		{
		
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG1+(LSU_Num*0x1C)),31,0,Dst);
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG2+(LSU_Num*0x1C)),31,0,Src);
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG3+(LSU_Num*0x1C)),19,0,size_bytes);
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG4+(LSU_Num*0x1C)),9,8,outport_id);
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG4+(LSU_Num*0x1C)),11,10,id_size);
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG4+(LSU_Num*0x1C)),7,4,0x0);  //priority - 0x0 (lowest) CRF-0, VC-0
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG4+(LSU_Num*0x1C)),15,12,0x0);  // Always use RIO_DEVICEID_REG0
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG4+(LSU_Num*0x1C)),31,16,destid);
			
			SRIO_REG_FIELD_WRITE((SRIO_LSU1_REG5+(LSU_Num*0x1C)),15,0,NWRITE); // Operation
			
			//Provide some delay for the transfer to occur
			SRIO_Delay(50000);
			
			GEL_TextOut(" DIO Operation successful\n\n");
		}
		else
		{
			//LSU 8 shadow registers are not available
			GEL_TextOut(" LSU 8 is Busy. Please try later\n\n");
		}
	}
	else
	{
		//LSU 8 shadow registers are not available
		GEL_TextOut(" LSU 8 shadow registers are Full. Please try later\n\n");
	}

	
}

#define HYPERLINK_SEG_ADD	(0x40100000u)

#define HYPERLINK_SRIO_LSU1_REG0	(0x00000D00u)
#define HYPERLINK_SRIO_LSU1_REG1    (0x00000D04u)
#define HYPERLINK_SRIO_LSU1_REG2    (0x00000D08u)
#define HYPERLINK_SRIO_LSU1_REG3    (0x00000D0Cu)
#define HYPERLINK_SRIO_LSU1_REG4    (0x00000D10u)
#define HYPERLINK_SRIO_LSU1_REG5    (0x00000D14u)
#define HYPERLINK_SRIO_LSU1_REG6    (0x00000D18u)

dialog  DIO_NWRITE_HYPERLINK(Src "Source Address", Dst "Destination Address", size_bytes "Size in Bytes", LSU_Num "LSU Number (0-7)", outport_id "Output Port (0-3)", id_size "ID size (0-8bits, 1-16bits)", destid "Dest Id")
{
	unsigned int temp,lsu_status, write_data;

	//check if any shadow registers of LSU8 are available
	
	lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)(HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG6+(LSU_Num*0x1C))),30,30);
	
	if(lsu_status == 0)
	{
	
		lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)(HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG6+(LSU_Num*0x1C))),31,31);
		
		if(lsu_status == 0)
		{
			
			GEL_TextOut(" First address to write %x\n\n",,,,,(HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG1+(LSU_Num*0x1C)));
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG1+(LSU_Num*0x1C)),31,0,Dst);
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG2+(LSU_Num*0x1C)),31,0,Src);
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG3+(LSU_Num*0x1C)),19,0,size_bytes);
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG4+(LSU_Num*0x1C)),9,8,outport_id);
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG4+(LSU_Num*0x1C)),11,10,id_size);
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+HYPERLINK_SRIO_LSU1_REG4+(LSU_Num*0x1C)),7,4,0x0);  //priority - 0x0 (lowest) CRF-0, VC-0
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+SRIO_LSU1_REG4+(LSU_Num*0x1C)),15,12,0x0);  // Always use RIO_DEVICEID_REG0
			
			SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+SRIO_LSU1_REG4+(LSU_Num*0x1C)),31,16,destid);
			
			//SRIO_REG_FIELD_WRITE((HYPERLINK_SEG_ADD+SRIO_LSU1_REG5+(LSU_Num*0x1C)),15,0,NWRITE); // Operation
			
			//Provide some delay for the transfer to occur
			SRIO_Delay(50000);
			
			GEL_TextOut(" DIO Operation successful\n\n");
		}
		else
		{
			//LSU 8 shadow registers are not available
			GEL_TextOut(" LSU 8 is Busy. Please try later\n\n");
		}
	}
	else
	{
		//LSU 8 shadow registers are not available
		GEL_TextOut(" LSU 8 shadow registers are Full. Please try later\n\n");
	}

	
}

