Event_Management_Port_Write_Status_Register()
{

	unsigned int reg_field;

	GEL_TextOut(" ******************* Event Management Port-Write Status Register (EM_PW_STAT) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_PW_STAT),8,8);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOCALOG       => one or more of the enabled errors in ERR_DET CSR is  ##NOT SET## (Port_write is not sent) \n");
	}
	else
	{
		
		GEL_TextOut(" LOCALOG       => one or more of the enabled errors in ERR_DET CSR is  **SET** (Port_write is sent)\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_PW_STAT),9,9);
	
	if(reg_field==0)
	{
		GEL_TextOut(" MULTIPORT_ERR => Multiple ports  ##HAVE NOT DETECTED##  errors which use port-write notification (Port_write is not sent)\n");
	}
	else
	{
		
		GEL_TextOut(" MULTIPORT_ERR => Multiple ports  **HAVE DETECTED**  errors which use port-write notification (Port_write is sent)\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_PW_STAT),27,27);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RCS           => A reset request  ##HAS NOT##  been detected by a port. (Port_write is not sent)\n");
	}
	else
	{
		
		GEL_TextOut(" RCS           => A reset request  **HAS**  been detected by a port. (Port_write is sent)\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_PW_STAT),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOG           => An enabled Log/Trans error has  ##NOT BEEN DETECTED##  and reported by User Core LOGERR Signals (Port_write is not sent)\n");
	}
	else
	{
		
		GEL_TextOut(" LOG           => An enabled Log/Trans error has  **BEEN DETECTED**  and reported by User Core LOGERR Signals (Port_write is sent)\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_PW_STAT),29,29);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PORT          => A port-specific event  ##HAS NOT BEEN##  detected. (Port_write is not sent)\n\n");
	}
	else
	{
		
		GEL_TextOut(" PORT          => A port-specific event  **HAS BEEN**  detected. (Port_write is sent)\n\n");
	}
	
}
	
