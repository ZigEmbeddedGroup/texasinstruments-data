	GEL_TextOut(" TAGS      => Number of Tags implemented in the PBMi for packet storage for this port is %d  \n",,,,,reg_field);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_IG_RESOURCES+(i*0x80))),25,16);
	
