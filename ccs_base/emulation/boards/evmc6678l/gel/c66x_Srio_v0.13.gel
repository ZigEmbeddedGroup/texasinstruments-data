hotmenu LSU_Config_Registers_Snapshot()
{
	unsigned int i;
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** SRIO LSU CONFIGURATION******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	for(i=0;i<8;i++)
	{                
		lsu_configuration(i);
	}

}


menuitem "SRIO LSU Status";

lsu_status(unsigned int lsu_no)
{
	unsigned int i,lsu_status,reg_field,j,lcb;
	
	i=lsu_no;
	
	GEL_TextOut(" ********************************** SRIO LSU%d STATUS ******************************************************\n \n",,,,,i);
	
	lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG6+(i*0x1C))),31,31);
	
	if(lsu_status==0)
	{
		GEL_TextOut(" BUSY         => LSU%d is  ##AVAILABLE##   \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" BUSY         => LSU%d is  **NOT AVAILABLE**   \n",,,,,i);
	}
	
	lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG6+(i*0x1C))),30,30);
	
	if(lsu_status==0)
	{
		GEL_TextOut(" FULL         => LSU%d shadow registers are  ##AVAILABLE##   \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" FULL         => LSU%d shadow registers are  **NOT AVAILABLE**   \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG6+(i*0x1C))),3,0);
	
	GEL_TextOut(" CURRENT_LTID => Current shadow register in use: %d \n",,,,,reg_field);
	
	lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_LSU1_REG6+(i*0x1C))),4,4);
	
	if(lsu_status==0)
	{
		GEL_TextOut(" CURRENT_LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" CURRENT_LCB  => This transaction is the current one having LTID: %d \n\n",,,,,reg_field);
	}
	
	GEL_TextOut(" *********** LSU%d SHADOW REGISTERS STATUS: ***********\n \n",,,,,i);
	
	if(i == 0 || i == 4)
	{
	
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_SETUP_REG0),(3+(i*4)),i*4);
		
		if(reg_field < 9)
		{
			for(j=0;j < reg_field;j++)
			{
				if(i == 0)
				{
					lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_STAT_REG0),((j*4)+3),j*4);
					
					lcb=lsu_status&0x1;
					
					lsu_status=lsu_status >> 1;
				}
				else if(i == 4)
				{
					lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_STAT_REG3),((j*4)+3),j*4);
					
					lcb=lsu_status&0x1;
					
					lsu_status=lsu_status >> 1;
				}
		
				if(lsu_status == 0x0)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, No Errors (Posted/Non-posted)\n\n");
				}
				else if(lsu_status == 0x1)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction Timeout occurred on Non-posted transaction\n\n");
				}
				else if(lsu_status == 0x2)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, Packet not sent due to flow control blockade (Xoff)\n\n");
				}
				else if(lsu_status == 0x3)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, Non-posted response packet (type 8 and 13) contained ERROR status, or response payload length was in error\n\n");
				}
				else if(lsu_status == 0x4)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, Packet not sent due to unsupported transaction type or invalid programming encoding for one or more LSU register fields\n\n");
				}
				else if(lsu_status == 0x5)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => DMA data transfer error\n\n");
				}
				else if(lsu_status == 0x6)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => 'Retry' DOORBELL response received, or Atomic Test-and-swap was not allowed (semaphore in use)\n\n");
				}
				else if(lsu_status == 0x7)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction completed, No packets sent as the transaction was killed using the CBUSY bit\n\n");
				}
				else
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Reserved\n\n");
				}
			}
		}
		else if(reg_field == 9)
		{
			for(j=0;j < reg_field;j++)
			{
				lsu_status=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_LSU_STAT_REG0),((j*4)+3),j*4);
				
				lcb=lsu_status&0x1;
				
				lsu_status=lsu_status >> 1;
		
				if(lsu_status == 0x0)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, No Errors (Posted/Non-posted)\n\n");
				}
				else if(lsu_status == 0x1)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction Timeout occurred on Non-posted transaction\n\n");
				}
				else if(lsu_status == 0x2)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, Packet not sent due to flow control blockade (Xoff)\n\n");
				}
				else if(lsu_status == 0x3)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, Non-posted response packet (type 8 and 13) contained ERROR status, or response payload length was in error\n\n");
				}
				else if(lsu_status == 0x4)
				{
					if(lcb==0)
					{
						GEL_TextOut(" LCB  => This transaction is the previous/next one having LTID: %d \n",,,,,j);
					}
					else
					{
						GEL_TextOut(" LCB  => This transaction is the current one having LTID: %d \n",,,,,j);
					}
					
					GEL_TextOut(" CC   => Transaction complete, Packet not sent due to unsupported transaction type or invalid programming encoding for one or more LSU register fields\n\n");
				}
				else if(lsu_status == 0x5)
				{
					if(lcb==0)
					{
