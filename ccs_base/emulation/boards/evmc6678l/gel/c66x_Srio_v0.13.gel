menuitem "SRIO Logical_Transport Layer Status";

Logical_Transport_Layer_Error_Detect_CSR()
{
	unsigned int reg_field;
	
	GEL_TextOut(" ********************************** Logical/Transport Layer Error Detect CSR (ERR_DET) ******************************************************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),6,6);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RX_IO_DMA_ACCESS  => A DMA access to the MAU has  ##NOT##  been blocked\n");
	}
	else
	{
		GEL_TextOut(" RX_IO_DMA_ACCESS  => A DMA access to the MAU  **WAS BLOCKED** . To clear this bit, write 0 to it\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),7,7);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RX_CPPI_SECURITY  => The RXU has  ##NOT##  detected an access block\n");
	}
	else
	{
		GEL_TextOut(" RX_CPPI_SECURITY  => The RXU  **HAS DETECTED**  an access block\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),22,22);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" UNSUPPORTED_TRANS => The MAU has  ##NOT##  received an unsupported transaction\n");
	}
	else
	{
		GEL_TextOut(" UNSUPPORTED_TRANS => The MAU  **HAS RECIEVED**  an unsupported transaction\n");
	}

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),23,23);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" UNSOLICITED_RSPNS => An unsolicited response packet has  ##NOT##  been received by an LSU or the TXU\n");
	}
	else
	{
		GEL_TextOut(" UNSOLICITED_RSPNS => An unsolicited response packet  **HAS BEEN RECEIVED**  by an LSU or the TXU\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),24,24);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PKT_RSPNS_TIMEOUT => A timeout has  ##NOT##  been detected by an LSU or the TXU\n");
	}
	else
	{
		GEL_TextOut(" PKT_RSPNS_TIMEOUT => A timeout  **HAS BEEN DETECTED**  by an LSU or the TXU\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),25,25);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" MSG_REQ_TIMEOUT   => A timeout has  ##NOT##  been detected by RXU\n");
	}
	else
	{
		GEL_TextOut(" MSG_REQ_TIMEOUT   => A timeout  **HAS BEEN DETECTED**  by the RXU\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),27,27);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" ILL_TRANS_DECODE  => The LSU/TXU did  ##NOT##  receive illegal fields in the response packet 
		                                The MAU/RXU did  ##NOT##  receive illegal fields in the request packet\n");
	}
	else
	{
		GEL_TextOut(" ILL_TRANS_DECODE  => The LSU/TXU  **RECEIVED**  illegal fields in the response packet 
		                                The MAU/RXU **RECEIVED** illegal fields in the request packet\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),28,28);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" ERR_MSG_FORMAT    => The RXU did  ##NOT##  receive a message data payload with an invalid size or segment.\n");
	}
	else
	{
		GEL_TextOut(" ERR_MSG_FORMAT    => The RXU  **RECEIVED**  a message data payload with an invalid size or segment\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),30,30);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" MSG_ERR_RSPNS     => The TXU did  ##NOT##  receive an ERROR response to a message logical layer request\n");
	}
	else
	{
		GEL_TextOut(" MSG_ERR_RSPNS     => The TXU  **RECEIVED**  an ERROR response to a message logical layer request\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),31,31);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" IO_ERR_RSPNS      => An LSU did  ##NOT##  receive an ERROR response to an I/O logical layer request\n\n");
	}
	else
	{
		GEL_TextOut(" IO_ERR_RSPNS      => An LSU  **RECEIVED**  an ERROR response to an I/O logical layer request\n\n");
	}

}



Logical_Transport_Layer_Device_ID_Capture_CSR()
{
	unsigned int source_dev_id,dest_dev_id,reg_field_1,reg_field_2;
	
	GEL_TextOut(" ********************************** Logical/Transport Layer Device ID Capture CSR (ID_CAPT) ******************************************************\n\n");
	
	source_dev_id=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ID_CAPT),15,0);
	
	dest_dev_id=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ID_CAPT),31,16);
	
	
	reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),31,0);
	
	reg_field_2=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_DET),31,0);
	
	if(reg_field_1 == 0 && reg_field_2 == 0)
	{
		GEL_TextOut(" No occurence of logical layer errors or logical layer error capture disabled\n\n");
	}
	else
	{                       
		GEL_TextOut(" Logical layer Error occurred in transaction from %x ---> %x \n\n",,,,,(unsigned short)source_dev_id,(unsigned short)dest_dev_id);
	}
}



Logical_Transport_Layer_Control_Capture_CSR()
{
	unsigned int ftype,ttype;
	
	GEL_TextOut(" ********************************** Logical/Transport Layer Control Capture CSR (CTRL_CAPT) ******************************************************\n\n");
	
	                       
    GEL_TextOut(" IMP_SPECIFIC  ---> %x \n",,,,,(unsigned short)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),15,0));
	
	                       
    GEL_TextOut(" MSGINFO       ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),23,16));
	
	ttype=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),27,24);
	
	ftype=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_CTRL_CAPT),31,28);
	
	if(ftype == 0x2 && ttype == 0x4)
	{
		GEL_TextOut(" PKT_TYPE      ---> NREAD packet\n\n");
	}
	else if(ftype == 0x2 && ttype == 0xC)
	{
		GEL_TextOut(" PKT_TYPE      ---> Atomic increment packet\n\n");
	}
	else if(ftype == 0x2 && ttype == 0xD)
	{
		GEL_TextOut(" PKT_TYPE      ---> Atomic decrement packet\n\n");
	}
	else if(ftype == 0x2 && ttype == 0xE)
	{
		GEL_TextOut(" PKT_TYPE      ---> Atomic set packet\n\n");
	}
	else if(ftype == 0x2 && ttype == 0xF)
	{
		GEL_TextOut(" PKT_TYPE      ---> Atomic clear packet\n\n");
	}
	else if(ftype == 0x5 && ttype == 0x4)
	{
		GEL_TextOut(" PKT_TYPE      ---> NWRITE packet\n\n");
	}
	else if(ftype == 0x5 && ttype == 0x5)
	{
		GEL_TextOut(" PKT_TYPE      ---> NWRITE_R packet\n\n");
	}
	else if(ftype == 0x5 && ttype == 0xE)
	{
		GEL_TextOut(" PKT_TYPE      ---> Atomic test and swap packet\n\n");
	}
	else if(ftype == 0x6)
	{
		GEL_TextOut(" PKT_TYPE      ---> Streaming write packet\n\n");
	}
	else if(ftype == 0x7)
	{
		GEL_TextOut(" PKT_TYPE      ---> Congestion Control packet\n\n");
	}
	else if(ftype == 0x8 && ttype == 0x0)
	{
		GEL_TextOut(" PKT_TYPE      ---> Maintenance read packet\n\n");
	}
	else if(ftype == 0x8 && ttype == 0x1)
	{
		GEL_TextOut(" PKT_TYPE      ---> Maintenance write packet\n\n");
	}
	else if(ftype == 0x8 && ttype == 0x2)
	{
		GEL_TextOut(" PKT_TYPE      ---> Maintenance read response packet\n\n");
	}
	else if(ftype == 0x8 && ttype == 0x3)
	{
		GEL_TextOut(" PKT_TYPE      ---> Maintenance write response packet\n\n");
	}
	else if(ftype == 0x8 && ttype == 0x4)
	{
		GEL_TextOut(" PKT_TYPE      ---> Maintenance port-write packet\n\n");
	}
	else if(ftype == 0xD && ttype == 0x0)
	{
		GEL_TextOut(" PKT_TYPE      ---> Response(+Doorbell Resp) packet\n\n");
	}
	else if(ftype == 0xD && ttype == 0x1)
	{
		GEL_TextOut(" PKT_TYPE      ---> Message Response packet\n\n");
	}
	else if(ftype == 0xD && ttype == 0x8)
	{
		GEL_TextOut(" PKT_TYPE      ---> Response w/payload packet\n\n");
	}
	else if(ftype == 0x9)
	{
		GEL_TextOut(" PKT_TYPE      ---> Data streaming packet\n\n");
	}
	else if(ftype == 0xA)
	{
		GEL_TextOut(" PKT_TYPE      ---> Doorbell packet\n\n");
	}
	else if(ftype == 0xB)
	{
		GEL_TextOut(" PKT_TYPE      ---> Message packet\n\n");
	}
	else
	{
		GEL_TextOut(" PKT_TYPE      ---> Not a valid packet type\n\n");
	}
}



