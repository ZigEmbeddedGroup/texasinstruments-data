Source_Operations()
{
	
	GEL_TextOut(" ********************************** Source Operations CAR (SRC_OP) ******************************************************\n");


	
	GEL_TextOut(" IMPLMNT_DEFINED_1[1:0]   ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_SRC_OP),1,0));

	
