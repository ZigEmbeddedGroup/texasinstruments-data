menuitem "SRIO Logical_Transport Layer Configuration";

Processing_Element_Logical_Layer_Control_CSR()
{
	unsigned int reg_field;

	GEL_TextOut(" ********************************** Processing Element Logical Layer Control CSR (PE_LL_CTL) ******************************************************\n\n");

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PE_LL_CTL),2,0);
	
	if(reg_field == 1)
	{
		GEL_TextOut(" EXTENDED_ADDRESSING_CONTROL[8] => PE supports 34 bit addresses\n\n");
	}
	else if(reg_field == 2)
	{
		GEL_TextOut(" EXTENDED_ADDRESSING_CONTROL[8] => PE supports 50 bit addresses\n\n");
	}
	else if(reg_field == 4)
	{
		GEL_TextOut(" EXTENDED_ADDRESSING_CONTROL[8] => PE supports 66 bit addresses\n\n");
	}
	else
	{
		GEL_TextOut(" EXTENDED_ADDRESSING_CONTROL[8] => Reserved\n\n");
	}
}


Logical_Transport_Layer_Error_Enable_CSR()
{
	unsigned int reg_field;


	GEL_TextOut(" ********************************** Logical/Transport Layer Error Enable CSR (ERR_EN) ******************************************************\n\n");

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),6,6);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RX_IO_SECURITY_ENABLE[6]     =>  **DISABLE**  reporting of attempt at unauthorized access to a memory location.\n");
	}
	else
	{
		GEL_TextOut(" RX_IO_SECURITY_ENABLE[6]     =>  ##ENABLE##  reporting of attempt at unauthorized access to a memory location\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),7,7);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" RX_CPPI_SECURITY_ENABLE[7]   =>  **DISABLE**  reporting of an attempt at unauthorized access to a RX queue\n");
	}
	else
	{
		GEL_TextOut(" RX_CPPI_SECURITY_ENABLE[7]   =>  ##ENABLE##  reporting of attempt at unauthorized access to a RX queue\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),22,22);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" UNSUPPORTED_TRANS_ENABLE[22] =>  **DISABLE**  reporting of an unsupported transaction error\n");
	}
	else
	{
		GEL_TextOut(" UNSUPPORTED_TRANS_ENABLE[22] =>  ##ENABLE##  reporting of an unsupported transaction error (switch or endpoint device)\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),23,23);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" UNSOLICITED_RESP_ENABLE[23]  =>  **DISABLE**  reporting of an unsolicited response error\n");
	}
	else
	{
		GEL_TextOut(" UNSOLICITED_RESP_ENABLE[23]  =>  ##ENABLE##  reporting of an unsolicited response error (switch or endpoint device)\n");
	}
	

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),24,24);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" PKT_RESP_TIMEOUT_ENABLE[24]  =>  **DISABLE**  reporting of a packet response time-out error\n");
	}
	else
	{
		GEL_TextOut(" PKT_RESP_TIMEOUT_ENABLE[24]  =>  ##ENABLE##  reporting of a packet response time-out error (endpoint device only)\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),25,25);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" MSG_REQ_TIMEOUT_ENABLE[25]   =>  **DISABLE**  reporting of a message request time-out error\n");
	}
	else
	{
		GEL_TextOut(" MSG_REQ_TIMEOUT_ENABLE[25]   =>  ##ENABLE##  reporting of a message request time-out error (endpoint device only)\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),27,27);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" ILL_TRANS_DECODE_ENABLE[27]  =>  **DISABLE**  reporting of an illegal transaction decode error\n");
	}
	else
	{
		GEL_TextOut(" ILL_TRANS_DECODE_ENABLE[27]  =>  ##ENABLE##  reporting of an illegal transaction decode error (switch or endpoint device)\n");
	}


	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),28,28);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" ERR_MSG_FORMAT_ENABLE[28]    =>  **DISABLE**  reporting of a message format error\n");
	}
	else
	{
		GEL_TextOut(" ERR_MSG_FORMAT_ENABLE[28]    =>  ##ENABLE##  reporting of a message format error (endpoint device only)\n");
	}

	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),30,30);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" MSG_ERR_RESP_ENABLE[30]      =>  **DISABLE**  reporting of a message error response\n");
	}
	else
	{
		GEL_TextOut(" MSG_ERR_RESP_ENABLE[30]      =>  ##ENABLE##  reporting of a message error response (endpoint device only)\n");
	}

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_ERR_EN),31,31);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" IO_ERR_RESP_ENABLE[31]       =>  **DISABLE**  reporting of an IO error response\n\n");
	}
	else
	{
		GEL_TextOut(" IO_ERR_RESP_ENABLE[31]       =>  ##ENABLE##  reporting of an IO error response (endpoint device only)\n\n");
	}

}

