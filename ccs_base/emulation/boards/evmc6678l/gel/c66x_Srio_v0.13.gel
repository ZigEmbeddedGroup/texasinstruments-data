	i=port_no;

	GEL_TextOut(" ******************* Port%d Fabric Status Register (SP%d_FABRIC_STATUS) ******************* \n\n",,,,,i,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_FABRIC_STATUS+(i*0x4))),19,16);
	
	GEL_TextOut(" IG_UC_BACKPRESSURE  => %x  \n",,,,,(unsigned char)reg_field);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_FABRIC_STATUS+(i*0x4))),23,20);
	
	GEL_TextOut(" IG_LLM_BACKPRESSURE => %x  \n\n",,,,,(unsigned char)reg_field);
	
}



