		PBM_Port_Ingress_Watermarks_0_Register(i);

		PBM_Port_Ingress_Watermarks_1_Register(i);

		PBM_Port_Ingress_Watermarks_2_Register(i);

		PBM_Port_Ingress_Watermarks_3_Register(i);
	}
}


PBM_Port_Status_Register(unsigned int port_no)
{
	unsigned int reg_field,i;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PBM Port Status Register (PBM_SP%d_STATUS) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event is  ##NOT DETECTED##  \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BABBLE_PACKET => Babble pkt event is  **DETECTED**  \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event is  ##NOT DETECTED##  \n");
	}
	else
	{
		
		GEL_TextOut(" EG_BAD_CHANNEL   => Bad channel event is  **DETECTED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),3,3);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event is  ##NOT DETECTED##  \n");
	}
	else
	{
		
		GEL_TextOut(" EG_CRQ_OVERFLOW  => CRQ overflow event is  **DETECTED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),4,4);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event is  ##NOT DETECTED##  \n");
	}
	else
	{
		
		GEL_TextOut(" EG_DATA_OVERFLOW => Data overflow event is  **DETECTED**  \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),15,15);
	
	if(reg_field==0)
	{
		GEL_TextOut(" EG_EMPTY         => The PBMe  ##HAS##  some pkts enqueued\n");
	}
	else
	{
		
		GEL_TextOut(" EG_EMPTY         => The PBMe  **HAS NO**  pkts enqueued\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PBM_SP0_STATUS+(i*0x80))),15,15);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IG_EMPTY         => The PBMi  ##HAS##  some pkts enqueued\n\n");
	}
	else
	{
		
		GEL_TextOut(" IG_EMPTY         => The PBMi  **HAS NO**  pkts enqueued\n\n");
	}
}


