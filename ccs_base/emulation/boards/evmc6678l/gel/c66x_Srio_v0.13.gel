{
	unsigned int i;
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** PORT PLM CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");
	
	for(i=0;i<SRIO_NO_OF_PORTS;i++)
	{
		GEL_TextOut(" ******************* PORT%d PLM CONFIGURATION ******************* \n\n",,,,,i);
		
		PLM_Port_Implementation_Specific_Control_Register(i);

		PLM_Port_Interrupt_Enable_Register(i);

		PLM_Port_Port_Write_Enable_Register(i);

		PLM_Port_Event_Generate_Register(i);

		PLM_Port_All_Interrupts_Enable_Register(i);

		PLM_Port_All_Port_Writes_Enable_Register(i);

		PLM_Port_Path_Control_Register(i);

		PLM_Port_Discovery_Timer_Register(i);

		PLM_Port_Silence_Timer(i);

		PLM_Port_Vmin_Exponent_Register(i);

		PLM_Port_Lane_Polarity_Control_Register(i);

		PLM_Port_Packet_Denial_Control_Register(i);

		PLM_Port_MECS_Forwarding_Register(i);
	}
}


PLM_Port_Power_Down_Control_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;

	GEL_TextOut(" ******************* PLM Port Power Down Control Register (PLM_SP%d_PWDN_CTL) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_RIO_PLM_SP0_PWDN_CTL+(i*0x80))),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" Port%d is in  ##NORMAL##  mode \n\n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" Port%d is in  **POWER DOWN**  mode \n\n",,,,,i);
	}
}

PLM_Port_Event_Status_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;

	GEL_TextOut(" ******************* PLM Port Event Status Register(PLM_SP%d_Status) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),10,10);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TLM_INT     => Port%d TLM has  ##NOT DETECTED##  an event, which requires interrupt notification. \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" TLM_INT     => Port%d TLM has  **DETECTED**  an event, which requires interrupt notification. \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),11,11);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PBM_INT     => Port%d PBM has  ##NOT DETECTED##  an event, which requires interrupt notification. \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" PBM_INT     => Port%d PBM has  **DETECTED**  an event, which requires interrupt notification. \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),12,12);
	
	if(reg_field==0)
	{
		GEL_TextOut(" MECS        => Port%d has  ##NOT RECEIVED##  a Multi-cast Event Control Symbol \n",,,,,i);
	}
	else
	{
		
		GGEL_TextOut(" MECS       => Port%d has  **RECEIVED**  a Multi-cast Event Control Symbol \n",,,,,i);
	}

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),14,14);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TLM_PW      => Port%d TLM has  ##NOT DETECTED##  an event, which requires Port-Write notification \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" TLM_PW      => Port%d TLM has  **DETECTED**  an event, which requires Port-Write notification \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),15,15);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PBM_PW      => Port%d PBM has  ##NOT DETECTED##  an event, which requires Port-Write notification \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" PBM_PW      => Port%d PBM has  **DETECTED**  an event, which requires Port-Write notification \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),16,16);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RST_REQ     => Port%d has  ##NOT RECEIVED## a reset request command \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" RST_REQ     => Port%d has  **RECEIVED** a reset request command \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),24,24);
	
	if(reg_field==0)
	{
		GEL_TextOut(" OUTPUT_DEGR => Port%d is  ##NOT##  in output degraded condition  \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" OUTPUT_DEGR => Port%d is  **IN** output degraded condition  \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),25,25);
	
	if(reg_field==0)
	{
		GEL_TextOut(" OUTPUT_FAIL => Port%d is  ##NOT##  in output failed condition  \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" OUTPUT_FAIL => Port%d is  **IN** output failed condition  \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),26,26);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PORT_ERR    => Port%d has  ##NOT ENCOUNTERED##  a unrecoverable HW error  \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" PORT_ERR    => Port%d has  **ENCOUNTERED**  a unrecoverable HW error  \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),27,27);
	
	if(reg_field==0)
	{
		GEL_TextOut(" DLT         => Port%d has  ##NOT DETECTED##  that its link partner has been removed  \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" DLT         => Port%d has  **DETECTED**  that its link partner has been removed  \n",,,,,i);
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LINK_INIT   => Port%d Link Initialization  **UNSUCCESSFUL**   \n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" LINK_INIT   => Port%d Link Initialization  ##SUCCESSFUL##   \n",,,,,i);
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_STATUS+(i*0x80))),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" MAX_DENIAL  => Port%d has  ##NOT EXCEEDED##  the denial threshold  \n\n",,,,,i);
	}
	else
	{
		
		GEL_TextOut(" MAX_DENIAL  => Port%d has  **EXCEEDED**  the denial threshold  \n\n",,,,,i);
	}
}

PLM_Port_Received_MECS_Status_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;

	GEL_TextOut(" ******************* PLM Port Received  MECS Status Register(PLM_SP%d_RCVD_MECS) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_RCVD_MECS+(i*0x80))),7,0);
	
	
	if((reg_field & 0x00000001) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=0 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=0 \n",,,,,i);
	}
	
	if((reg_field & 0x00000002) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=1 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=1 \n",,,,,i);
	}
	
	if((reg_field & 0x00000004) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=2 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=2 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000008) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=3 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=3 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000010) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=4 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=4 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000020) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=5 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=5 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000040) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=6 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=6 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000080) != 0)
	{
		GEL_TextOut(" Port%d  ##RECEIVED##  MECS with cmd=7 \n\n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DID NOT RECEIVE##  MECS with cmd=7 \n\n",,,,,i);
	}
	
}


