menuitem "SRIO Errors Scan";


phy_layer_error_scan_func(unsigned int port_no)
{
	unsigned int port_uninitialized, port_ok,i;
	unsigned int path_configuration, path_mode, port_widht_initialized, port_widht_bit0, port_widht_bit1, override_portwidht;
	unsigned int cnt_rty, cnt_pna, denial_thresh;
	unsigned int reg_field,reg_field_1,reg_field_2;
	unsigned int error_flag=0;
	unsigned int err_reasons_flag=0;
	
	i=port_no;
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut("\n********************************** SRIO PORT%d ERROR SCAN RESULTS ************************************* \n",,,,,i);
	GEL_TextOut("\n*******************************************************************************************************\n\n");
	

	port_uninitialized=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),0,0);
	
	port_ok=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),1,1);
	
	// check for port initialization
	if((port_uninitialized==1) || (port_ok==0))
	{
		GEL_TextOut(" Problem(PORT_UNINITIALIZED): Port%d is not Intialized. \n",,,,,i);
		
		GEL_TextOut(" Reason & Solution: The immediate SRIO peer connected to this DSP might be in Reset or its port is not configured\n\n");
		
		error_flag=1;
	}
		
	// check port configuration and widht
	
	path_configuration=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),10,8);
	
	path_mode=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),2,0);
	
	port_widht_bit0=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),31,31);
	
	port_widht_bit1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),30,30);
	
	port_widht_initialized=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),29,27);
	
	if(path_configuration == 4)  //path configuration 4
	{
		// all path modes are supported
		
		if(path_mode == 0) // Mode 0
		{
			if(port_widht_bit0 != 0 || port_widht_bit1 != 0)
			{
				GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
								  
				GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
				
				error_flag=1;
			}
			
			if(port_uninitialized != 1)
			{
				if(port_widht_initialized == 2 || port_widht_initialized == 3)
				{
					GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT SINGLE-LANE**   \n",,,,,i);
					
					GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
			
					error_flag=1;
				}
			}
		}
		
		if(path_mode == 1) // Mode 1
		{
			if(port_widht_bit1 != 0)
			{
				GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
								  
				GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
				
				error_flag=1;
			}
			
			if(port_uninitialized != 1)
			{
				if(i == 0 || i == 1)
				{
				
					if(port_widht_initialized == 2 || port_widht_initialized == 0 || port_widht_initialized == 1)
					{
						GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT TWO-LANE**   \n",,,,,i);
						
						GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
				
						error_flag=1;
					}
				}
				
				if(i == 2 || i == 3)
				{
				
					if(port_widht_initialized == 2 || port_widht_initialized == 3)
					{
						GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT SINGLE-LANE**   \n",,,,,i);
						
						GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
				
						error_flag=1;
					}
				}
			}
		}
		
		if(path_mode == 2) // Mode 2
		{
			if(port_widht_bit1 != 0)
			{
				GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
								  
				GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
				
				error_flag=1;
			}
			
			if(port_uninitialized != 1)
			{
				if(i == 0 || i == 1)
				{
				
					if(port_widht_initialized == 2 || port_widht_initialized == 3)
					{
						GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT SINGLE-LANE**   \n",,,,,i);
						
						GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
				
						error_flag=1;
					}
				}
				
				if(i == 2 || i == 3)
				{
				
					if(port_widht_initialized == 2 || port_widht_initialized == 0 || port_widht_initialized == 1)
					{
						GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT TWO-LANE**   \n",,,,,i);
						
						GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
				
						error_flag=1;
					}
				}
			}
		}
		
		if(path_mode == 3) // Mode 3
		{
			if(port_widht_bit1 != 0)
			{
				GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
								  
				GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
				
				error_flag=1;
			}
			
			if(port_uninitialized != 1)
			{
				if(port_widht_initialized == 2 || port_widht_initialized == 0 || port_widht_initialized == 1)
				{
					GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT TWO-LANE**   \n",,,,,i);
					
					GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
			
					error_flag=1;
				}
			}
		}
		
		if(path_mode == 4) // Mode 4
		{
			if(port_widht_bit0 != 0)
			{
				GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
								  
				GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
				
				error_flag=1;
			}
			
			if(port_uninitialized != 1)
			{
				if(port_widht_initialized == 0 || port_widht_initialized == 1 || port_widht_initialized == 3)
				{
					GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT FOUR-LANE**   \n",,,,,i);
					
					GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
			
					error_flag=1;
				}
			}
		}
	}
	
	
	if(path_configuration == 2)  //path configuration 2
	{
		// only Mode0 and Mode1 are available
		
		if(i == 0 || i == 1) //only port0 and port1 are operational
		{
		
			if(path_mode > 1)
			{
				GEL_TextOut(" Problem(PATH_MODE): Port%d PLM path mode settings are  **ILLEGAL**  and not allowed \n",,,,,i);
				
				GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings.\n\n");
				
				error_flag=1;
			}
			else
			{
				if(path_mode == 0) // Mode 0
				{
					if(port_widht_bit0 != 0 || port_widht_bit1 != 0)
					{
						GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
										  
						GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
						
						error_flag=1;
					}
					
					if(port_uninitialized != 1)
					{
						if(port_widht_initialized == 2 || port_widht_initialized == 3)
						{
							GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT SINGLE-LANE**   \n",,,,,i);
							
							GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
					
							error_flag=1;
						}
					}
				}
				
				if(path_mode == 1) // Mode 1
				{
					if(port_widht_bit1 != 0)
					{
						GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
										  
						GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
						
						error_flag=1;
					}
					
					if(port_uninitialized != 1)
					{
						if(port_widht_initialized == 2 || port_widht_initialized == 0 || port_widht_initialized == 1)
						{
							GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT TWO-LANE**   \n",,,,,i);
							
							GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
					
							error_flag=1;
						}
					}
				}
			}
		}
	}
	
	
	if(path_configuration == 1)  //path configuration 1
	{
		// only Mode0 is available
		
		if(i == 0) //only port0 is operational
		{
		
			if(path_mode > 0)
			{
				GEL_TextOut(" Problem(PATH_MODE): Port%d PLM path mode settings are  **ILLEGAL**  and not allowed \n",,,,,i);
				
				GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings.\n\n");
				
				error_flag=1;
			}
			else
			{
				if(path_mode == 0) // Mode 0
				{
					if(port_widht_bit0 != 0 || port_widht_bit1 != 0)
					{
						GEL_TextOut(" Problem(PORT_WIDTH): Port%d widht  **DOES NOT MATCH**  with PLM path configurations \n",,,,,i);
										  
						GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings. The current PLM path settings might not be legal\n\n");
						
						error_flag=1;
					}
					
					if(port_uninitialized != 1)
					{
						if(port_widht_initialized == 2 || port_widht_initialized == 3)
						{
							GEL_TextOut(" Problem(INITIALIZED_PORT_WIDTH): Port%d initialized port widht  **IS NOT SINGLE-LANE**   \n",,,,,i);
							
							GEL_TextOut(" Reason & Solution: Check PLM path configuartion settings\n\n");
					
							error_flag=1;
						}
					}
				}
			}
		}
	}
	
	
	// Check for port widht override settings
	
	override_portwidht=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),26,24);
	
	if(path_configuration == 4)  //path configuration 4
	{
		// all path modes are supported
		
		if(path_mode == 0) // Mode 0
		{
			if(override_portwidht != 0 && override_portwidht != 2)
			{
				GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
				
				error_flag=1;
			}
			
		}
		
		if(path_mode == 1) // Mode 1
		{
			if(i == 0 || i == 1)
			{
				if(override_portwidht != 0 && override_portwidht != 2 && override_portwidht != 3 && override_portwidht != 5)
				{
					GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
					
					error_flag=1;
				}
			}
			
			if(i == 2 || i == 3)
			{
				if(override_portwidht != 0 && override_portwidht != 2)
				{
					GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
					
					error_flag=1;
				}
			}
		}
		
		if(path_mode == 2) // Mode 2
		{
			if(i == 0 || i == 1)
			{
				if(override_portwidht != 0 && override_portwidht != 2)
				{
					GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
					
					error_flag=1;
				}
			}
			
			if(i == 2 || i == 3)
			{
				if(override_portwidht != 0 && override_portwidht != 2 && override_portwidht != 3 && override_portwidht != 5)
				{
					GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
					
					error_flag=1;
				}
			}
		}
		
		if(path_mode == 3) // Mode 3
		{
			if(override_portwidht != 0 && override_portwidht != 2 && override_portwidht != 3 && override_portwidht != 5)
			{
				GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
				
				error_flag=1;
			}
		}
		
		if(path_mode == 4) // Mode 4
		{
			if(override_portwidht != 0 && override_portwidht != 2 && override_portwidht != 3 && override_portwidht != 5 && override_portwidht != 6 && override_portwidht != 7)
			{
				GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
				
				error_flag=1;
			}
		}
	}
	
	
	if(path_configuration == 2)  //path configuration 2
	{
		// only Mode0 and Mode1 are available
		
		if(i == 0 || i == 1) //only port0 and port1 are operational
		{
			if(path_mode == 0) // Mode 0
			{
				if(override_portwidht != 0 && override_portwidht != 2)
				{
					GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
					
					error_flag=1;
				}
			}
			
			if(path_mode == 1) // Mode 1
			{
				if(override_portwidht != 0 && override_portwidht != 2 && override_portwidht != 3 && override_portwidht != 5)
				{
					GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
					
					error_flag=1;
				}
			}
		}
	}
	
	
	if(path_configuration == 1)  //path configuration 1
	{
		// only Mode0 is available
		
		if(i == 0) //only port0 is operational
		{
		
			if(path_mode == 0) // Mode 0
			{
				if(override_portwidht != 0 && override_portwidht != 2)
				{
					GEL_TextOut(" Problem(OVER_PWIDTH): Port%d widht override settings  **ILLEGAL**  and not allowed \n\n",,,,,i);
					
					error_flag=1;
				}
			}
		}
	}
	
	
	
	//check port error status
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),2,2);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(PORT_ERROR): Port%d input or output has encountered an error from which hardware was unable to recover.",,,,,i);
		GEL_TextOut(" (To clear this bit SW should write 1 to it)");
		GEL_TextOut(" Reason & Solution: This port has received 4 trails of 'Non-outstanding ackid from link response' control symbols, ");
		GEL_TextOut("                    and its not able to recover and the link times out.Some errors which might be the cause of");
		GEL_TextOut("                    this problem are: \n\n"); 
		
		error_flag=1;
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),5,5);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),5,5);

			if(reg_field != 0)
			{
				GEL_TextOut("                    NON_OUTSTANDING_ACKID: The port%d received a link response with an ackID that is not outstanding. \n\n",,,,,i);
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 5)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
						}
						else if(reg_field == 2)
						{
							GEL_TextOut(" INFO_TYPE => Implementation specific\n");
						}
						else
						{
							GEL_TextOut(" INFO_TYPE => Reserved\n");
						}
						
						GEL_TextOut(" CAPTURE0 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
		if(err_reasons_flag==0)
		{
			GEL_TextOut("                    No errors are captured. Please, enable the required errors detection in SP%d_ERR_EN Register \n\n",,,,,i);
		}
		else
		{
			err_reasons_flag==0;
		}
		
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),18,18);
	
	reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),19,19);
	
	reg_field_2=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),20,20);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(OUTPUT_RETRY_STP): The output port%d  is in the 'output retry-stopped' state. \n",,,,,i);
		GEL_TextOut(" Reason & Solution: The output port has received a packet-retry control symbol from its peer. \n\n");
		
		error_flag=1;
	}
	
	if(reg_field_1!=0)
	{
		GEL_TextOut(" Problem(OUTPUT_RETRIED): The output port%d has retried a pkt and cannot make forward progress.\n",,,,,i);
		GEL_TextOut(" Reason & Solution: The output port has received a packet-retry control symbol from its peer.  \n");
		GEL_TextOut("                    and it has retried the requested pkt and cannot make forward progress as it    \n");
		GEL_TextOut("                    is waiting for pkt-accepted or pkt-not-accepted control symbol from its peer. \n\n");
		
		error_flag=1;
	}
	
	
	if(reg_field_2!=0 && reg_field_1==0 && reg_field==0)
	{
		GEL_TextOut(" Problem(OUTPUT_RETRY_ENC): The output port%d has encountered a retry condition \n",,,,,i);
		GEL_TextOut(" Reason & Solution: Sometime back, this port has retried a pkt and was successful in doing so, by receiving a    \n");
		GEL_TextOut("                    pkt-accepted control symbol from its peer. \n\n");
		
		error_flag=1;
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),31,31);
		
	if(reg_field != 0)
	{
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),31,31);

		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),2,2);

			if(reg_field != 0)
			{
			
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),26,26);
				
				if(reg_field != 0)
				{
					GEL_TextOut(" Problem(OUTPUT_PKT_DROP): The input port%d has dropped a packet(output side of the ingress buffer) \n",,,,,i);
					GEL_TextOut(" Reason & Solution: For ingress traffic, there is congestion at the UDI which prevents a\n");
					GEL_TextOut("                    packet from being passed from the RX physical layer to the logical UDI layer\n");
					GEL_TextOut("                    within 215 SRIO_CLK cycles. No ingress or egress pakts are dropped under this\n");
					GEL_TextOut("                    scenario. \n\n");
					
					error_flag=1;
				}
			}
		}
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),3,3);
		
	if(reg_field != 0)
	{
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),25,25);

		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_CTL+(i*0x20))),2,2);

			if(reg_field != 0)
			{
			
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),26,26);
				
				if(reg_field != 0)
				{
					GEL_TextOut(" Problem(OUTPUT_PKT_DROP): The output port%d has dropped a packet(egress output pkts from UDI) \n",,,,,i);
					GEL_TextOut(" Reason & Solution: Here the port discards egress output pkts (i.e from UDI to physical layer) whenever the \n");
					GEL_TextOut("                    error counter reaches the failed error threshold and the output failed condition is reached.\n");
					GEL_TextOut("                    Therefore, here pkt is dropped at the output port. \n\n");
					
					error_flag=1;
				}
			}
		}
	}
	
	
	
	reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),8,8);
	
	reg_field_2=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),9,9);
	
	if(reg_field_1!=0 || reg_field_2!=0)
	{
		if(reg_field_1!=0)
		{
			GEL_TextOut(" Problem(INPUT_ERROR_STP): Packet dropped at input Port%d, as this port is in the 'input error-stopped' state \n",,,,,i);
			GEL_TextOut(" Reason & Solution: Here this port receives a bad packet from its peer and it enters input error stopped state, and  \n");
			GEL_TextOut("                    waits for getting the 'restart from error control symbol' from its peer. Until then, it discards   \n");
			GEL_TextOut("                    all the packets received at the input port.Some errors which might be the cause of \n");
			GEL_TextOut("                    this problem are: \n\n");
			
			error_flag=1;
		}
		
		if(reg_field_1==0 && reg_field_2!=0)
		{
			GEL_TextOut(" Problem(INPUT_ERROR_ENC): The input Port%d has encountered (and possibly recovered from) \n",,,,,i);
			GEL_TextOut("                           a transmission error (To clear this bit SW should write 1 to it) \n");
			GEL_TextOut(" Reason & Solution: Sometime back, this port had received a bad packet from its peer and had entered   \n");
			GEL_TextOut("                    input error stopped state, and had waited for getting the 'restart from error control symbol'     \n");
			GEL_TextOut("                    from its peer. This bit is still set, even after possibly recovering from this error \n");
			GEL_TextOut("                    (i.e. after receiving 'restart from error control symbol' from the peer).Some errors which \n");
			GEL_TextOut("                    might be the cause of this problem are: \n\n");
			
			error_flag=1;
		
		}
		
		//check for pkt errors
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),18,18);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),18,18);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_WITH_BAD_CRC: The Port%d received a packet with a bad CRC value \n\n",,,,,i);
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 18)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
						}
						else if(reg_field == 2)
						{
							GEL_TextOut(" INFO_TYPE => Implementation specific\n");
						}
						else
						{
							GEL_TextOut(" INFO_TYPE => Reserved\n");
						}
						
						GEL_TextOut(" CAPTURE0 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),17,17);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),17,17);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_OVER_276B: The port%d received packet that exceeds the maximum allowed size \n\n",,,,,i);
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 17)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
						}
						else if(reg_field == 2)
						{
							GEL_TextOut(" INFO_TYPE => Implementation specific\n");
						}
						else
						{
							GEL_TextOut(" INFO_TYPE => Reserved\n");
						}
						
						GEL_TextOut(" CAPTURE0 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),22,22);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),22,22);

			if(reg_field != 0)
			{
				GEL_TextOut("                    CORRUPT_CNTL_SYM: The port%d received a control symbol with a bad CRC value \n\n",,,,,i);
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 22)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
						}
						else if(reg_field == 2)
						{
							GEL_TextOut(" INFO_TYPE => Implementation specific\n");
						}
						else
						{
							GEL_TextOut(" INFO_TYPE => Reserved\n");
						}
						
						GEL_TextOut(" CAPTURE0 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),19,19);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),19,19);

			if(reg_field != 0)
			{
				GEL_TextOut("                    PKT_UNEXPECTED_ACKID: The port%d received a packet with unexpected/out-of-sequence ackID \n\n",,,,,i);
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 19)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
						}
						else if(reg_field == 2)
						{
							GEL_TextOut(" INFO_TYPE => Implementation specific\n");
						}
						else
						{
							GEL_TextOut(" INFO_TYPE => Reserved\n");
						}
						
						GEL_TextOut(" CAPTURE0 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),2,2);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),2,2);

			if(reg_field != 0)
			{
				GEL_TextOut("                    DELINEATION_ERROR: 1) The port%d detected a delineation error. The port received an unaligned /SC/ or /PD/ or undefined code-group \n",,,,,i);
				
				GEL_TextOut("                                       2) The port detected an illegal character\n");
				GEL_TextOut("                                       3) A character which is not a part of IDLE1 sequence has occured after link initialization\n");
				GEL_TextOut("                                       4) A character which is not a part of IDLE2 sequence has occured after link initialization\n\n");
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 2)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
						}
						else if(reg_field == 2)
						{
							GEL_TextOut(" INFO_TYPE => Implementation specific\n");
						}
						else
						{
							GEL_TextOut(" INFO_TYPE => Reserved\n");
						}
						
						GEL_TextOut(" CAPTURE0 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
		if(err_reasons_flag==0)
		{
			GEL_TextOut("                    No errors are captured. Please, enable the required errors detection in SP%d_ERR_EN Register \n\n",,,,,i);
		}
		else
		{
			err_reasons_flag==0;
		}
		
		
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),10,10);
	
	if(reg_field!=0)
	{
		GEL_TextOut(" Problem(INPUT_RETRY_STP): The input port%d drops all input packets, and is in the 'input retry-stopped' state. \n",,,,,i);
		GEL_TextOut(" Reason & Solution: This port has sent a pkt retry control symbol (because of internal phy buffers problem), \n");
		GEL_TextOut("                    and is waiting to get a 'restart from retry control symbol' from the peer. Untilthen,   \n");
		GEL_TextOut("                    this port discards all the input packets it receives.  \n\n");
		
		error_flag=1;
	}
	
	
	reg_field_1=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),16,16);
	
	reg_field_2=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_STAT+(i*0x20))),17,17);

	if(reg_field_1!=0 || reg_field_2!=0)
	{
		if(reg_field_1!=0)
		{
			GEL_TextOut(" Problem(OUTPUT_ERROR_STP): The output Port%d drops all pkts which it has to send, and is in the 'output error-stopped' state \n",,,,,i);
			GEL_TextOut(" Reason & Solution: When the error counter exceeds the failed error threshold, the output failed condition is \n");
			GEL_TextOut("                    encountered and the port enters the output error stopped state. In this state, the output port  \n");
			GEL_TextOut("                    does not try to send any pkts and drops all the pkts it receives from UDI.Some errors which \n");
			GEL_TextOut("                    might be the cause of this problem are: \n\n");
			
			error_flag=1;
		}
		
		if(reg_field_1==0 && reg_field_2!=0)
		{
			GEL_TextOut(" Problem(OUTPUT_ERROR_ENC): The output Port%d has encountered (and possibly recovered from) \n",,,,,i);
			GEL_TextOut("                           a transmission error (To clear this bit SW should write 1 to it) \n");
			GEL_TextOut(" Reason & Solution: Sometime back, this port was in the output error stopped state. In this state, the  \n");
			GEL_TextOut("                    output port will not be able to send any pkts into the SRIO network. This bit is still set,  \n");
			GEL_TextOut("                    even after possibly recovering from this state. Some errors which might be the cause of \n");
			GEL_TextOut("                    this problem are: \n\n"); 
			
			error_flag=1;
		}
		
		//check for pkt errors
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),21,21);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),21,21);

			if(reg_field != 0)
			{
				GEL_TextOut("                    CNTL_SYM_UNEXPECTED_ACKID: The port%d received an acknowledge control symbol with an unexpected ackID (packet-accepted or packet-retry). \n\n",,,,,i);
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 19)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
						}
						else if(reg_field == 2)
						{
							GEL_TextOut(" INFO_TYPE => Implementation specific\n");
						}
						else
						{
							GEL_TextOut(" INFO_TYPE => Reserved\n");
						}
						
						GEL_TextOut(" CAPTURE0 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG1+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE1 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG2+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE2 ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG3+(i*0x20))),31,0));
						
						GEL_TextOut(" CAPTURE3 ---> %x \n\n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_CAPT_DBG4+(i*0x20))),31,0));
					}
				}
			}
		}
		
		
		reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_RATE_EN+(i*0x40))),20,20);
		
		if(reg_field != 0)
		{
			reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_DET+(i*0x40))),20,20);

			if(reg_field != 0)
			{
				GEL_TextOut("                    RCVD_PKT_NOT_ACCPT: The port%d received a packet-not-accepted acknowledge control symbol \n\n",,,,,i);
				
				err_reasons_flag=1;
				
				reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24);
				
				if(reg_field == 20)
				{
					reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),0,0);

					if(reg_field != 0)
					{
						GEL_TextOut(" Port%d error capture information:  \n\n",,,,,i);
						
						GEL_TextOut(" IMP_SPECIFIC ---> %x \n",,,,,SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),23,4));

						GEL_TextOut(" ERROR_TYPE ---> %x \n",,,,,(unsigned char)SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),28,24));
						
						reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_SP0_ERR_ATTR_CAPT_DBG0+(i*0x20))),31,30);
						
						if(reg_field == 0)
						{
							GEL_TextOut(" INFO_TYPE => Packet\n");
						}
						else if(reg_field == 1)
						{
							GEL_TextOut(" INFO_TYPE => Control symbol (only error capture register 0 is valid)\n");
