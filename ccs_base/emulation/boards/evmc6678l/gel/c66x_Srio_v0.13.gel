{

	unsigned int reg_field,reg_field_1;
	
	unsigned int i;
		
	i=port_no;

	GEL_TextOut(" ******************* TLM Port%d Port-Write Enable Register(TLM_SP%d_PW_ENABLE)  ******************* \n\n",,,,,i,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_PW_ENABLE+(i*0x80))),20,20);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IG_BRR_FILTER => IG_BRR_FILTER  ##DOES NOT##  contribute to the port's Port_write request \n");
	}
	else
	{
		
		GEL_TextOut(" IG_BRR_FILTER => IG_BRR_FILTER  **DOES**  contribute to the port's Port_write request \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_PW_ENABLE+(i*0x80))),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" IG_BAD_VC     => IG_BAD_VC  ##DOES NOT##  contribute to the port's Port_write request \n\n");
	}
	else
	{
		
		GEL_TextOut(" IG_BAD_VC     => IG_BAD_VC  **DOES**  contribute to the port's Port_write request \n\n");
	}
}

TLM_Port_Base_Routing_Register_0_Control_Register(unsigned int port_no)
{

	unsigned int reg_field,reg_field_1;
	
	unsigned int i;
	
	i=port_no;

	GEL_TextOut(" ******************* TLM Port Base Routing  Register 0 Control Register(TLM_SP%d_BRR_0_CTL) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_BRR_0_CTL+(i*0x80))),24,24);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PRIVATE         => used by all ports in the path (PUBLIC) \n");
	}
	else
	{
		
		GEL_TextOut(" PRIVATE         => used only by one port (PRIVATE) \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_BRR_0_CTL+(i*0x80))),26,26);
	
	if(reg_field==0)
	{
		GEL_TextOut(" ROUTE_MR_TO_LLM => maintenance request/reserved packets with DestID matching BRR are routed to the User-Core \n");
	}
	else
	{
		
		GEL_TextOut(" ROUTE_MR_TO_LLM => maintenance request/reserved packets with DestID matching BRR are routed to the LLM \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_BRR_0_CTL+(i*0x80))),31,31);
	
	if(reg_field==0)
	{
		GEL_TextOut(" ENABLE          => BRR's  ##NOT USED##  for accepting and routing inbound pkts \n\n");
	}
	else
	{
		
		GEL_TextOut(" ENABLE          => BRR's  **USED**  for accepting and routing inbound pkts \n\n");
	}
}


TLM_Port_Base_Routing_Register0_Pattern_Match_Register(unsigned int port_no)
{

	unsigned int reg_field,reg_field_1;
	
	unsigned int i;
	
	i=port_no;

	GEL_TextOut(" ******************* TLM Port Base Routing Register 0 Pattern & Match Register(TLM_SP%d_BRR_0_PATTERN_MATCH) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_BRR_0_PATTERN_MATCH+(i*0x80))),15,0);
	
	GEL_TextOut(" MATCH   => %x => Indicates which of the 16 bits are compared against the DestID \n",,,,,reg_field);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_TLM_SP0_BRR_0_PATTERN_MATCH+(i*0x80))),31,16);
	
