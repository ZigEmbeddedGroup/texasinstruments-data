PLM_Port_Path_Control_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PLM Port Path Control Register (PLM_SP%d_PATH_CTL) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),2,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PATH_MODE   => MODE0( 1x | 1x | 1x | 1x )\n");
	}
	else if(reg_field==1)
	{
		GEL_TextOut(" PATH_MODE   => MODE1( 1x | 1x |    2x    )\n");
	}
	else if(reg_field==2)
	{
		GEL_TextOut(" PATH_MODE   => MODE2(    2x    | 1x | 1x )\n");
	}
	else if(reg_field==3)
	{
		GEL_TextOut(" PATH_MODE   => MODE3(    2x    |    2x    )\n");
	}
	else if(reg_field==4)
	{
		GEL_TextOut(" PATH_MODE   => MODE4(          4x         )\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),10,8);
	
	if(reg_field==1)
	{
		GEL_TextOut(" PATH_CONFIG => 1 Lane, 1 Port\n");
	}
	else if(reg_field==2)
	{
		GEL_TextOut(" PATH_CONFIG => 2 Lanes, a maximum of 2 ports\n");
	}
	else if(reg_field==4)
	{
		GEL_TextOut(" PATH_CONFIG => 4 Lanes, a maximum of 4 ports\n");
	}
	else
	{
		GEL_TextOut(" PATH_CONFIG => Reserved\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_PATH_CTL+(i*0x80))),20,16);
	
	GEL_TextOut(" PATH_ID     => %d \n\n",,,,,reg_field);
}

PLM_Port_Discovery_Timer_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PLM Port Discovery Timer Register(PLM_SP%d_DISCOVERY_TIMER) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PRESCALAR_SRV_CLK),7,0);
	
	srv_clk_period=(1/SRIO_IP_CLK_MHZ)*reg_field;
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_DISCOVERY_TIMER+(i*0x80))),31,28);
	
	GEL_TextOut(" DISCOVERY_TIMER => %f us (default value = %f)) \n\n",,,,,(srv_clk_period*52429*reg_field),(srv_clk_period*52429*0x7));
}
	

PLM_Port_Silence_Timer(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;

	GEL_TextOut(" ******************* Port Silence Timer(PLM_SP%d_SILENCE_TIMER) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PRESCALAR_SRV_CLK),7,0);
	
	srv_clk_period=(1/SRIO_IP_CLK_MHZ)*reg_field;
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_SILENCE_TIMER+(i*0x80))),31,28);
	
	GEL_TextOut(" SILENCE_TIMER => %f us \n\n",,,,,(srv_clk_period*410*reg_field));
}

PLM_Port_Vmin_Exponent_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PLM Port Vmin Exponent Register (PLM_SP%d_VMIN_EXP) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_VMIN_EXP+(i*0x80))),11,8);
	
	GEL_TextOut(" MMAX     => %x is the max threshold for Mcounter (as per RapidIO 2.1 specs) \n",,,,,(unsigned char)reg_field);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_VMIN_EXP+(i*0x80))),19,16);
	
	GEL_TextOut(" IMAX     => %x is the max threshold for Icounter (as per RapidIO 2.1 specs) \n",,,,,(unsigned char)reg_field);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_VMIN_EXP+(i*0x80))),28,24);
	
	GEL_TextOut(" VMIN_EXP => %x is the No of /VALID/ code groups required for synchronization \n\n",,,,,(unsigned char)reg_field);
}

PLM_Port_Lane_Polarity_Control_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;

	GEL_TextOut(" ******************* PLM Port Lane Polarity Control Register(PLM_SP%d_POL_CTL)  ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RX0_POL => RX0 differential pair is  ##NOT SWAPPED## \n");
	}
	else
	{
		
		GEL_TextOut(" RX0_POL => RX0 differential pair is  **SWAPPED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RX1_POL => RX1 differential pair is  ##NOT SWAPPED## \n");
	}
	else
	{
		
		GEL_TextOut(" RX1_POL => RX1 differential pair is  **SWAPPED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),2,2);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RX2_POL => RX2 differential pair is  ##NOT SWAPPED## \n");
	}
	else
	{
		
		GEL_TextOut(" RX2_POL => RX2 differential pair is  **SWAPPED** \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),3,3);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RX3_POL => RX3 differential pair is  ##NOT SWAPPED## \n");
	}
	else
	{
		
		GEL_TextOut(" RX3_POL => RX3 differential pair is  **SWAPPED** \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),16,16);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TX0_POL => TX0 differential pair is  ##NOT SWAPPED## \n");
	}
	else
	{
		
		GEL_TextOut(" TX0_POL => TX0 differential pair is  **SWAPPED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),17,17);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TX1_POL => TX1 differential pair is  ##NOT SWAPPED## \n");
	}
	else
	{
		
		GEL_TextOut(" TX1_POL => TX1 differential pair is  **SWAPPED** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),18,18);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TX2_POL => TX2 differential pair is  ##NOT SWAPPED## \n");
	}
	else
	{
		
		GEL_TextOut(" TX2_POL => TX2 differential pair is  **SWAPPED** \n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_POL_CTL+(i*0x80))),19,19);
	
	if(reg_field==0)
	{
		GEL_TextOut(" TX3_POL => TX3 differential pair is  ##NOT SWAPPED## \n\n");
	}
	else
	{
		
		GEL_TextOut(" TX3_POL => TX3 differential pair is  **SWAPPED** \n\n");
	}
}


PLM_Port_Packet_Denial_Control_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PLM Port Packet Denial Control Register(PLM_SP%d_DENIAL_CTL)  ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_DENIAL_CTL+(i*0x80))),7,0);
	
	GEL_TextOut(" DENIAL_THRESH => %x is the threshold of too many consecutive retries \n",,,,,reg_field);
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_DENIAL_CTL+(i*0x80))),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" CNT_RTY       => Retry Control Symbols  ##DO NOT COUNT##  towards the packet denial threshold\n");
	}
	else
	{
		
		GEL_TextOut(" CNT_RTY       => Retry Control Symbols  ##DO COUNT##  towards the packet denial threshold\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_DENIAL_CTL+(i*0x80))),29,29);
	
	if(reg_field==0)
	{
		GEL_TextOut(" CNT_PNA       => Packet-Not-Accepted Control Symbols  ##DO NOT COUNT##  towards the packet denial threshold\n\n");
	}
	else
	{
		
		GEL_TextOut(" CNT_PNA       => Packet-Not-Accepted Control Symbols  ##DO COUNT##  towards the packet denial threshold\n\n");
	}
}


PLM_Port_MECS_Forwarding_Register(unsigned int port_no)
{
	unsigned int i,reg_field,reg_field_1,srv_clk_period;
	
	i=port_no;
	
	GEL_TextOut(" ******************* PLM Port MECS Forwarding Register(PLM_SP%d_MECS_FWD) ******************* \n\n",,,,,i);
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)(SRIO_PLM_SP0_MECS_FWD+(i*0x80))),31,24);
	
	if((reg_field & 0x00000001) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=0 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=0 \n",,,,,i);
	}
	
	if((reg_field & 0x00000002) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=1 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=1 \n",,,,,i);
	}
	
	if((reg_field & 0x00000004) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=2 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=2 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000008) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=3 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=3 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000010) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=4 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=4 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000020) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=5 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=5 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000040) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=6 \n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=6 \n",,,,,i);
	}
	
	
	if((reg_field & 0x00000080) != 0)
	{
		GEL_TextOut(" Port%d  ##FORWARDS##  MECS with cmd=7 \n\n",,,,,i);
	}
	else
	{
		GEL_TextOut(" Port%d  ##DOES NOT FORWARD##  MECS with cmd=7 \n\n",,,,,i);
	}
	
}


