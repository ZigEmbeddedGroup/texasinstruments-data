menuitem "SRIO PW Configuration";


Port_Write_Control_Register()
{

	unsigned int reg_field;

	GEL_TextOut(" ******************* Port-Write Control Register (PW_CTL) *******************\n\n");

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_CTL),24,24);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PWC_MODE => Continuous Port-Write capture mode \n");
	}
	else
	{
		
		GEL_TextOut(" PWC_MODE => Reliable Port-Write capture mode \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_CTL),31,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_TIMER => Disabled. Port-Write is sent once only \n\n");
	}
	else if(reg_field==1)
	{
		GEL_TextOut(" PW_TIMER => 103 us\n\n");
	}
	else if(reg_field==2)
	{
		GEL_TextOut(" PW_TIMER => 205 us\n\n");
	}
	else if(reg_field==4)
	{
		GEL_TextOut(" PW_TIMER => 410 us\n\n");
	}
	else if(reg_field==8)
	{
		GEL_TextOut(" PW_TIMER => 820 us\n\n");
	}
	else
	{
		GEL_TextOut(" PW_TIMER => Reserved \n\n");
	}
	
}

Port_Write_Routing_Register()
{
	unsigned int reg_field;
	
	GEL_TextOut(" ******************* Port-Write Routing Register (PW_ROUTE) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_PW_ROUTE),3,0);
	
	if((reg_field & 0x00000001) != 0)
	{
		GEL_TextOut(" Set to send Port-Writes to port0 (default)\n\n");
	}
	else if((reg_field & 0x00000002) != 0)
	{
		GEL_TextOut(" Set to send Port-Writes to port1\n\n");
	}
	else if((reg_field & 0x00000004) != 0)
	{
		GEL_TextOut(" Set to send Port-Writes to port2\n\n");
	}
	else if((reg_field & 0x00000008) != 0)
	{
		GEL_TextOut(" Set to send Port-Writes to port3\n\n");
	}
	else
	{
		GEL_TextOut(" Reserved\n\n");
	}
}

Port_Write_Reception_Event_Generate_Register()
{

	unsigned int reg_field;

	GEL_TextOut(" ******************* Port-Write Reception Event Generate Register (PW_RX_EVENT_GEN) *******************\n\n");

	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_RIO_PW_RX_EVENT_GEN),0,0);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_VAL  => An Event is  **NOT GENERATED**  when valid Port-Write data is received\n");
	}
	else
	{
		
		GEL_TextOut(" PW_VAL  => An Event is  ##GENERATED##  when valid Port-Write data is received\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_RIO_PW_RX_EVENT_GEN),1,1);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_DISC => An Event is  **NOT GENERATED**  when a Port-Write is discarded\n\n");
	}
	else
	{
		
		GEL_TextOut(" PW_DISC => An Event is  ##GENERATED##  when a Port-Write is discarded\n\n");
	}
}


