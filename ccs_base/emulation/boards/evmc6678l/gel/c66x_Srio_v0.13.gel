hotmenu Interrupts_config()
{
	Event_Management_Interrupts_Enable_Register();
	
	Event_Management_Device_Interrupt_Enable_Register();
}

hotmenu Port_Write_config()
{
	Event_Management_Port_Write_Enable_Register();

    Event_Management_Device_Port_Write_Enable_Register();
}


hotmenu Multicast_Event_CS_config()
{
	Event_Management_MECS_Interrupt_Enable_Register();

	
	Event_Management_MECS_Capture_Out_Register();

	
	Event_Management_MECS_Trigger_In_Register();
}


hotmenu Reset_Request_config()
{
	Event_Management_Reset_Request_Interrupt_Enable_Register();

	Event_Management_Reset_Request_Port_Write_Enable_Register();
}


hotmenu EM_config_Snapshot()
{
	
	GEL_TextOut(" *******************************************************************************************************\n");
	GEL_TextOut(" ********************************** EVENT MGT CONFIGURATION ******************************************************\n");
	GEL_TextOut(" *******************************************************************************************************\n\n");

	Event_Management_Interrupts_Enable_Register();
	
	Event_Management_Device_Interrupt_Enable_Register();

	Event_Management_Port_Write_Enable_Register();

    Event_Management_Device_Port_Write_Enable_Register();
	
	Event_Management_MECS_Interrupt_Enable_Register();
	
	Event_Management_MECS_Capture_Out_Register();
	
	Event_Management_MECS_Trigger_In_Register();

	Event_Management_Reset_Request_Interrupt_Enable_Register();

	Event_Management_Reset_Request_Port_Write_Enable_Register();

}


menuitem "SRIO EM Status";

Event_Management_Interrupt_Status_Register()
{
	unsigned int reg_field;
	
	GEL_TextOut(" ******************* Event Management Interrupt Status Register (EM_INT_STAT) *******************\n\n");
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_STAT),8,8);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOCALOG => one or more of the enabled errors in ERR_DET CSR is  ##NOT SET## \n");
	}
	else
	{
		
		GEL_TextOut(" LOCALOG => one or more of the enabled errors in ERR_DET CSR is  **SET** \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_STAT),16,16);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PW_RX   => A Port-Write  ##HAS NOT##  been received\n");
	}
	else
	{
		
		GEL_TextOut(" PW_RX   => A Port-Write  **HAS**  been received\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_STAT),26,26);
	
	if(reg_field==0)
	{
		GEL_TextOut(" MECS    => A MECS with an enabled CMD field is  ##NOT RECEIVED##  by one of the RIO ports\n");
	}
	else
	{
		
		GEL_TextOut(" MECS    => A MECS with an enabled CMD field is  **RECEIVED**  by one of the RIO ports\n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_STAT),27,27);
	
	if(reg_field==0)
	{
		GEL_TextOut(" RCS     => A reset request  ##HAS NOT##  been detected by a port. \n");
	}
	else
	{
		
		GEL_TextOut(" RCS     => A reset request  **HAS**  been detected by a port. \n");
	}
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_STAT),28,28);
	
	if(reg_field==0)
	{
		GEL_TextOut(" LOG     => An enabled Log/Trans error has  ##NOT BEEN DETECTED##  and reported by User Core LOGERR Signals\n");
	}
	else
	{
		
		GEL_TextOut(" LOG     => An enabled Log/Trans error has  **BEEN DETECTED**  and reported by User Core LOGERR Signals\n");
	}
	
	
	reg_field=SRIO_REG_FIELD_READ((*(unsigned int*)SRIO_EM_INT_STAT),29,29);
	
	if(reg_field==0)
	{
		GEL_TextOut(" PORT    => A port-specific event  ##HAS NOT BEEN##  detected.\n\n");
	}
	else
	{
		
		GEL_TextOut(" PORT    => A port-specific event  **HAS BEEN**  detected.\n\n");
	}
	
}
	
	
