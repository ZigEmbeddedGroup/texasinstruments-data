cpintc0_edmatpcc0_chmap()
{
	unsigned int reg_field, event_no, chmap_reg_no, chmap_index,i;
	
	event_no = CIC0_EDMA3CC0_CC_ERRINT;
	
	chmap_reg_no = event_no/4;
	chmap_index = event_no%4;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_CH_MAP_REG0 + (chmap_reg_no*4)),((chmap_index*8)+7),(chmap_index*8));
	
	if(((reg_field >= 8) && (reg_field <= 15)) || ((reg_field >= 64) && (reg_field <= 73)))
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) ---> INTC0_OUT%d (Interrupts Core 0)\n",,,,,reg_field);
	}
	else if(((reg_field >= 24) && (reg_field <= 31)) || ((reg_field >= 74) && (reg_field <= 83)))
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) ---> INTC0_OUT%d (Interrupts Core 1)\n",,,,,reg_field);
	}
	else if(((reg_field >= 40) && (reg_field <= 47)) || ((reg_field >= 84) && (reg_field <= 93)))
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) ---> INTC0_OUT%d (Interrupts Core 2)\n",,,,,reg_field);
	}
	else if(((reg_field >= 56) && (reg_field <= 63)) || ((reg_field >= 94) && (reg_field <= 103)))
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) ---> INTC0_OUT%d (Interrupts Core 3)\n",,,,,reg_field);
	}
	else if(((reg_field >= 0) && (reg_field <= 7)))
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) ---> INTC0_OUT%d (Interrupts all Cores (broadcast) )\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) ---> INTC0_OUT%d\n",,,,,reg_field);
	}
	
	
	event_no = CIC0_EDMA3CC0_CC_MPINT;
	
	chmap_reg_no = event_no/4;
	chmap_index = event_no%4;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_CH_MAP_REG0 + (chmap_reg_no*4)),((chmap_index*8)+7),(chmap_index*8));
	
	if(((reg_field >= 8) && (reg_field <= 15)) || ((reg_field >= 64) && (reg_field <= 73)))
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) ---> INTC0_OUT%d (Interrupts Core 0)\n",,,,,reg_field);
	}
	else if(((reg_field >= 24) && (reg_field <= 31)) || ((reg_field >= 74) && (reg_field <= 83)))
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) ---> INTC0_OUT%d (Interrupts Core 1)\n",,,,,reg_field);
	}
	else if(((reg_field >= 40) && (reg_field <= 47)) || ((reg_field >= 84) && (reg_field <= 93)))
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) ---> INTC0_OUT%d (Interrupts Core 2)\n",,,,,reg_field);
	}
	else if(((reg_field >= 56) && (reg_field <= 63)) || ((reg_field >= 94) && (reg_field <= 103)))
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) ---> INTC0_OUT%d (Interrupts Core 3)\n",,,,,reg_field);
	}
	else if(((reg_field >= 0) && (reg_field <= 7)))
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) ---> INTC0_OUT%d (Interrupts all Cores (broadcast) )\n",,,,,reg_field);
	}
	else
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) ---> INTC0_OUT%d\n",,,,,reg_field);
	}
	
	for(event_no = CIC0_EDMA3CC0_TC_ERRINT0;event_no <=CIC0_EDMA3CC0_TC_ERRINT1;event_no++)
	{
	
		chmap_reg_no = event_no/4;
		chmap_index = event_no%4;
		
		reg_field = BB_REG_FIELD_READ((CPINTC0_CH_MAP_REG0 + (chmap_reg_no*4)),((chmap_index*8)+7),(chmap_index*8));
		
		if(((reg_field >= 8) && (reg_field <= 15)) || ((reg_field >= 64) && (reg_field <= 73)))
		{
			GEL_TextOut(" TPCC0 TPTC%d Error Interrupt (TPCC0 EDMATC_ERRINT%d) ---> INTC0_OUT%d (Interrupts Core 0)\n",,,,,(event_no-CIC0_EDMA3CC0_TC_ERRINT0),(event_no-CIC0_EDMA3CC0_TC_ERRINT0),reg_field);
		}
		else if(((reg_field >= 24) && (reg_field <= 31)) || ((reg_field >= 74) && (reg_field <= 83)))
		{
