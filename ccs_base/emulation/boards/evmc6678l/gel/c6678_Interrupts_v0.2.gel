	if(reg_field == 0)
	{
		GEL_TextOut(" VPVOLTUPDATE has been asserted but SMPS has not been responded in a defined time interval (VPNoSMPSAck) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" VPVOLTUPDATE has been asserted but SMPS has not been responded in a defined time interval (VPNoSMPSAck) is ##ENABLED##\n");
	}
	
	event_no = CIC0_VPEqValue;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SRSINTERUPTZ is asserted, but the new voltage is not different from the current SMPS voltage (VPEqValue) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" SRSINTERUPTZ is asserted, but the new voltage is not different from the current SMPS voltage (VPEqValue) is ##ENABLED##\n");
	}
	
	event_no = CIC0_VPMaxVdd;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" The new voltage required is equal to or greater than MaxVdd (VPMaxVdd) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" The new voltage required is equal to or greater than MaxVdd (VPMaxVdd) is ##ENABLED##\n");
	}
	
	event_no = VPMinVdd;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" The new voltage required is equal to or less than MinVdd (VPMinVdd) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" The new voltage required is equal to or less than MinVdd (VPMinVdd) is ##ENABLED##\n");
	}
	
	event_no = CIC0_VPINIDLE;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" Indicating that the FSM of Voltage Processor is in idle (VPINIDLE) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" Indicating that the FSM of Voltage Processor is in idle (VPINIDLE) is ##ENABLED##\n");
	}
	
	event_no = CIC0_VPOPPChangeDone;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" Indicating that the average frequency error is within the desired limit (VPOPPChangeDone) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" Indicating that the average frequency error is within the desired limit (VPOPPChangeDone) is ##ENABLED##\n");
	}
}


cpintc0_edmatpcc0_status(unsigned int status_flag)
{
	unsigned int reg_field, event_no, status_reg_no, status_index,i,status_reg_addr;
	
	if(status_flag == 0)
	{
		status_reg_addr = CPINTC0_RAW_STATUS_REG0;
	}
	else
	{
		status_reg_addr = CPINTC0_ENA_STATUS_REG0;
	}
	
	event_no = CIC0_EDMA3CC0_CC_ERRINT;
	
	status_reg_no = event_no/32;
	status_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) is ##NOT PENDING##\n");
	}
	else
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) is **PENDING**\n");
	}
	
	event_no = CIC0_EDMA3CC0_CC_MPINT;
	
	status_reg_no = event_no/32;
	status_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
	
	if(reg_field == 0)
	{
