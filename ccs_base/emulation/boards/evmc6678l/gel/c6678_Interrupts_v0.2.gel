cpintc0_edmatpcc0_enable()
{
	unsigned int reg_field, event_no, enable_reg_no, enable_index,i;
	
	event_no = CIC0_EDMA3CC0_CC_ERRINT;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" TPCC0 Error Interrupt (TPCC0 EDMACC_ERRINT) is ##ENABLED##\n");
	}
	
	event_no = CIC0_EDMA3CC0_CC_MPINT;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) is ##ENABLED##\n");
	}
	
	for(event_no = CIC0_EDMA3CC0_TC_ERRINT0;event_no <=CIC0_EDMA3CC0_TC_ERRINT1;event_no++)
	{
	
		enable_reg_no = event_no/32;
		enable_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
		
		if(reg_field == 0)
		{
			GEL_TextOut(" TPCC0 TPTC%d Error Interrupt (TPCC0 EDMATC_ERRINT%d) is **DISABLED**\n",,,,,(event_no-34),(event_no-34));
		}
		else
		{
			GEL_TextOut(" TPCC0 TPTC%d Error Interrupt (TPCC0 EDMATC_ERRINT%d) is ##ENABLED##\n",,,,,(event_no-34),(event_no-34));
		}
	}
	
	
	event_no = CIC0_EDMA3CC0_CC_GINT;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" TPCC0 EDMACC_GINT is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" TPCC0 EDMACC_GINT is ##ENABLED##\n");
	}
	
	for(event_no = CIC0_EDMA3CC0_CCINT0;event_no <=CIC0_EDMA3CC0_CCINT7;event_no++)
	{
	
		enable_reg_no = event_no/32;
		enable_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
		
		if(reg_field == 0)
		{
			GEL_TextOut(" TPCC0 Individual Completion Interrupt %d (TPCC0INT%d) is **DISABLED**\n",,,,,(event_no-CIC0_EDMA3CC0_CCINT0),(event_no-CIC0_EDMA3CC0_CCINT0));
		}
		else
		{
			GEL_TextOut(" TPCC0 Individual Completion Interrupt %d (TPCC0INT%d) is ##ENABLED##\n",,,,,(event_no-CIC0_EDMA3CC0_CCINT0),(event_no-CIC0_EDMA3CC0_CCINT0));
		}
	}
}



