cpintc0_SR_voltage_enable()
{
	unsigned int reg_field, event_no, enable_reg_no, enable_index,i;
	
	for(event_no = CIC0_SmartReflex_intrreq0;event_no <= CIC0_SmartReflex_intrreq3;event_no++)
