			GEL_TextOut(" Core%d VbusM error event (MDMAERREVT) ---> CORE%d CPU INTERRUPT VECTOR%d\n",,,,,DNUM,DNUM,i);
			
			chmap_flag = 1;
			
			break;
		}
	}
	
	if(chmap_flag == 0)
	{
		chmap_reg_no = event_no/32;
		chmap_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((COREPAC_INTC_EVTMASK0 + (chmap_reg_no*4)),chmap_index,chmap_index);
		
		if(reg_field == 0)
		{
			for(i=4; i<=15; i++)
			{
				intmux_reg = (i/4)-1;
				intmux_index = i%4;
				
				if(chmap_reg_no == BB_REG_FIELD_READ((COREPAC_INTC_INTMUX1 + (intmux_reg*4)),((8*intmux_index)+6),(8*intmux_index)))
				{
					GEL_TextOut(" Core%d VbusM error event (MDMAERREVT) ---> EVT[%d] ---> CORE%d CPU INTERRUPT VECTOR%d\n",,,,,DNUM,chmap_reg_no,DNUM,i);
					
					chmap_flag = 1;
					
					break;
				}
			}
			
			if(chmap_flag == 0)
			{
				GEL_TextOut(" Core%d VbusM error event (MDMAERREVT) ---> **NOT MAPPED**\n",,,,,DNUM);
			}
		}
		else
		{
			GEL_TextOut(" Core%d VbusM error event (MDMAERREVT) ---> **MASKED**\n",,,,,DNUM);
		}
	}
	
	chmap_flag = 0;
	
	event_no = 119;

	for(i=4; i<=15; i++)
	{
		intmux_reg = (i/4)-1;
		intmux_index = i%4;
		
		if(event_no == BB_REG_FIELD_READ((COREPAC_INTC_INTMUX1 + (intmux_reg*4)),((8*intmux_index)+6),(8*intmux_index)))
		{
			GEL_TextOut(" Core%d SYS CPU MP fault event (SYS_CMPA) ---> CORE%d CPU INTERRUPT VECTOR%d\n",,,,,DNUM,DNUM,i);
			
			chmap_flag = 1;
			
			break;
		}
	}
	
	if(chmap_flag == 0)
	{
		chmap_reg_no = event_no/32;
		chmap_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((COREPAC_INTC_EVTMASK0 + (chmap_reg_no*4)),chmap_index,chmap_index);
		
		if(reg_field == 0)
		{
			for(i=4; i<=15; i++)
			{
				intmux_reg = (i/4)-1;
				intmux_index = i%4;
				
				if(chmap_reg_no == BB_REG_FIELD_READ((COREPAC_INTC_INTMUX1 + (intmux_reg*4)),((8*intmux_index)+6),(8*intmux_index)))
				{
					GEL_TextOut(" Core%d SYS CPU MP fault event (SYS_CMPA) ---> EVT[%d] ---> CORE%d CPU INTERRUPT VECTOR%d\n",,,,,DNUM,chmap_reg_no,DNUM,i);
					
					chmap_flag = 1;
					
					break;
				}
			}
			
			if(chmap_flag == 0)
			{
				GEL_TextOut(" Core%d SYS CPU MP fault event (SYS_CMPA) ---> **NOT MAPPED**\n",,,,,DNUM);
			}
		}
		else
		{
			GEL_TextOut(" Core%d SYS CPU MP fault event (SYS_CMPA) ---> **MASKED**\n",,,,,DNUM);
		}
	}
	
	chmap_flag = 0;
}

