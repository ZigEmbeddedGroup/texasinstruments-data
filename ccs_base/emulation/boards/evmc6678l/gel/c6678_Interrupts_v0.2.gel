#define COREPAC_INTC_EVTFLAG0                          (0x01800000u)
#define COREPAC_INTC_EVTFLAG1                          (0x01800004u)
#define COREPAC_INTC_EVTFLAG2                          (0x01800008u)
#define COREPAC_INTC_EVTFLAG3                          (0x0180000Cu)

#define COREPAC_INTC_EVTSET0                           (0x01800020u)
#define COREPAC_INTC_EVTSET1                           (0x01800024u)
#define COREPAC_INTC_EVTSET2                           (0x01800028u)
#define COREPAC_INTC_EVTSET3                           (0x0180002Cu)

#define COREPAC_INTC_EVTCLR0                           (0x01800040u)
#define COREPAC_INTC_EVTCLR1                           (0x01800044u)
#define COREPAC_INTC_EVTCLR2                           (0x01800048u)
#define COREPAC_INTC_EVTCLR3                           (0x0180004Cu)

#define COREPAC_INTC_EVTMASK0                          (0x01800080u)
#define COREPAC_INTC_EVTMASK1                          (0x01800084u)
#define COREPAC_INTC_EVTMASK2                          (0x01800088u)
#define COREPAC_INTC_EVTMASK3                          (0x0180008Cu)

#define COREPAC_INTC_MEVTFLAG0                         (0x018000A0u)
#define COREPAC_INTC_MEVTFLAG1                         (0x018000A4u)
#define COREPAC_INTC_MEVTFLAG2                         (0x018000A8u)
#define COREPAC_INTC_MEVTFLAG3                         (0x018000ACu)

#define COREPAC_INTC_INTMUX1                           (0x01800104u)
#define COREPAC_INTC_INTMUX2                           (0x01800108u)
#define COREPAC_INTC_INTMUX3                           (0x0180010Cu)

#define COREPAC_INTC_AEGMUX0                           (0x01810140u)
#define COREPAC_INTC_AEGMUX1                           (0x01810144u)

#define COREPAC_INTC_INTXSTAT                          (0x01800180u)
#define COREPAC_INTC_INTXCLR                           (0x01800184u)
#define COREPAC_INTC_INTDMASK                          (0x01800188u)

#define COREPAC_INTC_EXPMASK0                          (0x018000C0u)
#define COREPAC_INTC_EXPMASK1                          (0x018000C4u)
#define COREPAC_INTC_EXPMASK2                          (0x018000C8u)
#define COREPAC_INTC_EXPMASK3                          (0x018000CCu)

#define COREPAC_INTC_MEXPFLAG0                         (0x018000E0u)
#define COREPAC_INTC_MEXPFLAG1                         (0x018000E4u)
#define COREPAC_INTC_MEXPFLAG2                         (0x018000E8u)
#define COREPAC_INTC_MEXPFLAG3                         (0x018000ECu)


//CorePac Interrupt Controller functions

corepac_intc_tetb_chmap()
{
	unsigned int reg_field, event_no, chmap_reg_no, chmap_index,i,intmux_reg,intmux_index;
	
	unsigned int chmap_flag = 0;

	event_no = 4;

	for(i=4; i<=15; i++)
	{
		intmux_reg = (i/4)-1;
		intmux_index = i%4;
		
		if(event_no == BB_REG_FIELD_READ((COREPAC_INTC_INTMUX1 + (intmux_reg*4)),((8*intmux_index)+6),(8*intmux_index)))
		{
			GEL_TextOut(" TETB%d is half full (TETBHFULLINT%d) ---> CORE%d CPU INTERRUPT VECTOR%d\n",,,,,DNUM,DNUM,DNUM,i);
			
			chmap_flag = 1;
			
			break;
		}
	}
	
	if(chmap_flag == 0)
	{
		chmap_reg_no = event_no/32;
		chmap_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((COREPAC_INTC_EVTMASK0 + (chmap_reg_no*4)),chmap_index,chmap_index);
		
		if(reg_field == 0)
		{
			for(i=4; i<=15; i++)
			{
				intmux_reg = (i/4)-1;
				intmux_index = i%4;
				
				if(chmap_reg_no == BB_REG_FIELD_READ((COREPAC_INTC_INTMUX1 + (intmux_reg*4)),((8*intmux_index)+6),(8*intmux_index)))
				{
					GEL_TextOut(" TETB%d is half full (TETBHFULLINT%d) ---> EVT[%d] ---> CORE%d CPU INTERRUPT VECTOR%d\n",,,,,DNUM,DNUM,chmap_reg_no,DNUM,i);
					
					chmap_flag = 1;
					
					break;
				}
			}
			
			if(chmap_flag == 0)
			{
				GEL_TextOut(" TETB%d is half full (TETBHFULLINT%d) ---> **NOT MAPPED**\n",,,,,DNUM,DNUM);
			}
		}
		else
		{
			GEL_TextOut(" TETB%d is half full (TETBHFULLINT%d) ---> **MASKED**\n",,,,,DNUM,DNUM);
		}
	}
	
	chmap_flag = 0;
	
	event_no = 5;

	for(i=4; i<=15; i++)
	{
		intmux_reg = (i/4)-1;
		intmux_index = i%4;
		
		if(event_no == BB_REG_FIELD_READ((COREPAC_INTC_INTMUX1 + (intmux_reg*4)),((8*intmux_index)+6),(8*intmux_index)))
		{
			GEL_TextOut(" TETB%d is full (TETBFULLINT%d) ---> CORE%d CPU INTERRUPT VECTOR%d\n",,,,,DNUM,DNUM,DNUM,i);
			
			chmap_flag = 1;
			
			break;
		}
	}
	
	if(chmap_flag == 0)
	{
		chmap_reg_no = event_no/32;
		chmap_index = event_no%32;
		
