	}
	else
	{
		GEL_TextOut(" TPCC0 Memory Protection Interrupt (TPCC0 EDMACC_MPINT) is **PENDING**\n");
	}
	
	for(event_no = CIC0_EDMA3CC0_TC_ERRINT0;event_no <=CIC0_EDMA3CC0_TC_ERRINT1;event_no++)
	{
	
		status_reg_no = event_no/32;
		status_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
		
		if(reg_field == 0)
		{
			GEL_TextOut(" TPCC0 TPTC%d Error Interrupt (TPCC0 EDMATC_ERRINT%d) is ##NOT PENDING##\n",,,,,(event_no-34),(event_no-34));
		}
		else
		{
			GEL_TextOut(" TPCC0 TPTC%d Error Interrupt (TPCC0 EDMATC_ERRINT%d) is **PENDING**\n",,,,,(event_no-34),(event_no-34));
		}
	}
	
	
	event_no = CIC0_EDMA3CC0_CC_GINT;
	
	status_reg_no = event_no/32;
	status_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" TPCC0 EDMACC_GINT is ##NOT PENDING##\n");
	}
	else
	{
		GEL_TextOut(" TPCC0 EDMACC_GINT is **PENDING**\n");
	}
	
	for(event_no = CIC0_EDMA3CC0_CCINT0;event_no <=CIC0_EDMA3CC0_CCINT7;event_no++)
	{
	
		status_reg_no = event_no/32;
		status_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
		
		if(reg_field == 0)
		{
			GEL_TextOut(" TPCC0 Individual Completion Interrupt %d (TPCC0INT%d) is ##NOT PENDING##\n",,,,,(event_no-CIC0_EDMA3CC0_CCINT0),(event_no-CIC0_EDMA3CC0_CCINT0));
		}
		else
		{
			GEL_TextOut(" TPCC0 Individual Completion Interrupt %d (TPCC0INT%d) is **PENDING**\n",,,,,(event_no-CIC0_EDMA3CC0_CCINT0),(event_no-CIC0_EDMA3CC0_CCINT0));
		}
	}
