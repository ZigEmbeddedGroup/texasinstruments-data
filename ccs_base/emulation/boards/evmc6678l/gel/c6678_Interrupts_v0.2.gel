menuitem "Shannon Interrupts APIs";

//CPINTC0 APIs

dialog CPINTC0_event_enable_disable_fn(event_no "Event Num (0 to 207)", enable_disable "Enable/Disable (Enable -> 1, Disable -> 0)")
{
	unsigned int event_reg_no, event_index;
	
	event_reg_no = event_no/32;
	event_index = event_no%32;
	
	if(enable_disable == 1)
	{
		//Write to the ENABLE_REG
		BB_REG_FIELD_WRITE((CPINTC0_ENABLE_REG0 + (event_reg_no*4)),event_index,event_index,0x1);
	}
	else if(enable_disable == 0)
	{
		//Write to the ENABLE_CLR_REG
		BB_REG_FIELD_WRITE((CPINTC0_ENABLE_CLR_REG0 + (event_reg_no*4)),event_index,event_index,0x1);
	}
	
	//Print Status to the console
	if(enable_disable == 1)
	{
		GEL_TextOut( "CPINTC0 Event%d Enabled successfully\n\n",,,,,event_no);
	}
	else if(enable_disable == 0)
	{
		GEL_TextOut( "CPINTC0 Event%d Disabled successfully\n\n",,,,,event_no);
	}
}



dialog CPINTC0_event_set_fn(event_no "Event Num (0 to 207)")
{
	unsigned int event_reg_no, event_index;
	
	event_reg_no = event_no/32;
	event_index = event_no%32;
	
	//Write to the RAW_STATUS_REG
	BB_REG_FIELD_WRITE((CPINTC0_RAW_STATUS_REG0 + (event_reg_no*4)),event_index,event_index,0x1);
	
	//Print Status to the console
	GEL_TextOut( "CPINTC0 Event%d set successfully\n\n",,,,,event_no);
}


dialog CPINTC0_event_clear_fn(event_no "Event Num (0 to 207)")
{
	unsigned int event_reg_no, event_index;
	
	event_reg_no = event_no/32;
	event_index = event_no%32;
	
	//Write to the ENA_STATUS_REG
	BB_REG_FIELD_WRITE((CPINTC0_ENA_STATUS_REG0 + (event_reg_no*4)),event_index,event_index,0x1);
	
	//Print Status to the console
	GEL_TextOut( "CPINTC0 Event%d cleared successfully\n\n",,,,,event_no);
}


dialog CPINTC0_event_channel_mapping_fn(event_no "Event Num (0 to 207)", intcout_num "CPINTC0 Out Num (0 to 255)")
{
	unsigned int chmap_reg_no, chmap_index;
	
	chmap_reg_no = event_no/4;
	chmap_index = event_no%4;
	
	//Write to the CH_MAP_REG
	BB_REG_FIELD_WRITE((CPINTC0_CH_MAP_REG0 + (chmap_reg_no*4)),((chmap_index*8)+7),(chmap_index*8),intcout_num);
	
	//Print Status to the console
	GEL_TextOut( "CPINTC0 Event%d mapped to INTC0_OUT%d successfully\n\n",,,,,event_no,intcout_num);
}

//CorePAC functions

dialog CorePAC_event_mask_unmask_fn(event_no "Event Num (4 to 127)", mask_unmask "Mask/Unmask (Mask -> 1, Unmask -> 0)")
{
	unsigned int event_reg_no, event_index;
	
	event_reg_no = event_no/32;
	event_index = event_no%32;
	
	//Write to the EVTMASK
	BB_REG_FIELD_WRITE((COREPAC_INTC_EVTMASK0 + (event_reg_no*4)),event_index,event_index,mask_unmask);
	
	//Print Status to the console
	if(mask_unmask == 1)
	{
		GEL_TextOut( "CorePAC%d Event%d Masked successfully\n\n",,,,,DNUM,event_no);
	}
	else if(mask_unmask == 0)
	{
		GEL_TextOut( "CorePAC%d Event%d Unmasked successfully\n\n",,,,,DNUM,event_no);
	}
}


dialog CorePAC_event_set_fn(event_no "Event Num (0 to 127)")
{
	unsigned int event_reg_no, event_index;
	
	event_reg_no = event_no/32;
	event_index = event_no%32;
	
	//Write to the EVTSET
	BB_REG_FIELD_WRITE((COREPAC_INTC_EVTSET0 + (event_reg_no*4)),event_index,event_index,0x1);
	
	//Print Status to the console
	GEL_TextOut( "CorePAC%d Event%d set successfully\n\n",,,,,DNUM,event_no);
}


dialog CorePAC_event_clear_fn(event_no "Event Num (0 to 127)")
{
	unsigned int event_reg_no, event_index;
	
	event_reg_no = event_no/32;
	event_index = event_no%32;
	
	//Write to the EVTCLR
	BB_REG_FIELD_WRITE((COREPAC_INTC_EVTCLR0 + (event_reg_no*4)),event_index,event_index,0x1);
	
	//Print Status to the console
	GEL_TextOut( "CorePAC%d Event%d cleared successfully\n\n",,,,,DNUM,event_no);
}


dialog CorePAC_event_mapping_fn(event_no "Event Num (0 to 127)", cpu_vector "CPU Vector (4 to 15)")
{
	unsigned int intmux_reg, intmux_index;
	
	intmux_reg = (cpu_vector/4)-1;
	intmux_index = cpu_vector%4;
	
	//Write to the INTMUX
	BB_REG_FIELD_WRITE((COREPAC_INTC_INTMUX1 + (intmux_reg*4)),((8*intmux_index)+6),(8*intmux_index),event_no);
	
	//Print Status to the console
	GEL_TextOut( "CorePAC%d Event%d mapped to CPU%d vector%d successfully\n\n",,,,,DNUM,event_no,DNUM,cpu_vector);
}
