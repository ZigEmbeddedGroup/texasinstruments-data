		GEL_TextOut(" Correctable (1-bit) soft error detected on SRAM read (MSMC_dedc_cerror) is **PENDING**\n");
	}
	
	event_no = CIC0_MSMC_dedc_nc_error;
	
	status_reg_no = event_no/32;
	status_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" Non-correctable (2-bit) soft error detected on SRAM read (MSMC_dedc_nc_error) is ##NOT PENDING##\n");
	}
	else
	{
		GEL_TextOut(" Non-correctable (2-bit) soft error detected on SRAM read (MSMC_dedc_nc_error) is **PENDING**\n");
	}
	
	event_no = CIC0_MSMC_scrub_nc_error;
	
	status_reg_no = event_no/32;
	status_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" Non-correctable (2-bit) soft error detected during scrub cycle (MSMC_scrub_nc_error) is ##NOT PENDING##\n");
	}
	else
	{
		GEL_TextOut(" Non-correctable (2-bit) soft error detected during scrub cycle (MSMC_scrub_nc_error) is **PENDING**\n");
	}
	
	event_no = CIC0_Reserved_101;
	
	status_reg_no = event_no/32;
	status_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SES MPAX setup error causing extended address to be out of EMIF range (MSMC_mpax_addr_error) is ##NOT PENDING##\n");
	}
	else
	{
		GEL_TextOut(" SES MPAX setup error causing extended address to be out of EMIF range (MSMC_mpax_addr_error) is **PENDING**\n");
	}
	
	for(event_no = CIC0_MSMC_mpf_error8;event_no <= CIC0_MSMC_mpf_error15;event_no++)
	{
	
		status_reg_no = event_no/32;
		status_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
		
		if(reg_field == 0)
		{
			GEL_TextOut(" Memory protection fault indicators for system master with PrivID-%d (MSMC_mpf_error%d) is ##NOT PENDING##\n",,,,,(8+(event_no-CIC0_MSMC_mpf_error8)),(8+(event_no-CIC0_MSMC_mpf_error8)));
		}
		else
		{
			GEL_TextOut(" Memory protection fault indicators for system master with PrivID-%d (MSMC_mpf_error%d) is **PENDING**\n",,,,,(8+(event_no-CIC0_MSMC_mpf_error8)),(8+(event_no-CIC0_MSMC_mpf_error8)));
		}
	}
	
	
	for(event_no = CIC0_MSMC_mpf_error8;event_no <= CIC0_MSMC_mpf_error15;event_no++)
	{
	
		status_reg_no = event_no/32;
		status_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((status_reg_addr + (status_reg_no*4)),status_index,status_index);
		
		if(reg_field == 0)
		{
			GEL_TextOut(" Memory protection fault indicators for system master with PrivID-%d (MSMC_mpf_error%d) is ##NOT PENDING##\n",,,,,(4+(event_no-CIC0_MSMC_mpf_error8)),(4+(event_no-CIC0_MSMC_mpf_error8)));
		}
		else
		{
			GEL_TextOut(" Memory protection fault indicators for system master with PrivID-%d (MSMC_mpf_error%d) is **PENDING**\n",,,,,(4+(event_no-CIC0_MSMC_mpf_error8)),(4+(event_no-CIC0_MSMC_mpf_error8)));
		}
	}
}


