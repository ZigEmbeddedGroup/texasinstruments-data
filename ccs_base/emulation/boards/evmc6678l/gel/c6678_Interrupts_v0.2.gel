	else
	{
		GEL_TextOut(" Non-correctable (2-bit) soft error detected during scrub cycle (MSMC_scrub_nc_error) is ##ENABLED##\n");
	}
	
	event_no = CIC0_Reserved_101;
	
	enable_reg_no = event_no/32;
	enable_index = event_no%32;
	
	reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
	
	if(reg_field == 0)
	{
		GEL_TextOut(" SES MPAX setup error causing extended address to be out of EMIF range (MSMC_mpax_addr_error) is **DISABLED**\n");
	}
	else
	{
		GEL_TextOut(" SES MPAX setup error causing extended address to be out of EMIF range (MSMC_mpax_addr_error) is ##ENABLED##\n");
	}
	
	for(event_no = CIC0_MSMC_mpf_error8;event_no <= CIC0_MSMC_mpf_error15;event_no++)
	{
	
		enable_reg_no = event_no/32;
		enable_index = event_no%32;
		
		reg_field = BB_REG_FIELD_READ((CPINTC0_ENABLE_REG0 + (enable_reg_no*4)),enable_index,enable_index);
		
		if(reg_field == 0)
		{
			GEL_TextOut(" Memory protection fault indicators for system master with PrivID-%d (MSMC_mpf_error%d) is **DISABLED**\n",,,,,(8+(event_no-CIC0_MSMC_mpf_error8)),(8+(event_no-CIC0_MSMC_mpf_error8)));
		}
		else
		{
			GEL_TextOut(" Memory protection fault indicators for system master with PrivID-%d (MSMC_mpf_error%d) is ##ENABLED##\n",,,,,(8+(event_no-CIC0_MSMC_mpf_error8)),(8+(event_no-CIC0_MSMC_mpf_error8)));
		}
	}
}


