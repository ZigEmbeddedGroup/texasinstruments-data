static void DDRSS_Set_DDR_PLL(unsigned int frequency)
{
    if(frequency == 933000000){
        Set_DDR_PLL_933MHz();
    }else if(frequency == 800000000){
        Set_DDR_PLL_800MHz();
    }else if(frequency == 666500000){
        Set_DDR_PLL_666MHz();
    }else if(frequency == 533000000){
        Set_DDR_PLL_533MHz();
    }else if(frequency == 400000000){
        Set_DDR_PLL_400MHz();
    }else{
        printf("Frequency not supported by GEL\n");
    }
}

static void DDRSS_LPDDR4_Ack_Freq_Upd_Req(void)                                   
{
      unsigned int req, req_type, counter;
      
      printf("--->>> Waiting for frequency change requests ... <<<---\n");
      
      for(counter = 0; counter < DDRSS_PLL_FHS_CNT; counter++)
      {
          //wait for freq change request
          req = HW_RD_REG32(CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR) & 0x80;
          while(req == 0x0){
              req = HW_RD_REG32(CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR) & 0x80;
          }

          req_type = HW_RD_REG32(CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR) & 0x03;
          GEL_TextOut("Frequency change request type %d received from controller \n",,,,, req_type);
          
          if(req_type == 1){
              DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
          }else if(req_type == 2){
              DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
          }else if(req_type == 0){
              Set_DDR_PLL_EXTBYPASS();
          }else{
              GEL_TextOut("error\n",,,,,);
          }
             
          // acknowledge freq change request
          HW_WR_REG32(CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR, 0x1);

          while((HW_RD_REG32(CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR) & 0x80) == 0x80);

          // clear acknowledge
          HW_WR_REG32(CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR, 0x0);
    }
    
    printf("--->>> All frequency change requests have completed... <<<---\n");                 
}

hotmenu J7ES_LPDDR4_Config(void)
{
    printf("--->>> LPDDR4 Initialization is in progress ... <<<---\n");
    
    //unlock MMR reg 5
    //Partition5 lockkey0
    HW_WR_REG32((M3_RAT_OFFSET + CTRLMMR_LOCK5_KICK0), CTRLMMR_LOCK5_KICK0_KEY);
    //Partition5 lockkey1
    HW_WR_REG32((M3_RAT_OFFSET + CTRLMMR_LOCK5_KICK1), CTRLMMR_LOCK5_KICK1_KEY);
    
    /* Start with PLL in bypass mode */
    Set_DDR_PLL_EXTBYPASS();
    
    DDRSS_Register_Init();
    
	//Trigger the DDR PI start bit
	HW_WR_REG32(J7ES_DDR_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_0__SFR_OFFS,   0x00000B01);    
    
	printf("--->>> DDR PI initialization started... <<<---\n");    

	//Trigger the DDR controller start bit
	HW_WR_REG32(J7ES_DDR_SS_BASE + DDRSS_CTL_0__SFR_OFFS,   0x00000B01);

    printf("--->>> DDR Controller initialization started... <<<---\n");    

    DDRSS_LPDDR4_Ack_Freq_Upd_Req();

    // Wait for PI completion
	while(((HW_RD_REG32(J7ES_DDR_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_79__SFR_OFFS)) & 0x1) != 0x1);
	HW_WR_REG32(J7ES_DDR_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_80__SFR_OFFS, 0x1 );
	
	// Wait for controller completion
    while((HW_RD_REG32(J7ES_DDR_SS_BASE + DDRSS_CTL_293__SFR_OFFS)!= 0x200));
    HW_WR_REG32(J7ES_DDR_SS_BASE + DDRSS_CTL_295__SFR_OFFS, 0x200 );

    printf("--->>> LPDDR4 Initialization is DONE! <<<---\n");  	
}

/* This function is run when the DMSC firmware is loaded on to the device */
hotmenu J7ES_LPDDR4_Config_Late()
{
    int status = 1;
    /* Remap the RAT to the GEL Configuration */
    *(0x44200020) = 0x8000001D;
    *(0x44200024) = 0x80000000;
    *(0x44200028) = 0x00000000;
    *(0x4420002C) = 0x00000000;
    *(0x44200030) = 0x8000001D;
    *(0x44200034) = 0x60000000;
    *(0x44200038) = 0x40000000;
    *(0x4420003C) = 0x00000000;
    *(0x44200040) = 0x8000001A;
    *(0x44200044) = 0xA0000000;
    *(0x44200048) = 0x40000000;
    *(0x4420004C) = 0x00000000;
    *(0x44200050) = 0x80000019;
    *(0x44200054) = 0xA8000000;
    *(0x44200058) = 0x70000000;
    *(0x4420005C) = 0x00000000;
    *(0x44200060) = 0x8000001B;
    *(0x44200064) = 0xB0000000;
    *(0x44200068) = 0x50000000;
    *(0x4420006C) = 0x00000000;
    *(0x44200070) = 0x8000001B;
    *(0x44200074) = 0xB8000000;
    *(0x44200078) = 0x58000000;
    *(0x4420007C) = 0x00000000;

    J7ES_LPDDR4_Config();

    /* Restore DMSC RAT configuration */
    *(0x44200020) = 0x8000001D;
    *(0x44200024) = 0x60000000;
    *(0x44200028) = 0x00000000;
    *(0x4420002C) = 0x00000000;
    *(0x44200030) = 0x8000001D;
    *(0x44200034) = 0x80000000;
    *(0x44200038) = 0x20000000;
    *(0x4420003C) = 0x00000000;
    *(0x44200040) = 0x8000001D;
    *(0x44200044) = 0xA0000000;
    *(0x44200048) = 0x40000000;
    *(0x4420004C) = 0x00000000;
    *(0x44200050) = 0x00000000;
    *(0x44200054) = 0xA8000000;
    *(0x44200058) = 0x70000000;
    *(0x4420005C) = 0x00000000;
    *(0x44200060) = 0x00000000;
    *(0x44200064) = 0xB0000000;
    *(0x44200068) = 0x50000000;
    *(0x4420006C) = 0x00000000;
    *(0x44200070) = 0x00000000;
    *(0x44200074) = 0xB8000000;
    *(0x44200078) = 0x58000000;
    *(0x4420007C) = 0x00000000;

}                                                 


hotmenu Enable_TI_InlineECC_for_UDMA_example()                                   
{                                                  

    unsigned int i=0;
    
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980120), 0x17); //ECC Control Register (Base Address + 0x120)   

    for(i=0;i<32;i++)
    {
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980128), 1<<15 | 0xC8); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    for(i=32;i<64;i++)
    {
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980128), 1<<15 | 0xA9); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    for(i=64;i<96;i++)
    {
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980128), 1<<15 | 0xAA); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    for(i=96;i<128;i++)
    {
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980128), 1<<15 | 0xAB); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980130), 0x0);//ECC Range 0 Start Address Register (Base Address + 0x130)
    HW_WR_REG32((M3_RAT_OFFSET + 0x2980134), 0xFFFF);//ECC Range 0 End Address Register (Base Address + 0x134)
    //ECC Range 1 Start Address Register (Base Address + 0x138)
    //ECC Range 1 End Address Register (Base Address + 0x13C)
    //ECC Range 2 Start Address Register (Base Address + 0x140)
    //ECC Range 2 End Address Register (Base Address + 0x144)
    printf("--->>> ECC region 0 enabled with all cache lines allocated for UDMA.... <<<---\n");       
     
}
