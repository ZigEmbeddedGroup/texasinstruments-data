PD_Encoder_PowerUp(){
	int status = 0;
	//Decode
    GEL_TextOut("Powering up LPSC_DECODE_0\n");
    status &= Set_MAIN_PSC_State( PD_DECODE, LPSC_DECODE_0, PSC_PD_ON, PSC_ENABLE);
	GEL_TextOut("Powering up LPSC_DECODE_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_DECODE, LPSC_DECODE_PBIST, PSC_PD_ON, PSC_ENABLE);
}

PD_Decoder_PowerUp(){
	int status = 0;
	//Encode
    GEL_TextOut("Powering up LPSC_ENCODE_0\n");
    status &= Set_MAIN_PSC_State( PD_ENCODE, LPSC_ENCODE_0, PSC_PD_ON, PSC_ENABLE);
	GEL_TextOut("Powering up LPSC_ENCODE_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_ENCODE, LPSC_ENCODE_PBIST, PSC_PD_ON, PSC_ENABLE);
}

PD_DMPAC_PowerUp(){
	int status = 0;
	//DMPAC
    GEL_TextOut("Powering up LPSC_DMPAC\n");
    status &= Set_MAIN_PSC_State( PD_DMPAC, LPSC_DMPAC, PSC_PD_ON, PSC_ENABLE);
	GEL_TextOut("Powering up LPSC_SDE\n");
    status &= Set_MAIN_PSC_State( PD_DMPAC, LPSC_SDE, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_DMPAC_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_DMPAC, LPSC_DMPAC_PBIST, PSC_PD_ON, PSC_ENABLE);
}

PD_VPAC_PowerUp(){
	int status = 0;
	//VPAC
    GEL_TextOut("Powering up LPSC_VPAC\n");
    status &= Set_MAIN_PSC_State( PD_VPAC, LPSC_VPAC, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_VPAC_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_VPAC, LPSC_VPAC_PBIST, PSC_PD_ON, PSC_ENABLE);
}

/*
* Internal function to turn on the WKUPMCU2MAIN bridge, in order to allow for
* the DMSC to access MMRs and IPs in the Main SoC after initializing the RAT.
*/
Turn_On_LPSC_WKUPMCU2MAIN(){
	int status = 1;
	GEL_TextOut("Powering up LPSC_WKUPMCU2MAIN\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUPMCU2MAIN, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Checking LPSC_WKUPMCU2MAIN\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUPMCU2MAIN);
}

/* Internal function to reset the DDR interface. */
Reset_DDR0(){
	int status = 1;

	//Reset the DDR interface.
    GEL_TextOut("Reset LPSC_EMIF_CFG_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_EMIF_DATA_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_0, PSC_PD_ON, PSC_SYNCRESET);

    GEL_TextOut("Powering up LPSC_EMIF_CFG_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_EMIF_DATA_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_0, PSC_PD_ON, PSC_ENABLE);
}

