	Main_MCANSS_PowerUp();
	Main_DSS_PowerUp();
/*	Main_ICSS_PowerUp();*/
	Main_9GSS_PowerUp();
	Main_Timer_PowerUp();
/*	C71_PowerUp();*/
	A72_PowerUp();
/*	GPU_PowerUp();*/
	Main_Pulsar_PowerUp();
/*	PD_Encoder_PowerUp();
	PD_Decoder_PowerUp();
	PD_DMPAC_PowerUp();
	PD_VPAC_PowerUp();*/

	GEL_TextOut("Powering up all PSC power domains done!\n");
}

