/*****************************************************************************/

/******* PLL HSDIV disable functions. *****************/

menuitem "PLL Configuration/Disable HSDIV Outputs";

menuitem "PLL Configuration/Disable HSDIV Outputs/Main_PLL0";

hotmenu Main_PLL0_HSDIV1_Disable(){

    address_offset = 0x80000000;

    Write_MMR_Field((CSL_PLL0_CFG_BASE + address_offset + (MAIN_PLL_INDEX * 0x1000) + (1*0x4 + 0x80)), 0, 1, 15);
    GEL_TextOut("Main_PLL0_HSDIV1 Disabled.\n");

}

