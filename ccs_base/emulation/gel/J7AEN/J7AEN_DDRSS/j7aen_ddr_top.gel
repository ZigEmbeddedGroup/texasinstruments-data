    GEL_TextOut("Setting auto entry for this mode to 0x7F(long counts) for testing, time to enter can be configured from 0x1 to 0xFF.\n");
}

hotmenu DDR_setup_auto_sr_short() {
    DDR_enable_auto_entry_low_power_modes();
    DDR_enable_auto_exit_low_power_modes();
    CDNC_set_auto_sr_short_timer(0x7F);
    GEL_TextOut("Setting auto entry for this mode to 0x7F(controller clocks) for testing, time to enter can be configured from 0x1 to 0xFFF.\n");
}

hotmenu DDR_clear_all_auto_sr_timers() {
    CDNC_clear_all_auto_sr_timers();
}

hotmenu DDR_disable_auto_exit_low_power_modes() {
    CDNC_change_auto_exit_lp(0);
    GEL_TextOut("Low power modes auto exit disabled.\n");
}

hotmenu DDR_disable_auto_entry_low_power_modes() {
    CDNC_change_auto_entry_lp(0);
    GEL_TextOut("Low power modes auto entry disabled.\n");
}

hotmenu DDR_enable_auto_exit_low_power_modes() {
    CDNC_change_auto_exit_lp(1);
    GEL_TextOut("Low power modes auto exit enabled.\n");
}

hotmenu DDR_enable_auto_entry_low_power_modes() {
    CDNC_change_auto_entry_lp(1);
    GEL_TextOut("Low power modes auto entry enabled.\n");
}

/* This is dummy function - GEL does not work real-time.
 * If GELs are imported to C code, this function must be implemented a loop of
 * "delay" microseconds
 */
static void us_delay(uint32_t delay)
{
    uint32_t loop;
    for (loop = 0; loop < delay * 100; loop++)
    {
        loop = loop;
    }
}

/* Wrapper function to simplify importing GEL file to a C code */
printf(char *temp)
{
    GEL_TextOut(temp);
}
