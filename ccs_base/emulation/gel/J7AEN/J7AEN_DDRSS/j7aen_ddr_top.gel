menuitem "DDR/Memory Config";


hotmenu Config_DDR() {
    Config_DDR__(1);
}


Config_DDR__(unsigned int cs_intrlv) {
    printf("--->>> LPDDR4 Initialization is in progress ... <<<---\n");
    
    // Write to TI regs for sizing
    // gels/ip/DDR/TI/v2/ddrss_ti_wrapper.gel
    // TI_set_DDR_size(0x000001EF); // 2GB
    // TI_set_DDR_size(0x00000210); // 4GB
    TI_set_DDR_size(0x00000231); // 8GB

    // gels/ip/DDR/CDNC?v2/ddrss_cdnc_cfg.gel
    CDNC_copy_regconfigs();

    // refer to 
    // sys_dve_lib/modules/sys_dv/new_tests/p_periph/d_ddrss/include/cdns_ddr_reg_config.c
    if (DDR_CMD_ADDR_SLICE_SWAP){
        printf("--->>> DDR COMMAND ADDRESS SLICE SWAP  <<<---\n");
        HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_99__SFR_OFFS,    (DDRSS_PI_99_DATA | (1 << 24))   );
        HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_101__SFR_OFFS,   ((DDRSS_PI_101_DATA & ~(0x1F << 16)) | (0x11 << 16)));
        HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_100__SFR_OFFS,   ((DDRSS_PI_100_DATA & ~(0x1F <<  0)) | (0x12 << 0)));
        HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_317__SFR_OFFS,   ((DDRSS_PI_317_DATA & ~(0x1F1F << 8)) | (0x100A << 8)));
    } 
 

    if(PLATFORM == QT)
    {
        if(DDR_MODE == LPDDR4){
            printf("--->>> LPDDR4 : Manual adjustment for QT sim  <<<---\n");

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_CTL_323__SFR_OFFS, 0x00000101); // DV code changes this manually. Row_diff.  

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_113__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_114__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_115__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_116__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_117__SFR_OFFS,	0x00000340); // DV IXCOM adjustment

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_128__SFR_OFFS,	0x01A00000); // DV IXCOM adjustment 

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_369__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_370__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_371__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_372__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_373__SFR_OFFS,	0x00000340); // DV IXCOM adjustment

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_384__SFR_OFFS,	0x01A00000); // DV IXCOM adjustment

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_625__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_626__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_627__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_628__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_629__SFR_OFFS,	0x00000340); // DV IXCOM adjustment

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_640__SFR_OFFS, 0x01A00000); // DV IXCOM adjustment

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_881__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_882__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_883__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_884__SFR_OFFS,	0x03400340); // DV IXCOM adjustment
            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_885__SFR_OFFS,	0x00000340); // DV IXCOM adjustment

            HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_896__SFR_OFFS,	0x01A00000); // DV IXCOM adjustment


            if(cs_intrlv) {
                printf("--->>> Enabled CS interleave  <<<---\n");
                HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_CTL_328__SFR_OFFS, (DDRSS_CTL_328_DATA | 0x1)); // CS interleave enabled

            } else {
                printf("--->>> Disable CS interleave  <<<---\n");
                HW_WR_REG32(DDRSS_CTL_BASE + DDRSS_CTL_328__SFR_OFFS, (DDRSS_CTL_328_DATA & 0xFFFFFFFE)); // CS interleave disabled
            }

        }

    }

    if(DDR_MODE == LPDDR4){
        //DDRSS_Set_DDR_PLL(DDRSS_PLL_BYPSASS);
        //DDR_PLL_Bypass();
        //printf("--->>> EXPERIMENTAL CONFIG CHANGE FOR UC 1.1 OVERCLOCKING DDR PLL ... <<<---\n");
        //Experimental config change for 1.1
        DDRSS_Set_DDR_PLL(25000000); //replace with bypass
        us_delay(5000);
        printf("--->>> Set DDR PLL to 25MHz for FSP F0... <<<---\n");
    }

    CDNC_init_start();

    if(DDR_MODE == LPDDR4){
        //DDR_Change_freq_ack();	//Wait for 2 Freq change req/ack handshakes (LPDDR4)
        DDR_Change_freq_ack();
        //DDR_Change_freq_ack_no_change_PLL(); // 1.1 Experimental change
        us_delay(500);
    }

    CDNC_wait_init_done();

    printf("--->>> LPDDR4 Initialization is DONE! <<<---\n");
}

menuitem "DDR/Memory Config/Frequency Set Points";

DDRSS_Set_DDR_PLL(unsigned int frequency)
{
    if(frequency == 1000000000){
        Set_MAIN_PLL12_HSDIV0_CLKOUT_1000MHz();
    }else if(frequency == 933000000){
        Set_MAIN_PLL12_HSDIV0_CLKOUT_933_25MHz();
    }else if(frequency == 800000000){
        Set_MAIN_PLL12_HSDIV0_CLKOUT_800MHz();
    }else if(frequency == 400000000){
		Set_MAIN_PLL12_HSDIV0_CLKOUT_400MHz();
	}else if(frequency == 333350000){
		Set_MAIN_PLL12_HSDIV0_CLKOUT_333MHz();
	}else if(frequency == 266500000){
		Set_MAIN_PLL12_HSDIV0_CLKOUT_267MHz();
	}else if(frequency == 200000000){
		Set_MAIN_PLL12_HSDIV0_CLKOUT_200MHz();
    }else if(frequency == 25000000){	//BYPASS
        //Replace with true bypass for Silicon
		Set_MAIN_PLL12_HSDIV0_CLKOUT_25MHz();
    }else{
        printf("Frequency not supported by GEL\n");
    }
}

DDR_Change_freq_ack()
{
    unsigned int req, req_type, counter;

    printf("--->>> Inside DDR_Change_freq_ack function ... <<<---\n");

	//unlock MMR reg 5
	//Partition5 lockkey0
	HW_WR_REG32((CTL_MMR_BASE + 0x15008), 0x68EF3490); //0x80115008
	//Partition5 lockkey1
	HW_WR_REG32(( CTL_MMR_BASE + 0x1500C), 0xD172BC5A);

	us_delay(500);

    printf("--->>> Waiting for first frequency change request ... <<<---\n");

   for(counter = 0; counter < DDRSS_PLL_FHS_CNT; counter++)
      {
		req = (HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x80);
		while((req ) == 0x0){
			req = (HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x80);
		}

		req_type = HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x03;
        GEL_TextOut("Iter %d: Frequency change request type %d received from controller \n",,,,, (counter + 1) ,req_type);

		if(req_type == 1){
              DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
          }else if(req_type == 2){
              DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
          }else if(req_type == 0){
			  DDRSS_Set_DDR_PLL(25000000);	//Replace with true bypass for Silicon
          }else{
              GEL_TextOut("error in DDR_Change_freq_ack\n",,,,,);
          }

		HW_WR_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_ACK), 0x1); //set the ack bit
		while(((HW_RD_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ))) & 0x80) == 0x80);
		HW_WR_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_ACK), 0x0); //clear the ack bit
	  }

	printf("--->>> Frequency Change request handshake is completed... <<<---\n");
}

DDR_Change_freq_ack_no_change_PLL()
{
    unsigned int req, req_type, counter;

    printf("--->>> EXPERIMENTAL CONFIG CHANGE FOR UC 1.1. OVERCLOCKING DDR PLL ... <<<---\n");

	//unlock MMR reg 5
	//Partition5 lockkey0
	HW_WR_REG32((CTL_MMR_BASE + 0x15008), 0x68EF3490); //0x80115008
	//Partition5 lockkey1
	HW_WR_REG32(( CTL_MMR_BASE + 0x1500C), 0xD172BC5A);

	us_delay(500);

    printf("--->>> Waiting for first frequency change request ... <<<---\n");

   for(counter = 0; counter < DDRSS_PLL_FHS_CNT; counter++)
      {
		req = (HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x80);
		while((req ) == 0x0){
			req = (HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x80);
		}

		req_type = HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x03;
        GEL_TextOut("Iter %d: Frequency change request type %d received from controller \n",,,,, (counter + 1) ,req_type);

		if(req_type == 1){
              //DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
          }else if(req_type == 2){
              //DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
          }else if(req_type == 0){
			  //DDRSS_Set_DDR_PLL(25000000);	//Replace with true bypass for Silicon
          }else{
              GEL_TextOut("error in DDR_Change_freq_ack\n",,,,,);
          }

		HW_WR_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_ACK), 0x1); //set the ack bit
		while(((HW_RD_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ))) & 0x80) == 0x80);
		HW_WR_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_ACK), 0x0); //clear the ack bit
	  }

	printf("--->>> Frequency Change request handshake is completed... <<<---\n");
}

Request_DDR_Change_freq(unsigned int req_type)
{
	unsigned int req, req_type_from_ddr, ack, error;
	unsigned int debug_info = 0;

	printf("--->>> Inside Request_DDR_Change_freq function ... <<<---\n");
	//unlock MMR reg 5
	//Partition5 lockkey0
	HW_WR_REG32((CTL_MMR_BASE + 0x15008), 0x68EF3490); //0x63015008
	//Partition5 lockkey1
	HW_WR_REG32(( CTL_MMR_BASE + 0x1500C), 0xD172BC5A);

	us_delay(500);

	if(!(req_type >=0 && req_type <=2)){
		GEL_TextOut("error invalid FSP req_type: %d\n",,,,,req_type);
	}else{
		GEL_TextOut("Setting the req_type and initiating FSP frequency change\n");
		HW_WR_REG32((CTL_MMR_BASE + CHNG_DDR4_FSP_REQ), req_type & 0x3);

		HW_WR_REG32((CTL_MMR_BASE + CHNG_DDR4_FSP_REQ), (req_type & 0x3) + 0x100);

		GEL_TextOut("request sent to DDR, wait for request to come from DDR\n");
		req = (HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x80);
		while(req == 0){
			req = (HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x80);
		}

		req_type_from_ddr = HW_RD_REG32(CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ) & 0x03;
        GEL_TextOut("Frequency change request type %d received from controller \n",,,,, req_type_from_ddr);

		if(req_type_from_ddr == 1){
			DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
		}else if(req_type_from_ddr == 2){
			DDRSS_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
		}else if(req_type_from_ddr == 0){
			//DDRSS_Set_DDR_PLL(DDRSS_PLL_BYPSASS);
			//DDR_PLL_Bypass();
			DDRSS_Set_DDR_PLL(25000000); //replace with bypass
		}else{
			GEL_TextOut("error\n",,,,,);
		}

		HW_WR_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_ACK), 0x1); //set the ack bit
		while(((HW_RD_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_REQ))) & 0x80) == 0x80);
		HW_WR_REG32((CTL_MMR_BASE + DDR4_FSP_CLKCHNG_ACK), 0x0); //clear the ack bit

		// wait for DDR to ack original request, and check error
		ack = HW_RD_REG32((CTL_MMR_BASE + CHNG_DDR4_FSP_ACK) & 0x100);
		while(ack == 0){
			ack = HW_RD_REG32((CTL_MMR_BASE + CHNG_DDR4_FSP_ACK) & 0x100);
		}
		error = HW_RD_REG32((CTL_MMR_BASE + CHNG_DDR4_FSP_ACK) & 0x1);
		if(error ==0){
			GEL_TextOut("FSP change was sucessful\n");
		}else{
			GEL_TextOut("FSP change was not sucessful\n");
		}
	}
}

hotmenu DDR_PLL_Bypass_needs_QT_force()
{
    unsigned int debug_info = 0;
    unsigned int Base_Address = 0x80680000;  //0x80680000 for M3,   0x680000 for R5/A53
    unsigned int address_offset = 0;
    unsigned int PLL_index = 12;
    unsigned int CONTROLOL = 0x20;
    unsigned int HSDIV_index = 0;
    unsigned int hsdiv_value = 7;

    //Unlock the PLL
    Unlock_PLL_MMR(Base_Address, address_offset, PLL_index);  // M3 base address
    if(debug_info){
        GEL_TextOut("Unlocked PLL MMRs.\n");
    }

    Write_MMR_Field((Base_Address + address_offset + (PLL_index * 0x1000) + CONTROLOL), 1, 1, 31);
    if(debug_info){
        GEL_TextOut("DDR PLL Bypassed?\n");
    }

    Lock_PLL_MMR(Base_Address, address_offset, PLL_index);  // M3 base address
    if(debug_info){
        GEL_TextOut("Locked PLL MMRs.\n");
    }
}

