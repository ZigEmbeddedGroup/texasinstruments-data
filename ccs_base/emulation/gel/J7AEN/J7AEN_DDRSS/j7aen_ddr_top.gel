//Translate #defines from other GELs into consistent naming convention for rest of DDR GELs
//Requirements:
//Base address for TI DDR regs
//Offset calculation: 0x80000000-0x0
#define RAT_OFFSET_DDRSS_SS_CTL (0x80000000)
#define DDRSS_SS_BASE           (0x0F300000 + RAT_OFFSET_DDRSS_SS_CTL)

//Base address for Cadence DDR regs
#define DDRSS_CTL_BASE          (0x0F308000 + RAT_OFFSET_DDRSS_SS_CTL)

//Base address for certain MMRs (depending on SoC)
//Must be taken from another GEL file if already defined, will be abstracted to allow for consistent naming

//Offset calculation: 0x60000000-0x40000000
#define RAT_OFFSET_CTL_MMR          0x20000000

//Raw Address on AM64/AM62 should be: 0x43000000
#define CTL_MMR_BASE                (CSL_WKUP_CTRL_MMR0_CFG0_BASE + RAT_OFFSET_CTL_MMR )

//MMR for PLL HSDIVs

//FSP MAIN_CTRL_MMR register offsets
#define CHNG_DDR4_FSP_REQ 		0x14000	// Change LPDDR4 FSP Request Register - initiate a LPDDR4 frequency set point change to the DDR Controller (r/w)
#define CHNG_DDR4_FSP_ACK		0x14004 // Change LPDDR4 FSP Acknowledge Register - DDR Controller to acknowledge the LPDDR4 frequency set point shange request (read only)
#define DDR4_FSP_CLKCHNG_REQ	0x14080 // LPDDR4 FSP Clock Change Request Register - DDR Controller to request the DDR PLL clock frequency change (read only)
#define DDR4_FSP_CLKCHNG_ACK	0x140C0 // LPDDR4 FSP Clock Change Acknowledge Register - acknowledge a DDR PLL clock frequency change to the DDR Controller (r/w)




//Platform defined as a #define or variable called "PLATFORM"
//Must be taken from the top level file for SoC
//Require to have QT, EVM, and SVB at least defined as #defines

//DDR mode intended to be used defined as a define or variable called "DDR_MODE"
//Must be taken from the top level file for SoC
//Require to have LPDDR4 and DDR4 defined as #defines

#define static
#define void
#define uint32_t                  unsigned int
#define HW_WR_REG32(addr, data)   *(uint32_t *) (addr) = (uint32_t) (data)
#define HW_RD_REG32(addr)         *(uint32_t *) (addr)
#define CLR_BITS(input,mask,shift) 		(input & ~(mask<<shift))
#define SET_BITS(input,mask,shift) 		(input | (mask<<shift))
#define PUT_BITS(input,val,mask,shift)	((input & ~(mask<<shift)) | (val<<shift))
#define min(a,b) ((a<b)?a:b)
#define max(a,b) ((a>b)?a:b)
//#define AUTO_TEMP_RANGE 1 //not implemented - need to manually uncomment the section in the DDR controller configuration gel file.



