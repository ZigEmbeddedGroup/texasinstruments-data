//DDR functions
menuitem "PLL Configuration/non-UC/DDR_PLL";

hotmenu Set_MAIN_PLL0_HSDIV2_CLKOUT_400MHz(){
	int debug_info = DEBUG;
	int gel_trace_on  = GEL_TRACE;
    address_offset = AddrOffset();
	//for debugging only: 
	if(debug_info){
		GEL_TextOut("Debugging enabled\n");
	}
	if(gel_trace_on){
		GEL_Trace(1);
		GEL_TextOut("GEL_trace enabled\n");
	}
	else{
		GEL_Trace(0);
	}
	//Main SoC DDR PLL
	GEL_TextOut("Setting MAIN_PLL0_HSDIV2_CLKOUT_400MHz\n");
	Program_HSDIV(CSL_MAIN_PLL0_CFG_BASE, address_offset, MAIN_PLL_INDEX, 2, 4);
	GEL_TextOut("MAIN_PLL0_HSDIV2_CLKOUT set.\n");
}

