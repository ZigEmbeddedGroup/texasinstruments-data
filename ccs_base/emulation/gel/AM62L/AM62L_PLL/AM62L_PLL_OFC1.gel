/*****************************************************************************/
/* PLL functions. */

menuitem "PLL Configuration/OFC1";

menuitem "PLL Configuration/OFC1/Standard Configuration";

/**
 * \brief  Set all PLLs on 
 *
 * \param   none
 *
 * \return  none
 */
hotmenu Set_All_PLL_OFC1(){
	int debug_info = DEBUG;
	int gel_trace_on  = GEL_TRACE;
	address_offset = AddrOffset();

	if(debug_info){
		GEL_TextOut("Debugging enabled\n");
	}
	if(gel_trace_on){
		GEL_Trace(1);
		GEL_TextOut("GEL_trace enabled\n");
	}
	else{
		GEL_Trace(0);
	}

	//Turn on the PLLs.
	GEL_TextOut("Programming all PLLs.\n");
	//WKUP PLL
	GEL_TextOut("Programming WKUP PLL 0 (WKUP PLL)\n");
	Program_PLL(CSL_WKUP_PLL0_CFG_BASE, address_offset, WKUP_PLL_INDEX, OFC1, NONE);
	GEL_TextOut("WKUP PLL 0 (WKUP PLL) Set.\n");
	//MAIN PLL
	GEL_TextOut("Programming Main PLL 0 (Main PLL)\n");
	Program_PLL(CSL_MAIN_PLL0_CFG_BASE, address_offset, MAIN_PLL_INDEX, OFC1, NONE);
	GEL_TextOut("Main PLL 0 (Main PLL) Set.\n");
	//MPU PLL
	GEL_TextOut("Programming Main PLL 8 (ARM0 PLL)\n");
	Program_PLL(CSL_MAIN_PLL0_CFG_BASE, address_offset, ARM0_PLL_INDEX, OFC1, NONE);
	GEL_TextOut("Main PLL 8 (ARM0 PLL) Set.\n");
	//DSS PLL
	GEL_TextOut("Programming Main PLL 17 (DSS PLL)\n");
	Program_PLL(CSL_MAIN_PLL0_CFG_BASE, address_offset, DSS_PLL_INDEX, OFC1, NONE);
	GEL_TextOut("Main PLL 17 (DSS PLL) Set.\n");
	GEL_TextOut("All PLLs programmed.\n");
}

menuitem "PLL Configuration/OFC1/Individual Standard Configurations"

