/*  
Note: if the HSDIV value is -1 that means it's either nonexistent or not used. 
Note: if the mod_div value is -1 that means it isn't programmed beyond the default value of "1", which means the input divider is set to divide-by-1.
Note: the divider values here are directly programmed tothe HSDIV control MMR. They don't factor in the +1 that's added in the hardware. 
	  Users should add +1 to the HSDIV divider values they add in here for any calculations they make outside of the GEL framework and the hardware.
Note: This is configured for OFC1 as defined by SOCDV + Venkat.
*/


#define FREF_QT  25.0 	//25MHz HFOSC0 reference clock on QT
#define FREF_EVM 25.0
#define FREF_SVB 25.0


//WKUP PLL0: WKUP PLL
/* Frequencies:
PLL input: 		25MHz
VCO output:		2400MHz
POSTDIV output: 	1200MHz
HSDIV0 output: 		400MHz 	//Peripheral Sysclk
HSDIV1 output: 		96MHz	//I2C
HSDIV2 output: 		96MHz	//UART
HSDIV3 output: 		100MHz	//GPMC
HSDIV4 output: 		160MHz	//OSPI
HSDIV5 output: 		400MHz  //WKUP_SYSCLK0
HSDIV6 output: 		50MHz	//SPI
HSDIV7 output: 		200MHz  //DMTIMER
HSDIV8 output: 		30MHz	//ADC
HSDIV9 output:		200MHz	//MMCSD
MODSS configuration: 
- Spread: 3.125%
- Modulator Divider: %-by-1
- Downspread or centerspread: downspread
*/
#define WKUP_PLL0_OFC1_FBDIV              96
#define WKUP_PLL0_OFC1_FRACDIV            -1
#define WKUP_PLL0_OFC1_PREDIV             1
#define WKUP_PLL0_OFC1_POSTDIV1           2
#define WKUP_PLL0_OFC1_POSTDIV2           1
#define WKUP_PLL0_OFC1_HSDIV0_DIV_VAL     5  //6
#define WKUP_PLL0_OFC1_HSDIV1_DIV_VAL     24 //25
#define WKUP_PLL0_OFC1_HSDIV2_DIV_VAL     24 //25
#define WKUP_PLL0_OFC1_HSDIV3_DIV_VAL     23 //24
#define WKUP_PLL0_OFC1_HSDIV4_DIV_VAL     14 //15
#define WKUP_PLL0_OFC1_HSDIV5_DIV_VAL     2  //3
#define WKUP_PLL0_OFC1_HSDIV6_DIV_VAL     23 //24
#define WKUP_PLL0_OFC1_HSDIV7_DIV_VAL     5  //6
#define WKUP_PLL0_OFC1_HSDIV8_DIV_VAL     39 //40
#define WKUP_PLL0_OFC1_HSDIV9_DIV_VAL     5  //6
#define WKUP_PLL0_OFC1_SSMOD_SPREAD       0x1F
#define WKUP_PLL0_OFC1_SSMOD_MODDIV       -1
#define WKUP_PLL0_OFC1_SSMOD_DOWNSPREAD   1
//WKUP PLL0 PLL Controller Parameters
#define WKUP_CTRL_BPDIV  	0
#define WKUP_CTRL_OD1 		0
#define WKUP_CTRL_DIV1 		1


//MAIN PLL0: MAIN PLL
/* Frequencies:
PLL input: 		25MHz
VCO output:		2GHz
POSTDIV output: 	1GHz
HSDIV0 output: 		500MHz	//MAIN_SYSCLK
HSDIV1 output: 		N/A   	//Reserved
HSDIV2 output: 		400MHz	//DDR
HSDIV3 output: 		133MHz	//GPMC
HSDIV4 output: 		80MHz	//MCAN
HSDIV5 output: 		200MHz	//MMCSD
HSDIV6 output: 		250MHz	//CPSW/CPTS
HSDIV7 output: 		200MHz	//OSPI
HSDIV8 output: 		100MHz	//USB
HSDIV9 output: 		333MHz	//Debug Trace
MODSS configuration: 
- Spread: 3.125%
- Modulator Divider: %-by-1
- Downspread or centerspread: downspread
*/
#define MAIN_PLL0_OFC1_FBDIV             80   	//fbdiv
#define MAIN_PLL0_OFC1_FRACDIV           -1    	//fracdiv
#define MAIN_PLL0_OFC1_PREDIV            1     	//prediv
#define MAIN_PLL0_OFC1_POSTDIV1          2     	//postdiv1
#define MAIN_PLL0_OFC1_POSTDIV2          1     	//postdiv2
#define MAIN_PLL0_OFC1_HSDIV0_DIV_VAL    3     	//4
#define MAIN_PLL0_OFC1_HSDIV1_DIV_VAL    -1		//disabled
#define MAIN_PLL0_OFC1_HSDIV2_DIV_VAL    4		//5
#define MAIN_PLL0_OFC1_HSDIV3_DIV_VAL    14		//15
#define MAIN_PLL0_OFC1_HSDIV4_DIV_VAL    24		//25
#define MAIN_PLL0_OFC1_HSDIV5_DIV_VAL    4		//5
#define MAIN_PLL0_OFC1_HSDIV6_DIV_VAL    3		//4
#define MAIN_PLL0_OFC1_HSDIV7_DIV_VAL    4		//5
#define MAIN_PLL0_OFC1_HSDIV8_DIV_VAL    9		//10
#define MAIN_PLL0_OFC1_HSDIV9_DIV_VAL    2		//3
#define MAIN_PLL0_OFC1_SSMOD_SPREAD      0x1F	//spread
#define MAIN_PLL0_OFC1_SSMOD_MODDIV      -1    	//mod_div
#define MAIN_PLL0_OFC1_SSMOD_DOWNSPREAD  1     	//downspread


//MAIN PLL8: ARM0 PLL
/* Frequencies:
PLL input: 		25MHz
VCO output:		2500MHz
POSTDIV output: 	2500MHz
HSDIV0 output: 		1.25GHz
HSDIV1 output: 		N/A
HSDIV2 output: 		N/A
HSDIV3 output: 		N/A
HSDIV4 output: 		N/A
HSDIV5 output: 		N/A
HSDIV6 output: 		N/A
HSDIV7 output: 		N/A
HSDIV8 output: 		N/A
MODSS configuration: 
- Spread: 3.125%
- Modulator Divider: %-by-1
- Downspread or centerspread: downspread
*/
#define MAIN_PLL8_OFC1_FBDIV             100
#define MAIN_PLL8_OFC1_FRACDIV           -1
#define MAIN_PLL8_OFC1_PREDIV            1
#define MAIN_PLL8_OFC1_POSTDIV1          1
#define MAIN_PLL8_OFC1_POSTDIV2          1
#define MAIN_PLL8_OFC1_HSDIV0_DIV_VAL    1 //2
#define MAIN_PLL8_OFC1_HSDIV1_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV2_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV3_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV4_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV5_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV6_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV7_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV8_DIV_VAL    -1
#define MAIN_PLL8_OFC1_HSDIV9_DIV_VAL    -1
#define MAIN_PLL8_OFC1_SSMOD_SPREAD      0x1F
#define MAIN_PLL8_OFC1_SSMOD_MODDIV      -1
#define MAIN_PLL8_OFC1_SSMOD_DOWNSPREAD  1


//MAIN PLL17: DSS PLL
/* Frequencies:
PLL input:  	25MHz
VCO output:		2145MHz
POSTDIV output: 	2145MHz
HSDIV0 output: 		165MHz
HSDIV1 output: 		N/A
HSDIV2 output: 		N/A
HSDIV3 output: 		N/A
HSDIV4 output: 		N/A
HSDIV5 output: 		N/A
HSDIV6 output: 		N/A
HSDIV7 output: 		N/A
HSDIV8 output: 		N/A
MODSS configuration: 
- Spread: 3.125%
- Modulator Divider: %-by-1
- Downspread or centerspread: downspread
Typically it's Fout = Fref * (fbdiv_int + fbdiv_frac / 2^24) / refdiv.
*/
#define MAIN_PLL17_OFC1_FBDIV            85
#define MAIN_PLL17_OFC1_FRACDIV          0xCCCCCD
#define MAIN_PLL17_OFC1_PREDIV           1
#define MAIN_PLL17_OFC1_POSTDIV1         1
#define MAIN_PLL17_OFC1_POSTDIV2         1
#define MAIN_PLL17_OFC1_HSDIV0_DIV_VAL   12 //13
#define MAIN_PLL17_OFC1_HSDIV1_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV2_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV3_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV4_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV5_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV6_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV7_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV8_DIV_VAL   -1
#define MAIN_PLL17_OFC1_HSDIV9_DIV_VAL   -1
#define MAIN_PLL17_OFC1_SSMOD_SPREAD     0x1F
#define MAIN_PLL17_OFC1_SSMOD_MODDIV     -1
#define MAIN_PLL17_OFC1_SSMOD_DOWNSPREAD 1


