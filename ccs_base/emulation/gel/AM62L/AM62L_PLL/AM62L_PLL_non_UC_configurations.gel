    Program_PLL(CSL_MAIN_PLL0_CFG_BASE, address_offset, ARM0_PLL_INDEX, OFC1, ARM0_700MHz);
    GEL_TextOut("MAIN_PLL8_HSDIV0_CLKOUT set.\n");
    
    //add delay
    j=0;
    for(j=0; j<50000; j++);
    
    GEL_TextOut("Setting MAIN_PLL8_HSDIV0_CLKOUT_800MHz\n");
    Program_PLL(CSL_MAIN_PLL0_CFG_BASE, address_offset, ARM0_PLL_INDEX, OFC1, ARM0_800MHz);
    GEL_TextOut("MAIN_PLL8_HSDIV0_CLKOUT set.\n");
    
    //add delay
    j=0;
    for(j=0; j<50000; j++);
    
    GEL_TextOut("Setting MAIN_PLL8_HSDIV0_CLKOUT_900MHz\n");
    Program_PLL(CSL_MAIN_PLL0_CFG_BASE, address_offset, ARM0_PLL_INDEX, OFC1, ARM0_900MHz);
    GEL_TextOut("MAIN_PLL8_HSDIV0_CLKOUT set.\n");
    
