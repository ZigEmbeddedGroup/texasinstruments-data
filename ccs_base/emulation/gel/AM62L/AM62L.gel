#define DDR4 	 1
#define LPDDR4 	 2
#define MHZ25    1
int DDR_MODE;	//set in DDR GEL functions based on board
unsigned int AM62_DDRSS_SS_BASE;	
unsigned int AM62_DDRSS_CTL_BASE;
unsigned int WKUP_CTRL_MMR0_CFG0_BASE;

StartUp(){

    //Load the common GEL
    GEL_LoadGel( "$(GEL_file_dir)/AM62L_common/AM62L_common.gel");
    
    //Load init functions for SMS
    GEL_LoadGel( "$(GEL_file_dir)/AM62L_InitConfig.gel");

    //Load the PSC GELs
    GEL_LoadGel( "$(GEL_file_dir)/AM62L_PSC/AM62L_PSC.gel");
   
    //Load the PLL GELS
    GEL_LoadGel( "$(GEL_file_dir)/AM62L_PLL/AM62L_PLL_MMR.gel");

    //Load the DDR GELs
    //GEL_LoadGel("$(GEL_file_dir)/AM62L_DDRSS/AM62x_ddr_top.gel");
    GEL_LoadGel( "$(GEL_file_dir)/AM62L_PLL/AM62L_PLL_PARAMS_OFC1.gel");
    GEL_LoadGel( "$(GEL_file_dir)/AM62L_PLL/AM62L_PLL.gel");
    GEL_LoadGel( "$(GEL_file_dir)/AM62L_PLL/AM62L_PLL_OFC1.gel");
}

OnTargetConnect(){
	Configure_RAT();
    NOBOOT_ROM_safeguard();
	Set_All_PLL_OFC1();
	Set_PSC_All_On();
    GEL_TextOut("\n");
	GEL_TextOut("*****Use Scripts->DDR init from SMS or connect to A53 to configure DDR\n");
}

/* END OF FILE */
