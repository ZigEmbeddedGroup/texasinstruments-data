menuitem "Power Sleep Controller/Reset by Power Domain Controls";

/* Resetting the cores can only be done if they are in WFI */

hotmenu GP_CORE_CTL_Reset()
{
	int status = 0;
	GEL_TextOut("Resetting GP_CORE_CTL...\n");
    //GEL_TextOut("Resetting LPSC_MAIN_GP_ALWAYSON\n");
	//status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_ALWAYSON, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Resetting LPSC_MAIN_GP_TEST\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_TEST, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Resetting LPSC_MAIN_GP_PBIST\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_PBIST, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Resetting LPSC_MAIN_GP_ISO0_N\n");
