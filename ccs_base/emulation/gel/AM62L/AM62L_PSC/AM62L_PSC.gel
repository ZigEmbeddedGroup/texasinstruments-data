menuitem "Power Sleep Controller/Power Up by Power Domain Controls";

hotmenu GP_CORE_CTL_PowerUp()
{
	int status = 0;
	GEL_TextOut("Powering up GP_CORE_CTL...\n");
    //GEL_TextOut("Powering up LPSC_MAIN_GP_ALWAYSON\n");
	//status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_ALWAYSON, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_TEST\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_TEST, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_PBIST\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_PBIST, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_ISO0_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_ISO0_N, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_ISO1_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_ISO1_N, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_TIFS\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_TIFS, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_USB0\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_USB0_ISO_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB0_ISO_N, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_USB1\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB1, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_USB1_ISO_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB1_ISO_N, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_DPHY_TX\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_DPHY_TX, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_GP_WKPERI\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_WKPERI, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up GP_CORE_CTL done.\n");
    return status;
}

