}

menuitem "Power Sleep Controller/Power Down by Power Domain Controls";

/* Note: Powering down the cores can only be done if they are in WFI */

hotmenu GP_CORE_CTL_PowerDown()
{
	int status = 0;
	GEL_TextOut("Powering Down GP_CORE_CTL...\n");
    GEL_TextOut("Powering Down LPSC_MAIN_GP_TEST\n");
