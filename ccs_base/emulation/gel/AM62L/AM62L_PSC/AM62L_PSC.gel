hotmenu PD_MPU_CLST_PowerDown()
{
    unsigned int val = 0;
    int status = 0;    
    
    //L2 Flush Sequence
	GEL_TextOut("Flushing L2 Cache...\n");

    //Disable cache and snoop interface
    *(MAIN_SEC_MMR0_CFG0_BASE+PM_CONFIG_OFFSET) = *(MAIN_SEC_MMR0_CFG0_BASE+PM_CONFIG_OFFSET) | 0x3;

    //Set L2FLUSHREQ
    *(MAIN_SEC_MMR0_CFG0_BASE+PM_CONFIG_OFFSET) = *(MAIN_SEC_MMR0_CFG0_BASE+PM_CONFIG_OFFSET) | (0x1<<5);

    //Poll for L2_HW_FLUSH_DONE
    while((val & 0x00001000) != 0x00001000) val = *(MAIN_SEC_MMR0_CFG0_BASE+PM_status_OFFSET);
	GEL_TextOut("L2 Cache Flushed.\n");

    //Deassert L2FLUSHREQ
    *(MAIN_SEC_MMR0_CFG0_BASE+PM_CONFIG_OFFSET) = *(MAIN_SEC_MMR0_CFG0_BASE+PM_CONFIG_OFFSET) & ~(0x1<<5);
    
	GEL_TextOut("Powering Down PD_MPU_CLST...\n");
	GEL_TextOut("Powering Down LPSC_MAIN_MPU_CLST\n");
    status += Set_MAIN_PSC_State(PD_MPU_CLST, LPSC_MAIN_MPU_CLST, PSC_PD_ON, PSC_SYNCRESETDISABLE);
	GEL_TextOut("Powering Down LPSC_MAIN_MPU_CLST_PBIST\n");
    status += Set_MAIN_PSC_State(PD_MPU_CLST, LPSC_MAIN_MPU_CLST_PBIST, PSC_PD_OFF, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down PD_MPU_CLST done.\n");
	return status;
}

