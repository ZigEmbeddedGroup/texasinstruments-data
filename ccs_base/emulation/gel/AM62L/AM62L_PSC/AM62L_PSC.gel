    GEL_TextOut("Resetting LPSC_MAIN_GP_USB0_ISO_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB0_ISO_N, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Resetting LPSC_MAIN_GP_USB1\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Resetting LPSC_MAIN_GP_USB1_ISO_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB1_ISO_N, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Resetting LPSC_MAIN_GP_DPHY_TX\n");
