    status += Set_MAIN_PSC_State(PD_CRYPTO, LPSC_MAIN_CRYPTO, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Resetting PD_CRYPTO done.\n");
	return status;
}

hotmenu PD_DDRSS_Reset()
    {
    int i;
	int status = 0;
	GEL_TextOut("Resetting PD_DDR...\n");
	GEL_TextOut("Resetting LPSC_MAIN_DDR_LOCAL\n");
    status += Set_MAIN_PSC_State(PD_DDR, LPSC_MAIN_DDR_LOCAL, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Resetting LPSC_MAIN_DDR_CFG_ISO_N\n");
    status += Set_MAIN_PSC_State(PD_DDR, LPSC_MAIN_DDR_CFG_ISO_N, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Resetting LPSC_MAIN_DDR_DATA_ISO_N\n");
    status += Set_MAIN_PSC_State(PD_DDR, LPSC_MAIN_DDR_DATA_ISO_N, PSC_PD_ON, PSC_SYNCRESET);
    
    for(i=0;i<0x10000;i++);
    
    GEL_TextOut("Enabling LPSC_MAIN_DDR_LOCAL\n");
    status += Set_MAIN_PSC_State(PD_DDR, LPSC_MAIN_DDR_LOCAL, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Enabling LPSC_MAIN_DDR_CFG_ISO_N\n");
    status += Set_MAIN_PSC_State(PD_DDR, LPSC_MAIN_DDR_CFG_ISO_N, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Enabling LPSC_MAIN_DDR_DATA_ISO_N\n");
    status += Set_MAIN_PSC_State(PD_DDR, LPSC_MAIN_DDR_DATA_ISO_N, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Resetting PD_DDR done.\n");
    
	return status;
}

