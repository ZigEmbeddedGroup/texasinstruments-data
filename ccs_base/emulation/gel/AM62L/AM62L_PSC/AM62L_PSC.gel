    GEL_TextOut("Powering Down LPSC_MAIN_GP_TIFS\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_TIFS, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down LPSC_MAIN_GP_USB0\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB0, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down LPSC_MAIN_GP_USB0_ISO_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB0_ISO_N, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down LPSC_MAIN_GP_USB1\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB1, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down LPSC_MAIN_GP_USB1_ISO_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_USB1_ISO_N, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down LPSC_MAIN_GP_DPHY_TX\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_DPHY_TX, PSC_PD_ON, PSC_SYNCRESETDISABLE);
