    GEL_TextOut("Powering Down LPSC_MAIN_GP_PBIST\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_PBIST, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down LPSC_MAIN_GP_ISO0_N\n");
    status += Set_MAIN_PSC_State(GP_CORE_CTL, LPSC_MAIN_GP_ISO0_N, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering Down LPSC_MAIN_GP_ISO1_N\n");
