    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00030E00 ); //CS3 MR14
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01030E00 ); //trigger read
