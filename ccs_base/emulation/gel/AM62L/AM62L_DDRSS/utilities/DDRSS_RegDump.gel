hotmenu MR_testing()
{   
    //set FSP_WR_CURRENT = 0
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS, HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS) & ~0x1);
    GEL_TextOut("Setting FSP_WR_CURRENT = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS));

    //read MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000C00 ); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000C00 ); //trigger read
    GEL_TextOut("MR12 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010C00 ); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010C00 ); //trigger read
    GEL_TextOut("MR12 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    
    //read MR14
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000E00 ); //CS1 MR14
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000E00 ); //trigger read
    GEL_TextOut("MR14 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010E00 ); //CS1 MR14
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010E00 ); //trigger read
    GEL_TextOut("MR14 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    //write unique values to MR12 and read back
    
    //write MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0080000C); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_225__SFR_OFFS, 0x1F);       //data
    
    //trigger write
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0280000C);
    
    GEL_TextOut("Writing 0x1F to MR12 CS0\n");
    
    //read MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000C00 ); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000C00 ); //trigger read
    GEL_TextOut("MR12 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010C00 ); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010C00 ); //trigger read
    GEL_TextOut("MR12 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));
    

    //write MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0080010C); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_226__SFR_OFFS, 0x29);       //data
        
    //trigger write
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0280010C);
        
    GEL_TextOut("Writing 0x29 to MR12 CS1\n");
        
    //read MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000C00 ); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000C00 ); //trigger read
    GEL_TextOut("MR12 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010C00 ); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010C00 ); //trigger read
    GEL_TextOut("MR12 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));
    
}


hotmenu MR_testing_FSP()
{   
    //set FSP_WR_CURRENT = 0
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS, HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS) & ~0x1);
    GEL_TextOut("Setting FSP_WR_CURRENT = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS));

    //read MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000C00 ); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000C00 ); //trigger read
    GEL_TextOut("MR12 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010C00 ); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010C00 ); //trigger read
    GEL_TextOut("MR12 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    
    //read MR14
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000E00 ); //CS01 MR14
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000E00 ); //trigger read
    GEL_TextOut("MR14 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010E00 ); //CS1 MR14
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010E00 ); //trigger read
    GEL_TextOut("MR14 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    //write unique values to MR12 and read back
    
    //write MRW_DFS_UPDATE_FRC
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_194__SFR_OFFS, 0x01000000); //freq1
        
    //write MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0080000C); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_225__SFR_OFFS, 0x11);       //data
    
    //trigger write
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0280000C);
    
    GEL_TextOut("Writing 0x11 to MR12 CS0, freq 1\n");
    
    //read MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000C00 ); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000C00 ); //trigger read
    GEL_TextOut("MR12 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010C00 ); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010C00 ); //trigger read
    GEL_TextOut("MR12 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));
    
    //write MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0080010C); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_226__SFR_OFFS, 0x5);       //data
        
    //trigger write
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_190__SFR_OFFS, 0x0280010C);
        
    GEL_TextOut("Writing 0x5 to MR12 CS1\n");
        
    
    //set FSP_WR_CURRENT = 1
        HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS, HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS) | 0x1);
        GEL_TextOut("Setting FSP_WR_CURRENT = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_282__SFR_OFFS));

    //read MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000C00 ); //CS0 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000C00 ); //trigger read
    GEL_TextOut("MR12 CS0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));

    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00010C00 ); //CS1 MR12
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01010C00 ); //trigger read
    GEL_TextOut("MR12 CS1 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));
    
}


