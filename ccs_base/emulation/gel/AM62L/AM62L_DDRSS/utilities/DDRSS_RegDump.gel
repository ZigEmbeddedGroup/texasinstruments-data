    //GEL_TextOut("MR16_DATA_0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_268__SFR_OFFS) >> 24);

    //MR17 is write only, read from controller register
    //GEL_TextOut("MR17_DATA_0 = %x\n",,,,,(HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_269__SFR_OFFS) >> 8) & 0xFF);

