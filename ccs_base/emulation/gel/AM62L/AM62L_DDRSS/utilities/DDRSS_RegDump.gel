hotmenu Memory_RegDump()
{
    //MR0
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x00000000 ); //CS0 MR0
    HW_WR_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_191__SFR_OFFS, 0x01000000 ); //trigger read
    GEL_TextOut("MR0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_CTL_192__SFR_OFFS));
    
    //MR1 is write only, read from controller register
    GEL_TextOut("MR1_DATA_F1_0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_337__SFR_OFFS));
    GEL_TextOut("MR1_DATA_F2_0 = %x\n",,,,,HW_RD_REG32(AM62A_DDRSS_CTL_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_345__SFR_OFFS));
        
