}
Check_FSP_Complete()
{
	//check saus of freq change
	if(((HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_342__SFR_OFFS) >>16 ) & 0x1) == 0x1)
	{
		GEL_TextOut("The DFS request from the hardware interface was ignored because the dfs enable parameter is cleared to ’b0, the memory was still initializing, or the DQS oscillator was in progress\n");	
		HW_WR_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_350__SFR_OFFS,0x1);  //ack and clear the int
	}
	if(((HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_342__SFR_OFFS) >>16 ) & 0x2) == 0x2)
	{
		GEL_TextOut("The DFS operation initiated by the hardware interface was terminated because the PHY did not de-assert the dfi init complete signal within the time specified in the tdfi init start fN parameter after the controller asserted the dfi init start signal during a DFS operation\n");
		HW_WR_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_350__SFR_OFFS,0x2);  //ack and clear the int	
	}
	if(((HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_342__SFR_OFFS) >>16 ) & 0x4) == 0x4)
	{
		GEL_TextOut("A DFS operation initiated by the hardware interface completed\n");
		HW_WR_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_350__SFR_OFFS,0x4);  //ack and clear the int
	}
	if(((HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_342__SFR_OFFS) >>16 ) & 0x8) == 0x8)
	{
		GEL_TextOut("The DFS request from software was ignored because the dfs enable parameter is cleared to ’b0, the memory was still initializing, or the DQS oscillator was in progress\n");
		HW_WR_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_350__SFR_OFFS,0x8);  //ack and clear the int
	}
	if(((HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_342__SFR_OFFS) >>16 ) & 0x10) == 0x10)
	{
		GEL_TextOut("The DFS operation initiated by the software interface was terminated because the PHY did not de-assert the dfi init complete signal within the time specified in the tdfi init start fN parameter after the controller asserted the dfi init start signal during a DFS operation\n");
		HW_WR_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_350__SFR_OFFS,0x10);  //ack and clear the int
	}
	if(((HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_342__SFR_OFFS) >>16 ) & 0x20) == 0x20)
	{
		GEL_TextOut("A DFS operation initiated by software completed.");
		HW_WR_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_350__SFR_OFFS,0x20);  //ack and clear the int
	}
}

Request_FSP_0()
{
	Request_DDR_Change_freq(0);
}

hotmenu Request_FSP_1()
{
	Request_DDR_Change_freq(1);
	Check_FSP_Complete();
}

hotmenu Request_FSP_2()
{
	Request_DDR_Change_freq(2);
	Check_FSP_Complete();
}	
/* This is dummy function - GEL does not work real-time.
 * If GELs are imported to C code, this function must be implemented a loop of
 * "delay" microseconds
 */
static void us_delay(uint32_t delay)
{
    uint32_t loop;
    for (loop = 0; loop < delay * 100; loop++)
    {
        loop = loop;
    }
}

/* Wrapper function to simplify importing GEL file to a C code */
printf(char *temp)
{
    GEL_TextOut(temp);
}

menuitem "ResetInNoBootMode"

hotmenu ResetInNoBootMode()
{
    GEL_TextOut("Run this script from R5 core\n");
    Write_MMR(0x43000030,0xFB);
    GEL_TextOut("Changing bootmode to NoBoot\n");
    GEL_TextOut("Performing warm reset...\n");
    GEL_TextOut("Ignore errors beyond this point...\n");
    Write_MMR(0x04518170,(Read_MMR(0x04518170) & ~0xF00) | 0x600); //CTRLMMR_MCU_RST_CTRL[11:8] = 0x6 for MCU warm reset

}        

hotmenu FSP_Status()
{
	
	GEL_TextOut("Current frequency being used is F%d\n",,,,,(HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_177__SFR_OFFS) >> 24 & 0x3));
	GEL_TextOut("FSP set that is currently in use:  %d\n",,,,,(HW_RD_REG32(AM62_DDRSS_CTL_BASE + DDRSS_CTL_278__SFR_OFFS) >> 24 & 0x1));
}	
	
