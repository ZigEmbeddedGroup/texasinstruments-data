{
    Write_MMR(MSS_RCM_U_BASE + MSS_RCM_LOCK0_KICK0,0x01234567);
    Write_MMR(MSS_RCM_U_BASE + MSS_RCM_LOCK0_KICK1 ,0xFEDCBA8);
    GEL_TextOut("MSS_RCM Control Registers Unlocked\n");
}



hotmenu TOP_CTRL_unlock()
{
    Write_MMR(TOP_CTRL_U_BASE + TOP_CTRL_LOCK0_KICK0,0x01234567);
    Write_MMR(TOP_CTRL_U_BASE + TOP_CTRL_LOCK0_KICK1,0xFEDCBA8);
    GEL_TextOut("TOP_CTRL Control Registers Unlocked\n");
}
	

hotmenu C2K_CTRL_unlock()
{
    Write_MMR(CONTROLSS_CTRL_U_BASE + CONTROLSS_CTRL_LOCK0_KICK0,0x01234567);
    Write_MMR(CONTROLSS_CTRL_U_BASE + CONTROLSS_CTRL_LOCK0_KICK1,0xFEDCBA8);
    GEL_TextOut("CONTROLSS_CTRL Control Registers Unlocked\n");
}	
    
hotmenu R5F_ROM_eclipse()
{
	Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_ROM_ECLIPSE,0x7);
	 while( ((Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_STATUS_REG) & 0x1)   != 0x1) ) {
	       }	
    GEL_TextOut("R5F ROM Eclipse\n");
}


hotmenu R5F_SS0_Core0_unhalt()
{
	Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_CORE0_HALT,0x00000000);
	GEL_TextOut("R5FSS0_0 Released\n");
}


hotmenu R5F_SS0_Core1_unhalt()
{
//	Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_CONTROL,0x00000000);
	Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_CORE1_HALT,0x00000000);
    GEL_TextOut("R5FSS0_1 Released\n");
}



hotmenu R5F_SS0_Reset()
{
  Write_MMR(MSS_RCM_U_BASE+MSS_RCM_R5SS0_RST2ASSERTDLY, 0x0);  
  Write_MMR(MSS_RCM_U_BASE+MSS_RCM_R5SS0_RST_WFICHECK, 0x00000707);  
  Write_MMR(MSS_CTRL_U_BASE+MSS_CTRL_R5SS0_CONTROL, 0x707);
  Write_MMR(MSS_CTRL_U_BASE+MSS_CTRL_R5SS0_CONTROL, 0x700);
//  Write_MMR(MSS_CTRL_U_BASE+MSS_CTRL_R5SS0_CONTROL, 0x70700);
  Write_MMR(MSS_CTRL_U_BASE+MSS_CTRL_R5SS0_CONTROL, 0x70000);
  Write_MMR(MSS_CTRL_U_BASE+MSS_CTRL_R5SS0_FORCE_WFI, 0x7); 

  GEL_TextOut("\n\n***R5FSS0 Reset Complete***\n");
}



hotmenu R5F_SS0_POR_Reset()
{
	Write_MMR(MSS_RCM_U_BASE + MSS_RCM_R5SS0_POR_RST_CTRL, 0x7);
	Write_MMR(MSS_RCM_U_BASE + MSS_RCM_R5SS0_POR_RST_CTRL, 0x0);
	GEL_TextOut("\n*R5FSS0 POR Complete*\n");
}



hotmenu MSS_L2_Mem_Init()
{
    Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_L2IOCRAM_MEM_INIT,0x7);
    while( ((Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_L2OCRAM_MEM_INIT_DONE) & 0x7)   != 0x7)) {
           }
    GEL_TextOut("L2 Mem Init Complete\n");
}

hotmenu MSS_TPCC_Mem_Init()
{
    Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_TPCC_MEM_INIT,0x1);
    while( ((Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_TPCC_MEM_INIT_DONE) & 0x1)   != 0x1) ) {
        }
    GEL_TextOut("TPCC Mem Init Complete\n");
}

hotmenu MailBox_MEM_Init()
{
    Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_MAILBOXRAM_MEM_INIT , 0x1);

    while( ((Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_MAILBOXRAM_MEM_INIT_DONE) & 0x1)   != 0x1) ) {
    }
    GEL_TextOut("MailBox Mem Init Complete\n");
}


hotmenu Dual_core_switch()

{
 
    Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_CONTROL,0x00000000);
    while( ((Read_MMR_Field(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_STATUS_REG,1,8) & 0x1)   != 0x0) ) {
       }
    GEL_TextOut("Switch to dual core mode \n");

}


hotmenu TCM_MEM_Init()

{

    Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_ATCM_MEM_INIT, 0x1); //TCMA0
    Write_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_BTCM_MEM_INIT, 0x1); //TCMB0

    while( ((Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_ATCM_MEM_INIT_DONE) & 0x1)   != 0x1) ) {
       }
    while( ((Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_BTCM_MEM_INIT_DONE) & 0x1)   != 0x1) ) {
           }

    GEL_TextOut("AM261x TCM MEM init Done\n");

}

hotmenu R5F_SS0_Reset_Lockstep()
{
    
  Write_MMR(MSS_RCM_U_BASE+MSS_RCM_R5SS0_RST2ASSERTDLY, 0x0);
  Write_MMR(MSS_RCM_U_BASE+MSS_RCM_R5SS0_RST_WFICHECK, 0x00000707);
  Write_MMR(MSS_CTRL_U_BASE+MSS_CTRL_R5SS0_FORCE_WFI, 0x7);

  GEL_TextOut("\n\n***R5FSS0 Reset for Lockstep ***\n\n");
  
}

hotmenu read_tcm()
{
    Read_MMR(0x00000000);    
}

hotmenu Core_Frequency_Select()

{
    //This API identifies the AM261x Package and calls Configure_R5F0_400MHZ for Automotive package and Configure_R5F0_500MHZ for Industrial package.

  if( ((Read_MMR( TOP_CTRL_U_BASE + TOP_CTRL_EFUSE_JTAG_USERCODE_ID ) & 0x7)   == 0x6) ) {
	 GEL_TextOut("ZCZ - 15 mm x 15 mm Package \n");
	 Configure_R5F0_400MHZ();
       }
 if( ((Read_MMR( TOP_CTRL_U_BASE  + TOP_CTRL_EFUSE_JTAG_USERCODE_ID ) & 0x7)   == 0x2) ) {
 	GEL_TextOut("ZFG - 13.25 mm x 13.25 mm Package\n");
	Configure_R5F0_500MHZ();
           }
 if( ((Read_MMR( TOP_CTRL_U_BASE  + TOP_CTRL_EFUSE_JTAG_USERCODE_ID ) & 0x7)   == 0x4) ) {
	GEL_TextOut("ZEJ - 13 mm x 13 mm Package\n");
    Configure_R5F0_400MHZ();
           }
 if( ((Read_MMR( TOP_CTRL_U_BASE  + TOP_CTRL_EFUSE_JTAG_USERCODE_ID ) & 0x7)   == 0x1) ) {
	GEL_TextOut("ZNC - 10 mm x 10 mm Package\n");
	Configure_R5F0_500MHZ();
           }

}

hotmenu Control_MMR_Register_Unlock()

{
    MSS_CTRL_unlock();
    MSS_TOPRCM_unlock();
    MSS_RCM_unlock();
    MSS_IOMUX_Unlock();
    TOP_CTRL_unlock();
    C2K_CTRL_unlock();
    
}


dialog read_32b_value_32b_address(address "Address: " )
{
        unsigned int * p_address;
        p_address = (unsigned int *) address;

        GEL_TextOut("Address %x:      %x\n",,,,,
        address,
        *p_address) ;
}

dialog write_32b_value_32b_address(address "Address: ", value "Value:" )
{
        unsigned int * p_address;
        p_address = (unsigned int *) address;
        *p_address = value;
        GEL_TextOut("writing %x to address: %x\n",,,,,
        value,
        address) ;
}


