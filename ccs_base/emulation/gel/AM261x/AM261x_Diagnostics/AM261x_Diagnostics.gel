menuitem "AM261x Diagnostics";



hotmenu AM261x_Cryst_Clock_Loss_Status()
{
	unsigned int  val_crystal_clk_loss_stat;
	val_crystal_clk_loss_stat = Read_MMR(MSS_TOP_RCM_U_BASE + MSS_TOP_RCM_CLK_LOSS_STATUS);
	
	if((val_crystal_clk_loss_stat & 1) == 0x1)
		GEL_TextOut("Crystal Clock not present \n");
	else
		GEL_TextOut("Crystal Clock present \n");
}



hotmenu AM261x_RC_Clock_Boot_Status()
{
	unsigned int  val_rc_clk_boot_stat;
	val_rc_clk_boot_stat = Read_MMR(MSS_TOP_RCM_U_BASE + MSS_TOP_RCM_CLK_LOSS_STATUS);
	if((val_rc_clk_boot_stat & 0x100) == 1)
		GEL_TextOut("RC Clock  present at boot \n");
	else
		GEL_TextOut("RC Clock not present at boot\n");
}


hotmenu AM261x_SOP_Mode()
{
	unsigned int  val_sop_mode ;
	val_sop_mode = Read_MMR(MSS_TOP_RCM_U_BASE + MSS_TOP_RCM_SOP_MODE_VALUE);

	GEL_TextOut("SOP MODE = %x    \n",,,,, val_sop_mode);
	
	if(val_sop_mode == 0)
		GEL_TextOut("QSPI - 4S Functional boot mode\n");
	else if(val_sop_mode == 1)
		GEL_TextOut("UART Functional boot mode\n");
	else if(val_sop_mode == 2)
	     GEL_TextOut("QSPI - 1S Functional boot mode\n");
    else if(val_sop_mode == 3)
        GEL_TextOut("OSPI - 8S Functional boot mode\n");
    else if(val_sop_mode == 6)
        GEL_TextOut("OSPI Serial NAND (1S) - Single Read boot mode  \n");
    else if(val_sop_mode == 7)
        GEL_TextOut("OSPI Serial NAND (4S) - Quad Read Mode\n");
    else if(val_sop_mode == 11)
        GEL_TextOut("DevBoot mode \n");
    else if(val_sop_mode == 12)
        GEL_TextOut("OSPI - 8D (xSPI SFDP) Functional boot mode \n");
    else if(val_sop_mode == 13)
        GEL_TextOut("OSPI Serial NAND (8S) - Octal Read boot mode \n");
    else if(val_sop_mode == 14)
        GEL_TextOut("USB DFU boot mode \n");
    else 
      GEL_TextOut("******************* ERROR!!! Reserved Boot Mode ***************\n");		
}


hotmenu AM261x_Read_Device_Type()
{
    unsigned int dev_type;
    dev_type = Read_MMR(TOP_CTRL_U_BASE + TOP_CTRL_EFUSE_DEVICE_TYPE);
    GEL_TextOut("EFuse Device Type Value = %x    \n",,,,, dev_type);
}


hotmenu AM261x_dual_or_lockstep_mode()
{
	unsigned int r5fss0;
	
		r5fss0 = Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_STATUS_REG);
		 GEL_TextOut("r5fss0 = %x    \n",,,,, r5fss0);
		
		if((r5fss0 & (1 << 8)) != 0)
		{
			GEL_TextOut("*** R5FSS0 is in Lockstep mode *** \n\n");	
		}
		else
		{
			GEL_TextOut("*** R5FSS0 is in Dual core mode *** \n\n");	
		}
			
		
}


hotmenu AM261x_Single_Core_mode()
{
	unsigned int r5fss0;
	
		 r5fss0 = Read_MMR(MSS_CTRL_U_BASE + MSS_CTRL_R5SS0_STATUS_REG);
		 GEL_TextOut("R5FSS0 = %x    \n\n",,,,, r5fss0);	
			
		
}

hotmenu Clockout0_Clock_Config_R5SS0()
{
    Write_MMR(0x531000DC, 0x2);
    Write_MMR(MSS_TOP_RCM_U_BASE + MSS_TOP_RCM_CLKOUT0_CLK_SRC_SEL, 0x111); //DPLL_CORE_HSDIV0_CLKOUT0  
    Write_MMR(MSS_TOP_RCM_U_BASE + MSS_TOP_RCM_CLKOUT0_DIV_VAL, 0x999);
}


