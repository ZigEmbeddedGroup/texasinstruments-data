/*
 * Platform: AM261x Sitara MCU SoCs - AM261x
 * Usage: This GEL will be run from CCS upon connection to the AM261x Device - "Cortex_R5_0" Core.
 *        Comment this GEL_RESET() api in onTargetConnnect() if running AM261x.gel from DAP.
 */


StartUp(){
    //Load Register offsets
    GEL_LoadGel( "$(GEL_file_dir)/AM261x_common/AM261x_reg_offsets.gel");

    //Load the common GEL
    GEL_LoadGel( "$(GEL_file_dir)/AM261x_common/AM261x_common.gel");

    //Load the PLL GEL
    GEL_LoadGel( "$(GEL_file_dir)/AM261x_PLL/AM261x_PLL.gel");

    //Load Peripheral clocks gel file
    GEL_LoadGel( "$(GEL_file_dir)/AM261x_PLL/AM261x_Peripheral_Clocks.gel");

    //Load the PRU GEL.
    GEL_LoadGel( "$(GEL_file_dir)/AM261x_PRU/AM261x_PRU.gel");

	//Load Diagnostics gel file
	GEL_LoadGel("$(GEL_file_dir)/AM261x_Diagnostics/AM261x_Diagnostics.gel");
}


OnTargetConnect(){
    GEL_TextOut("***OnTargetConnect() Launched***\n");
    GEL_TextOut("AM261x Initialization Scripts Launched. \nPlease Wait...\n");

    GEL_TextOut("***AM261x Checks sequence Launched...\n");
    GEL_TextOut("AM261x_Cryst_Clock_Loss_Status() Launched\n");
    AM261x_Cryst_Clock_Loss_Status();

    GEL_TextOut("AM261x_SOP_Mode() Launched\n");
    AM261x_SOP_Mode();

    GEL_TextOut("AM261x_Read_Device_Type() Launched\n");
    AM261x_Read_Device_Type();

    GEL_TextOut("AM261x_dual_or_lockstep_mode() Launched\n");
    AM261x_dual_or_lockstep_mode();

    GEL_TextOut("*** Note:Please call this function for Dual Core switch: Dual_core_switch() \n\n");

    GEL_TextOut("Control_MMR_Register_Unlock() Launched\n");
    Control_MMR_Register_Unlock();

    GEL_TextOut("Configure_R5F0() Launched\n");
    Core_Frequency_Select(); 

    //Configure_R5F0_400MHZ(); //uncomment this, to configure R5F at 400MHZ
    //Configure_R5F0_500MHZ(); //uncomment this, to configure R5F at 500MHZ

   /* Comment this GEL_Reset() api if running AM261x.gel from DAP */
    GEL_Reset();
}

OnPreFileLoaded()
{
   GEL_Reset();
   GEL_TextOut("CPU reset (soft reset) has been issued through GEL on program load.\n");
}


menuitem "AM261x Device Initialization";

hotmenu Configure_R5F0_400MHZ()
{
    Program_R5FCLK_400M_SYSCLK_200M();
    GEL_TextOut("AM261x R5F running at 400Mhz\n");

    Dual_core_switch();
    GEL_TextOut("AM261x Dual core switch\n");

    R5F_ROM_eclipse();
    R5F_SS0_Core0_unhalt();
    R5F_SS0_Core1_unhalt();

    TCM_MEM_Init();
    MSS_L2_Mem_Init();
    MailBox_MEM_Init();
    AM261x_dual_or_lockstep_mode();

	Configure_All_Peripheral_Clks_400MHzPLL();
}


hotmenu Configure_R5F0_500MHZ()
{
    Program_R5FCLK_500M_SYSCLK_250M();
    GEL_TextOut("AM261x R5F running at 500Mhz\n");

    Dual_core_switch();
    GEL_TextOut("AM261x Dual core switch\n");

    R5F_ROM_eclipse();
    R5F_SS0_Core0_unhalt();
    R5F_SS0_Core1_unhalt();

    TCM_MEM_Init();
    MSS_L2_Mem_Init();
    MailBox_MEM_Init();
    AM261x_dual_or_lockstep_mode();

	Configure_All_Peripheral_Clks_500MHzPLL();
}
