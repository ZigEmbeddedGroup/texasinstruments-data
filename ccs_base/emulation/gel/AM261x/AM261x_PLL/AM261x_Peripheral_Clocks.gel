Write_MMR(MSS_RCM_U_BASE+MSS_RCM_LIN1_CLK_GATE, 0x7);
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_LIN2_CLK_GATE, 0x7);
 
//UART
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_UART0_CLK_GATE, 0x7);
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_UART1_CLK_GATE, 0x7);
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_UART2_CLK_GATE, 0x7);
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_UART3_CLK_GATE, 0x7);
 
//RGMII
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_RGMII_250_CLK_GATE, 0x7);
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_RGMII_50_CLK_GATE, 0x7);
