Write_MMR(MSS_RCM_U_BASE+MSS_RCM_I2C1_CLK_GATE, 0x7);
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_I2C2_CLK_GATE, 0x7);
 
//LIN
