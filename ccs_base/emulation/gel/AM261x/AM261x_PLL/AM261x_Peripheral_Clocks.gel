/* Revision history:
* [05-15-25] Adding Additional 400MHz clock configuration functions for RTI, RTI_WDT, LIN_UART, I2C, MCAN, OSPI, ICSSM_CORE, ICSSM_UART, TRACE, GPMC, ELM, MMCSD, MCSPI, CONTROLSS, CPTS
*/
 
 
menuitem "AM261x IP Clocks Configuration";
 
hotmenu Program_RTI0_Clocks()
{
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_RTI0_CLK_DIV_VAL, 0x000);
Write_MMR(MSS_RCM_U_BASE+MSS_RCM_RTI0_CLK_SRC_SEL, 0x222);
while(Read_MMR(MSS_RCM_U_BASE + MSS_RCM_RTI0_CLK_STATUS) != 0x4);
GEL_TextOut("RTI0 Clock Enabled (250MHz)\n");
}
 
 
