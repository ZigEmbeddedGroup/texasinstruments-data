/* StartUp()              - Executed whenever CCS is invoked         */
/* OnReset()              - Executed after Debug->Reset CPU          */
/* OnRestart()            - Executed after Debug->Restart            */
/* OnPreFileLoaded()      - Executed before File->Load Program       */
/* OnFileLoaded()         - Executed after File->Load Program        */
/* OnTargetConnect()      - Executed after Debug->Connect            */

#define PWRAP_DPREC0                            (0x0U)
#define PWRAP_SPREC                             (0x00F0U)

int gGEL_Reset_Done;
int gGEL_ResetCalled = 0;
int gGEL_RemoteCmd_Done;

menuitem "MSPM33C321A_Commands"

/* initialize CCS debugger memory map                                */
hotmenu memorymap_init()
{
    /*
     * Syntax for GEL_MapAddStr.
     * GEL_MapAddStr(address, page, length, "attribute", waitstate);

    Basic Attribute Types           Derived Attribute Types
    String      Description         String      Description
    R           Read                NONE        No memory/protected
    W           Write               RAM         Read and write
    P           Port                ROM         Read only
    EX          External            WOM         Write only
    EM          Emulator            INPORT      Port read only
    PR          Programmable        OUTPORT     Port write only
    ER          Erasable            IOPORT      Port read and write
    DA          Dual access         SARAM       Single access RAM
    ASn         Access size         DARAM       Dual access RAM
    SHnC        Shared              FLASH       Flash ROM
    CACHE       Cache               EXRAM       External RAM
    TX          Text                EXROM       External ROM
    MN          Monitor             EPROM       Erasable write-able EPROM
    SA          Single access       MONITOR     Monitor ROM
    FL          Flash               PRAM        Program RAM
    MR          Memory mapped       PROM        Program ROM
    NULL        NULL                NULL        NULL
    */

    GEL_MapAddStr(0x00000000, 0, 0x00100000, "R|AS4", 0);   /* FLASH_Main_ECC_Corrected */
    GEL_MapAddStr(0x40028000, 0, 0x00002000, "R|W|AS4", 0); /* FRI */
    GEL_MapAddStr(0x4002D000, 0, 0x00002000, "R|W|AS4", 0); /* EAM */
    GEL_MapAddStr(0x4002B000, 0, 0x00002000, "R|W|AS4", 0); /* MEMCFG */
    GEL_MapAddStr(0x40020000, 0, 0x00001F00, "R|W|AS4", 0); /* DMA0 */
    GEL_MapAddStr(0x40022000, 0, 0x00001F00, "R|W|AS4", 0); /* DMA1 */
    /* GEL_MapAddStr(0x01000000, 0, 0x11FFFFFF, "R|W|AS4", 0); */

    GEL_MapAddStr(0x20000000, 0, 0x00040000, "R|W|AS4", 0); /* SRAM */
    GEL_MapAddStr(0x20100000, 0, 0x00040000, "R|W|AS4", 0); /* SRAM_Parity */
    GEL_MapAddStr(0x20200000, 0, 0x00040000, "R|W|AS4", 0); /* SRAM_No_Parity */
    GEL_MapAddStr(0x20300000, 0, 0x00040000, "R|W|AS4", 0); /* SRAM_Parity_Code */
    GEL_MapAddStr(0x40000000, 0, 0x00002000, "R|W|AS4", 0); /* ADC0_ADC_LITE_REGS */
    GEL_MapAddStr(0x40002000, 0, 0x00002000, "R|W|AS4", 0); /* ADC1_ADC_LITE_REGS */
    GEL_MapAddStr(0x40004000, 0, 0x00002000, "R|W|AS4", 0); /* ADC0_ADC_LITE_RESULT_REGS */
    GEL_MapAddStr(0x40006000, 0, 0x00002000, "R|W|AS4", 0); /* ADC1_ADC_LITE_RESULT_REGS */
    GEL_MapAddStr(0x40010000, 0, 0x00001F00, "R|W|AS4", 0); /* TIMA0_0 */
    GEL_MapAddStr(0x40012000, 0, 0x00001F00, "R|W|AS4", 0); /* TIMA0_1 */
    GEL_MapAddStr(0x40032000, 0, 0x00001F00, "R|W|AS4", 0); /* QSPI */
    GEL_MapAddStr(0x40042000, 0, 0x00002000, "R|W|AS4", 0); /* FLASHCTL */
    GEL_MapAddStr(0x40044000, 0, 0x00001E00, "R|W|AS4", 0); /* TRNG */
    GEL_MapAddStr(0x40046000, 0, 0x00002000, "R|W|AS4", 0); /* GSC */
    GEL_MapAddStr(0x400AF000, 0, 0x00786818, "R|W|AS4", 0); /* SYSCTL */
    GEL_MapAddStr(0x400C0000, 0, 0x00001F00, "R|W|AS4", 0); /* TIMG4_0 */
