    GEL_MapAddStr(0x5062A000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC5_I2CC */
    GEL_MapAddStr(0x50644000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC2_I2CT */
    GEL_MapAddStr(0x50646000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC3_I2CT */
    GEL_MapAddStr(0x5064A000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC5_I2CT */
    GEL_MapAddStr(0x50660000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC0_SPI */
    GEL_MapAddStr(0x5066A000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC5_SPI */
    GEL_MapAddStr(0x50680000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC0 */
    GEL_MapAddStr(0x50684000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC2 */
    GEL_MapAddStr(0x50686000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC3 */
    GEL_MapAddStr(0x50688000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC4 */
    GEL_MapAddStr(0x5068A000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS1_UC5 */
    GEL_MapAddStr(0x50700000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC0_UART */
    GEL_MapAddStr(0x50700000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2 */
    GEL_MapAddStr(0x50702000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC1_UART */
    GEL_MapAddStr(0x50704000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC2_UART */
    GEL_MapAddStr(0x50706000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC3_UART */
    GEL_MapAddStr(0x50720000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC0_I2CC */
    GEL_MapAddStr(0x50722000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC1_I2CC */
    GEL_MapAddStr(0x50724000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC2_I2CC */
    GEL_MapAddStr(0x50726000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC3_I2CC */
    GEL_MapAddStr(0x50740000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC0_I2CT */
    GEL_MapAddStr(0x50742000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC1_I2CT */
    GEL_MapAddStr(0x50744000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC2_I2CT */
    GEL_MapAddStr(0x50746000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC3_I2CT */
    GEL_MapAddStr(0x50760000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC0_SPI */
    GEL_MapAddStr(0x50762000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC1_SPI */
    GEL_MapAddStr(0x50764000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC2_SPI */
    GEL_MapAddStr(0x50780000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC0 */
    GEL_MapAddStr(0x50782000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC1 */
    GEL_MapAddStr(0x50784000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC2 */
    GEL_MapAddStr(0x50786000, 0, 0x000A0D00, "R|W|AS4", 0); /* SPGSS2_UC3 */
    GEL_MapAddStr(0x90100000, 0, 0x00004000, "R|AS4", 0);   /* FLASH_NonMain_ECC_Corrected */
    GEL_MapAddStr(0x90110000, 0, 0x00002000, "R|AS4", 0);   /* FLASH_Factory_ECC_Corrected */
    GEL_MapAddStr(0x90200000, 0, 0x00020000, "R|AS4", 0);   /* FLASH_Main_ECC_Code */
    GEL_MapAddStr(0x90260000, 0, 0x00000800, "R|AS4", 0);   /* FLASH_NonMain_ECC_Code */
    GEL_MapAddStr(0x90270000, 0, 0x00000400, "R|AS4", 0);   /* FLASH_Factory_ECC_Code */
    GEL_MapAddStr(0x90000000, 0, 0x00008000, "R|AS4", 0);   /* FLASH_Data_Main_ECC_Corrected */
    GEL_MapAddStr(0x9010C000, 0, 0x00002000, "R|AS4", 0);   /* FLASH_Data_NonMain_ECC_Corrected */
    GEL_MapAddStr(0x90240000, 0, 0x00001000, "R|AS4", 0);   /* FLASH_Data_Main_ECC_Code */
    GEL_MapAddStr(0x90261800, 0, 0x00000400, "R|AS4", 0);   /* FLASH_Data_NonMain_ECC_Code */
    GEL_MapAddStr(0x90118000, 0, 0x00002000, "R|AS4", 0);   /* FLASH_Engr_ECC_Corrected */
    GEL_MapAddStr(0x90120000, 0, 0x00001000, "R|AS4", 0);   /* FLASH_Data_Engr_ECC_Corrected */
    GEL_MapAddStr(0x90280000, 0, 0x00000400, "R|AS4", 0);   /* FLASH_Engr_ECC_Code */
    GEL_MapAddStr(0x90281000, 0, 0x00000200, "R|AS4", 0);   /* FLASH_Data_Engr_ECC_Code */



    /* ARM standard IPs */
    GEL_MapAddStr(0xE0000000, 0, 0x00001000, "R|W|AS4", 0);       /* itm */
    GEL_MapAddStr(0xE0001000, 0, 0x00001000, "R|W|AS4", 0);       /* dwt */
    GEL_MapAddStr(0xE0002000, 0, 0x00001000, "R|W|AS4", 0);       /* fpb */
    GEL_MapAddStr(0xE000EDF0, 0, 0x00000018, "R|W|AS4", 0);       /* dcb */
    GEL_MapAddStr(0xE0040000, 0, 0x00001000, "R|W|AS4", 0);       /* tpiu */
    GEL_MapAddStr(0xE0041004, 0, 0x00001000, "R|W|AS4", 0);       /* etm */
    GEL_MapAddStr(0xE0042000, 0, 0x00001000, "R|W|AS4", 0);       /* cti */
    GEL_MapAddStr(0xE0043000, 0, 0x00001000, "R|W|AS4", 0);       /* mtb */
    GEL_MapAddStr(0xE000E004, 0, 0x00000008, "R|W|AS4", 0);       /* icb */
    GEL_MapAddStr(0xE000E010, 0, 0x00000010, "R|W|AS4", 0);       /* systick */
    GEL_MapAddStr(0xE000E100, 0, 0x00000448, "R|W|AS4", 0);       /* nvic */
    GEL_MapAddStr(0xE000ED00, 0, 0x00000074, "R|W|AS4", 0);       /* cpuidbr, icsr, vtor, aircr, scr */
    GEL_MapAddStr(0xE002ED00, 0, 0x00000074, "R|W|AS4", 0);       /* cpuidbr, icsr, vtor, aircr, scr */
    GEL_MapAddStr(0xE000ED90, 0, 0x00000034, "R|W|AS4", 0);       /* mpu */
    GEL_MapAddStr(0xE000EDD0, 0, 0x00000028, "R|W|AS4", 0);       /* sau */
    GEL_MapAddStr(0xE000EF00, 0, 0x00000004, "R|W|AS4", 0);       /* sig */
    GEL_MapAddStr(0xE000EF34, 0, 0x00000018, "R|W|AS4", 0);       /* fpu */

    GEL_TextOut("Memory Map Initialization Complete\n");
}

hotmenu Software_SYSreset()
{
    *(unsigned int *) (0x400B0300) = 0x0 ;
    *(unsigned int *) (0x400B0304) = 0xE4000001 ;
}
hotmenu Software_BOOTreset()
{
    *(unsigned int *) (0x500B0300) = 0x1 ;
    *(unsigned int *) (0x500B0304) = 0xE4000001 ;
}
hotmenu Software_SYSRST_with_BSL()
{
    *(unsigned int *) (0x400B0300) = 0x2 ;
    *(unsigned int *) (0x400B0304) = 0xE4000001 ;
}
hotmenu Software_POR()
{
    *(unsigned int *) (0x400B0300) = 0x3 ;
    *(unsigned int *) (0x400B0304) = 0xE4000001 ;
}

DefineResets()
{
    DEBUG_RemoveResets(0);
    DEBUG_DefineReset( "Software_SYSreset", "Perform a CPU Reset", 0, " Software_SYSreset()" );
    DEBUG_DefineReset( "Software_POR", "Perform a software POR", 0, "Software_POR()" );
    DEBUG_DefineReset( "Software_SYSRST_with_BSL", "Peform Software SYSRST with BSL", 0, "Software_SYSRST_with_BSL()");
    DEBUG_DefineReset( "Software_BOOTreset", "Perform a Software BOOTreset", 0, "Software_BOOTreset()" );
}

StartUp(major, minor, revision, build)
{
    DefineResets();
    /*GEL_TextOut("In StartUp\n");*/
    GEL_HandleTargetError(
        ".*-613.*",
        "\nConnection to MSPM33 core failed.\n
Possible root causes:
1) Debug access within NONMAIN was disabled or enabled with password.\n2) Peripheral mis-configuration (e.g improper watchdog or clock).\n
To see a more detailed diagnostic of the issue, please press the 'Read boot diagnostic' button.",
        1,
        "Read boot diagnostic",
        "MSPM33_BootDiag_DebugRead()"
    );

    GEL_HandleTargetError(
        ".*-6305.*",
        "\nConnection to MSPM33 core failed.\n
Possible root causes:
1) Debug access within NONMAIN was disabled or enabled with password.\n2) Peripheral mis-configuration (e.g improper watchdog or clock).\n
To see a more detailed diagnostic of the issue, please press the 'Read boot diagnostic' button.",
        1,
        "Read boot diagnostic",
        "MSPM33_BootDiag_DebugRead()"
    );

    GEL_HandleTargetError(
        ".*-614.*",
        "\nConnection to MSPM33 core failed.\n
Possible root causes:
1) Debug access within NONMAIN was disabled or enabled with password.\n2) Peripheral mis-configuration (e.g improper watchdog or clock).\n
To see a more detailed diagnostic of the issue, please press the 'Read boot diagnostic' button.",
        1,
        "Read boot diagnostic",
        "MSPM33_BootDiag_DebugRead()"
    );

    GEL_HandleTargetError( ".*-614.*", "\nDevice Connection Error.
This could be caused by the device having gone to low power mode.
Try forcing an external reset pressing the 'Force Reset' button.
If the error persists, try:
    1) Invoking BSL,
    2) Calling a DSSM Mass erase, or,
    3) Calling a DSSM Factory Reset.
Check device FAQs for more information.",
1, "Force Reset", "GEL_MSPM33_Board_Reset()" );
}

/*
 * Starts a board reset from the device
 *  It will call a function from CS_DAP to trigger the reset.
 *  Function won't return until reset is done.
 */
GEL_MSPM33_Board_Reset()
{
    if ('GEL'::gGEL_ResetCalled == 0)
    {
        'GEL'::gGEL_ResetCalled = 1;
        'GEL'::gGEL_Reset_Done = 0;
        GEL_EvalOnTarget( "CS_DAP_0", "GEL_DAPInit_remotePORReset()", 0 );
        while(!'GEL'::gGEL_Reset_Done)
            ;
        'GEL'::gGEL_ResetCalled = 0;
    }
}

/*
 * Called every time a target is connected.
 *  Validates the device ID and initializes the memory map.
 */
OnTargetConnect()
{
    DefineResets();
    GEL_MapReset();
    memorymap_init();
    GEL_MapOn();
}

/*
 * Called after the parent router is connected, but before the target is connected.
 */
OnPreTargetConnect()
{
    if (GEL_MatchesConnection(".*XDS.*")) {
        if (GEL_GetBoolDebugProperty("EnableWaitForDebug") == 1) {
            MSPM33_ResetCtl_WaitForDebug();
            GEL_EvalOnTarget("CS_DAP_0", "PWRAP_DPREC0 = 0x00120008", 0);
        }
    }
}

OnPreFileLoaded()
{
    if (GEL_MatchesConnection(".*XDS.*")) {
        if (GEL_GetBoolDebugProperty("EnableWaitForDebug") == 1) {
            MSPM33_ResetCtl_WaitForDebug();
            GEL_EvalOnTarget("CS_DAP_0", "PWRAP_DPREC0 = 0x00120008", 0);
            GEL_Halt();
        }
    }
}

/*
 * GEL callback function called when the program is restarted.
 */
OnRestart()
{
    if (GEL_MatchesConnection(".*XDS.*")) {
        GEL_Halt();
        GEL_EvalOnTarget("CS_DAP_0", "PWRAP_DPREC0 = PWRAP_DPREC0 | 0x00020000", 0);
        // This will result in 0x1A reset cause. Same as in M0.
        GEL_EvalOnTarget("CS_DAP_0", "PWRAP_SPREC = PWRAP_SPREC | 0x00000001", 0);
    }
}

OnReset()
{
    if (GEL_MatchesConnection(".*XDS.*")) {
        // SYSRST through debugger
        string resetType = GEL_GetStringDebugProperty("FlashResetType");
        if (resetType == "Hard reset") {
            GEL_EvalOnTarget("CS_DAP_0", "PWRAP_SPREC = PWRAP_SPREC | 0x00000001", 0);
        }

        // Setting INRST bit
        GEL_EvalOnTarget("CS_DAP_0", "PWRAP_DPREC0 = PWRAP_DPREC0 | 0x00020000", 0);
    }
}

MSPM33_ResetCtl_WaitForDebug()
{
    int loop = 10; //to ensure it catches

    do
    {
        GEL_EvalOnTarget("CS_DAP_0", "PWRAP_SPREC = PWRAP_SPREC | 0x00000001", 0);
        GEL_EvalOnTarget("CS_DAP_0", "PWRAP_DPREC0 = PWRAP_DPREC0 | 0x00004000", 0);
        GEL_EvalOnTarget("CS_DAP_0", "PWRAP_SPREC = PWRAP_SPREC | 0x00000001", 0);
        loop--;
    }while(loop != 0);

    loop = 10000; //inserting artificial delay to ensure device his able to reinit before connect

    do
    {
        loop--;
    }while(loop != 0);

    return;
}

hotmenu MSPM33_Mailbox_MassErase_Manual()
{
    'GEL'::gGEL_RemoteCmd_Done = 0;
    GEL_EvalOnTarget( "CS_DAP_0", "GEL_DAPInit_remoteMassErase(0)", 0 );
    while(!'GEL'::gGEL_RemoteCmd_Done)
        ;
    GEL_TextOut("Mass Erase executed. Please terminate debug session, power-cycle and restart debug session.\n");
}

hotmenu MSPM33_Mailbox_MassErase_Auto()
{
    if(GEL_IsConnected() == 1)
    {
        GEL_Disconnect();
    }

    'GEL'::gGEL_RemoteCmd_Done = 0;
    GEL_EvalOnTarget( "CS_DAP_0", "GEL_DAPInit_remoteMassErase(1)", 0 );
    while(!'GEL'::gGEL_RemoteCmd_Done)
        ;
    GEL_TextOut("Mass Erase executed. Please terminate debug session, power-cycle and restart debug session.\n");
}

