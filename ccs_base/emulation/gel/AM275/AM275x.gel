/*
 *Platform: Keystone 3 SoCs
 * - AM275
 *Usage: This GEL will be run from CCS upon connection to the Cortex-M4
 *   (TIFS) CPU.
 */



StartUp(){

	//Load the common GEL
	GEL_LoadGel( "$(GEL_file_dir)/AM275_common/AM275_common.gel");

	//Load the PSC GEL
	GEL_LoadGel( "$(GEL_file_dir)/AM275_PSC/AM275_PSC.gel");

	//Load the PLL GEL
	GEL_LoadGel( "$(GEL_file_dir)/AM275_PLL/AM275_PLL_MMR.gel");
	GEL_LoadGel( "$(GEL_file_dir)/AM275_PLL/AM275_PLL_PARAMS_OFC1.gel");
	GEL_LoadGel( "$(GEL_file_dir)/AM275_PLL/AM275_PLL.gel");   
	GEL_LoadGel( "$(GEL_file_dir)/AM275_PLL/AM275_PLL_OFC1.gel");


}

// Device onTarget connect sequence function
OnTargetConnect(){
	//M4 RAT configs
	Configure_RAT();

	// Enable ATCM
	Configure_ATCM();

	// R5 Halt and Boot vectors config
	Configure_R5F_Halt_Upon_PowerUp();
	Configure_R5F_Bootvectors();
	NOBOOT_ROM_safeguard();

	// All PLL configs
	Set_All_PLL_OFC1_NOM();

	// Set all PSCs power on
	Set_PSC_All_On();

	GEL_TextOut( "\n Now your able to connect to C7x0, C7X1, WKUP R5 Core and MAIN_R5_0 core \n");
	GEL_TextOut( "To connect MAIN_R5_1 (R50_1) core run this gel script from SMS_CM4_TIFS core : Initial Device Configuration/Switch_Cluster0_to_Dual_Core \n");
	GEL_TextOut( "To connect MAIN_R5_2 (R51_0) core run this gel script from SMS_CM4_TIFS core : Initial Device Configuration/Configure_Cluster1_ATCM, Initial Device Configuration/Configure_Cluster1_R5F_Halt_Upon_PowerUp and Device Configuration/Configure_Cluster1_R5F_Bootvectors\n");
	GEL_TextOut( "To connect MAIN_R5_3 (R51_1) core run this gel script from SMS_CM4_TIFS core : Initial Device Configuration/Switch_Cluster1_to_Dual_Core \n");
	GEL_TextOut( "To connect BLAZER_Cortex_M4F core run this gel script from SMS_CM4_TIFS_core: Device Configuration/Init_HSM_M4 \n");

	// Un comment below scripts to run as part of onTargetConnect if you want to connect to all cores.
		//Switch_Cluster0_to_Dual_Core();
		//Configure_Cluster1_ATCM();
		//Configure_Cluster1_R5F_Halt_Upon_PowerUp();
		//Configure_Cluster1_R5F_Bootvectors();
		//Switch_Cluster1_to_Dual_Core();
		//Init_HSM_M4();

}
