	GEL_TextOut( "Powering up LPSC_MAIN_MCAN2 \n");
 	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCAN2, PSC_PD_ON, PSC_ENABLE);

	GEL_TextOut( "Powering up LPSC_MAIN_MCAN3 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCAN3, PSC_PD_ON, PSC_ENABLE);
	GEL_TextOut( "Powering up LPSC_MAIN_MCAN4 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCAN4, PSC_PD_ON, PSC_ENABLE);
	GEL_TextOut( "Powering up LPSC_MAIN_MCASP0 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP0, PSC_PD_ON, PSC_ENABLE);

	GEL_TextOut( "Powering up LPSC_MAIN_MCASP1 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP1, PSC_PD_ON, PSC_ENABLE);
	GEL_TextOut( "Powering up LPSC_MAIN_MCASP2 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP2, PSC_PD_ON, PSC_ENABLE);
	GEL_TextOut( "Powering up LPSC_MAIN_MCASP3 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP3, PSC_PD_ON, PSC_ENABLE);

	GEL_TextOut( "Powering up LPSC_MAIN_MCASP4 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP4, PSC_PD_ON, PSC_ENABLE);
	
	if(status){
		GEL_TextOut( "Powering up GP_CORE_CTL all done. \n");
	}else{
		GEL_TextOut("********Error: Failed while Powering up GP_CORE_CTL.\n");
	}
	return status;
}



