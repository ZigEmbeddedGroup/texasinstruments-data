change_HSM_M4_LRST(int enable) {
	unsigned int* mdctl;

	unsigned int loop_cnt = 0;
	unsigned int ret = 1;

	unsigned int* mdstat;
	unsigned int mdstat_lrstz=0;

	unsigned int address_offset = 0;
	address_offset = 0x80000000;

	//LPSC_HSM
	mdctl  = (unsigned int*)(MAIN_PSC_MDCTL_BASE + ( 4 * LPSC_MAIN_HSM ) + address_offset);

	if(enable==1) {
        	*mdctl = ((*mdctl) & ~(0x100));
	} else {
		*mdctl = ((*mdctl) | (0x100));
	}

	mdstat = (unsigned int*)(MAIN_PSC_MDSTAT_BASE + ( 4 * LPSC_MAIN_HSM )+ address_offset);
	mdstat_lrstz = (*mdstat >> 8) & 0x1;

	if(mdstat_lrstz == 1)
		GEL_TextOut( "LPSC_HSM: Local Reset Released\n");
	else
		GEL_TextOut( "LPSC_HSM: Local Reset Asserted\n");
}
