	GEL_TextOut( "Powering Down LPSC_MAIN_MCAN2 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCAN2, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_MCAN3 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCAN3, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_MCAN4 \n");
 	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCAN4, PSC_PD_ON, PSC_DISABLE);

	GEL_TextOut( "Powering Down LPSC_MAIN_OSPI0 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_OSPI0, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_OSPI1 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_OSPI1, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_HYPERBUS \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_HYPERBUS, PSC_PD_ON, PSC_DISABLE);

 	GEL_TextOut( "Powering Down LPSC_MAIN_SA3UL \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_SA3UL, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_MCASP0 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP0, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_MCASP1 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP1, PSC_PD_ON, PSC_DISABLE);

	GEL_TextOut( "Powering Down LPSC_MAIN_MCASP2 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP2, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_MCASP3 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP3, PSC_PD_ON, PSC_DISABLE);
 	GEL_TextOut( "Powering Down LPSC_MAIN_MCASP4 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MCASP4, PSC_PD_ON, PSC_DISABLE);

	GEL_TextOut( "Powering Down LPSC_MAIN_ATL \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_ATL, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_ASRC0 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_ASRC0, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_ASRC1 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_ASRC1, PSC_PD_ON, PSC_DISABLE);

	GEL_TextOut( "Powering Down LPSC_MAIN_MLB \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_MLB, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_ADC \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_ADC, PSC_PD_ON, PSC_DISABLE);

	if(status){
		GEL_TextOut( "Powering Down GP_CORE_CTL done. \n");
	}else{
		GEL_TextOut("********Error: Failed while Powering Down GP_CORE_CTL.\n");
