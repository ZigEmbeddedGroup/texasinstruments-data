menuitem "Power Sleep Controller/Power Down/Clock Gate by Power Domain Controls";

hotmenu GP_CORE_CTL_PowerDown()
{
	int status = 1;
	GEL_TextOut( "Powering Down GP_CORE_CTL. \n");

	GEL_TextOut( "Powering Down LPSC_MAIN_ALWAYSON \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_ALWAYSON, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_DM \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_DM, PSC_PD_ON, PSC_DISABLE);
	GEL_TextOut( "Powering Down LPSC_MAIN_DM_PBIST0 \n");
	status &= Set_MAIN_PSC_State( GP_CORE_CTL, LPSC_MAIN_DM_PBIST0, PSC_PD_ON, PSC_DISABLE);

