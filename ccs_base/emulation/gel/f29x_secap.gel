menuitem "SSU Zone Disable Functions"

hotmenu C29Debug_Disable()
{
    TRANSMIT_CONTROL = 0x0;
    TRANSMIT_DATA = 0x4;
    TRANSMIT_CONTROL = 0x4;
    TRANSMIT_DATA = 0x1;
    TRANSMIT_CONTROL = 0x8;
    TRANSMIT_DATA = 0x1;
    TRANSMIT_CONTROL = 0xC;
    TRANSMIT_DATA = 0x1;
    TRANSMIT_CONTROL = 0x10;
    TRANSMIT_DATA = 0x1;
}

