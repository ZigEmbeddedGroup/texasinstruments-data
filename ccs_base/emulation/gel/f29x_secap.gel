menuitem "SEC-AP Debug Status Signals (2)"

hotmenu Clock_Status()
{
    unsigned int genDbgStatus2;
    unsigned int genDbgStickyStatus0;

    GEL_TextOut("Following are the status of different bits:\n\n");

    genDbgStatus2 = GEN_DBG_STATUS2;
    GEL_TextOut("CPU1 SYSCLK EN -->  %d\n",,,,, ((genDbgStatus2 & 0x1000000)>>24));
    GEL_TextOut("CPU2 SYSCLK EN -->  %d\n",,,,, ((genDbgStatus2 & 0x2000000)>>25));
    GEL_TextOut("CPU3 SYSCLK EN -->  %d\n",,,,, ((genDbgStatus2 & 0x4000000)>>26));
    GEL_TextOut("PLL LOCK -->  %d\n",,,,, ((genDbgStatus2 & 0x80000000)>>31));

    genDbgStickyStatus0 = GEN_DBG_STICKY_STATUS0;
    GEL_TextOut("Sticky Status Bits:\n");
    GEL_TextOut("SYSCTL CPU1 SYSCLK -->  %d\n",,,,,((genDbgStickyStatus0 & 0x1)>>0));
    GEL_TextOut("SYSCTL CPU2 SYSCLK -->  %d\n",,,,,((genDbgStickyStatus0 & 0x2)>>1));
    GEL_TextOut("SYSCTL CPU3 SYSCLK -->  %d\n",,,,,((genDbgStickyStatus0 & 0x4)>>2));
    GEL_TextOut("SYSCTL HSM CLOCK -->  %d\n",,,,,((genDbgStickyStatus0 & 0x40)>>6));
    GEL_TextOut("SYSCTL UNGATED CLOCK -->  %d\n",,,,,((genDbgStickyStatus0 & 0x80)>>7));
    GEL_TextOut("SYSCTL INTOSC1 -->  %d\n",,,,,((genDbgStickyStatus0 & 0x100)>>8));
    GEL_TextOut("SYSCTL INTOSC2-->  %d\n",,,,,((genDbgStickyStatus0 & 0x200)>>9));
    GEL_TextOut("SYSCTL CRUDE OSC -->  %d\n",,,,,((genDbgStickyStatus0 & 0x400)>>10));
}

hotmenu Clear_Clock_Status()
{
    TRANSMIT_CONTROL = 0x220;
    TRANSMIT_DATA = 0xFFF;
}

