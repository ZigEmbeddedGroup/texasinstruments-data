menuitem "SSU Zone Enable Functions";

hotmenu C29Debug_Enable()
{
    TRANSMIT_CONTROL = 0x0;
    TRANSMIT_DATA = 0x4;
    TRANSMIT_CONTROL = 0x4;
    TRANSMIT_DATA = 0x55555555;
    TRANSMIT_CONTROL = 0x8;
    TRANSMIT_DATA = 0x55555555;
    TRANSMIT_CONTROL = 0xC;
    TRANSMIT_DATA = 0x55555555;
    TRANSMIT_CONTROL = 0x10;
    TRANSMIT_DATA = 0x55555555;
}

hotmenu Zone1_FullEnable()
{
    //Write to PasswordID Register
    TRANSMIT_CONTROL = 0x0;
    TRANSMIT_DATA = 0x1;
    TRANSMIT_CONTROL = 0x4;
    TRANSMIT_DATA = 0x55555555;
    TRANSMIT_CONTROL = 0x8;
    TRANSMIT_DATA = 0x55555555;
    TRANSMIT_CONTROL = 0xC;
    TRANSMIT_DATA = 0x55555555;
    TRANSMIT_CONTROL = 0x10;
    TRANSMIT_DATA = 0x55555555;
}

hotmenu Zone2_FullEnable()
{
    //Write to PasswordID Register
    TRANSMIT_CONTROL = 0x0;
    TRANSMIT_DATA = 0x2;
