menuitem "Initialize Memory Map";

/*---------------------------------------------------------------------*/
/* OnTargetConnect() is called each time a target is connected. 	   */
/* Its execution finishes before anything else occurs. 				   */
/* Customize this function to perform essential target initialization. */
/*---------------------------------------------------------------------*/
OnTargetConnect()
{
    GEL_TextOut("\n\nExecuting On Target Connect Functions\n\n");

    // On connection scan in zone passwords
    C29Debug_Enable();
    Zone1_FullEnable();
    Zone2_FullEnable();
    Zone3_FullEnable();

    GEL_TextOut("\n\nSEC-AP Ready\n\n");
}

OnReset(int nErrorCode)
{
      GEL_TextOut("Reset Done\n");
//    GEL_Run();
}

