menuitem "F29P32x Device Emulation";
hotmenu Emulate_F29P329SM2()
{
    'REG'::DevCfgRegs.MCUCNF1   = 0xFFFFFFFEU;              //  EMIF is not preent
    'REG'::DevCfgRegs.MCUCNF2   = 0xFFFC00FFU;              //  EPWM        = 8/18
    'REG'::DevCfgRegs.MCUCNF4   = 0xFFFFFFCFU;              //  EQEP        = 4/6
    'REG'::DevCfgRegs.MCUCNF7   = 0xFFC3FFFFU;              //  UART        = 2/6
    'REG'::DevCfgRegs.MCUCNF10  = 0xFFFFFC7FU;              //  MCAN        = 3/6
    'REG'::DevCfgRegs.MCUCNF13  = 0xFFFFFFEFU;              //  ADC         = 4/5
    'REG'::DevCfgRegs.MCUCNF14  = 0xFFFFF00FU;              //  CMPSS       = 4/12
    'REG'::DevCfgRegs.MCUCNF16  = 0xFFFCFFFFU;              //  DAC         = 0/2
    'REG'::DevCfgRegs.MCUCNF17  = 0xFFFFFFC0U;              //  CLB         = 0/6
    'REG'::DevCfgRegs.MCUCNF18  = 0xFFF3FFF3U;              //  FSI         = 2/4
    'REG'::DevCfgRegs.MCUCNF19  = 0xFFFFFFFFU;              //  LIN         = 2/2
    'REG'::DevCfgRegs.MCUCNF23  = 0xFFFFFFFEU;              //  Ethercat is not present
    'REG'::DevCfgRegs.MCUCNF26  = 0xFFFFFFFFU;              //  AES, SHA, PKA and TRNG
    'REG'::DevCfgRegs.MCUCNF31  = 0xFFFFFFFFU;              //  SM2, SM3 and SM4
    'REG'::DevCfgRegs.MCUCNF64  = 0xFFFFFFEFU;              //  CPU3 is not present
    'REG'::DevCfgRegs.MCUCNF65  = 0xF000FFFFU;              //  CDA0-11 are absent
    'REG'::DevCfgRegs.MCUCNF74  = 0xFFFFFFFFU;              //  FLC1B0/B1 flash
    'REG'::DevCfgRegs.MCUCNF76  = 0xFFFFFFFFU;              //  FLC1B2/B3 flash
    'REG'::DevCfgRegs.MCUCNF78  = 0xFFFFFF0FU;              //  FLC1B4 flash
    'REG'::DevCfgRegs.MCUCNF79  = 0xFFFF0000U;              //  FLC2B0/B1 flash is not present
    'REG'::DevCfgRegs.MCUCNF81  = 0xFFFF0000U;              //  FLC2B2/B3 flash is not present
    GEL_TextOut("F29P329SM2 is emulated.\n");
}

FindDevice()
{
    unsigned int partid = 'REG'::DevCfgRegs.PARTIDH;

    if(partid == 0x0DFF0C00)   GEL_TextOut("The connected device is F29H850TU9\n");
    if(partid == 0x0DDE0C00)   GEL_TextOut("The connected device is F29H859TU8\n");
    if(partid == 0x0DDC0C00)   GEL_TextOut("The connected device is F29H859TM8\n");
    if(partid == 0x0DE90C00)   GEL_TextOut("The connected device is F29H850DM7\n");
    if(partid == 0x0DEB0C00)   GEL_TextOut("The connected device is F29H850DU7\n");
    if(partid == 0x0DC80C00)   GEL_TextOut("The connected device is F29H859DM6\n");
    if(partid == 0x0DCA0C00)   GEL_TextOut("The connected device is F29H859DU6\n");
    if(partid == 0x0CBE0C00)   GEL_TextOut("The connected device is F29P580DM5\n");
    if(partid == 0x0C9E0C00)   GEL_TextOut("The connected device is F29P589DM5\n");
    if(partid == 0x0C9F0C00)   GEL_TextOut("The connected device is F29P589DU5\n");
    if(partid == 0x0C4F0C00)   GEL_TextOut("The connected device is F29P329SM2\n");
}

CheckFlash()
{
    if((*(unsigned int*)0x10001000) != 0xFFFFFFFF)
    {
        GEL_TextOut("Program found in Flash memory. Make sure to erase Flash if loading an application to RAM. If loading to Flash, Flash Plugin will erase the selected banks.\n");
    }
}