/********************************************************************/
/*                                                                  */
/* This GEL file is to be used with the f29h85x devices  .          */
/* Changes may be required to support specific hardware designs.    */
/*                                                                  */
/* Code Composer Studio supports six reserved GEL functions that    */
/* automatically get executed if they are defined. They are:        */
/*                                                                  */
/* StartUp()              - Executed whenever CCS is invoked        */
/* OnReset()              - Executed after Debug->Reset CPU         */
/* OnRestart()            - Executed after Debug->Restart           */
/* OnPreFileLoaded()      - Executed before File->Load Program      */
/* OnFileLoaded()         - Executed after File->Load Program       */
/* OnTargetConnect()      - Executed after Debug->Connect           */
/*                                                                  */
/********************************************************************/

#define TIMER_RESET_FREERUN     1

StartUp()
{
}

OnPreReset(int resetIndex)
{
    int apCnt;

    'REG'::DevCfgRegs.SOC_SECURE_BOOT_INFO_REG6 = 0xA1B2C3D4;
    //
    //  Disable FRI prefetch only if REVID is less than 3
    //
    if('REG'::DevCfgRegs.REVID.REVID < 3)
    {
        if('REG'::SsuGenRegs.CPUID.CPUID == 1)
        {
            'REG'::Fri1Regs.FRI1_INTF_CTRL.PREFETCH_EN = 0;
        }

        if('REG'::SsuGenRegs.CPUID.CPUID == 3)
        {
            'REG'::Fri1Regs.FRI2_INTF_CTRL.PREFETCH_EN = 0;
        }
    }
    //
    //  Disable APRs in SSUMODE2 and 3 so that LINK0 can acquire required APRs without conflict
    //
    if('REG'::SsuGenRegs.CPUID.CPUID == 1)
    {
        if('REG'::SsuGenRegs.SSUMODE.OPMODE != 0x30)
        {
            for(apCnt = 0;apCnt < 64;apCnt++)
            {
                'REG'::SsuCpu1ApRegs.SSU_CPU1_AP_REGS_RegisterFile0[apCnt].AP_CFG.APD = 0x1;
            }
        }
        // Reset MCUCNF Regs corresponding to ADC and DAC
        'REG'::DevCfgRegs.MCUCNF13 = 0xFFFFFFFF;
        'REG'::DevCfgRegs.MCUCNF16 = 0xFFFFFFFF;
    }
}

bool wasReset = false;
OnReset(int nErrorCode)
{
    'GEL'::wasReset = true;
    GEL_SetTimer(1000 /* ms */, TIMER_RESET_FREERUN, "StuckInReset()", /* count = */ 1);

    GEL_TextOut("Reset Done\n");

}

OnHalt()
{
    if ('GEL'::wasReset)
    {
        GEL_CancelTimer(TIMER_RESET_FREERUN);
        'GEL'::wasReset = false;

        // If CPU1, clear RAMOPEN
        if('REG'::SsuGenRegs.CPUID.CPUID == 1)
        {
            'REG'::SsuCpu1CfgRegs.RAMOPENCLR.CLEAR_LINK1 = 1;
            GEL_TextOut("RAMOPEN Cleared\n");
        }
        disable_wd();
    }
}

StuckInReset()
{
    // Handle case where user does 'reset > disconnect' before timer ends
    if(GEL_IsConnected())
    {
        GEL_TextOut("Stuck in free-running state after reset\n");
    }
    'GEL'::wasReset = false;
}

OnRestart(int nErrorCode)
{
    DebugControllerConfig();
    CheckInterruptStatus();
    if('REG'::SsuGenRegs.CPUID.CPUID == 1)
    {
        'REG'::SsuCpu2CfgRegs.CPU_RST_CTRL.SW_SYSRSN = 0xC9;
        'REG'::SsuCpu3CfgRegs.CPU_RST_CTRL.SW_SYSRSN = 0xC9;
        GEL_TextOut("CPU2/3 is held in reset.\n\n");
    }
}

OnPreFileLoaded()
{
    DebugControllerConfig();

    // If CPU1, Initialize M0 RAM
    if('REG'::SsuGenRegs.CPUID.CPUID == 1)
    {
        GEL_MemoryFill(0x20000000, 0, 0x200, 0x0, 0x13);
        GEL_MemoryFill(0x20000A7C, 0, 0xBD, 0x0, 0x13);
        GEL_MemoryFill(0x20000D80, 0, 0x68, 0x0, 0x13);
        GEL_TextOut("M0 RAM initialization complete.\n\n");

        'REG'::SsuCpu2CfgRegs.CPU_RST_CTRL.SW_SYSRSN = 0xC9;
        'REG'::SsuCpu3CfgRegs.CPU_RST_CTRL.SW_SYSRSN = 0xC9;
        GEL_TextOut("CPU2/3 is held in reset.\n\n");
    }
    CheckFlash();
}

OnFileLoaded(int nErrorCode, int bSymbolsOnly)
{
    // check for errors in loading program
    if (nErrorCode)
    {
        GEL_TextOut("An error occurred while loading a file. -%d-\n",,,,, nErrorCode);
    }
    else
    {
        GEL_TextOut("File was loaded successfully. -%d-\n",,,,, nErrorCode);
    }

    // Check to see if only symbols are loaded
    if (bSymbolsOnly)
    {
        GEL_TextOut("Only symbols were loaded.\n");
    }
    else
    {
        GEL_TextOut("Full load.\n");
    }
}

OnTargetConnect()
{
    GEL_TextOut("Executing On Target Connect Functions\n");
    FindDevice();

    // In case user disconnects and reconnects before reset timer ends
    GEL_CancelTimer(TIMER_RESET_FREERUN, /* throwIfNotSet = */ false);
    'GEL'::wasReset = false;

    // Disable watchdog and setup memory map */
    disable_wd();
    setup_Memory_Map();

    // Connect to SEC_AP_C29 on CPU1 connection
    if(GEL_EvalOnTarget("SEC_AP_C29", "!GEL_IsConnected()"))
    {
        GEL_EvalOnTarget("SEC_AP_C29", "GEL_Connect()");
    }

    GEL_TextOut("Device Ready\n");
}

/*------------------------------------------------------------------------------------------------
*
* Check the Interrupt Status
*
* ----------------------------------------------------------------------------------------------*/
CheckInterruptStatus()
{
    int intrSts = DSTS.INTS;
    if (intrSts == 0)
        GEL_TextOut("CPU is in Main code.\n");
    else
    {
        if(intrSts == 1)
            GEL_TextOut("Warning: CPU is in INT Handler (normal interrupt service routine). Kindly perform a CPU Reset to execute from main loop.\n");
        else if(intrSts == 2)
            GEL_TextOut("Warning: CPU is in RTINT Handler (real-time interrupt service routine). Kindly perform a CPU Reset to execute from main loop.\n");
        else if(intrSts == 3)
            GEL_TextOut("Warning: CPU is in NMI Handler routine. Kindly perform a CPU Reset to execute from main loop.\n");
    }
}


/*************************************************************************************************/
/*                                F29H850TU9 Memory Map                                         */
/*                                                                                               */
/*************************************************************************************************/
setup_Memory_Map()
{
    GEL_MapReset();
    GEL_MapOn();

    GEL_MapAddStr(0x00000000,0, 0x10000000, "R|AS4",0);                 /* ROM */
    GEL_MapAddStr(0x10000000,0, 0x10000000, "R|AS4",0);                 /* Flash*/
    GEL_MapAddStr(0x20000000,0, 0x10000000, "R|W|AS4",0);               /* RAM */
    GEL_MapAddStr(0x30000000,0, 0x208C00,   "R|W|AS4",0);               /* Peripherals */
    GEL_MapAddStr(0x30208C00,0, 0x1400,     "R|W|AS2",0);               /* WD Regs */
    GEL_MapAddStr(0x3020A000,0, 0x66000,    "R|W|AS4",0);               /* Peripherals */
    GEL_MapAddStr(0x30270000,0, 0x1000,     "R|W|AS2",0);               /* XINT Regs */
    GEL_MapAddStr(0x30271000,0, 0xFD8F000,  "R|W|AS4",0);               /* Peripherals */
    GEL_MapAddStr(0x60000000,0, 0x10000000, "R|W|AS4",0);               /* Peripherals */
    GEL_MapAddStr(0x70000000,0, 0x150000,   "R|W|AS4",0);               /* Peripherals */
    GEL_MapAddStr(0x70150000,0, 0x70000,    "R|W|AS2",0);               /* I2C, SPI, FSI */
    GEL_MapAddStr(0x701C0000,0, 0xFE40000,  "R|W|AS4",0);               /* Peripherals */
    GEL_MapAddStr(0x80000000,0, 0x10000000, "R|W|AS4",0);               /* EMIF */
    GEL_MapAddStr(0x90000000,0, 0x10000000, "R|W|AS4",0);               /* EMIF */
    GEL_MapAddStr(0xA0000000,0, 0x10000000, "R|W|AS4",0);               /* EMIF */
    GEL_MapAddStr(0xB0000000,0, 0x10000000, "R|W|AS4",0);               /* EMIF */

    GEL_TextOut("Memory Map Initialization Complete\n");
}

