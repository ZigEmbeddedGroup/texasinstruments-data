menuitem "Error Handling/ESM_CPU1";
hotmenu ESM_CPU1_Check_Status()
{
    GEL_TextOut("ESM_CPU1 Status : \n");
    GEL_TextOut("  All Active/Pending Error Events : \n");
    readESMStatus('REG'::EsmCpu1Regs, 2);

    GEL_TextOut("  Active/Pending and Enabled Error Events : \n");
    readESMStatus('REG'::EsmCpu1Regs, 1);
    GEL_TextOut("ESM_CPU1 Status Done \n");
}
hotmenu ESM_CPU1_Clear_Raw_Status()
{
    'REG'::EsmCpu1Regs.ERR_GRP[0].STS = 0xFFFFFFFF;
    'REG'::EsmCpu1Regs.ERR_GRP[1].STS = 0xFFFFFFFF;
    'REG'::EsmCpu1Regs.ERR_GRP[2].STS = 0xFFFFFFFF;
    'REG'::EsmCpu1Regs.ERR_GRP[3].STS = 0xFFFFFFFF;
    'REG'::EsmCpu1Regs.ERR_GRP[4].STS = 0xFFFFFFFF;
    'REG'::EsmCpu1Regs.ERR_GRP[5].STS = 0xFFFFFFFF;
    'REG'::EsmCpu1Regs.ERR_GRP[6].STS = 0xFFFFFFFF;
    'REG'::EsmCpu1Regs.ERR_GRP[7].STS = 0xFFFFFFFF;
    GEL_TextOut("ESM_CPU1 Raw Status Cleared \n");
}
hotmenu ESM_CPU1_SoftReset()
{
    'REG'::EsmCpu1Regs.SFT_RST = 0x0000000F;
    GEL_TextOut("Soft Reset to ESM_CPU1 Done\n");
    'REG'::EsmCpu1Regs.EOI = 0x00000004;
