menuitem "Disable Watchdog";
hotmenu disable_wd()
{
    //Disables watchdog
    'REG'::WdRegs.WDCR = 0x0068;
    GEL_TextOut("Watchdog Timer Disabled\n");
}

/*------------------------------------------------------------------------------------------------*/

menuitem "CPU Reset Handling"
hotmenu Release_CPU2_Reset()
{
    unsigned int addrResetVect;

    if ('REG'::SsuGenRegs.CPUID.CPUID != 1)
    {
        GEL_TextOut("The CPU2 reset release function can only be executed from CPU1.\n");
        return;
    }

    GEL_TextOut("CPU2 reset release in progress.\n");

    /* Load reset vector from symbol in currently loaded .out */
    //addrResetVect = ptrCPU2ResetVector;
    addrResetVect = 0x20107FE0; // use last addresses in LPA1

    //GEL_TextOut("CPU2 Reset Vector Address: %x\n",,,,, ptrCPU2ResetVector);

    /* Write dummy loop opcodes to this address */
    if (true) //(((unsigned int)addrResetVect >> 28) == 2) // Only RAM supported
    {
        GEL_TextOut("Writing op codes to memory.\n");
        *(addrResetVect) = 0x0c319002;
        *(addrResetVect + 4) = 0x0b52117f;
        *(addrResetVect + 8) = 0x0b52117f;
        *(addrResetVect + 12) = 0x3510;

        /* Disable Lockstep Mode */
        GEL_TextOut("Disabling CPU1/CPU2 lockstep mode.\n");
        'REG'::DevCfgRegs.LSEN = 0;

        /* Update SSU registers with reset vector */
        'REG'::SsuCpu2CfgRegs.RST_VECT.ADDR = addrResetVect;
        'REG'::SsuCpu2CfgRegs.RST_LINK.LINK = 2;
        'REG'::SsuCpu2CfgRegs.DEF_NMI_VECT.ADDR = addrResetVect;
        'REG'::SsuCpu2CfgRegs.DEF_NMI_LINK.LINK = 2;

        /* Release CPU reset */
        'REG'::SsuCpu2CfgRegs.CPU_RST_CTRL.SW_SYSRSN = 0x36;
        GEL_TextOut("Released CPU2 from reset.\n");
    }
    else
    {
        GEL_TextOut("Reset vector address is not in RAM and cannot be modified. Operation cancelled.\n");
    }
}

hotmenu Release_CPU3_Reset()
{
    unsigned int addrResetVect;

    if ('REG'::SsuGenRegs.CPUID.CPUID != 1)
    {
        GEL_TextOut("The CPU3 reset release function can only be executed from CPU1.\n");
        return;
    }

    GEL_TextOut("CPU3 reset release in progress.\n");

    /* Load reset vector from symbol in currently loaded .out */
    //addrResetVect = ptrCPU3ResetVector;

    //GEL_TextOut("CPU3 Reset Vector Address: %x\n",,,,, ptrCPU3ResetVector);

    if (true) //(((unsigned int)addrResetVect >> 28) == 1)
    {
        GEL_TextOut("Reset vector address is in Flash. Writing init function to CPA0 RAM.\n");
        addrResetVect = 0x20110000;
    }

    /* Write dummy loop opcodes to this address */
    if (((unsigned int)addrResetVect >> 28) == 2) // Only RAM supported
    {
        GEL_TextOut("Writing op codes to memory.\n");
        *(addrResetVect) = 0x0c319002;
        *(addrResetVect + 4) = 0x0b52117f;
        *(addrResetVect + 8) = 0x0b52117f;
        *(addrResetVect + 12) = 0x3510;

        /* Update SSU registers with reset vector */
        'REG'::SsuCpu3CfgRegs.RST_VECT.ADDR = addrResetVect;
        'REG'::SsuCpu3CfgRegs.RST_LINK.LINK = 2;
        'REG'::SsuCpu3CfgRegs.DEF_NMI_VECT.ADDR = addrResetVect;
        'REG'::SsuCpu3CfgRegs.DEF_NMI_LINK.LINK = 2;

        /* Release CPU reset */
        'REG'::SsuCpu3CfgRegs.CPU_RST_CTRL.SW_SYSRSN = 0x36;
        GEL_TextOut("Released CPU3 from reset.\n");
    }
    else
    {
        GEL_TextOut("Reset vector address is not in RAM and cannot be modified. Operation cancelled.\n");
    }
}
hotmenu Device_Reset_XRSn()
{
    'REG'::DevCfgRegs.SOC_SECURE_BOOT_INFO_REG7 = 0x00000000;
    'REG'::CpuSysRegs.SIMRESET = 0xA5A50002;
    GEL_TextOut("Issued XRSn reset pulse to device.\n");
}

menuitem "Emulation Boot Mode Select"
hotmenu Enable_RAM_Emulation_Boot()
{
    // Override boot modes with RAM boot
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_LOW = 0x05050505;
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_HIGH = 0x05050505;
    'REG'::SsuGenRegs.EMU_BOOTPIN_CONFIG = 0x5A020100;
    'REG'::SsuGenRegs.EMU_BOOTEN = 1;
}

hotmenu Enable_Flash_Emulation_Boot()
{
    // Override boot modes with Flash boot
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_LOW = 0x03030303;
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_HIGH = 0x03030303;
    'REG'::SsuGenRegs.EMU_BOOTPIN_CONFIG = 0x5A020100;
    'REG'::SsuGenRegs.EMU_BOOTEN = 1;
}

hotmenu Default_Emulation_Boot_Mode()
{
    // Reset to default behavior
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_LOW = 0;
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_HIGH = 0;
    'REG'::SsuGenRegs.EMU_BOOTPIN_CONFIG = 0;
    'REG'::SsuGenRegs.EMU_BOOTEN = 1;
}

hotmenu Disable_Emulation_Boot()
{
    // Reset to default behavior
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_LOW = 0;
    'REG'::SsuCpu1CfgRegs.EMU_BOOTDEF_HIGH = 0;
    'REG'::SsuGenRegs.EMU_BOOTPIN_CONFIG = 0;
    // Disable EMU boot
    'REG'::SsuGenRegs.EMU_BOOTEN = 0;
}

