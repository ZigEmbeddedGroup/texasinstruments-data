    GEL_TextOut("LPA0 initialization done\n");

    'REG'::MemssLCfgRegs.LPA1_MEM_CONFIG.INIT = 1;  //LPA1
    while('REG'::MemssLCfgRegs.LPA1_MEM_CONFIG.INIT_STS != 1); //Wait for InitDone Status
