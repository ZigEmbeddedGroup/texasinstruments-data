/*------------------------------------------------------------------------------------------------*/

printErrAggErrorName(typeRegVal, type)
{
    if(type == GelMacro_Prog)
    {
        if((typeRegVal >> 0)  & 1)   GEL_TextOut("      - INSTR_SECURITY_VIO\n");
        if((typeRegVal >> 1)  & 1)   GEL_TextOut("      - SEC_ENTRY_VIO\n");
        if((typeRegVal >> 2)  & 1)   GEL_TextOut("      - SEC_EXIT_VIO\n");
        if((typeRegVal >> 3)  & 1)   GEL_TextOut("      - MAX_PSP_ERR\n");
        if((typeRegVal >> 4)  & 1)   GEL_TextOut("      - ACC_TIMEOUT_ERR\n");
        if((typeRegVal >> 5)  & 1)   GEL_TextOut("      - ACC_ACK_ERR\n");
        if((typeRegVal >> 6)  & 1)   GEL_TextOut("      - UNCERR\n");
        if((typeRegVal >> 7)  & 1)   GEL_TextOut("      - CERR\n");
        if((typeRegVal >> 8)  & 1)   GEL_TextOut("      - WARN_PSP_ERR\n");
        if((typeRegVal >> 9)  & 1)   GEL_TextOut("      - SW_BREAKPOINT_ERR\n");
        if((typeRegVal >> 10) & 1)   GEL_TextOut("      - ILLEGAL_INSTRUCTION\n");
        if((typeRegVal >> 11) & 1)   GEL_TextOut("      - INSTRUCTION_TIMEOUT\n");
        if((typeRegVal >> 30) & 1)   GEL_TextOut("      - LP_SOFTWARE_ERR\n");
        if((typeRegVal >> 31) & 1)   GEL_TextOut("      - HP_SOFTWARE_ERR\n");
    }
    if(type == GelMacro_Data)
    {
        if((typeRegVal >> 0)  & 1)  GEL_TextOut("      - SECURITY_VIO\n");
        if((typeRegVal >> 4)  & 1)  GEL_TextOut("      - ACC_TIMEOUT_ERR\n");
        if((typeRegVal >> 5)  & 1)  GEL_TextOut("      - ACC_ACK_ERR\n");
        if((typeRegVal >> 6)  & 1)  GEL_TextOut("      - UNCERR\n");
        if((typeRegVal >> 7)  & 1)  GEL_TextOut("      - CERR\n");
        if((typeRegVal >> 8)  & 1)  GEL_TextOut("      - UNALIGNED_ADDR_ERR\n");
        if((typeRegVal >> 30) & 1)  GEL_TextOut("      - LP_SOFTWARE_ERR\n");
        if((typeRegVal >> 31) & 1)  GEL_TextOut("      - HP_SOFTWARE_ERR\n");
    }
    if(type == GelMacro_Int)
    {
        if((typeRegVal >> 0)  & 1)  GEL_TextOut("      - MAIN_ISR_ENTRY_ERR\n");
        if((typeRegVal >> 1)  & 1)  GEL_TextOut("      - MAIN_VECT_CERR\n");
        if((typeRegVal >> 2)  & 1)  GEL_TextOut("      - MAIN_VECT_UNCERR\n");
        if((typeRegVal >> 3)  & 1)  GEL_TextOut("      - MAIN_INTERRUPT_RETURN_ERR\n");
        if((typeRegVal >> 4)  & 1)  GEL_TextOut("      - INT_ISR_ENTRY_ERR\n");
        if((typeRegVal >> 5)  & 1)  GEL_TextOut("      - INT_VECT_CERR\n");
        if((typeRegVal >> 6)  & 1)  GEL_TextOut("      - INT_VECT_UNCERR\n");
        if((typeRegVal >> 7)  & 1)  GEL_TextOut("      - INT_INTERRUPT_RETURN_ERR\n");
        if((typeRegVal >> 8)  & 1)  GEL_TextOut("      - RTINT_ISR_ENTRY_ERR\n");
        if((typeRegVal >> 9)  & 1)  GEL_TextOut("      - RTINT_VECT_CERR\n");
        if((typeRegVal >> 10) & 1)  GEL_TextOut("      - RTINT_VECT_UNCERR\n");
        if((typeRegVal >> 11) & 1)  GEL_TextOut("      - RTINT_INTERRUPT_RETURN_ERR\n");
        if((typeRegVal >> 12) & 1)  GEL_TextOut("      - RTINT_CONTEXT_RESTORE_VECT_CERR\n");
        if((typeRegVal >> 13) & 1)  GEL_TextOut("      - RTINT_CONTEXT_RESTORE_VECT_UNCERR\n");
        if((typeRegVal >> 15) & 1)  GEL_TextOut("      - NMI_MAXISP_ERR\n");
        if((typeRegVal >> 16) & 1)  GEL_TextOut("      - NMI_ISR_ENTRY_ERR\n");
        if((typeRegVal >> 17) & 1)  GEL_TextOut("      - NMI_VECT_CERR\n");
        if((typeRegVal >> 18) & 1)  GEL_TextOut("      - NMI_VECT_UNCERR\n");
        if((typeRegVal >> 19) & 1)  GEL_TextOut("      - NMI_INTERRUPT_RETURN_ERR\n");
        if((typeRegVal >> 20) & 1)  GEL_TextOut("      - NMI_CONTEXT_RESTORE_VECT_CERR\n");
        if((typeRegVal >> 21) & 1)  GEL_TextOut("      - NMI_CONTEXT_RESTORE_VECT_UNCERR\n");
        if((typeRegVal >> 22) & 1)  GEL_TextOut("      - SCRUB_VECT_CERR\n");
        if((typeRegVal >> 23) & 1)  GEL_TextOut("      - SCRUB_VECT_UNCERR\n");
        if((typeRegVal >> 24) & 1)  GEL_TextOut("      - WARNISP\n");
        if((typeRegVal >> 25) & 1)  GEL_TextOut("      - MAXISP\n");
        if((typeRegVal >> 26) & 1)  GEL_TextOut("      - PIPE_SECURITY_VIO\n");
        if((typeRegVal >> 27) & 1)  GEL_TextOut("      - REG_PARITY_ERR\n");
        if((typeRegVal >> 28) & 1)  GEL_TextOut("      - REG_PARITY_DIAG_ERR\n");
        if((typeRegVal >> 29) & 1)  GEL_TextOut("      - PIPE_LOCK_KEY_ERR\n");
        if((typeRegVal >> 30) & 1)  GEL_TextOut("      - LP_SOFTWARE_ERR\n");
        if((typeRegVal >> 31) & 1)  GEL_TextOut("      - HP_SOFTWARE_ERR\n");
    }
    if(type == GelMacro_SSU)
    {
        if((typeRegVal >> 1)  & 1)  GEL_TextOut("      - CPU1_SSU_MMR_ACCESS_ERROR\n");
        if((typeRegVal >> 2)  & 1)  GEL_TextOut("      - CPU2_SSU_MMR_ACCESS_ERROR\n");
        if((typeRegVal >> 3)  & 1)  GEL_TextOut("      - CPU3_SSU_MMR_ACCESS_ERROR\n");
        if((typeRegVal >> 7)  & 1)  GEL_TextOut("      - MODE_INVALID\n");
        if((typeRegVal >> 12) & 1)  GEL_TextOut("      - FLC1_MMR_ACCESS_ERROR\n");
        if((typeRegVal >> 17) & 1)  GEL_TextOut("      - FLC2_MMR_ACCESS_ERROR\n");
        if((typeRegVal >> 31) & 1)  GEL_TextOut("      - HP_SOFTWARE_ERR\n");

        if((typeRegVal >> 8) & 1)
        {
            int err = (typeRegVal >> 9) & 0xF;
            if(err == 0)   GEL_TextOut("      - FLC1_ILLADDR\n");
            if(err == 1)   GEL_TextOut("      - FLC1_ILLPROG\n");
            if(err == 2)   GEL_TextOut("      - FLC1_ILLERASE\n");
            if(err == 3)   GEL_TextOut("      - FLC1_ILLRDVER\n");
            if(err == 4)   GEL_TextOut("      - FLC1_ILLMODECH\n");
            if(err == 5)   GEL_TextOut("      - FLC1_ILLCMD\n");
            if(err == 6)   GEL_TextOut("      - FLC1_ILLSIZE\n");
            if(err == 7)   GEL_TextOut("      - FLC1_ILLBANKERASE\n");
        }
        if((typeRegVal >> 13) & 1)
        {
            int err = (typeRegVal >> 14) & 0xF;
            if(err == 0)   GEL_TextOut("      - FLC1_ILLADDR\n");
            if(err == 1)   GEL_TextOut("      - FLC1_ILLPROG\n");
            if(err == 2)   GEL_TextOut("      - FLC1_ILLERASE\n");
            if(err == 3)   GEL_TextOut("      - FLC1_ILLRDVER\n");
            if(err == 4)   GEL_TextOut("      - FLC1_ILLMODECH\n");
            if(err == 5)   GEL_TextOut("      - FLC1_ILLCMD\n");
            if(err == 6)   GEL_TextOut("      - FLC1_ILLSIZE\n");
            if(err == 7)   GEL_TextOut("      - FLC1_ILLBANKERASE\n");
        }
    }
    if(type == GelMacro_Ecat)
    {
        if((typeRegVal >> 6)  & 1)  GEL_TextOut("      - UNCERR\n");
        if((typeRegVal >> 31) & 1)  GEL_TextOut("      - HP_SOFTWARE_ERR\n");
    }
}

