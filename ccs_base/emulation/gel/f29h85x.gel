/*------------------------------------------------------------------------------------------------
*
* Interrupts Handling
*
* ----------------------------------------------------------------------------------------------*/

menuitem "Interrupts";
hotmenu Check_Interrupt_Status()
{
    int i = 0;
    unsigned int ctl, prio, context, linkOwner, isr;

    unsigned int cpuIntState = DSTS.INTS;

    GEL_TextOut("CPU State :\n");
    GEL_TextOut("    INT Enable : %d\n",,,,, DSTS.INTE);
    if(cpuIntState == 0) GEL_TextOut("    Interrupt Status : Main code\n");
    if(cpuIntState == 1) GEL_TextOut("    Interrupt Status : INT Handler, Priority : %d\n",,,,,(unsigned int)DSTS.ISR_PRIORITY);
    if(cpuIntState == 2) GEL_TextOut("    Interrupt Status : RTINT Handler, Priority : %d\n",,,,,(unsigned int)DSTS.ISR_PRIORITY);
    if(cpuIntState == 3) GEL_TextOut("    Interrupt Status : NMI Handler\n");
    GEL_TextOut("    NMI Flag : %d, RTINT Flag : %d, INT Flag : %d\n",,,,, ISTS.NMIF, ISTS.RTINTF, ISTS.INTF);
    GEL_TextOut("    INTSP : %d, CURRSP : %d\n",,,,, ISTS.INTSP, ISTS.CURRSP);

    GEL_TextOut("PIPE State :\n");
    GEL_TextOut("    INT/RTINT Enable       : %d\n",,,,, 'REG'::PipeRegs.GLOBAL_EN==3);
    GEL_TextOut("    Current context        : %d\n",,,,, 'REG'::PipeRegs.TASK_CTRL.ACTIVE_CONTEXT_ID==3);
    GEL_TextOut("    Supervisor INT Enable  : %d\n",,,,, 'REG'::PipeRegs.TASK_CTRL.SUP_IGN_INTE_EN);
    GEL_TextOut("    RTINT Threshold        : %d\n",,,,, 'REG'::PipeRegs.RTINT_THRESHOLD);
    GEL_TextOut("    Nesting group Mask     : %x\n",,,,, 'REG'::PipeRegs.INT_GRP_MASK.INT_GRP_MASK);

    GEL_TextOut("Pending interrupts in PIPE :\n");

    while(i < 256)
    {
        ctl       = 'REG'::PipeRegs.INT_CTL_L[i];
        prio      = 'REG'::PipeRegs.INT_CONFIG[i] & 0xFF;3;
        context   = 'REG'::PipeRegs.INT_CONFIG[i] >> 16;
        linkOwner = 'REG'::PipeRegs.INT_LINK_OWNER[i] & 0xFF;
        isr       = 'REG'::PipeRegs.INT_VECT_ADDR[i];

        if(ctl & 0x2)
        {
            string info = GEL_StrCat(getIntName(i), " - ");

            if(ctl & 0x4)
                info = GEL_StrCat(info, "Overflowed, ");

            if(ctl & 0x1)
                info = GEL_StrCat(info, "Enabled, ");
            else
                info = GEL_StrCat(info, "Disabled, ");


            GEL_TextOut("  - [%d] %s Link = %d, ISR = %x, Priority = %d, ContextID = %d\n",,,,,i, info, linkOwner, isr, prio, context);
        }
        i += 1;
    }
    GEL_TextOut("Interrupt Status Check Done\n");
}

hotmenu Clear_Pending_Interrupts()
{
    'REG'::PipeRegs.ALL_FLAG_CLR = 0xFEED0003;
    'REG'::PipeRegs.ALL_FLAG_CLR = 0xFEED0000;
}


/*------------------------------------------------------------------------------------------------*/

readESMStatus(esmRegs, reg)
{
    int group = 0;
    int ch    = 0;
    int errNo;
    unsigned int groupStatus;

    while(group < 8)
    {
        if(reg == 1) groupStatus = esmRegs.ERR_GRP[group].STS;
        else         groupStatus = esmRegs.ERR_GRP[group].RAW;

        ch = 0;
        while(ch < 32)
        {
            if(((groupStatus >> ch) & 1) == 1)
            {
                errNo = group * 32 + ch;
                printESMErrorName(errNo);
            }
            ch = ch + 1;
        }
        group = group + 1;
    }
}

/*------------------------------------------------------------------------------------------------*/

readErrAggStatus(baseAddr, name, type)
{
    unsigned int hpAddr  = *(baseAddr + 0);
    unsigned int lpAddr  = *(baseAddr + 1);
    unsigned int errType = *(baseAddr + 2);
    unsigned int pc      = *(baseAddr + 5);

    if(errType != 0)
    {
        GEL_TextOut("  - %s Errors (HP Error Addr = %x, LP Error Addr = %x, PC = %x)\n",,,,,name, hpAddr, lpAddr, pc);
        printErrAggErrorName(errType, type);
    }
}

/*------------------------------------------------------------------------------------------------*/

printESMErrorName(errNo)
{
	if(errNo == 0)    GEL_TextOut("  - ESM_EVENT_ErrorAggregator_CPU1_HPERR\n");
    if(errNo == 1)    GEL_TextOut("  - ESM_EVENT_ErrorAggregator_CPU2_HPERR\n");
    if(errNo == 2)    GEL_TextOut("  - ESM_EVENT_ErrorAggregator_CPU3_HPERR\n");
    if(errNo == 3)    GEL_TextOut("  - ESM_EVENT_ErrorAggregator_CPU1_INT_HPERR\n");
    if(errNo == 4)    GEL_TextOut("  - ESM_EVENT_ErrorAggregator_CPU2_INT_HPERR\n");
    if(errNo == 5)    GEL_TextOut("  - ESM_EVENT_ErrorAggregator_CPU3_INT_HPERR\n");
