* ----------------------------------------------------------------------------------------------*/
menuitem "Error Handling/CPU Reset Cause";
hotmenu Get_ResetCause()
{
    string reset = "ResetCauses = ";
    if('REG'::CpuSysRegs.RESC.ESMRESET == 1)       reset = GEL_StrCat(reset, " ESM_Reset,");
    if('REG'::CpuSysRegs.RESC.SIMRESET_XRSn == 1)  reset = GEL_StrCat(reset, " XRSN_SimReset,");
    if('REG'::CpuSysRegs.RESC.ECAT_RESET_OUT == 1) reset = GEL_StrCat(reset, " Ethercat_Reset,");
    if('REG'::CpuSysRegs.RESC.NMIWDRSn == 1)       reset = GEL_StrCat(reset, " NMI_Watchdog_Reset,");
    if('REG'::CpuSysRegs.RESC.WDRSn == 1)          reset = GEL_StrCat(reset, " XRSn,");
    if('REG'::CpuSysRegs.RESC.XRSn == 1)           reset = GEL_StrCat(reset, " POR,");

    GEL_TextOut("%s\n",,,,,GEL_SubStr(reset, 0, GEL_StrLen(reset)-1));
}
hotmenu Clear_ResetCause()
{
    'REG'::CpuSysRegs.RESCCLR = 0x1A0F;
    GEL_TextOut("Reset Causes Cleared\n");
}

