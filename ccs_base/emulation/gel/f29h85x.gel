menuitem "Error Handling/Missing Clock Detection";
hotmenu MCD_Get_Status()
{
    GEL_TextOut("MCD Enable = %d, OSC Connection = %d, MCD Flag = %d\n",,,,, 'REG'::DevCfgRegs.MCDCR.MCLKOFF == 0, 'REG'::DevCfgRegs.MCDCR.OSCOFF == 0, 'REG'::DevCfgRegs.MCDCR.MCLKSTS);
}
hotmenu MCD_Clear_Status()
{
    'REG'::DevCfgRegs.MCDCR.OSCOFF = 0;
    'REG'::DevCfgRegs.MCDCR.MCLKOFF = 0;
    'REG'::DevCfgRegs.MCDCR.MCLKCLR = 1;
    GEL_TextOut("MCD Flag Cleared\n");
    MCD_Get_Status();
}

