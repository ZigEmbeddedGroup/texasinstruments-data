#define OSPI_REGS              0x41910000
#define HOST_XIP_REGS          0x41912000
#define IOMUX_REGS             0x41140000
#define WSOC_COMMON_SPARE_A7   0x408200c0
#define APP_ID                 0
#define MAC_ID                 1

StartUp()
{
    /* Load the cc35xx_utils.gel file */
    GEL_LoadGel("$(GEL_file_dir)/cc35xx_utils.gel");

    GEL_TextOut("M33 on startup cc35x1\n");

    // GEL_HandleTargetError(".*-615.*", "", 0, "", "HandleReset()");
}

menuitem "CC35xx"
OnReset(int nErrorCode)
{
    GEL_TextOut("M33 OnReset\n");
}

OnTargetConnect()
{
    GEL_TextOut("M33 OnTargetConnect\n");
    /* Initialize memory map */
    memorymap_init();
}

OnPreFileLoaded()
{
    GEL_TextOut("OnPreFileLoaded\n");
}

OnFileLoaded(int nErrorCode, int bSymbolsOnly)
{
    if (nErrorCode)
        GEL_TextOut("An error occurred while loading a file. -%d\n",,,,, ErrorCode);
    else
        GEL_TextOut("File was loaded successfully. -%d\n",,,,, nErrorCode);

    if (bSymbolsOnly)
        GEL_TextOut("Only symbols were loaded\n");
    else
        GEL_TextOut("Full load\n");
}

memorymap_init()
{
    GEL_MapOff();
    GEL_MapReset();
    GEL_MapOn();

    /*
    * Syntax for GEL_MapAddStr.
    * GEL_MapAddStr(address, page, length, "attribute", waitstate);

    Basic Attribute Types           Derived Attribute Types
    String      Description         String      Description
    R           Read                NONE        No memory/protected
    W           Write               RAM         Read and write
    P           Port                ROM         Read only
    EX          External            WOM         Write only
    EM          Emulator            INPORT      Port read only
    PR          Programmable        OUTPORT     Port write only
    ER          Erasable            IOPORT      Port read and write
    DA          Dual access         SARAM       Single access RAM
    ASn         Access size         DARAM       Dual access RAM
    SHnC        Shared              FLASH       Flash ROM
    CACHE       Cache               EXRAM       External RAM
    TX          Text                EXROM       External ROM
    MN          Monitor             EPROM       Erasable write-able EPROM
    SA          Single access       MONITOR     Monitor ROM
    FL          Flash               PRAM        Program RAM
    MR          Memory mapped       PROM        Program ROM
    NULL        NULL                NULL        NULL
    */

    //GEL_MapAddStr(0x41900000, 0, 0x0000EFFF, "R|W", 0);  /* mcu  regs */
    //GEL_MapAddStr(0x4190F000, 0, 0x00000FFF, "R|W", 0);  /* icache regs */
    GEL_MapAddStr(0x41910000, 0, 0x0000FFFF, "R|W", 0);  /* host_xip_slv */

    GEL_MapAddStr(0x00000000, 0, 0x00008000, "R|W", 0);  /* TCM Code RAM Non-Secure */
    GEL_MapAddStr(0x04000000, 0, 0x00008000, "R|W", 0);  /* TCM Code RAM Secure*/

    GEL_MapAddStr(0x08000000, 0, 0x03FFFFFF, "R|W", 0);  /* Code RAM Non-Secure */
    GEL_MapAddStr(0x0C000000, 0, 0x03FFFFFF, "R|W", 0);  /* Code RAM Secure */

    GEL_MapAddStr(0x10000000, 0, 0x03FFFFFF, "R", 0);  /* External Code Flash Non-Secure */
    GEL_MapAddStr(0x14000000, 0, 0x03FFFFFF, "R", 0);  /* External Code Flash Secure */

    GEL_MapAddStr(0xA0000000, 0, 0x03FFFFFF, "R|W", 0);  /* External Code Flash Non-Secure */
    GEL_MapAddStr(0xA4000000, 0, 0x03FFFFFF, "R|W", 0);  /* External Code Flash Secure */

    GEL_MapAddStr(0x20000000, 0, 0x03FFFFFF, "R|W", 0);  /* TCM Data RAM Non-Secure */
    GEL_MapAddStr(0x24000000, 0, 0x03FFFFFF, "R|W", 0);  /* TCM Data RAM Secure */

    GEL_MapAddStr(0x28000000, 0, 0x03FFFFFF, "R|W", 0);  /* Data RAM Non-Secure */
    GEL_MapAddStr(0x2C000000, 0, 0x03FFFFFF, "R|W", 0);  /* Data RAM Secure */

    GEL_MapAddStr(0x40700000, 0, 0x000FFFFF, "R|W", 0);  /* Code RAM */
    GEL_MapAddStr(0x40600000, 0, 0x000FFFFF, "R|W", 0);  /*  Date RAM */

    GEL_MapAddStr(0x40900000, 0, 0x0000FFFF, "R|W", 0);  /* Phy Ctx RAM */
    GEL_MapAddStr(0x40910000, 0, 0x00007FFF, "R|W", 0);  /* Phy Scr RAM */
    // GEL_MapAddStr(0x4091C000, 0, 0x00001FFF, "R|W", 0);  /* Phy MCU regs */

    GEL_MapAddStr(0x40C00000, 0, 0x00010000, "R|W", 0);  /* BLE Code RAM Secure */

    GEL_MapAddStr(0xE0002000, 0, 0x00000024, "R|W", 0); /* ARM BPU programmers model (FPB) */
    GEL_MapAddStr(0xE000ED00, 0, 0x00000090, "R|W", 0); /* ARM System Control Block (SCB) */

    /* ==================================== Modules Address Definitions ============================================= */

	GEL_MapAddStr(0x44d05000, 0, 0x000002BC, "R|W", 0); /* ble_rfcore_mdm_secure */
	GEL_MapAddStr(0x40D05000, 0, 0x000002BC, "R|W", 0); /* ble_rfcore_mdm */
	GEL_MapAddStr(0x44d01000, 0, 0x00000150, "R|W", 0); /* ble_rfcore_rdbell_cm0p_secure */
	GEL_MapAddStr(0x40D01000, 0, 0x00000150, "R|W", 0); /* ble_rfcore_rdbell_cm0p */
	GEL_MapAddStr(0x44d01000, 0, 0x00000048, "R|W", 0); /* ble_rfcore_rdbell_secure */
	GEL_MapAddStr(0x40D01000, 0, 0x00000048, "R|W", 0); /* ble_rfcore_rdbell */
	GEL_MapAddStr(0x44d06000, 0, 0x00000140, "R|W", 0); /* ble_rfcore_rfe_secure */
	GEL_MapAddStr(0x40D06000, 0, 0x00000140, "R|W", 0); /* ble_rfcore_rfe */
	GEL_MapAddStr(0x44d00000, 0, 0x00000460, "R|W", 0); /* ble_top_secure */
	GEL_MapAddStr(0x40D00000, 0, 0x00000460, "R|W", 0); /* ble_top */
	GEL_MapAddStr(0x44850000, 0, 0x000000E8, "R|W", 0); /* coex_secure */
	GEL_MapAddStr(0x40850000, 0, 0x000000E8, "R|W", 0); /* coex */
	GEL_MapAddStr(0x45e00000, 0, 0x0000011C, "R|W", 0); /* core_aon_secure */
	GEL_MapAddStr(0x41E00000, 0, 0x0000011C, "R|W", 0); /* core_aon */
	GEL_MapAddStr(0x452a0000, 0, 0x00002020, "R|W", 0); /* dcan_secure */
	GEL_MapAddStr(0x412A0000, 0, 0x00002020, "R|W", 0); /* dcan */
	GEL_MapAddStr(0x450c0000, 0, 0x00000090, "R|W", 0); /* gpadc_ctrl_secure */
	GEL_MapAddStr(0x410C0000, 0, 0x00000090, "R|W", 0); /* gpadc_ctrl */
	GEL_MapAddStr(0x45260000, 0, 0x00001020, "R|W", 0); /* gptimer0_secure */
