/* \file        cc23xx_util.gel
 * \brief       Utility functions used to check which device is being connected to.
 *              Note: this gel script is intended to be loaded only on CC23xx and CC27xx devices.
 *
 * \revision    $Revision$
 */
int _deviceId = -1;
int _partId   = -1;
int _variantId = -1;

/** \brief  Reads the DEVICEID from the target and stores it in 'GEL'::_deviceId if it has not already been read */
ReadDeviceId()
{
    if('GEL'::_deviceId == -1)
    {
        // Read DEVICEID from device
        'GEL'::_deviceId = GEL_EvalOnTarget("CS_DAP_0", "'REG'::CFGAP_DEVICEID");
    }
}

/** \brief  Reads the PARTID from the target and stores it in 'GEL'::_partId if it has not already been read */
ReadPartId()
{
    if('GEL'::_partId == -1)
    {
        // Read PARTID from device
        'GEL'::_partId = GEL_EvalOnTarget("CS_DAP_0", "'REG'::CFGAP_PARTID");
    }
}

/** \brief  Reads the VariantID from the target's PARTID and stores it in 'GEL'::_variantId if it has not already been read */
ReadVariantId()
{
    if('GEL'::_variantId == -1)
    {
        // READ PARTID from device
        ReadPartId();
        'GEL'::_variantId = ('GEL'::_partId & 0xff0000) >> 16;
    }
}

/** \brief Determine if device is a CC27XX device */
IsCC27xx()
{
    int result = 0;

    ReadDeviceId();

    if(IsCC27xx_1M() || IsCC27xx_2M()
    )
    {
        result = 1;
    }

    return result;
}

/** \brief Determine if device is a CC27XX 2M device */
IsCC27xx_2M()
{
    int result = 0;
    ReadDeviceId();
    if(('GEL'::_deviceId & 0x0FFFFFFF) == 0x0BBC502F)
    {
        result = 1;
    }
    return result;
}

/** \brief Determine if device is a CC27XX 1M device */
IsCC27xx_1M()
{
    int result = 0;

    ReadDeviceId();

    if(('GEL'::_deviceId & 0x0FFFFFFF) == 0x0BB9802F)
    {
        result = 1;
    }

    return result;
}

/** \brief Determine if device is a CC27xxx10 device */
IsCC27xxx10()
{
    int result = 0;
    int variantId = 0;

    if(IsCC27xx_1M())
    {
        ReadVariantId();

        variantId = 'GEL'::_variantId;

        if (variantId == 0xE8 || variantId == 0xDE || variantId == 0x9D
        || variantId == 0xE6 || variantId == 0x31)
        {
            result = 1;
        }
    }

    return result;
}

/** \brief Determine if device is a CC27xxx7 device */
IsCC27xxx7()
{
    int result = 0;
    int variantId = 0;

    if(IsCC27xx_1M())
    {
        ReadVariantId();

        variantId = 'GEL'::_variantId;

        if (variantId == 0x48 || variantId == 0x87)
        {
            result = 1;
        }
    }

    return result;
}

/** \brief Determine if device is a CC27xx20 device */
IsCC27xxx20()
{
    int result = 0;
    int variantId = 0;
    if(IsCC27xx_2M())
    {
        ReadVariantId();
        variantId = 'GEL'::_variantId;
        if (variantId == 0x6E || variantId == 0x08 || variantId == 0xCA || variantId == 0x17
            || variantId == 0x2F || variantId == 0x67 || variantId == 0x80 || variantId == 0x4B
            || variantId == 0xE0 || variantId == 0xB1)
        {
            result = 1;
        }
    }
    return result;
}

/** \brief Determine if device is a CC27xx15 device */
IsCC27xxx15()
{
    int result = 0;
    int variantId = 0;
    if(IsCC27xx_2M())
    {
        ReadVariantId();
        variantId = 'GEL'::_variantId;
        if (variantId == 0x5A || variantId == 0x38 || variantId == 0xB9 || variantId == 0xF8
            || variantId == 0x9D)
        {
            result = 1;
        }
    }
    return result;
}

/** \brief Determine if device is a CC2755P20 device. This is the only 2M device with 192kB of RAM */
IsCC2755P20()
{
    int result = 0;
    int variantId = 0;
    if(IsCC27xxx20())
    {
        ReadVariantId();
        variantId = 'GEL'::_variantId;
        if (variantId == 0xB1)
        {
            result = 1;
        }
    }
    return result;
}


/** \brief  Determine if device is a CC23XX device */
IsCC23xx()
{

    int result = 0;

    if( IsCC23x0R5() || IsCC23x0R2()
      )
    {
        result = 1;
    }

    return result;

}

/** \brief  Determine if device is a CC2340R2 device */
IsCC23x0R2()
{
    int result = 0;

    ReadDeviceId();

    if(('GEL'::_deviceId & 0x0FFFFFFF) == 0x0BB8502F)
    {
        result = 1;
    }

    return result;
}

/** \brief  Determine if device is a CC2340R22 device */
IsCC23x0R22()
{
    int result = 0;
    int variantId = 0;

    ReadDeviceId();

    if(('GEL'::_deviceId & 0x0FFFFFFF) == 0x0BB8402F)
    {
        ReadVariantId();

        variantId = 'GEL'::_variantId;

        if (variantId == 0x9E)
        {
            result = 1;
        }
    }

    return result;
}

/** \brief  Determine if device is a CC23x0R5 device */
IsCC23x0R5()
{

    int result = 0;

    ReadDeviceId();
    if((('GEL'::_deviceId & 0x0FFFFFFF) == 0x0BB8402F) || (('GEL'::_deviceId & 0x0FFFFFFF) == 0x0BBAE02F))
    {
        result = 1;
    }

    return result;
}

/** \brief  Determine if device is a CC23x0R53 device */
IsCC23x0R53()
{

    int result = 0;

    ReadDeviceId();
    if(('GEL'::_deviceId & 0x0FFFFFFF) == 0x0BBAE02F)
    {
        result = 1;
    }

    return result;
}

/** \brief  Determine if device is a CC23x0R5 rev A with trim state A or B */
IsCC23x0R5_rev_A_trim_state_A_or_B()
{
    int result = 0;
    int trimState;

    if(IsCC23x0R5() && ((('GEL'::_deviceId & 0xF0000000) >> 28) == 0x0))
    {
        trimState = ((*((unsigned int *) 0x4E0003AC)) & 0xFF000000) >> 24;
        if (trimState == 0xFF || trimState == 0xFE)
        {
            result = 1;
        }
    }

    return result;
}




