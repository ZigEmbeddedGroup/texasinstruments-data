	GEL_TextOut("Powering down LPSC_SERDES_2\n");
    status &= Set_MAIN_PSC_State( PD_SERDES_2, LPSC_SERDES_2, PSC_PD_OFF, PSC_SYNCRESETDISABLE);
    GEL_TextOut("LPSC_SERDES_2 powered down.\n");
    return status;
}

