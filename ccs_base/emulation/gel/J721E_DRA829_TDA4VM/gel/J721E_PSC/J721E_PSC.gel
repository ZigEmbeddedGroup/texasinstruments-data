menuitem "Power Sleep Controller/Power Down by Power Domain Controls";

hotmenu PD_GP_CORE_CTL_WKUP_PowerDown(){
	int status = 1;
	GEL_TextOut("Powering down PD_GP_CORE_CTL_WKUP...\n");
	//WKUP domain
    GEL_TextOut("Powering down LPSC_WKUP_ALWAYSON\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUP_ALWAYSON, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_DMSC\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_DMSC, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_DEBUG2DMSC\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_DEBUG2DMSC, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_WKUP_GPIO\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUP_GPIO, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_WKUPMCU2MAIN\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUPMCU2MAIN, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MCU_TEST\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_TEST, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MCU_DEBUG\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_DEBUG, PSC_PD_ON, PSC_SYNCRESETDISABLE);
	//MCAN
	GEL_TextOut("Powering down LPSC_MCU_MCAN_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_MCAN_0, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MCU_MCAN_1\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_MCAN_1, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    //OSPI
    GEL_TextOut("Powering down LPSC_MCU_OSPI_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_OSPI_0, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MCU_OSPI_1\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_OSPI_1, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    //Hyperbus
    GEL_TextOut("Powering down LPSC_MCU_HYPERBUS\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_HYPERBUS, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    //I3C
    GEL_TextOut("Powering down LPSC_MCU_I3C_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_I3C_0, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MCU_I3C_1\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_I3C_1, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    //ADC
    GEL_TextOut("Powering down LPSC_MCU_ADC_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_ADC_0, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MCU_ADC_1\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_ADC_1, PSC_PD_OFF, PSC_SYNCRESETDISABLE);
    //Don't turn on the spare PSCs (there are 2 of them)
    GEL_TextOut("PD_GP_CORE_CTL_WKUP powered down.\n");
    return status;
}

hotmenu PD_MCU_PULSAR_PowerDown(){
	int status = 1; 
	GEL_TextOut("Powering down PD_MCU_PULSAR...\n");
	//R5F
    GEL_TextOut("Powering down LPSC_MCU_R5_0\n");
    status &= Set_WKUP_PSC_State( PD_MCU_PULSAR, LPSC_MCU_R5_0, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MCU_R5_1\n");
