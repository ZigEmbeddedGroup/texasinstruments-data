    GEL_TextOut("Checking LPSC_MCU_TEST\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_TEST);
    GEL_TextOut("Checking LPSC_MCU_DEBUG\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_DEBUG);
	//MCAN
	GEL_TextOut("Checking LPSC_MCU_MCAN_0\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_MCAN_0);
    GEL_TextOut("Checking LPSC_MCU_MCAN_1\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_MCAN_1);
    //OSPI
    GEL_TextOut("Checking LPSC_MCU_OSPI_0\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_OSPI_0);
    GEL_TextOut("Checking LPSC_MCU_OSPI_1\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_OSPI_1);
    //Hyperbus
    GEL_TextOut("Checking LPSC_MCU_HYPERBUS\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_HYPERBUS);
    //I3C
    GEL_TextOut("Checking LPSC_MCU_I3C_0\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_I3C_0);
    GEL_TextOut("Checking LPSC_MCU_I3C_1\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_I3C_1);
    //ADC
    GEL_TextOut("Checking LPSC_MCU_ADC_0\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_ADC_0);
    GEL_TextOut("Checking LPSC_MCU_ADC_1\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_ADC_1);
    //Don't turn on the spare PSCs (there are 2 of them)
    GEL_TextOut("All WKUP PSCs checked/read.\n");
    return status;
}

