    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_DSI);
    //eDP
    GEL_TextOut("Checking LPSC_EDP_0\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_EDP_0);
    GEL_TextOut("Checking LPSC_EDP_1\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_EDP_1);
    //CSI
    GEL_TextOut("Checking LPSC_CSITX_0\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_CSITX_0);
    GEL_TextOut("Checking LPSC_CSIRX_PHY_0\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_PHY_0);
	GEL_TextOut("Checking LPSC_CSIRX_PHY_1\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_PHY_1);
    GEL_TextOut("Checking LPSC_CSIRX_PHY_2\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_PHY_2);
    GEL_TextOut("Checking LPSC_CSIRX_0\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_0);
	GEL_TextOut("Checking LPSC_CSIRX_1\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_1);
    GEL_TextOut("Checking LPSC_CSIRX_2\n");
    status &= Get_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_2);

    //GPU
    GEL_TextOut("Checking LPSC_GPUCOM\n");
    status &= Get_MAIN_PSC_State( PD_GPUCOM, LPSC_GPUCOM);
    GEL_TextOut("Checking LPSC_GPUPBIST\n");
    status &= Get_MAIN_PSC_State( PD_GPUCOM, LPSC_GPUPBIST);
    GEL_TextOut("Checking LPSC_GPUCORE\n");
    status &= Get_MAIN_PSC_State( PD_GPUCORE, LPSC_GPUCORE);

    //Decode
    GEL_TextOut("Checking LPSC_DECODE_0\n");
    status &= Get_MAIN_PSC_State( PD_DECODE, LPSC_DECODE_0);
	GEL_TextOut("Checking LPSC_DECODE_PBIST\n");
    status &= Get_MAIN_PSC_State( PD_DECODE, LPSC_DECODE_PBIST);
    //Encode
    GEL_TextOut("Checking LPSC_ENCODE_0\n");
    status &= Get_MAIN_PSC_State( PD_ENCODE, LPSC_ENCODE_0);
	GEL_TextOut("Checking LPSC_ENCODE_PBIST\n");
    status &= Get_MAIN_PSC_State( PD_ENCODE, LPSC_ENCODE_PBIST);
    //DMPAC
    GEL_TextOut("Checking LPSC_DMPAC\n");
    status &= Get_MAIN_PSC_State( PD_DMPAC, LPSC_DMPAC);
	GEL_TextOut("Checking LPSC_SDE\n");
    status &= Get_MAIN_PSC_State( PD_DMPAC, LPSC_SDE);
	GEL_TextOut("Checking LPSC_DMPAC_PBIST\n");
    status &= Get_MAIN_PSC_State( PD_DMPAC, LPSC_DMPAC_PBIST);
    //VPAC
    GEL_TextOut("Checking LPSC_VPAC\n");
    status &= Get_MAIN_PSC_State( PD_VPAC, LPSC_VPAC);
    GEL_TextOut("Checking LPSC_VPAC_PBIST\n");
    status &= Get_MAIN_PSC_State( PD_VPAC, LPSC_VPAC_PBIST);
    GEL_TextOut( "Checking all PSC power domains done!\n");
    return status;
}

