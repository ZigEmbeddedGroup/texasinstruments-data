menuitem "Power Sleep Controller/Reset Functions";

hotmenu MAIN_PSC_Peripheral_Reset(){
	int status = 1;
	GEL_TextOut( "Resetting MAIN domain peripherals...\n");
	GEL_TextOut("Reset LPSC_MAIN_ALWAYSON\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_ALWAYSON, PSC_PD_ON, PSC_SYNCRESET);
   	GEL_TextOut("Reset LPSC_MAIN_TEST\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_TEST, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Powering up LPSC_MAIN_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_PBIST, PSC_PD_ON, PSC_SYNCRESET);
    //Audio
    GEL_TextOut("Reset LPSC_PER_AUDIO\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_AUDIO, PSC_PD_ON, PSC_SYNCRESET);
    //ATL
	GEL_TextOut("Reset LPSC_PER_ATL\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_ATL, PSC_PD_ON, PSC_SYNCRESET);
    //MLB 
	GEL_TextOut("Reset LPSC_PER_MLB\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_MLB, PSC_PD_ON, PSC_SYNCRESET);
    //Motor
	GEL_TextOut("Reset LPSC_PER_MOTOR\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_MOTOR, PSC_PD_ON, PSC_SYNCRESET);
    //MISCIO
	GEL_TextOut("Reset LPSC_PER_MISCIO\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_MISCIO, PSC_PD_ON, PSC_SYNCRESET);
    //GPMC
	GEL_TextOut("Reset LPSC_PER_GPMC\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_GPMC, PSC_PD_ON, PSC_SYNCRESET);
	//VPFE
	GEL_TextOut("Reset LPSC_PER_VPFE\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_VPFE, PSC_PD_ON, PSC_SYNCRESET);
	//VPE
	GEL_TextOut("Reset LPSC_PER_VPE\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_VPE, PSC_PD_ON, PSC_SYNCRESET);
    //Don't turn on the spare main LPSCs (there are 2 of them)
	GEL_TextOut("Reset LPSC_MAIN_DEBUG\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_DEBUG, PSC_PD_ON, PSC_SYNCRESET);
    //DDR
    GEL_TextOut("Reset LPSC_EMIF_CFG_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_EMIF_DATA_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_EMIF_CFG_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_EMIF_DATA_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_1, PSC_PD_ON, PSC_SYNCRESET);
    //Don't turn on the PER SPARE2.
    //DMTimer
    GEL_TextOut("Reset LPSC_DMTIMER_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_DMTIMER_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_DMTIMER_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_DMTIMER_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_DMTIMER_2\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_DMTIMER_2, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_DMTIMER_3\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_DMTIMER_3, PSC_PD_ON, PSC_SYNCRESET);
    //MMC
    GEL_TextOut("Reset LPSC_MMC4B_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MMC4B_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MMC4B_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MMC4B_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MMC8B_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MMC8B_0, PSC_PD_ON, PSC_SYNCRESET);
    //UFS
    GEL_TextOut("Reset LPSC_UFS_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_UFS_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_UFS_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_UFS_1, PSC_PD_ON, PSC_SYNCRESET);
    //SAUL
   	GEL_TextOut("Reset LPSC_SAUL\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_SAUL, PSC_PD_ON, PSC_SYNCRESET);
    //I3C
    GEL_TextOut("Reset LPSC_PER_I3C\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_I3C, PSC_PD_ON, PSC_SYNCRESET);
    //MCANSS
   	GEL_TextOut("Reset LPSC_MAIN_MCANSS_0\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_1\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_2\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_2, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_3\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_3, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_4\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_4, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_5\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_5, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_6\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_6, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_7\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_7, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_8\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_8, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_9\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_9, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_10\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_10, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_11\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_11, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_12\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_12, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MAIN_MCANSS_13\n");
    status &= Set_MAIN_PSC_State( PD_MCANSS, LPSC_MAIN_MCANSS_13, PSC_PD_ON, PSC_SYNCRESET);
    //SERDES
    GEL_TextOut("Reset LPSC_SERDES_0\n");
    status &= Set_MAIN_PSC_State( PD_SERDES_0, LPSC_SERDES_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_SERDES_1\n");
    status &= Set_MAIN_PSC_State( PD_SERDES_1, LPSC_SERDES_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_SERDES_2\n");
    status &= Set_MAIN_PSC_State( PD_SERDES_2, LPSC_SERDES_2, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_SERDES_3\n");
    status &= Set_MAIN_PSC_State( PD_SERDES_3, LPSC_SERDES_3, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_SERDES_4\n");
    status &= Set_MAIN_PSC_State( PD_SERDES_4, LPSC_SERDES_4, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_SERDES_5\n");
    status &= Set_MAIN_PSC_State( PD_SERDES_5, LPSC_SERDES_5, PSC_PD_ON, PSC_SYNCRESET);
    //USB
    GEL_TextOut("Reset LPSC_USB_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_USB_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_USB_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_USB_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_USB_2\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_USB_2, PSC_PD_ON, PSC_SYNCRESET);
    //PCIe
    GEL_TextOut("Reset LPSC_PCIE_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PCIE_0, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Reset LPSC_PCIE_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PCIE_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_PCIE_2\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PCIE_2, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_PCIE_3\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PCIE_3, PSC_PD_ON, PSC_SYNCRESET);
    //ICSSG
    GEL_TextOut("Reset LPSC_ICSSG_0\n");
    status &= Set_MAIN_PSC_State( PD_ICSS, LPSC_ICSSG_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_ICSSG_1\n");
    status &= Set_MAIN_PSC_State( PD_ICSS, LPSC_ICSSG_1, PSC_PD_ON, PSC_SYNCRESET);
    //9GSS
    GEL_TextOut("Reset LPSC_9GSS\n");
    status &= Set_MAIN_PSC_State( PD_9GSS, LPSC_9GSS, PSC_PD_ON, PSC_SYNCRESET);
    //DSS
    GEL_TextOut("Reset LPSC_DSS_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_DSS_PBIST, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_DSS\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_DSS, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_TX_DPHY_0\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_TX_DPHY_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_DSI\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_DSI, PSC_PD_ON, PSC_SYNCRESET);
    //eDP
    GEL_TextOut("Reset LPSC_EDP_0\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_EDP_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_EDP_1\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_EDP_1, PSC_PD_ON, PSC_SYNCRESET);
    //CSI
    GEL_TextOut("Reset LPSC_CSITX_0\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_CSITX_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_CSIRX_PHY_0\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_PHY_0, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Reset LPSC_CSIRX_PHY_1\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_PHY_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_CSIRX_PHY_2\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_PHY_2, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_CSIRX_0\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_0, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Reset LPSC_CSIRX_1\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_CSIRX_2\n");
    status &= Set_MAIN_PSC_State( PD_DSS, LPSC_CSIRX_2, PSC_PD_ON, PSC_SYNCRESET);

    //GPU
    GEL_TextOut("Reset LPSC_GPUCOM\n");
    status &= Set_MAIN_PSC_State( PD_GPUCOM, LPSC_GPUCOM, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_GPUPBIST\n");
    status &= Set_MAIN_PSC_State( PD_GPUCOM, LPSC_GPUPBIST, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_GPUCORE\n");
    status &= Set_MAIN_PSC_State( PD_GPUCORE, LPSC_GPUCORE, PSC_PD_ON, PSC_SYNCRESET);

    //Decode
    GEL_TextOut("Reset LPSC_DECODE_0\n");
    status &= Set_MAIN_PSC_State( PD_DECODE, LPSC_DECODE_0, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Reset LPSC_DECODE_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_DECODE, LPSC_DECODE_PBIST, PSC_PD_ON, PSC_SYNCRESET);
    //Encode
    GEL_TextOut("Reset LPSC_ENCODE_0\n");
    status &= Set_MAIN_PSC_State( PD_ENCODE, LPSC_ENCODE_0, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Reset LPSC_ENCODE_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_ENCODE, LPSC_ENCODE_PBIST, PSC_PD_ON, PSC_SYNCRESET);
    //DMPAC
    GEL_TextOut("Reset LPSC_DMPAC\n");
    status &= Set_MAIN_PSC_State( PD_DMPAC, LPSC_DMPAC, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Reset LPSC_SDE\n");
    status &= Set_MAIN_PSC_State( PD_DMPAC, LPSC_SDE, PSC_PD_ON, PSC_SYNCRESET);
	GEL_TextOut("Reset LPSC_DMPAC_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_DMPAC, LPSC_DMPAC_PBIST, PSC_PD_ON, PSC_SYNCRESET);
    //VPAC
    GEL_TextOut("Reset LPSC_VPAC\n");
    status &= Set_MAIN_PSC_State( PD_VPAC, LPSC_VPAC, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_VPAC_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_VPAC, LPSC_VPAC_PBIST, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut( "All Main Peripheral PSC power domains reset!\n");
    return status;
}

hotmenu PD_MCU_PULSAR_Reset(){
	int status = 1; 
	GEL_TextOut("Reset PD_MCU_PULSAR...\n");
	//R5F
    GEL_TextOut("Reset LPSC_MCU_R5_0\n");
    status &= Set_WKUP_PSC_State( PD_MCU_PULSAR, LPSC_MCU_R5_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MCU_R5_1\n");
    status &= Set_WKUP_PSC_State( PD_MCU_PULSAR, LPSC_MCU_R5_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_MCU_PULSAR_PBIST_0\n");
    status &= Set_WKUP_PSC_State( PD_MCU_PULSAR, LPSC_MCU_PULSAR_PBIST_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("PD_MCU_PULSAR reset.\n");
    return status;
}

hotmenu PD_GP_CORE_CTL_Reset(){
	int status = 1;
	GEL_TextOut("Powering up PD_GP_CORE_CTRL...\n");
	//Now for Main PSC power tree
   	GEL_TextOut("Powering up LPSC_MAIN_ALWAYSON\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_ALWAYSON, PSC_PD_ON, PSC_SYNCRESET);
   	GEL_TextOut("Reset LPSC_MAIN_TEST\n");
