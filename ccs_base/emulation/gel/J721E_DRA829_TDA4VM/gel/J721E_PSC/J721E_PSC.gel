hotmenu Turn_Off_Serdes(){
	//SERDES
	PD_SERDES_0_PowerDown();
	PD_SERDES_1_PowerDown();
	PD_SERDES_2_PowerDown();
	PD_SERDES_3_PowerDown();
	PD_SERDES_4_PowerDown();
	PD_SERDES_5_PowerDown();
}

