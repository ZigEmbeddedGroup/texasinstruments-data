    GEL_TextOut("Powering down LPSC_MCU_PULSAR_PBIST_0\n");
    status &= Set_WKUP_PSC_State( PD_MCU_PULSAR, LPSC_MCU_PULSAR_PBIST_0, PSC_PD_OFF, PSC_SYNCRESETDISABLE);
    GEL_TextOut("PD_MCU_PULSAR powered down.\n");
    return status;
}

hotmenu PD_GP_CORE_CTL_PowerDown(){
	int status = 1;
	GEL_TextOut("Powering down PD_GP_CORE_CTRL...\n");
	//Now for Main PSC power tree
   	GEL_TextOut("Powering down LPSC_MAIN_ALWAYSON\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_ALWAYSON, PSC_PD_ON, PSC_SYNCRESETDISABLE);
   	GEL_TextOut("Powering down LPSC_MAIN_TEST\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_TEST, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    GEL_TextOut("Powering down LPSC_MAIN_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_PBIST, PSC_PD_ON, PSC_SYNCRESETDISABLE);
    //Audio
    GEL_TextOut("Powering down LPSC_PER_AUDIO\n");
