    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_1, PSC_PD_ON, PSC_SYNCRESET);
    //Don't turn on the PER SPARE2.
    //DMTimer
    GEL_TextOut("Reset LPSC_DMTIMER_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_DMTIMER_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_DMTIMER_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_DMTIMER_1, PSC_PD_ON, PSC_SYNCRESET);
