/**
 * \file  J721E_R5LOCKSTEP.gel
 *
 * \brief GEL File to manage split-mode/lockstep functionality for R5F CPUs.
 */

#define MCU_SEC_MMR_BASE  (0x45A50000)
#define MAIN_SEC_MMR_BASE (0x45A40000)

menuitem "R5 Lockstep Control"

hotmenu MCU_R5_Cluster_0_split() {
    unsigned int * sec_mmr;
    sec_mmr = (unsigned int *) (MCU_SEC_MMR_BASE +  0x40);
    *sec_mmr = 0x00000008;

}

hotmenu MCU_R5_Cluster_0_lock() {
    unsigned int * sec_mmr;
    sec_mmr = (unsigned int *) (MCU_SEC_MMR_BASE +  0x40);
    *sec_mmr = 0x00000009;

}

hotmenu MAIN_R5_Cluster_0_split() {
    unsigned int * sec_mmr;
    sec_mmr = (unsigned int *) (MAIN_SEC_MMR_BASE +  0x40);
    *sec_mmr = 0x00000008;

}

hotmenu MAIN_R5_Cluster_0_lock() {
    unsigned int * sec_mmr;
    sec_mmr = (unsigned int *) (MAIN_SEC_MMR_BASE +  0x40);
    *sec_mmr = 0x00000009;

}

hotmenu MAIN_R5_Cluster_1_split() {
    unsigned int * sec_mmr;
    sec_mmr = (unsigned int *) (MAIN_SEC_MMR_BASE +  0x1040);
    *sec_mmr = 0x00000008;

}

hotmenu MAIN_R5_Cluster_1_lock() {
    unsigned int * sec_mmr;
    sec_mmr = (unsigned int *) (MAIN_SEC_MMR_BASE +  0x1040);
    *sec_mmr = 0x00000009;

}
