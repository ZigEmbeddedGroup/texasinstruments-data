    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1407__SFR_OFFS, DDRSS3_PHY_1407_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1408__SFR_OFFS, DDRSS3_PHY_1408_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1409__SFR_OFFS, DDRSS3_PHY_1409_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1410__SFR_OFFS, DDRSS3_PHY_1410_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1411__SFR_OFFS, DDRSS3_PHY_1411_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1412__SFR_OFFS, DDRSS3_PHY_1412_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1413__SFR_OFFS, DDRSS3_PHY_1413_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1414__SFR_OFFS, DDRSS3_PHY_1414_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1415__SFR_OFFS, DDRSS3_PHY_1415_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1416__SFR_OFFS, DDRSS3_PHY_1416_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1417__SFR_OFFS, DDRSS3_PHY_1417_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1418__SFR_OFFS, DDRSS3_PHY_1418_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1419__SFR_OFFS, DDRSS3_PHY_1419_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1420__SFR_OFFS, DDRSS3_PHY_1420_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1421__SFR_OFFS, DDRSS3_PHY_1421_DATA  );
    HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PHY_Core_REGISTER_BLOCK__OFFS + DDRSS_PHY_1422__SFR_OFFS, DDRSS3_PHY_1422_DATA  );

    if (PRE_SILICON) {

        printf("--->>> Pre-SILICON SIMULATION: Manual modification by Rajesh... <<<---\n");
        //from 0x2f0e0a09 to clear (LPI_WKUP_EN[0]=0) to disable the controller idle
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_CTL_139__SFR_OFFS, (DDRSS3_CTL_139_DATA & 0xFEFFFFFF));
        //from 0x07000401 to remove lp entry (LPI_CTRL_REQ_EN=0)
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_CTL_140__SFR_OFFS, (DDRSS3_CTL_140_DATA & 0xFFFFFFFE));
        //from 0x08080100 to avoid per chipselect pd enable(PCPCS_PD_EN=0)
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_CTL_148__SFR_OFFS, (DDRSS3_CTL_148_DATA & 0xFFFFFEFF));
        //from 0x15110000 to update the AREF_NORM_THRESHOLD to 0x13 in case of PBR
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_CTL_227__SFR_OFFS, (DDRSS3_CTL_227_DATA & 0xFFE0FFFF | 0x00130000));
        //from 0x01180101 to 0x01140101 to reduce NUM_Q_ENTRIES_ACT_DISABLE from 0x18 to 0x14 per CDN suggestion
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_CTL_277__SFR_OFFS, (DDRSS3_CTL_277_DATA & 0xFFE0FFFF | 0x00140000));
        //from 0x00000000 to Enables use of the AWALLSTRB signal for AXI port 0.
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_CTL_377__SFR_OFFS, (DDRSS3_CTL_377_DATA | 0x00010000));
        //to clear DISABLE_MEMORY_MASKED_WRITE bit. Bit[16]
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_CTL_430__SFR_OFFS, (DDRSS3_CTL_430_DATA & 0xFFFEFFFF));


        printf("--->>> Disable all trainig for pre-silicon simulation <<<---\n");
        //Reggen=0x01010404, DV=> (FIELD__PI_WRLVL_EN_F1__WRITE(0x0) | FIELD__PI_WRLVL_EN_F0__WRITE(0x0) | FIELD__PI_TDFI_CTRL_DELAY_F2__WRITE(0x4) | FIELD__PI_TDFI_CTRL_DELAY_F1__WRITE(0x4)));
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_175__SFR_OFFS, 0x00000404);
        //Reggen=0x00001501, DV=> (FIELD__PI_TDFI_WRLVL_WW_F0__WRITE(0x15)  FIELD__PI_WRLVL_EN_F2__WRITE(0x0)));
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_176__SFR_OFFS, 0x00001500);
        //Reggen=0x01010101, DV=> (FIELD__PI_TMRZ_F0__WRITE(0x1) | FIELD__PI_CALVL_EN_F2__WRITE(0x0) | FIELD__PI_CALVL_EN_F1__WRITE(0x0) | FIELD__PI_CALVL_EN_F0__WRITE(0x0)));
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_191__SFR_OFFS, 0x01000000);
        //Reggen=0x00000101, DV=> (FIELD__PI_NTP_TRAIN_EN_F0__WRITE(0x0) | FIELD__PI_WDQLVL_EN_F0__WRITE(0x0) | FIELD__PI_WDQLVL_VREF_DELTA_F0__WRITE(0x1)));
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_212__SFR_OFFS, 0x00000001);
        //Reggen=0x01011e1a, DV=> (FIELD__PI_WDQLVL_EN_F1__WRITE(0x0) | FIELD__PI_WDQLVL_VREF_DELTA_F1__WRITE(0x1) | FIELD__PI_WDQLVL_VREF_INITIAL_STOP_POINT_F1__WRITE(0x1e) | FIELD__PI_WDQLVL_VREF_INITIAL_START_POINT_F1__WRITE(0x1a)));
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_214__SFR_OFFS, 0x00011E1A);
        //Reggen=0x09000101, DV=> (FIELD__PI_TRTP_F0__WRITE(0x9) | FIELD__PI_NTP_TRAIN_EN_F2__WRITE(0x0) | FIELD__PI_WDQLVL_EN_F2__WRITE(0x0) | FIELD__PI_WDQLVL_VREF_DELTA_F2__WRITE(0x1)));
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_217__SFR_OFFS, 0x09000001);

        //adjust the latencies
        printf("--->>> Adjust the latencies for pre-silicon simulation <<<---\n");
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_131__SFR_OFFS,  0x01A00000 );
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_387__SFR_OFFS,  0x01A00000 );
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_643__SFR_OFFS,  0x01A00000 );
        HW_WR_REG32(J7_DDR3_SS_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_899__SFR_OFFS,  0x01A00000 );
    }

    printf("--->>> DDR3 PHY programming completed... <<<---\n");  

}


static void DDRSS0_Set_DDR_PLL(unsigned int frequency)
{
    if(frequency == 1066500000){
        Set_DDR0_PLL_1066MHz();
    }else if(frequency == 533000000){
        Set_DDR0_PLL_533MHz();
    }else{
        printf("Frequency not supported by GEL\n");
    }
}

static void DDRSS1_Set_DDR_PLL(unsigned int frequency)
{
    if(frequency == 1066500000){
        Set_DDR1_PLL_1066MHz();
    }else if(frequency == 533000000){
        Set_DDR1_PLL_533MHz();
    }else{
        printf("Frequency not supported by GEL\n");
    }
}

static void DDRSS2_Set_DDR_PLL(unsigned int frequency)
{
    if(frequency == 1066500000){
        Set_DDR2_PLL_1066MHz();
    }else if(frequency == 533000000){
        Set_DDR2_PLL_533MHz();
    }else{
        printf("Frequency not supported by GEL\n");
    }
}

static void DDRSS3_Set_DDR_PLL(unsigned int frequency)
{
    if(frequency == 1066500000){
        Set_DDR3_PLL_1066MHz();
    }else if(frequency == 533000000){
        Set_DDR3_PLL_533MHz();
    }else{
        printf("Frequency not supported by GEL\n");
    }
}

static void DDRSS_LPDDR4_Ack_Freq_Upd_Req(uint32_t ddrss_num)                                   
{
    // unsigned int req, req_type, counter;
    unsigned int req_type, counter;
    unsigned int fsp_clkchng_req_addr = 0;
    unsigned int fsp_clkchng_ack_addr = 0;
    unsigned int ddrss_pll_fhs_cnt = DDRSS_PLL_FHS_CNT;

    if (PRE_SILICON) {
        ddrss_pll_fhs_cnt = 2;
    }

    if (ddrss_num == 0) {
        fsp_clkchng_req_addr = CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR0;
        fsp_clkchng_ack_addr = CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR0;
    } else if (ddrss_num == 1) {
        fsp_clkchng_req_addr = CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR1;
        fsp_clkchng_ack_addr = CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR1;
    } else if (ddrss_num == 2) {
        fsp_clkchng_req_addr = CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR2;
        fsp_clkchng_ack_addr = CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR2;
    } else if (ddrss_num == 3) {
        fsp_clkchng_req_addr = CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR3;
        fsp_clkchng_ack_addr = CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR3;
    }

    // GEL_TextOut("Frequency change request addr %x \n",,,,, fsp_clkchng_req_addr);
    // GEL_TextOut("Frequency change ack addr %x \n",,,,, fsp_clkchng_ack_addr);
    printf("--->>> Waiting for frequency change requests ... <<<---\n");

    for(counter = 0; counter < ddrss_pll_fhs_cnt; counter++)
    {
        //wait for freq change request
        // while((HW_RD_REG32(fsp_clkchng_req_addr) & 0x80) == 0x0);
        while((HW_RD_REG32((M4_RAT_OFFSET + fsp_clkchng_req_addr)) & 0x80) == 0x0);

        req_type = (HW_RD_REG32((M4_RAT_OFFSET + fsp_clkchng_req_addr)) & 0x03);
        GEL_TextOut("Frequency change request type %d received from controller \n",,,,, req_type);
        // GEL_TextOut("PLL_FREQ_1 %d  \n",,,,, DDRSS_PLL_FREQUENCY_1);
        // GEL_TextOut("PLL_FREQ_2 %d  \n",,,,, DDRSS_PLL_FREQUENCY_2);

        if(req_type == 1){
            if (ddrss_num == 0) {
                DDRSS0_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
            } else if (ddrss_num == 1) {
                DDRSS1_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
            } else if (ddrss_num == 2) {
                DDRSS2_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
            } else if (ddrss_num == 3) {
                DDRSS3_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_1);
            }
        }else if(req_type == 2){
            if (ddrss_num == 0) {
                DDRSS0_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
            } else if (ddrss_num == 1) {
                DDRSS1_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
            } else if (ddrss_num == 2) {
                DDRSS2_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
            } else if (ddrss_num == 3) {
                DDRSS3_Set_DDR_PLL(DDRSS_PLL_FREQUENCY_2);
            }
        }else if(req_type == 0){
            if (ddrss_num == 0) {
                Set_DDR0_PLL_EXTBYPASS();
            } else if (ddrss_num == 1) {
                Set_DDR1_PLL_EXTBYPASS();
            } else if (ddrss_num == 2) {
                Set_DDR2_PLL_EXTBYPASS();
            } else if (ddrss_num == 3) {
                Set_DDR3_PLL_EXTBYPASS();
            }
        }else{
            GEL_TextOut("error\n",,,,,);
        }

        // acknowledge freq change request
        HW_WR_REG32((M4_RAT_OFFSET + fsp_clkchng_ack_addr), 0x1); 

        while((HW_RD_REG32((M4_RAT_OFFSET + fsp_clkchng_req_addr)) & 0x80) == 0x80);

        // clear acknowledge
        HW_WR_REG32((M4_RAT_OFFSET + fsp_clkchng_ack_addr), 0x0); 
    }

    printf("--->>> All frequency change requests have completed... <<<---\n");                 
}

// hotmenu J7_LPDDR4_Config(void)
J7_LPDDR4_Config_Single(uint32_t ddrss_num)
{
    uint32_t j7_ddr_ss_base    = 0;

    printf("--->>> LPDDR4 Initialization is in progress ... <<<---\n");

    //unlock MMR reg 5
    //Partition5 lockkey0
    HW_WR_REG32((M4_RAT_OFFSET + CTRLMMR_LOCK5_KICK0), CTRLMMR_LOCK5_KICK0_KEY);
    //Partition5 lockkey1
    HW_WR_REG32((M4_RAT_OFFSET + CTRLMMR_LOCK5_KICK1), CTRLMMR_LOCK5_KICK1_KEY);

    if (!PRE_SILICON) {
        /* Start with PLL in bypass mode */
        if (ddrss_num == 0)      { Set_DDR0_PLL_EXTBYPASS(); } 
        else if (ddrss_num == 1) { Set_DDR1_PLL_EXTBYPASS(); } 
        else if (ddrss_num == 2) { Set_DDR2_PLL_EXTBYPASS(); }
        else if (ddrss_num == 3) { Set_DDR3_PLL_EXTBYPASS(); }
    }

    if (ddrss_num == 0)        { DDRSS0_Register_Init(); } 
    else if (ddrss_num == 1)   { DDRSS1_Register_Init(); } 
    else if (ddrss_num == 2)   { DDRSS2_Register_Init(); } 
    else if (ddrss_num == 3)   { DDRSS3_Register_Init(); } 

    if (ddrss_num == 0)        { j7_ddr_ss_base = J7_DDR0_SS_BASE; } 
    else if (ddrss_num == 1)   { j7_ddr_ss_base = J7_DDR1_SS_BASE; } 
    else if (ddrss_num == 2)   { j7_ddr_ss_base = J7_DDR2_SS_BASE; }
    else if (ddrss_num == 3)   { j7_ddr_ss_base = J7_DDR3_SS_BASE; }

    //Trigger the DDR PI start bit
    HW_WR_REG32(j7_ddr_ss_base + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_0__SFR_OFFS,   0x00000B01);    

    printf("--->>> DDR PI initialization started... <<<---\n");    

    //Trigger the DDR controller start bit
    HW_WR_REG32(j7_ddr_ss_base + DDRSS_CTL_0__SFR_OFFS,   0x00000B01);

    printf("--->>> DDR Controller initialization started... <<<---\n");    

    DDRSS_LPDDR4_Ack_Freq_Upd_Req(ddrss_num);

    // Wait for PI completion
    while(((HW_RD_REG32(j7_ddr_ss_base + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_79__SFR_OFFS)) & 0x1) != 0x1);
    HW_WR_REG32(j7_ddr_ss_base + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_80__SFR_OFFS, 0x1 );

    // Wait for controller completion
    while((HW_RD_REG32(j7_ddr_ss_base + DDRSS_CTL_293__SFR_OFFS)!= 0x200));
    HW_WR_REG32(j7_ddr_ss_base + DDRSS_CTL_295__SFR_OFFS, 0x200 );

    printf("--->>> LPDDR4 Initialization is DONE! <<<---\n");  	
}

