    if (PRE_SILICON) {

        printf("--->>> Pre-SILICON SIMULATION: Manual modification by Rajesh... <<<---\n");
        //from 0x2f0e0a09 to clear (LPI_WKUP_EN[0]=0) to disable the controller idle
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_CTL_139__SFR_OFFS, (DDRSS0_CTL_139_DATA & 0xFEFFFFFF));
        //from 0x07000401 to remove lp entry (LPI_CTRL_REQ_EN=0)
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_CTL_140__SFR_OFFS, (DDRSS0_CTL_140_DATA & 0xFFFFFFFE));
        //from 0x08080100 to avoid per chipselect pd enable(PCPCS_PD_EN=0)
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_CTL_148__SFR_OFFS, (DDRSS0_CTL_148_DATA & 0xFFFFFEFF));
        //from 0x15110000 to update the AREF_NORM_THRESHOLD to 0x13 in case of PBR
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_CTL_227__SFR_OFFS, (DDRSS0_CTL_227_DATA & 0xFFE0FFFF | 0x00130000));
        //from 0x01180101 to 0x01140101 to reduce NUM_Q_ENTRIES_ACT_DISABLE from 0x18 to 0x14 per CDN suggestion
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_CTL_277__SFR_OFFS, (DDRSS0_CTL_277_DATA & 0xFFE0FFFF | 0x00140000));
        //from 0x00000000 to Enables use of the AWALLSTRB signal for AXI port 0.
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_CTL_377__SFR_OFFS, (DDRSS0_CTL_377_DATA | 0x00010000));
        //to clear DISABLE_MEMORY_MASKED_WRITE bit. Bit[16]
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_CTL_430__SFR_OFFS, (DDRSS0_CTL_430_DATA & 0xFFFEFFFF));


        printf("--->>> Disable all trainig for pre-silicon simulation <<<---\n");
        //Reggen=0x01010404, DV=> (FIELD__PI_WRLVL_EN_F1__WRITE(0x0) | FIELD__PI_WRLVL_EN_F0__WRITE(0x0) | FIELD__PI_TDFI_CTRL_DELAY_F2__WRITE(0x4) | FIELD__PI_TDFI_CTRL_DELAY_F1__WRITE(0x4)));
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_175__SFR_OFFS, 0x00000404);
        //Reggen=0x00001501, DV=> (FIELD__PI_TDFI_WRLVL_WW_F0__WRITE(0x15) | FIELD__PI_WRLVL_EN_F2__WRITE(0x0)));
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_176__SFR_OFFS, 0x00001500);
        //Reggen=0x01010101, DV=> (FIELD__PI_TMRZ_F0__WRITE(0x1) | FIELD__PI_CALVL_EN_F2__WRITE(0x0) | FIELD__PI_CALVL_EN_F1__WRITE(0x0) | FIELD__PI_CALVL_EN_F0__WRITE(0x0)));
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_191__SFR_OFFS, 0x01000000);
        //Reggen=0x00000101, DV=> (FIELD__PI_NTP_TRAIN_EN_F0__WRITE(0x0) | FIELD__PI_WDQLVL_EN_F0__WRITE(0x0) | FIELD__PI_WDQLVL_VREF_DELTA_F0__WRITE(0x1)));
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_212__SFR_OFFS, 0x00000001);
        //Reggen=0x01011e1a, DV=> (FIELD__PI_WDQLVL_EN_F1__WRITE(0x0) | FIELD__PI_WDQLVL_VREF_DELTA_F1__WRITE(0x1) | FIELD__PI_WDQLVL_VREF_INITIAL_STOP_POINT_F1__WRITE(0x1e) | FIELD__PI_WDQLVL_VREF_INITIAL_START_POINT_F1__WRITE(0x1a)));
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_214__SFR_OFFS, 0x00011E1A);
        //Reggen=0x09000101, DV=> (FIELD__PI_TRTP_F0__WRITE(0x9) | FIELD__PI_NTP_TRAIN_EN_F2__WRITE(0x0) | FIELD__PI_WDQLVL_EN_F2__WRITE(0x0) | FIELD__PI_WDQLVL_VREF_DELTA_F2__WRITE(0x1)));
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_PI_REGISTER_BLOCK__OFFS + DDRSS_PI_217__SFR_OFFS, 0x09000001);

        //adjust the latencies
        printf("--->>> Adjust the latencies for pre-silicon simulation <<<---\n");
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_Data_Slice_0_REGISTER_BLOCK__OFFS + DDRSS_PHY_131__SFR_OFFS,  0x01A00000 );
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_Data_Slice_1_REGISTER_BLOCK__OFFS + DDRSS_PHY_387__SFR_OFFS,  0x01A00000 );
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_Data_Slice_2_REGISTER_BLOCK__OFFS + DDRSS_PHY_643__SFR_OFFS,  0x01A00000 );
        HW_WR_REG32(J7_DDR0_SS_BASE + DDRSS_Data_Slice_3_REGISTER_BLOCK__OFFS + DDRSS_PHY_899__SFR_OFFS,  0x01A00000 );
    }

    printf("--->>> DDR0 PHY programming completed... <<<---\n");  

}

