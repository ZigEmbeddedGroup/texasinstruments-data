#define static
#define void
#define uint32_t                  unsigned int
#define HW_WR_REG32(addr, data)   *(uint32_t *) (addr) = (uint32_t) (data)
#define HW_RD_REG32(addr)         *(uint32_t *) (addr)

#define CTRLMMR_LOCK5_KICK0                 0x00115008U
#define CTRLMMR_LOCK5_KICK1                 0x0011500CU
#define CTRLMMR_LOCK5_KICK0_KEY             0x68EF3490U
#define CTRLMMR_LOCK5_KICK1_KEY             0xD172BC5AU

/*
 *  Use these addresses if running from M4
 */
#define M4_RAT_OFFSET                       0x80000000U  //depends on M4 RAT config 
#define J7_DDR0_SS_BASE                     0x82990000U  //when running from M4
#define J7_DDR1_SS_BASE                     0x829B0000U  //when running from M4
#define J7_DDR2_SS_BASE                     0x829D0000U  //when running from M4
#define J7_DDR3_SS_BASE                     0x829F0000U  //when running from M4
#define CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR0  0x114080U
#define CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR0  0x1140C0U
#define CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR1  0x114090U
#define CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR1  0x1140D0U
#define CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR2  0x1140A0U
#define CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR2  0x1140E0U
#define CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR3  0x1140B0U
#define CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR3  0x1140F0U

#define MULTI_DDR_CFG0  0x114100U
#define MULTI_DDR_CFG1  0x114104U
#define DDR_CFG_LOAD    0x114110U

#define PRE_SILICON (0U)
/*
 *  Use these addresses if NOT running from M4
 */
/*
#define M4_RAT_OFFSET                       0x00000000U 
#define J7_DDR_SS_BASE                    0x02990000U
#define CTRLMMR_DDR4_FSP_CLKCHNG_REQ_ADDR   0x00114080U
#define CTRLMMR_DDR4_FSP_CLKCHNG_ACK_ADDR   0x001140C0U
*/

menuitem "J7 DDR Memory config"

/* This is dummy function - GEL does not work real-time.
 * If GELs are imported to C code, this function must be implemented a loop of
 * "delay" microseconds
 */
static void us_delay(uint32_t delay)
{
    uint32_t loop;
    for (loop = 0; loop < delay * 100; loop++)
    {
    loop = loop;
    }
}

/* Wrapper function to simplify importing GEL file to a C code */
printf(char *temp)
{
    GEL_TextOut(temp);
}


