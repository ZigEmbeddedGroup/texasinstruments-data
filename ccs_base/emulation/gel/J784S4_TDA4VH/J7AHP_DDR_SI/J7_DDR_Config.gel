hotmenu J7_LPDDR4_Config(void)
{
    uint32_t ret = 0;
    ret = Set_DDR_Interleave();
    if (ret == 1) return;
    if(MULTI_DDR_CFG_EMIFS_ACTIVE & 0x1) {J7_LPDDR4_Config_Single(0);}
    if(MULTI_DDR_CFG_EMIFS_ACTIVE & 0x2) {J7_LPDDR4_Config_Single(1);}
    if(MULTI_DDR_CFG_EMIFS_ACTIVE & 0x4) {J7_LPDDR4_Config_Single(2);}
    if(MULTI_DDR_CFG_EMIFS_ACTIVE & 0x8) {J7_LPDDR4_Config_Single(3);}
}

/* This function is run when the DMSC firmware is loaded on to the device */
hotmenu J7_LPDDR4_Config_Late()
{
    int status = 1;
    /* Remap the RAT to the GEL Configuration */
    *(0x44200020) = 0x8000001D;
    *(0x44200024) = 0x80000000;
    *(0x44200028) = 0x00000000;
    *(0x4420002C) = 0x00000000;
    *(0x44200030) = 0x8000001D;
    *(0x44200034) = 0x60000000;
    *(0x44200038) = 0x40000000;
    *(0x4420003C) = 0x00000000;
    *(0x44200040) = 0x8000001A;
    *(0x44200044) = 0xA0000000;
    *(0x44200048) = 0x40000000;
    *(0x4420004C) = 0x00000000;
    *(0x44200050) = 0x80000019;
    *(0x44200054) = 0xA8000000;
    *(0x44200058) = 0x70000000;
    *(0x4420005C) = 0x00000000;
    *(0x44200060) = 0x8000001B;
    *(0x44200064) = 0xB0000000;
    *(0x44200068) = 0x50000000;
    *(0x4420006C) = 0x00000000;
    *(0x44200070) = 0x8000001B;
    *(0x44200074) = 0xB8000000;
    *(0x44200078) = 0x58000000;
    *(0x4420007C) = 0x00000000;

    J7_LPDDR4_Config();

    /* Restore DMSC RAT configuration */
    *(0x44200020) = 0x8000001D;
    *(0x44200024) = 0x60000000;
    *(0x44200028) = 0x00000000;
    *(0x4420002C) = 0x00000000;
    *(0x44200030) = 0x8000001D;
    *(0x44200034) = 0x80000000;
    *(0x44200038) = 0x20000000;
    *(0x4420003C) = 0x00000000;
    *(0x44200040) = 0x8000001D;
    *(0x44200044) = 0xA0000000;
    *(0x44200048) = 0x40000000;
    *(0x4420004C) = 0x00000000;
    *(0x44200050) = 0x00000000;
    *(0x44200054) = 0xA8000000;
    *(0x44200058) = 0x70000000;
    *(0x4420005C) = 0x00000000;
    *(0x44200060) = 0x00000000;
    *(0x44200064) = 0xB0000000;
    *(0x44200068) = 0x50000000;
    *(0x4420006C) = 0x00000000;
    *(0x44200070) = 0x00000000;
    *(0x44200074) = 0xB8000000;
    *(0x44200078) = 0x58000000;
    *(0x4420007C) = 0x00000000;

}                                                 


hotmenu Enable_TI_InlineECC_for_DRU_Example()                                   
{                                                  

    unsigned int i=0;

    HW_WR_REG32((M4_RAT_OFFSET + 0x2980120), 0x17); //ECC Control Register (Base Address + 0x120)   

    for(i=0;i<64;i++)
    {
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980128), 1<<15 | 0x68); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    for(i=64;i<128;i++)
    {
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980128), 1<<15 | 0x69); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    HW_WR_REG32((M4_RAT_OFFSET + 0x2980130), 0x0);//ECC Range 0 Start Address Register (Base Address + 0x130)
    HW_WR_REG32((M4_RAT_OFFSET + 0x2980134), 0xFFFF);//ECC Range 0 End Address Register (Base Address + 0x134)
    //ECC Range 1 Start Address Register (Base Address + 0x138)
    //ECC Range 1 End Address Register (Base Address + 0x13C)
    //ECC Range 2 Start Address Register (Base Address + 0x140)
    //ECC Range 2 End Address Register (Base Address + 0x144)
    printf("--->>> ECC region 0 enabled with all cache lines allocated for DRU.... <<<---\n");       
}


hotmenu Enable_TI_InlineECC_for_UDMA_example()                                   
{                                                  

    unsigned int i=0;

    HW_WR_REG32((M4_RAT_OFFSET + 0x2980120), 0x17); //ECC Control Register (Base Address + 0x120)   

    for(i=0;i<32;i++)
    {
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980128), 1<<15 | 0xC8); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    for(i=32;i<64;i++)
    {
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980128), 1<<15 | 0xA9); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    for(i=64;i<96;i++)
    {
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980128), 1<<15 | 0xAA); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }

    for(i=96;i<128;i++)
    {
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980124), i);//ECC Cache RouteID Index Register (Base Address + 0x124)
        HW_WR_REG32((M4_RAT_OFFSET + 0x2980128), 1<<15 | 0xAB); //ECC Cache RouteID Value Register (Base Address + 0x128)       
    }


    HW_WR_REG32((M4_RAT_OFFSET + 0x2980130), 0x0);//ECC Range 0 Start Address Register (Base Address + 0x130)
    HW_WR_REG32((M4_RAT_OFFSET + 0x2980134), 0xFFFF);//ECC Range 0 End Address Register (Base Address + 0x134)
    //ECC Range 1 Start Address Register (Base Address + 0x138)
    //ECC Range 1 End Address Register (Base Address + 0x13C)
    //ECC Range 2 Start Address Register (Base Address + 0x140)
    //ECC Range 2 End Address Register (Base Address + 0x144)
    printf("--->>> ECC region 0 enabled with all cache lines allocated for UDMA.... <<<---\n");       

}
hotmenu Enable_TI_InlineECC_for_DRU_Example2()                                   
