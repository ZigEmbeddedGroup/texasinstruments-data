Load_2132_Config()
{
    GEL_UnloadGel("$(GEL_file_dir)/J721S2-DDR-EVM-LP4-4266.gel");
    GEL_LoadGel("$(GEL_file_dir)/J721S2-DDR-EVM-LP4-2132.gel");
    GEL_UnloadGel("$(GEL_file_dir)/J7_DDR_Config.gel");
    GEL_LoadGel("$(GEL_file_dir)/J7_DDR_Config.gel");
}

Load_4266_Config()
{
    //GEL_UnloadGel("$(GEL_file_dir)/J721S2-DDR-EVM-LP4-2133.gel");
    GEL_LoadGel("$(GEL_file_dir)/Configs/k3-j784s4-ddr-evm-lp4-4266.gel");
    GEL_UnloadGel("$(GEL_file_dir)/J7_DDR_Config.gel");
    GEL_LoadGel("$(GEL_file_dir)/J7_DDR_Config.gel");
}

///////////////////////////////////////////////////////////////////////////////
// MULTI_DDR_CFG0
// [29:24]: ddr_intrlv_gran
// [21:16]: ddr_intrlv_size
// [ 4: 0]: heartbeat_per
///////////////////////////////////////////////////////////////////////////////
// MULTI_DDR_CFG0
// [19:16]: ecc_enable
// [12: 8]: hybrid_select
// [ 3: 0]: emifs_active, 0x1: EMIF0 active, 0x2: EMIF1 active, 0x3: EMIF0,1 active
///////////////////////////////////////////////////////////////////////////////
// DDR_CFG_LOAD
//[31:28]: ddr_cfgg_load, when set to 4b'0110
//[ 0: 0]: ddr_load_stat
///////////////////////////////////////////////////////////////////////////////

Set_DDR_Interleave_Config(uint32_t multi_ddr_cfg0_val, uint32_t multi_ddr_cfg1_val)
{
    //unlock MMR reg 5
    //Partition5 lockkey0
    HW_WR_REG32((M4_RAT_OFFSET + 0x115008), 0x68EF3490);
    //Partition5 lockkey1
    HW_WR_REG32((M4_RAT_OFFSET + 0x11500C), 0xD172BC5A);

    if(HW_RD_REG32((M4_RAT_OFFSET + DDR_CFG_LOAD)) & 0x1) {
        GEL_TextOut("--->>> ----------------------------------------------------------- <<<---\n");
        GEL_TextOut("--->>> ERROR: DDR Interelave Configuration has been done already.        <<<---\n");
        GEL_TextOut("--->>>        Need to reset system to change DDR Interleave Config <<<---\n");
        GEL_TextOut("--->>> ----------------------------------------------------------- <<<---\n");
        return 1;
    } else {
        HW_WR_REG32((M4_RAT_OFFSET + MULTI_DDR_CFG0), multi_ddr_cfg0_val); 
        HW_WR_REG32((M4_RAT_OFFSET + MULTI_DDR_CFG1), multi_ddr_cfg1_val);
        HW_WR_REG32((M4_RAT_OFFSET + DDR_CFG_LOAD),   0x60000000); //

        // Wait until DDR config load is complete
        while((HW_RD_REG32(M4_RAT_OFFSET + DDR_CFG_LOAD) & 0x1) == 0x0);
        return 0;
    }
}

Set_DDR_Interleave_DDR0_Only()
{

    uint32_t multi_ddr_cfg_val0 = 0x00000003; // gran: 0x0, intrlv_size: 0x0,  heartbeat:0x3
    uint32_t multi_ddr_cfg_val1 = 0x00000101; // hybrid_select: 0x1, emifs_active: 0x1, 

    GEL_TextOut("--->>> ==================================================  <<<---\n");
    GEL_TextOut("--->>> Set DDR Interelave Configuration: Enable DDR0 only <<<---\n");
    GEL_TextOut("--->>> ====================================================  <<<---\n");

    return Set_DDR_Interleave_Config(multi_ddr_cfg_val0, multi_ddr_cfg_val1);
}


Set_DDR_Interleave_DDR1_Only()
{

    uint32_t multi_ddr_cfg_val0 = 0x00000003; // gran: 0x0, intrlv_size: 0x0,  heartbeat:0x3
    uint32_t multi_ddr_cfg_val1 = 0x00000202; // hybrid_select: 0x2, emifs_active: 0x2, 

    GEL_TextOut("--->>> ==================================================  <<<---\n");
    GEL_TextOut("--->>> Set DDR Interelave Configuration: Enable DDR0 only <<<---\n");
    GEL_TextOut("--->>> ====================================================  <<<---\n");

    return Set_DDR_Interleave_Config(multi_ddr_cfg_val0, multi_ddr_cfg_val1);
}

Set_DDR_Interleave_128B_Granule()
{
    uint32_t multi_ddr_cfg_val0 = 0x000B0003; // gran(128B): 0x0, intrlv_size(16GB): 0xB,  heartbeat:0x3
    // hybrid_select, recommend to be non-zero    
    uint32_t multi_ddr_cfg_val1 = 0x00000003; // hybrid_select: 0x0, emifs_active: 0x3,  

    GEL_TextOut("--->>> ==================================================  <<<---\n");
    GEL_TextOut("--->>> Set DDR Interelave Configuration:                   <<<---\n");
    GEL_TextOut("--->>>  Interleaved with 128B Granule size, region: 16GB   <<<---\n");
    GEL_TextOut("--->>> ==================================================  <<<---\n");

    return Set_DDR_Interleave_Config(multi_ddr_cfg_val0, multi_ddr_cfg_val1);
}

// Set_DDR_Interleave_16KB_Granule()
// {
//     uint32_t multi_ddr_cfg_val0 = 0x040B0003; // gran(16KB): 0x4, intrlv_size(16GB): 0xB,  heartbeat:0x3
//     // hybrid_select, recommend to be non-zero    
//     uint32_t multi_ddr_cfg_val1 = 0x00000003; // hybrid_select: 0x0, emifs_active: 0x3,  

//     GEL_TextOut("--->>> ==================================================  <<<---\n");
//     GEL_TextOut("--->>> Set DDR Interelave Configuration:                   <<<---\n");
//     GEL_TextOut("--->>>  Interleaved with 16KB Granule size, region: 16GB   <<<---\n");
//     GEL_TextOut("--->>> ==================================================  <<<---\n");

//     return Set_DDR_Interleave_Config(multi_ddr_cfg_val0, multi_ddr_cfg_val1);
// }

Set_DDR_Interleave()
{
    uint32_t MULTI_DDR_CFG_INTRLV_HEARTBEAT = 0x3;


    uint32_t multi_ddr_cfg_val0 = (MULTI_DDR_CFG_INTRLV_GRAN      << 24) | 
                                  (MULTI_DDR_CFG_INTRLV_SIZE      << 16) | 
                                  (MULTI_DDR_CFG_INTRLV_HEARTBEAT <<  0);

    // hybrid_select, recommend to be non-zero    
    uint32_t multi_ddr_cfg_val1 = (MULTI_DDR_CFG_ECC_ENABLE      << 16) | 
                                  (MULTI_DDR_CFG_HYBRID_SELECT   <<  8) | 
                                  (MULTI_DDR_CFG_EMIFS_ACTIVE    <<  0);
    // uint32_t num_ddr       = 0;
    // uint32_t gran_size     = 0;
    // uint32_t intrlv_region = 0;
    // uint32_t ddr0_enabled = 0;
    // uint32_t ddr1_enabled = 0;

    GEL_TextOut("--->>> ==================================================  <<<---\n");
    GEL_TextOut("--->>> Set DDR Interelave Configuration:                   <<<---\n");
    GEL_TextOut("--->>>  multi DDR config 0 : 0x%x                 <<<---\n",,,,,multi_ddr_cfg_val0);
    GEL_TextOut("--->>>  multi DDR config 1 : 0x%x                 <<<---\n",,,,,multi_ddr_cfg_val1);

    if (MULTI_DDR_CFG_EMIFS_ACTIVE == 0xF) { 
        GEL_TextOut("--->>>    Quad DDR enabled                                 <<<---\n");
    } else if (MULTI_DDR_CFG_EMIFS_ACTIVE == 0x3) { 
        GEL_TextOut("--->>>    Dual DDR enabled                                 <<<---\n");
    } else if (MULTI_DDR_CFG_EMIFS_ACTIVE == 0x1) {
        GEL_TextOut("--->>>    Single DDR 0 enabled                                 <<<---\n");
    } else if (MULTI_DDR_CFG_EMIFS_ACTIVE == 0x2) {
        GEL_TextOut("--->>>    Single DDR 1 enabled                                 <<<---\n");
    }
    
    if (MULTI_DDR_CFG_EMIFS_ACTIVE == 0xF) { 
        if (MULTI_DDR_CFG_INTRLV_GRAN == 0x0) {
            GEL_TextOut("--->>>    128B Granule Size                                    <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x1) {
            GEL_TextOut("--->>>    512B Granule Size                                    <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x2) {
            GEL_TextOut("--->>>    2KB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x3) {
            GEL_TextOut("--->>>    4KB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x4) {
            GEL_TextOut("--->>>    16KB Granule Size                                    <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x5) {
            GEL_TextOut("--->>>    32KB Granule Size                                    <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x6) {
            GEL_TextOut("--->>>    512MB Granule Size                                   <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x7) {
            GEL_TextOut("--->>>    1GB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x8) {
            GEL_TextOut("--->>>    1.5GB Granule Size                                   <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0x9) {
            GEL_TextOut("--->>>    2GB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0xA) {
            GEL_TextOut("--->>>    3GB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0xB) {
            GEL_TextOut("--->>>    4GB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0xC) {
            GEL_TextOut("--->>>    6GB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0xD) {
            GEL_TextOut("--->>>    8GB Granule Size                                     <<<---\n");
        } else if (MULTI_DDR_CFG_INTRLV_GRAN == 0xE) {
            GEL_TextOut("--->>>    16GB Granule Size                                    <<<---\n");
        }
    }
    GEL_TextOut("--->>> ==================================================  <<<---\n");

    return Set_DDR_Interleave_Config(multi_ddr_cfg_val0, multi_ddr_cfg_val1);
}

