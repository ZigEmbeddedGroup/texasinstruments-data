hotmenu Set_DDR2_PLL_1066MHz(){
    unsigned int address_offset = 0x80000000;
    GEL_TextOut("Setting DDR2 PLL to produce a clock at 1066MHz.\n");
    GEL_TextOut("Programming Main PLL 27 (DDR2 PLL)\n");
