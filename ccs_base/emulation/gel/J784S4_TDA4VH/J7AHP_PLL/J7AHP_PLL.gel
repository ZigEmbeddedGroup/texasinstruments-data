/**
 * \brief  Set all PLLs on 
 *
 * \param   none
 *
 * \return  none
 */
hotmenu Set_All_PLL(){
    int debug_info = PLL_DEBUG;
    address_offset = 0x80000000;
    //for debugging only: 
    if(debug_info){
        GEL_TextOut("Debugging enabled\n");
        GEL_Trace(1);
    }else{
        GEL_TextOut("Debugging disabled.\n");
        GEL_Trace(0);
    }
    //Turn on LPSC_WKUPMCU2MAIN.
    Turn_On_LPSC_WKUPMCU2MAIN();
    //Turn on the PLLs.
    GEL_TextOut("Programming all PLLs.\n");
    //Main PLL
    GEL_TextOut("Programming Main PLL 0 (Main PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, MAIN_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 0 (Main PLL) Set.\n");
    //Per0 PLL
    GEL_TextOut("Programming Main PLL 1 (Peripheral 0 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, PER0_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 1 (Peripheral 0 PLL) Set.\n");
    //Per1 PLL
    GEL_TextOut("Programming Main PLL 2 (Peripheral 1 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, PER1_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 2 (Peripheral 1 PLL) Set.\n");
    //CPSW9 PLL
    GEL_TextOut("Programming Main PLL 3 (CPSW5X PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, CPSW5X_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 3 (CPSW5X PLL) Set.\n");
    //Audio 0 PLL
    GEL_TextOut("Programming Main PLL 4 (Audio 0 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, AUDIO0_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 4 (Audio 0 PLL) Set.\n");
    //Video PLL
    GEL_TextOut("Programming Main PLL 5 (Video PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, VIDEO_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 5 (Video PLL) Set.\n");
   //Video PLL
    GEL_TextOut("Programming Main PLL 6 (GPU PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, GPU_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 6 (GPU PLL) Set.\n");
    //MSMC/C71 PLL
    GEL_TextOut("Programming Main PLL 7 (MSMC PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, MSMC_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 7 (MSMC PLL) Set.\n");
    //ARM0 PLL
    GEL_TextOut("Programming Main PLL 8 (ARM0 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, ARM0_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 8 (ARM0 PLL) Set.\n");
    //ARM1 PLL
    GEL_TextOut("Programming Main PLL 9 (ARM1 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, ARM1_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 9 (ARM1 PLL) Set.\n");
    //DDR0 PLL
    GEL_TextOut("Programming Main PLL 12 (DDR0 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, DDR0_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 12 (DDR0 PLL) Set.\n");
    //Main SoC Pulsar PLL
    GEL_TextOut("Programming Main PLL 14 (Main Domain Pulsar) PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, MAIN_R5F_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 14 (Main Domain Pulsar PLL) Set.\n");
    //DSS PLLs -- DSS0 PLL
    GEL_TextOut("Programming Main PLL 16 (DSS0 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, DSS0_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 16 (DSS0 PLL) Set.\n");
    //DSS PLLs -- DSS1 PLL
    GEL_TextOut("Programming Main PLL 17 (DSS1 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, DSS1_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 17 (DSS1 PLL) Set.\n");
    //DSS PLLs -- DSS3 PLL
    GEL_TextOut("Programming Main PLL 19 (DSS3 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, DSS3_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 19 (DSS3 PLL) Set.\n");
    //Vision PLL
    GEL_TextOut("Programming Main PLL 25 (Vision PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, VISION_PLL_INDEX, DMPAC_520);
    GEL_TextOut("Main PLL 25 (Vision PLL) Set.\n");
    //DDR1 PLL
    GEL_TextOut("Programming Main PLL 26 (DDR1 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, DDR1_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 26 (DDR1 PLL) Set.\n");
    //DDR2 PLL
    GEL_TextOut("Programming Main PLL 27 (DDR2 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, DDR2_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 27 (DDR2 PLL) Set.\n");
    //DDR3 PLL
    GEL_TextOut("Programming Main PLL 28 (DDR3 PLL)\n");
    Setup(CSL_PLL0_CFG_BASE, address_offset, DDR3_PLL_INDEX, OFC1);
    GEL_TextOut("Main PLL 28 (DDR3 PLL) Set.\n");
    address_offset = 0x20000000;
    //MCU PLL
    GEL_TextOut("Programming MCU PLL 0 (MCU PLL)\n");
    Setup(CSL_MCU_PLL0_CFG_BASE, address_offset, MCU_R5F_PLL_INDEX, OFC1);
    GEL_TextOut("MCU PLL 0 (MCU PLL) Set.\n");
    //MCU Peripheral PLL
    GEL_TextOut("Programming MCU PLL 1 (MCU Peripheral PLL)\n");
    Setup(CSL_MCU_PLL0_CFG_BASE, address_offset, MCU_PER1_PLL_INDEX, OFC1);
    GEL_TextOut("MCU PLL 1 (MCU PLL) Set.\n");
    //MCU CPSW PLL
    GEL_TextOut("Programming MCU PLL 2 (MCU CPSW PLL)\n");
    Setup(CSL_MCU_PLL0_CFG_BASE, address_offset, MCU_PER2_PLL_INDEX, OFC1);
    GEL_TextOut("MCU PLL 2 (MCU PLL) Set.\n");
    GEL_TextOut("All PLLs programmed.\n");
    return 0;
}

