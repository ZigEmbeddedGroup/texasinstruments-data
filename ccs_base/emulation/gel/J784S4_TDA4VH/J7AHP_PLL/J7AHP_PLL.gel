hotmenu PLL5_2400MHz(){
    unsigned int address_offset = 0x80000000;
    GEL_TextOut("Setting Video PLL (Main_PLL5) to a VCO of 2400MHz.\n");
    Program_PLL(CSL_PLL0_CFG_BASE, address_offset, VIDEO_PLL_INDEX, VIDEO_2400);
    GEL_TextOut("Programming HSDIV 0 to 400MHz\n");
    Program_HSDIV(CSL_PLL0_CFG_BASE, address_offset, VIDEO_PLL_INDEX, 0, 5); //5+1 = 6, 2400 / 6 = 400MHz
    GEL_TextOut("Programming HSDIV 1 to 600MHz.\n");
    Program_HSDIV(CSL_PLL0_CFG_BASE, address_offset, VIDEO_PLL_INDEX, 1, 3); //3+1 = 4, 2400 / 4 = 600MHz
    GEL_TextOut("Video PLL set to 2400MHz, HSDIV 0 set to 400MHz, HSDIV 1 set to 600MHz.\n");
}

