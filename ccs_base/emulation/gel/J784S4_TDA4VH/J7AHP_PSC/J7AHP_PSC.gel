/* This function will turn on: 
1. Main Always on
2. Main Test (DFT?)
3. Main PBIST
4. Audio
5. ATL
6. MLB
7. Motor
8. MiscIO (I2C, SPI, etc.)
9. GPMC
10. VPFE
11. VPE
12. Spare 0
13. Spare 1
14. Debug
15. DDR0
16. DDR1
17. Spare 2
18. CC_top_pbist
19. MMC4b 0
20. MMC4b 1
21. MMC8b 0
 */
Main_GP_CORE_CTL_PowerUp(){
    int status = 0;
    GEL_TextOut("Powering up LPSC_MAIN_ALWAYSON\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_ALWAYSON, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_TEST\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_TEST, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_PBIST, PSC_PD_ON, PSC_ENABLE);
    //Audio
    GEL_TextOut("Powering up LPSC_PER_AUDIO\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_AUDIO, PSC_PD_ON, PSC_ENABLE);
    //ATL
    GEL_TextOut("Powering up LPSC_PER_ATL\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_ATL, PSC_PD_ON, PSC_ENABLE);
    //MLB 
    GEL_TextOut("Powering up LPSC_PER_MLB\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_MLB, PSC_PD_ON, PSC_ENABLE);
    //Motor
    GEL_TextOut("Powering up LPSC_PER_MOTOR\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_MOTOR, PSC_PD_ON, PSC_ENABLE);
    //MISCIO
    GEL_TextOut("Powering up LPSC_PER_MISCIO\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_MISCIO, PSC_PD_ON, PSC_ENABLE);
    //GPMC
    GEL_TextOut("Powering up LPSC_PER_GPMC\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_GPMC, PSC_PD_ON, PSC_ENABLE);
    //VPFE
    GEL_TextOut("Powering up LPSC_PER_VPFE\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_VPFE, PSC_PD_ON, PSC_ENABLE);
    //VPE
    GEL_TextOut("Powering up LPSC_PER_VPE\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_VPE, PSC_PD_ON, PSC_ENABLE);
    //Turn on the spare main LPSCs (there are 2 of them)
    GEL_TextOut("Powering up LPSC_PER_SPARE_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_SPARE_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_PER_SPARE_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_SPARE_1, PSC_PD_ON, PSC_ENABLE);
    //Main Debug
    GEL_TextOut("Powering up LPSC_MAIN_DEBUG\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MAIN_DEBUG, PSC_PD_ON, PSC_ENABLE);
    //DDR
    GEL_TextOut("Powering up LPSC_EMIF_CFG_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_EMIF_DATA_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_EMIF_CFG_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_1, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_EMIF_DATA_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_1, PSC_PD_ON, PSC_ENABLE);
    //DDR 2
    GEL_TextOut("Powering up LPSC_EMIF_CFG_2\n");
    status &= Set_MAIN_PSC_State( PD_DDR2, LPSC_EMIF_CFG_2, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_EMIF_DATA_2\n");
    status &= Set_MAIN_PSC_State( PD_DDR2, LPSC_EMIF_DATA_2, PSC_PD_ON, PSC_ENABLE);
    //Turn on the PER SPARE2.
    GEL_TextOut("Powering up LPSC_PER_SPARE_2\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_SPARE_2, PSC_PD_ON, PSC_ENABLE);
    // CC Top PBIST
    GEL_TextOut("Powering up LPSC_CC_TOP_PBIST\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_CC_TOP_PBIST, PSC_PD_ON, PSC_ENABLE);
    //MMC
    GEL_TextOut("Powering up LPSC_MMC4B_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MMC4B_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MMC4B_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MMC4B_1, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MMC8B_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_MMC8B_0, PSC_PD_ON, PSC_ENABLE);
    //SAUL
   	GEL_TextOut("Powering up LPSC_SAUL\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_SAUL, PSC_PD_ON, PSC_ENABLE);
    //I3C
    GEL_TextOut("Powering up LPSC_PER_I3C\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_PER_I3C, PSC_PD_ON, PSC_ENABLE);
}

