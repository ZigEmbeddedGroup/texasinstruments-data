menuitem "Power Sleep Controller/Common PSC Power Controls";

hotmenu Set_PSC_All_On(){
	GEL_TextOut( "Powering up all PSC power domains in progress...\n");
        //WKUP Domain
	WKUP_GP_CORE_CTL_PowerUp();
	WKUP_MCU_PULSAR_PowerUp();

	//Main Domain
	Main_GP_CORE_CTL_PowerUp();
	Bolton_PowerUp();
	Main_SERDES_0_PowerUp();
	Main_SERDES_1_PowerUp();
	Main_SERDES_4_PowerUp();
	Main_SERDES_5_PowerUp();
	Main_MCANSS_PowerUp();
	Main_DSS_PowerUp();
	Main_9GSS_PowerUp();
	Main_PCIe_PowerUp();
	Main_Timer_PowerUp();
	Main_USB_Hyperlink_PowerUp();
	C71_PowerUp();
	A72_PowerUp();
	GPU_PowerUp();
	Main_Pulsar_PowerUp();
	PD_Encoder_PowerUp();
	PD_Decoder_PowerUp();
	PD_DMPAC_PowerUp();
	PD_VPAC_PowerUp();
	PD_Spare_PowerUp();

	GEL_TextOut("Powering up all PSC power domains done!\n");
}

WKUP_GP_CORE_CTL_PowerUp(){
	int status = 1;

    GEL_TextOut("Powering up LPSC_WKUP_ALWAYSON\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUP_ALWAYSON, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_DMSC\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_DMSC, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_DEBUG2DMSC\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_DEBUG2DMSC, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_WKUP_GPIO\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUP_GPIO, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_WKUPMCU2MAIN\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUPMCU2MAIN, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MAIN2WKUPMCU\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MAIN2WKUPMCU, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MCU_TEST\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_TEST, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MCU_DEBUG\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_DEBUG, PSC_PD_ON, PSC_ENABLE);
	//MCAN
	GEL_TextOut("Powering up LPSC_MCU_MCAN_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_MCAN_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MCU_MCAN_1\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_MCAN_1, PSC_PD_ON, PSC_ENABLE);
    //OSPI
    GEL_TextOut("Powering up LPSC_MCU_OSPI_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_OSPI_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MCU_OSPI_1\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_OSPI_1, PSC_PD_ON, PSC_ENABLE);
    //Hyperbus
    GEL_TextOut("Powering up LPSC_MCU_HYPERBUS\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_HYPERBUS, PSC_PD_ON, PSC_ENABLE);
    //I3C
    GEL_TextOut("Powering up LPSC_MCU_I3C_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_I3C_0, PSC_PD_ON, PSC_ENABLE);
    //ADC
    GEL_TextOut("Powering up LPSC_MCU_ADC_0\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_ADC_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_MCU_ADC_1\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_MCU_ADC_1, PSC_PD_ON, PSC_ENABLE);
    //SMS HSM
    GEL_TextOut("Powering up LPSC_WKUP_SPARE_0 (HSM) \n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUP_SPARE_0, PSC_PD_ON, PSC_ENABLE);

}

WKUP_MCU_PULSAR_PowerUp(){
	int status = 0;
