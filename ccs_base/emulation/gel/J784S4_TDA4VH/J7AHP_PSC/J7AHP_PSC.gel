PD_Spare_PowerUp(){
	int status = 0;
	//PD_SPARE4
    GEL_TextOut("Powering up PD_SPARE4\n");
    status &= Set_MAIN_PSC_State( PD_SPARE4, LPSC_SPARE_4, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up PD_SPARE5\n");
    status &= Set_MAIN_PSC_State( PD_SPARE5, LPSC_SPARE_5, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up PD_SPARE6\n");
    status &= Set_MAIN_PSC_State( PD_SPARE6, LPSC_SPARE_6, PSC_PD_ON, PSC_ENABLE);
}

/*
* Internal function to turn on the WKUPMCU2MAIN bridge, in order to allow for
* the DMSC to access MMRs and IPs in the Main SoC after initializing the RAT.
*/
Turn_On_LPSC_WKUPMCU2MAIN(){
	int status = 1;
	GEL_TextOut("Powering up LPSC_WKUPMCU2MAIN\n");
    status &= Set_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUPMCU2MAIN, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Checking LPSC_WKUPMCU2MAIN\n");
    status &= Get_WKUP_PSC_State( PD_GP_CORE_CTL_WKUP, LPSC_WKUPMCU2MAIN);
}

/* Internal function to reset the DDR interface. */
Reset_DDR0(){
	int status = 1;

	//Reset the DDR interface.
    GEL_TextOut("Reset LPSC_EMIF_CFG_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_0, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_EMIF_DATA_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_0, PSC_PD_ON, PSC_SYNCRESET);

    GEL_TextOut("Reset LPSC_EMIF_CFG_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_1, PSC_PD_ON, PSC_SYNCRESET);
    GEL_TextOut("Reset LPSC_EMIF_DATA_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_1, PSC_PD_ON, PSC_SYNCRESET);

    GEL_TextOut("Powering up LPSC_EMIF_CFG_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_0, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_EMIF_DATA_0\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_0, PSC_PD_ON, PSC_ENABLE);

    GEL_TextOut("Powering up LPSC_EMIF_CFG_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_CFG_1, PSC_PD_ON, PSC_ENABLE);
    GEL_TextOut("Powering up LPSC_EMIF_DATA_1\n");
    status &= Set_MAIN_PSC_State( PD_GP_CORE_CTRL, LPSC_EMIF_DATA_1, PSC_PD_ON, PSC_ENABLE);
}

change_HSM_M4_LRST(int enable) {
    unsigned int* mdctl;

    unsigned int loop_cnt = 0;
    unsigned int ret = 1;
    
    unsigned int* mdstat;
    unsigned int mdstat_lrstz=0;

    unsigned int address_offset = 0;
    
    if (*((unsigned int*)WAKEUP_PSC_BASE) != PSC_PID)
    {
        address_offset = 0x20000000;
    }

    //LPSC_HSM
    mdctl  = (unsigned int*)(WAKEUP_PSC_MDCTL_BASE + ( 4 * LPSC_WKUP_SPARE_0 ) + address_offset);

    if(enable==1) {
        *mdctl = ((*mdctl) & ~(0x100));
    } else {
        *mdctl = ((*mdctl) | (0x100));
    }
    
    mdstat = (unsigned int*)(WAKEUP_PSC_MDSTAT_BASE + ( 4 * LPSC_WKUP_SPARE_0 )+ address_offset);
    mdstat_lrstz = (*mdstat >> 8) & 0x1;
            
    if(mdstat_lrstz == 1)
        GEL_TextOut( "LPSC_HSM: Local Reset Released\n");
    else
        GEL_TextOut( "LPSC_HSM: Local Reset Asserted\n");
}

