<module id="DEV_CFG_REGS" HW_revision="" description="DEV CFG Registers">
	<register id="PARTIDL" width="32" page="1" offset="0x2" internal="0" description="Lower 32-bit of Device PART Identification Number">
		<bitfield id="QUAL" description="Qualification Status" begin="7" end="6" width="2" rwaccess="RW"/>
		<bitfield id="FLASH_SIZE" description="FLASH_SIZE" begin="23" end="16" width="8" rwaccess="RW"/>
		<bitfield id="PARTID_FORMAT_REV" description="PARTID_FORMAT_REV" begin="31" end="28" width="4" rwaccess="RW"/>
	</register>
	<register id="PARTIDH" width="32" page="1" offset="0x4" internal="0" description="Upper 32-bit of Device PART Identification Number">
		<bitfield id="FAMILY" description="Device family" begin="15" end="8" width="8" rwaccess="RW"/>
		<bitfield id="PARTNO" description="Device part number" begin="23" end="16" width="8" rwaccess="RW"/>
		<bitfield id="DEVICE_CLASS_ID" description="Device class ID" begin="31" end="24" width="8" rwaccess="R"/>
	</register>
	<register id="REVID" width="32" page="1" offset="0x6" internal="0" description="Device Revision Number">
		<bitfield id="REVID" description="Device Revision ID. This is specific to the Device" begin="15" end="0" width="16" rwaccess="RW"/>
	</register>
	<register id="DC_MEMORY" width="32" page="1" offset="0xe" internal="0" description="Device Capability: Memory Blocks Customization">
		<bitfield id="BANK0_32KB_1" description="BANK0_32KB_1 present" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="BANK0_32KB_2" description="BANK0_32KB_2 present" begin="1" end="1" width="1" rwaccess="RW"/>
		<bitfield id="BANK0_32KB_3" description="BANK0_32KB_3 present" begin="2" end="2" width="1" rwaccess="RW"/>
		<bitfield id="BANK0_32KB_4" description="BANK0_32KB_4 present" begin="3" end="3" width="1" rwaccess="RW"/>
		<bitfield id="BANK0_32KB_5" description="BANK0_32KB_5 present" begin="4" end="4" width="1" rwaccess="RW"/>
		<bitfield id="BANK0_32KB_6" description="BANK0_32KB_6 present" begin="5" end="5" width="1" rwaccess="RW"/>
		<bitfield id="BANK0_32KB_7" description="BANK0_32KB_7 present" begin="6" end="6" width="1" rwaccess="RW"/>
		<bitfield id="BANK0_32KB_8" description="BANK0_32KB_8 present" begin="7" end="7" width="1" rwaccess="RW"/>
		<bitfield id="BANK1_32KB_1" description="BANK1_32KB_1 present" begin="8" end="8" width="1" rwaccess="RW"/>
		<bitfield id="BANK1_32KB_2" description="BANK1_32KB_2 present" begin="9" end="9" width="1" rwaccess="RW"/>
		<bitfield id="BANK1_32KB_3" description="BANK1_32KB_3 present" begin="10" end="10" width="1" rwaccess="RW"/>
		<bitfield id="BANK1_32KB_4" description="BANK1_32KB_4 present" begin="11" end="11" width="1" rwaccess="RW"/>
	</register>
	<register id="PERCNF" width="32" page="1" offset="0x10" internal="0" description="Peripheral Configuration register - GPIO">
		<bitfield id="GPIO_228_226" description="GPIO226, GPIO228 Double bond protection configuration" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="GPIO_230_227" description="GPIO227, GPIO230 Double bond protection configuration" begin="1" end="1" width="1" rwaccess="RW"/>
	</register>
	<register id="TRIMERRSTS" width="32" page="1" offset="0x12" internal="0" description="TRIM Error Status register">
		<bitfield id="LERR" description="TRIM Load error status" begin="15" end="0" width="16" rwaccess="RW"/>
	</register>
	<register id="SOFTPRES_PROC_INFRA" width="32" page="1" offset="0x1e" internal="0" description="Processing and Infra Blocks Software Reset register">
		<bitfield id="DCC1" description="DCC1 soft reset" begin="8" end="8" width="1" rwaccess="RW"/>
		<bitfield id="FLASHA" description="FLASHA soft reset" begin="9" end="9" width="1" rwaccess="RW"/>
	</register>
	<register id="SOFTPRES_CTRL_PERIPH" width="32" page="1" offset="0x20" internal="0" description="Control Peripherals Software Reset register">
		<bitfield id="PWM1" description="PWM1 soft reset" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="PWM3" description="PWM3 soft reset" begin="2" end="2" width="1" rwaccess="RW"/>
		<bitfield id="ECAP1" description="ECAP1 soft reset" begin="12" end="12" width="1" rwaccess="RW"/>
		<bitfield id="EQEP1" description="EQEP1 soft reset" begin="14" end="14" width="1" rwaccess="RW"/>
		<bitfield id="ADC_A" description="ADC_A soft reset" begin="15" end="15" width="1" rwaccess="RW"/>
		<bitfield id="CMPSS1" description="CMPSS1 soft reset" begin="17" end="17" width="1" rwaccess="RW"/>
		<bitfield id="CMPSS2" description="CMPSS2 soft reset" begin="18" end="18" width="1" rwaccess="RW"/>
		<bitfield id="CMPSS3" description="CMPSS3 soft reset" begin="19" end="19" width="1" rwaccess="RW"/>
		<bitfield id="PGA1" description="PGA1 soft reset" begin="24" end="24" width="1" rwaccess="RW"/>
	</register>
	<register id="SOFTPRES_COMM_PERIPH" width="32" page="1" offset="0x22" internal="0" description="Communication Peripherals Software Reset register">
		<bitfield id="I2C_A" description="I2C_A soft reset" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="SCI_A" description="SCI_A soft reset" begin="2" end="2" width="1" rwaccess="RW"/>
		<bitfield id="SCI_B" description="SCI_B soft reset" begin="3" end="3" width="1" rwaccess="RW"/>
		<bitfield id="UART_A" description="UART_A soft reset" begin="4" end="4" width="1" rwaccess="RW"/>
		<bitfield id="SPI_A" description="SPI_A soft reset" begin="6" end="6" width="1" rwaccess="RW"/>
	</register>
	<register id="SOFTPRES_JTAG" width="32" page="1" offset="0x24" internal="0" description="JTAG Software Reset register">
		<bitfield id="JTAG_nTRST" description="Multi Bit JTAG nTRST " begin="3" end="0" width="4" rwaccess="RW"/>
		<bitfield id="JTAG_nTRST_Key" description="JTAG nTRST Key" begin="31" end="16" width="16" rwaccess="RW"/>
	</register>
	<register id="TAP_STATUS" width="32" page="1" offset="0x28" internal="0" description="Status of JTAG State machine and Debugger Connect">
		<bitfield id="TAP_STATE" description="Present TAP State" begin="15" end="0" width="16" rwaccess="R"/>
		<bitfield id="DCON" description="Debugger Connect Indication" begin="31" end="31" width="1" rwaccess="R"/>
	</register>
	<register id="ECAPTYPE" width="32" page="1" offset="0x2a" internal="0" description="Configures ECAP Type for the device">
		<bitfield id="TYPE" description="Configure ECAP type" begin="1" end="0" width="2" rwaccess="RW"/>
		<bitfield id="LOCK" description="Lock bit for the register" begin="15" end="15" width="1" rwaccess="RW"/>
	</register>
	<register id="TAP_CONTROL" width="32" page="1" offset="0x2c" internal="0" description="Disable TAP control">
		<bitfield id="BSCAN_DIS" description="Disable BSCAN TAP control" begin="0" end="0" width="1" rwaccess="RW"/>
		<bitfield id="KEY" description="Key value to enable write" begin="31" end="16" width="16" rwaccess="RW"/>
	</register>
</module>
